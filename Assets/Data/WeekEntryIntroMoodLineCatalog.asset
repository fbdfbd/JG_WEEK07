    - _characterType: 2
      _resolvedMoodType: 8
      _contextLine: "\uBC00\uB9AC\uC544\uB294 \uC544\uBC84\uC9C0\uC758 \uB9D0\uB300\uB85C
        \uC120\uBB3C\uC744 \uAC74\uB124\uB3C4, \uC544\uBCA8\uB9AC\uC544\uAC00 \uC27D\uAC8C
