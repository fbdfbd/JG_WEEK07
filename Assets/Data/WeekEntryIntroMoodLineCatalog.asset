        \uB9C9\uC2A4\uB294 \uC790\uC2E0\uC758 \uB9D0\uC774 \uC774 \uC544\uC774\uC5D0\uAC8C
        \uB2FF\uAE30 \uC26C\uC6B8 \uAC83\uC774\uB77C\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 2
      _directionType: 0
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC5B4\uB978\uB4E4\uC758 \uB9D0\uC774
