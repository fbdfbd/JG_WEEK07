        \uAC78 \uB290\uB08D\uB2C8\uB2E4."
    - _characterType: 3
      _resolvedMoodType: 4
      _contextLine: "\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC774\uC81C
