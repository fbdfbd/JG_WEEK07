      _directionType: 4
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB0AF\uC120 \uC790\uB9AC\uC5D0\uC11C\uB3C4
        \uC6B8\uC74C\uC744 \uC0BC\uD0A4\uB294 \uC544\uC774\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
        \uC720\uD53C\uB294 \uC774 \uC544\uC774\uAC00 \uC0DD\uAC01\uBCF4\uB2E4 \uD63C\uC790
        \uC798 \uBC84\uD2F4\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 3
      _directionType: 5
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC791\uC740 \uC18C\uB9AC\uC5D0\uB3C4
        \uB4A4\uB97C \uB3CC\uC544\uBCF4\uB294 \uBC84\uB987\uC774 \uC0DD\uACBC\uC2B5\uB2C8\uB2E4.
        \uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uBD99\uC7A1\uC744 \uC190\uC744
        \uCC3E\uACE0 \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 3
      _directionType: 6
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB0A9\uB4DD\uD560 \uC218 \uC5C6\uB294\uC77C
        \uC55E\uC5D0\uC11C \uBC1C\uC744 \uB5BC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uC720\uD53C\uB294
        \uB354 \uBD80\uB4DC\uB7EC\uC6B4 \uB9D0\uB85C \uAC10\uC2F8\uC57C\uACA0\uB2E4\uACE0
        \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 3
      _directionType: 7
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC2DC\uD0A4\uB294 \uB300\uB85C
