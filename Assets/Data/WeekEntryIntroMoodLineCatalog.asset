        \uC720\uD53C\uB294 \uB354 \uB2E4\uC815\uD55C \uB9D0\uB85C \uC774 \uC544\uC774\uB97C
        \uAC10\uC2F8\uC57C\uACA0\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 3
      _directionType: 7
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC815\uD574\uC9C4 \uC21C\uC11C\uAC00
