        \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 3
      _resolvedMoodType: 3
      _contextLine: "\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC790\uC2E0\uC758
