  m_Name: WeekEntryIntroMoodLineCatalog
  m_EditorClassIdentifier: Assembly-CSharp::SO_WeekEntryIntroMoodLineCatalog
  _weekLineSets:
  - _weekId: week_003
    _noCharacterMetLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB0AF\uC120 \uC790\uB9AC\uC5D0\uC11C\uB3C4
      \uC6B8\uC74C\uC744 \uC0BC\uD0A4\uB294 \uC544\uC774\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC544\uBCA8\uB9AC\uC544 \uACC1\uC5D0\uB294 \uC544\uBB34\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4."
    _characterMoodLines:
    - _characterType: 0
      _directionType: 0
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC5B4\uB978\uB4E4\uC758 \uB9D0\uC774
        \uB298 \uB9DE\uB294 \uAC83\uC740 \uC544\uB2C8\uB77C\uB294 \uAC78 \uC5B4\uB834\uD48B\uC774
        \uC54C\uC544\uAC11\uB2C8\uB2E4. \uB9AC\uC548\uC740 \uC774 \uC544\uC774\uC5D0\uAC8C\uB294
        \uC18D\uB9C8\uC74C\uC744 \uB9D0\uD558\uAE30 \uD3B8\uD558\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 0
      _directionType: 1
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB2E4\uC815\uD55C \uB9D0\uC740
        \uB300\uCCB4\uB85C \uC88B\uC740 \uB73B\uC774\uB77C\uACE0 \uBBFF\uC2B5\uB2C8\uB2E4.
        \uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC790\uC2E0\uC758 \uB9D0\uC744
        \uC27D\uAC8C \uBBFF\uC744 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 0
      _directionType: 2
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC98\uC74C \uBCF4\uB294 \uAC83\uC744
        \uAC74\uB4DC\uB9AC\uAE30\uC804\uC5D0 \uAD00\uCC30\uBD80\uD130 \uD569\uB2C8\uB2E4.
        \uB9AC\uC548\uC740 \uC774 \uC544\uC774\uAC00 \uC790\uC2E0\uC5D0\uAC8C\uB3C4
        \uC18D\uB9C8\uC74C\uC744 \uD138\uC5B4\uB193\uC9C0 \uC54A\uB294\uB2E4\uACE0
        \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 0
      _directionType: 3
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBAA8\uB974\uB294 \uAC83\uC774
        \uC788\uC73C\uBA74 \uD55C\uCC38\uC744 \uB4E4\uC5EC\uB2E4\uBD05\uB2C8\uB2E4.
        \uB9AC\uC548\uC740 \uC774\uC57C\uAE30 \uBA87 \uAC1C\uBA74 \uC774 \uC544\uC774\uC758
        \uB208\uC774 \uBE5B\uB0A0\uAC83\uC774\uB77C\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 0
      _directionType: 4
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB0AF\uC120 \uC790\uB9AC\uC5D0\uC11C\uB3C4
        \uC6B8\uC74C\uC744 \uC0BC\uD0A4\uB294 \uC544\uC774\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
        \uB9AC\uC548\uC740 \uC774\uB97C \uBCF4\uACE0 \uC544\uBCA8\uB9AC\uC544\uAC00
        \uC27D\uAC8C \uBB34\uB108\uC9C0\uC9C0 \uC54A\uC744 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 0
      _directionType: 5
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC791\uC740 \uC18C\uB9AC\uC5D0\uB3C4
        \uB4A4\uB97C \uB3CC\uC544\uBCF4\uB294 \uBC84\uB987\uC774 \uC0DD\uACBC\uC2B5\uB2C8\uB2E4.
        \uB9AC\uC548\uC740 \uC790\uC2E0\uC758 \uC9D1\uC5D0\uC11C\uB294 \uC774 \uC544\uC774\uAC00
        \uBC84\uD2F0\uAE30 \uC5B4\uB835\uACA0\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 0
      _directionType: 6
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB0A9\uB4DD\uD560 \uC218 \uC5C6\uB294\uC77C
        \uC55E\uC5D0\uC11C \uBC1C\uC744 \uB5BC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uB9AC\uC548\uC740
        \uC774 \uACE0\uC9D1\uC774 \uC2DC\uB828\uC744 \uBC84\uD168\uB0BC \uC218 \uC788\uB294
        \uD798\uC774 \uB420\uAC83\uC774\uB77C\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 0
      _directionType: 7
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC2DC\uD0A4\uB294 \uB300\uB85C
        \uC6C0\uC9C1\uC774\uB294 \uC77C\uC5D0 \uC870\uAE08\uC529 \uC775\uC219\uD574\uC84C\uC2B5\uB2C8\uB2E4.
        \uB9AC\uC548\uC740 \uC774 \uC544\uC774\uAC00 \uC790\uC2E0\uC758 \uB9D0\uB3C4
        \uC798 \uB530\uB97C\uC9C0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 1
      _directionType: 0
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC5B4\uB978\uB4E4\uC758 \uB9D0\uC774
        \uB298 \uB9DE\uB294 \uAC83\uC740 \uC544\uB2C8\uB77C\uB294 \uAC78 \uC5B4\uB834\uD48B\uC774
        \uC54C\uC544\uAC11\uB2C8\uB2E4. \uB9C9\uC2A4\uB294 \uC870\uC2EC\uC2A4\uB7FD\uAC8C
        \uC6C3\uACE0\uC788\uC2B5\uB2C8\uB2E4."
    - _characterType: 1
      _directionType: 1
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB2E4\uC815\uD55C \uB9D0\uC740
        \uB300\uCCB4\uB85C \uC88B\uC740 \uB73B\uC774\uB77C\uACE0 \uBBFF\uC2B5\uB2C8\uB2E4.
        \uB9C9\uC2A4\uB294 \uC774 \uC544\uC774 \uC606\uC5D0 \uC790\uC2E0\uC774 \uC11C\uC788\uC744
        \uC218 \uC788\uACA0\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 1
      _directionType: 2
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC98\uC74C \uBCF4\uB294 \uAC83\uC744
        \uAC74\uB4DC\uB9AC\uAE30\uC804\uC5D0 \uAD00\uCC30\uBD80\uD130 \uD569\uB2C8\uB2E4.
        \uB9C9\uC2A4\uB294 \uC774 \uC544\uC774\uC5D0\uAC8C \uB2E4\uAC00\uAC00\uB824\uBA74
        \uBA3C\uC800 \uAC00\uBA74\uC744 \uC368\uC57C\uACA0\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 1
      _directionType: 3
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBAA8\uB974\uB294 \uAC83\uC774
        \uC788\uC73C\uBA74 \uD55C\uCC38\uC744 \uB4E4\uC5EC\uB2E4\uBD05\uB2C8\uB2E4.
        \uB9C9\uC2A4\uB294 \uC774 \uAD00\uC2EC\uC744 \uB2E4\uB978 \uACF3\uC73C\uB85C
        \uB3CC\uB9B4 \uC218 \uC788\uACA0\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 1
      _directionType: 4
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB0AF\uC120 \uC790\uB9AC\uC5D0\uC11C\uB3C4
