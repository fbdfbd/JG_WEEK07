        \uBBFF\uC73C\uBA70 \uC6C3\uC2B5\uB2C8\uB2E4."
    - _characterType: 3
      _directionType: 2
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBAA8\uB4E0 \uC77C\uB4E4\uC744
        \uBC14\uB85C \uD5C8\uAC00\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uC720\uD53C\uB294
