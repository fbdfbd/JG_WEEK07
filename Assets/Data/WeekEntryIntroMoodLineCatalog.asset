    - _characterType: 2
      _resolvedMoodType: 8
      _contextLine: "\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC120\uBB3C\uBCF4\uB2E4\uB294
        \uADF8 \uC7A5\uBD80\uC5D0 \uAD00\uC2EC \uC788\uB294 \uAC83\uC744 \uD655\uC778\uD569\uB2C8\uB2E4."
    - _characterType: 2
      _resolvedMoodType: 7
      _contextLine: "\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uD654\uB824\uD55C
