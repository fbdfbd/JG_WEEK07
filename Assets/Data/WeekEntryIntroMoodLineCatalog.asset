    - _characterType: 3
      _directionType: 4
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC0AC\uB78C\uB4E4 \uC55E\uC5D0\uC11C\uB3C4
        \uB2F9\uB2F9\uD558\uAC8C \uC11C\uC788\uC2B5\uB2C8\uB2E4. \uC720\uD53C\uB294
        \uC790\uC2E0\uC774 \uB9C8\uB828\uD55C \uC790\uB9AC\uAC00 \uD544\uC694\uD558\uC9C0
