      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC120\uD0DD\uD558\uAE30 \uC804\uC5D0
        \uADF8 \uC548\uCABD\uC744 \uBA3C\uC800 \uD655\uC778\uD569\uB2C8\uB2E4. \uC720\uD53C\uB294
        \uC544\uBCA8\uB9AC\uC544\uAC00 \uC790\uC2E0\uB9CC\uC740 \uBBFF\uAC8C \uB9CC\uB4DC\uB294
        \uBC29\uBC95\uC744 \uC900\uBE44\uD569\uB2C8\uB2E4."
    - _characterType: 3
      _directionType: 3
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBCF4\uC774\uC9C0 \uC54A\uB294
        \uAC00\uB2A5\uC131\uC744 \uD5A5\uD574 \uD55C \uAC78\uC74C \uB354 \uB2E4\uAC00\uC12D\uB2C8\uB2E4.
        \uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC88B\uC544\uD560 \uB9CC\uD55C
        \uC0C8\uB85C\uC6B4 \uAC83\uC744 \uC900\uBE44\uD569\uB2C8\uB2E4."
    - _characterType: 3
      _directionType: 4
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC790\uC2E0\uC758 \uC774\uB984\uC774
        \uAC00\uC9C4 \uBB34\uAC8C\uB97C \uC870\uC6A9\uD788 \uBC1B\uC544\uB4E4\uC785\uB2C8\uB2E4.
        \uC720\uD53C\uB294 \uC774 \uC544\uC774\uC5D0\uAC8C \uC120\uC744 \uB118\uAE30
        \uC5B4\uB835\uB2E4\uB294 \uAC78 \uB2E4\uC2DC \uD655\uC778\uD569\uB2C8\uB2E4."
    - _characterType: 3
      _directionType: 5
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC790\uC2E0\uC758 \uC774\uB984\uC774
        \uBD88\uB9B4 \uB54C\uB9C8\uB2E4 \uC5B4\uAE68\uAC00 \uC870\uAE08 \uAD73\uC2B5\uB2C8\uB2E4.
        \uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uAE30\uB308 \uACF3\uC744
        \uCC3E\uACE0 \uC788\uB2E4\uACE0 \uBD05\uB2C8\uB2E4."
    - _characterType: 3
      _directionType: 6
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB0A9\uB4DD\uD558\uC9C0 \uBABB\uD55C
        \uCC45\uC784\uC740 \uBC1B\uC544\uB4E4\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
        \uC720\uD53C\uB294 \uB354 \uBD80\uB4DC\uB7EC\uC6B4 \uBC29\uC2DD\uC73C\uB85C
        \uC811\uADFC\uD574\uC57C\uACA0\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 3
      _directionType: 7
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC5ED\uD560\uC774 \uC8FC\uC5B4\uC9C0\uBA74
