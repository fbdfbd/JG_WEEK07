  - _weekId: week_005
    _noCharacterMetLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB0AF\uC120 \uC0AC\uB78C\uB4E4
      \uC0AC\uC774\uC5D0\uC11C\uB3C4 \uAE38\uC744 \uD5E4\uB9E4\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uC544\uBCA8\uB9AC\uC544 \uACC1\uC5D0\uB294 \uC544\uBB34\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4."
    _characterMoodLines:
    - _characterType: 0
      _directionType: 0
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC6C3\uB294 \uC5BC\uAD74 \uB4A4\uC5D0
        \uB2E4\uB978 \uB73B\uC774 \uC788\uC744 \uC218 \uC788\uB2E4\uB294 \uAC78 \uC54C\uC544\uAC11\uB2C8\uB2E4.
        \uB9AC\uC548\uC740 \uC18D\uB9C8\uC74C\uC744 \uB9D0\uD574\uB3C4 \uB418\uACA0\uB2E4\uACE0
        \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 0
      _directionType: 1
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC88B\uC740 \uC5BC\uAD74\uB85C
