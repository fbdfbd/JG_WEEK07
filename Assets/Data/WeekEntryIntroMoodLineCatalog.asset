        \uB9C9\uC2A4\uB294 \uC774 \uC544\uC774\uB77C\uBA74 \uACC1\uC5D0 \uC624\uB798
        \uB0A8\uC544\uB3C4 \uB418\uACA0\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 1
      _directionType: 5
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC791\uC740 \uC18C\uB9AC\uC5D0\uB3C4
