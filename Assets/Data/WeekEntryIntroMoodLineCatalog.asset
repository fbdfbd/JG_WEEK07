        \uB9C9\uC2A4\uB294 \uC774 \uC544\uC774 \uC55E\uC5D0 \uB204\uAD70\uAC00 \uC11C\uC57C
        \uD55C\uB2E4\uB294 \uC0DD\uAC01\uC744 \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    - _characterType: 1
      _directionType: 6
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB0A9\uB4DD\uD560 \uC218 \uC5C6\uB294\uC77C
