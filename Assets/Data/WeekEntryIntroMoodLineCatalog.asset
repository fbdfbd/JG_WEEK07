    _characterMoodLines:
    - _characterType: 0
      _resolvedMoodType: 1
      _contextLine: "\uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC6B8\uC9C0
        \uC54A\uACE0 \uC549\uC544 \uC788\uB294 \uBAA8\uC2B5\uC744 \uBC14\uB77C\uBD05\uB2C8\uB2E4."
    - _characterType: 0
      _resolvedMoodType: 0
      _contextLine: "\uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uAC00 \uB0AF\uC120
