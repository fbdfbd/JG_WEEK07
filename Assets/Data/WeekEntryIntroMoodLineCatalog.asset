        \uC774 \uACE0\uC9D1\uC774 \uC545\uC601\uD5A5\uC744 \uB07C\uCE60 \uC218 \uC788\uB2E4\uACE0
        \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 1
      _directionType: 7
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC2DC\uD0A4\uB294 \uB300\uB85C
