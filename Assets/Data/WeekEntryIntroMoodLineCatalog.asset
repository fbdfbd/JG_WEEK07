        \uC544\uBCA8\uB9AC\uC544\uAC00 \uC790\uC2E0\uC774 \uC544\uBCA8\uB9AC\uC544\uC758
        \uAE30\uC900\uC774 \uB418\uC5C8\uB2E4\uACE0 \uB290\uB08D\uB2C8\uB2E4."
  - _weekId: week_009
    _noCharacterMetLine: "\uC544\uBCA8\uB9AC\uC544 \uACC1\uC5D0\uB294 \uC544\uBB34\uB3C4
      \uC5C6\uC2B5\uB2C8\uB2E4."
    _characterMoodLines:
    - _characterType: 0
      _directionType: 0
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC74\uB124\uC9C4 \uB9D0\uB4E4\uC758
        \uBB34\uAC8C\uB97C \uAC00\uB2A0\uD569\uB2C8\uB2E4. \uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544
        \uC55E\uC5D0\uC11C \uC18D\uB0B4\uB97C \uC228\uAE30\uC9C0 \uC54A\uC544\uB3C4
        \uB418\uACA0\uB2E4\uACE0 \uB290\uB08D\uB2C8\uB2E4."
    - _characterType: 0
      _directionType: 1
      _contextLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC544\uC9C1\uC740 \uB2E4\uC815\uD55C
