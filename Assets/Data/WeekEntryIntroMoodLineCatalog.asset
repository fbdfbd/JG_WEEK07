        \uC54A\uB294\uB2E4\uB294 \uAC83\uC744 \uAE30\uC5B5\uD574\uB461\uB2C8\uB2E4."
    - _characterType: 0
      _resolvedMoodType: 0
      _contextLine: "\uB9AC\uC548\uC740 \uD669\uC2E4\uC758 \uC774\uB984\uC774 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
        \uC544\uC9C1 \uBB34\uAC81\uAC8C \uB2FF\uB294\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    - _characterType: 1
      _resolvedMoodType: 2
      _contextLine: "\uB9C9\uC2A4\uB294 \uC544\uBCA8\uB9AC\uC544\uB97C \uC9C0\uD0AC
        \uB300\uC0C1\uC774 \uC544\uB2C8\uB77C \uB530\uB97C \uC0AC\uB78C\uC73C\uB85C
        \uBC14\uB77C\uBD05\uB2C8\uB2E4."
    - _characterType: 1
      _resolvedMoodType: 4
      _contextLine: "\uB9C9\uC2A4\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uACC1\uC744
        \uC9C0\uD0A4\uBA70, \uADF8 \uB108\uBA38\uC758 \uC790\uB9AC\uAE4C\uC9C0 \uBC14\uB77C\uBD05\uB2C8\uB2E4."
    - _characterType: 2
      _resolvedMoodType: 8
      _contextLine: "\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uBB3C\uAC74\uC758
        \uD3EC\uC7A5\uBCF4\uB2E4 \uADF8 \uC548\uCABD\uC744 \uBCF4\uB294 \uC544\uC774\uB77C\uACE0
        \uC544\uBC84\uC9C0\uC5D0\uAC8C \uC804\uD569\uB2C8\uB2E4."
    - _characterType: 2
      _resolvedMoodType: 7
      _contextLine: "\uBC00\uB9AC\uC544\uB294 \uC544\uBC84\uC9C0\uC5D0\uAC8C \uC81C\uC548\uC758
        \uD3EC\uC7A5\uB9CC \uADF8\uB7F4\uB4EF\uD558\uAC8C \uBC14\uAFB8\uC5B4\uB3C4,
        \uC544\uBCA8\uB9AC\uC544\uC758 \uB208\uAE38\uC740 \uB04C \uC218 \uC788\uACA0\uB2E4\uACE0
        \uC804\uD569\uB2C8\uB2E4."
    - _characterType: 3
      _resolvedMoodType: 3
      _contextLine: "\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC790\uC2E0\uC5D0\uAC8C
        \uC644\uC804\uD788 \uC758\uC9C0\uD558\uC9C0\uB294 \uC54A\uB294\uB2E4\uB294
        \uAC78 \uC54C\uC544\uCC55\uB2C8\uB2E4."
    - _characterType: 3
      _resolvedMoodType: 4
      _contextLine: "\uC720\uD53C\uB294 \uB2E4\uC815\uD55C \uB9D0 \uBA87 \uB9C8\uB514\uBA74,
