--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_rumor_direct_default__step_event_week_008_rumor_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC18C\uBB38 \uD5C8\uAC00"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uACBD\uBE44\uB300\uC7A5\uC774 \uC9C4\uD759\uC774 \uBB3B\uC740 \uC7A5\uD654\uB97C
      \uC2E0\uC740 \uCC44 \uC232 \uC785\uAD6C \uCABD\uC5D0\uC11C \uAC78\uC5B4 \uB098\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACBD\uBE44\uB300\uC7A5\uB2D8, \uC232\uC5D0\uC11C \uC624\uC2DC\uB294
      \uAC70\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC608, \uC544\uAC00\uC528. \uC0C8\uBCBD\uBD80\uD130 \uD55C \uBC14\uD034
      \uB3CC\uACE0 \uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uC2A8 \uC77C \uC788\uC5C8\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\u2026\uC232 \uAC00\uC7A5\uC790\uB9AC\uC5D0\uC11C \uBC1C\uC790\uAD6D\uC774
      \uC5EC\uB7FF \uB098\uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC1C\uC790\uAD6D?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC608. \uC6B0\uB9AC \uACBD\uBE44\uB4E4\uC758 \uAC83\uC774 \uC544\uB2D9\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4\uB978 \uC0AC\uB78C\uB4E4 \uAC70\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC608. \uD55C \uBA85\uB3C4 \uC544\uB2C8\uACE0, \uC5EC\uB7FF\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC5B8\uC81C \uAC70\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC774\uD2C0 \uC548\uCABD\uC73C\uB85C \uBCF4\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB514\uB85C \uB4E4\uC5B4\uAC14\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC548\uCABD\uC73C\uB85C \uB4E4\uC5B4\uAC04 \uD754\uC801\uB3C4 \uC788\uACE0,
      \uB2E4\uC2DC \uB098\uC628 \uD754\uC801\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uB204\uAD70\uC9C0 \uC54C\uC544\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC544\uC9C1\uC740 \uBAA8\uB985\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0AC\uB0E5\uC9C0\uAE30 \uC601\uAC10\uB2D8\uC740\uC694. \uBB34\uC0AC\uD558\uC138\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\u2026\uC624\uB450\uB9C9\uC740 \uC870\uC6A9\uD588\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC2DC \uAC00\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC232 \uC548\uCABD\uC744 \uD55C\uCC38
      \uBC14\uB77C\uBD24\uB2E4."
  _nemoLine: "\uACBD\uBE44\uB300\uC7A5\uC774 \uC9C4\uD759\uC774 \uBB3B\uC740 \uC7A5\uD654\uB97C
    \uC2E0\uC740 \uCC44 \uC232 \uC785\uAD6C \uCABD\uC5D0\uC11C \uAC78\uC5B4 \uB098\uC654\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
