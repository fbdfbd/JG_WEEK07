  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_max_4__step_event_week_008_max_4
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uC815\uC6D0. \uD574\uC9C8 \uBB34\uB835."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC131\uC778\uC2DD\uC774 \uB05D\uB098\uBA74, \uC544\uBCA8\uB9AC\uC544\uB294
      \uC5B4\uB5BB\uAC8C \uD558\uC2E4 \uC0DD\uAC01\uC785\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uC9C1 \uBAA8\uB974\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uBC1C\uD14C\uB9AC\uC628\uC774 \uD798\uC774 \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C9\uC2A4\uB3C4\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB124. \uAC00\uBB38\uB3C4, \uC800\uB3C4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8 \uB458\uC774 \uD56D\uC0C1 \uAC19\uC740 \uB73B\uC740 \uC544\uB2D0
      \uC218 \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC870\uC6A9\uD788 \uC544\uBCA8\uB9AC\uC544\uB97C
      \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uC800\uB294 \uC544\uBCA8\uB9AC\uC544 \uACC1\uC5D0
      \uC788\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4. \uD5C8\uB77D\uD574 \uC8FC\uC2E0\uB2E4\uBA74\uC694."
  _nemoLine: "\uBC31\uC791\uC800 \uC815\uC6D0. \uD574\uC9C8 \uBB34\uB835."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
