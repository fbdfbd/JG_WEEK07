  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_rian_3__step_event_week_008_rian_3
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC624\uB298\uC740 \uD669\uC2E4 \uCABD \uC0AC\uB78C\uB4E4\uB3C4 \uC544\uBCA8\uB9AC\uC544\uB97C
      \uC9C0\uCF1C\uBCFC \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uB97C\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB124. \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uBC31\uC791\uAC00\uC758 \uD6C4\uACC4\uC790\uB2C8\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC74C."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "...\uC544\uBCA8\uB9AC\uC544\uB77C\uBA74 \uC54C\uAC30\uC9C0\uB9CC, \uB108\uBB34
      \uBE68\uB9AC \uB300\uB2F5\uD558\uC9C0\uB294 \uB9C8\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uCD95\uD558\uCC98\uB7FC \uB4E4\uB9AC\uB294 \uB9D0\uB3C4, \uC5B4\uB5A4
      \uB9D0\uC744 \uB2F4\uACE0 \uC788\uC744\uC9C0 \uBAA8\uB985\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uB0AE\uC740 \uBAA9\uC18C\uB9AC\uB85C \uB9D0\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC6C3\uC73C\uBA74\uC11C \uAC74\uB124\uB294 \uB9D0\uC77C\uC218\uB85D,
      \uD55C \uBC88 \uB354 \uC0DD\uAC01\uD558\uC138\uC694."
  _nemoLine: "\uC624\uB298\uC740 \uD669\uC2E4 \uCABD \uC0AC\uB78C\uB4E4\uB3C4 \uC544\uBCA8\uB9AC\uC544\uB97C
    \uC9C0\uCF1C\uBCFC \uAC81\uB2C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
