  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_rian_blocked__step_event_week_008_rian_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uD669\uC2E4 \uBB38\uC7A5\uC774 \uCC0D\uD78C
      \uCD95\uD558 \uC11C\uC2E0\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD669\uC2E4\uC5D0\uC11C \uC628 \uAC74\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC608. \uC804\uC57C\uC81C\uC5D0 \uB9DE\uCDB0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uCD95\uD558\uD55C\uB2E4\uB294 \uB9D0\uC740 \uC788\uB294\uB370, \uCD95\uD558\uBC1B\uB294
      \uB290\uB08C\uC740 \uC5C6\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uACF5\uC2DD \uC11C\uC2E0\uC774\uB2C8 \uD615\uC2DD\uC744 \uAC16\uCD98
      \uAC83\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC11C\uC2E0\uC758 \uCCAB \uBB38\uC7A5\uC744
      \uB2E4\uC2DC \uC77D\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB38\uC7A5\uC740 \uC788\uB294\uB370, \uBAA9\uC18C\uB9AC\uB294 \uC5C6\uC5B4\uC694."
  _nemoLine: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uD669\uC2E4 \uBB38\uC7A5\uC774 \uCC0D\uD78C
    \uCD95\uD558 \uC11C\uC2E0\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
