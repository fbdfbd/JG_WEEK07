  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_excursion_basement_direct_cautious__step_event_week_008_excursion_basement_direct_cautious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC637\uAC10\uC740 \uB0A1\uC558\uC9C0\uB9CC, \uC544\uC9C1 \uC644\uC804\uD788
      \uC0C1\uD558\uC9C0\uB294 \uC54A\uC740 \uC0C1\uD0DC\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACC4\uC18D \uAC78\uC5B4\uB450\uB294 \uAC74 \uC88B\uC9C0 \uC54A\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uADF8\uB807\uC2B5\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uAC8C \uB54C\uBB38\uC5D0 \uC5B4\uAE68\uC120\uC774 \uB354 \uB9DD\uAC00\uC9C8
      \uAC70\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uADF8\uB7F4 \uC218\uB3C4 \uC788\uACA0\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uCC9C \uC0AC\uC774\uB97C \uBC1B\uCCD0\uC11C \uB215\uD600 \uBCF4\uAD00\uD558\uB294
      \uD3B8\uC774 \uB0AB\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC798 \uC544\uC2DC\uB294\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0A8\uACA8\uC9C4 \uAC78 \uC9C0\uD0A4\uB824\uBA74 \uAC10\uC815\uBCF4\uB2E4
      \uBC29\uC2DD\uC774 \uBA3C\uC800\uC77C \uB54C\uB3C4 \uC788\uC73C\uB2C8\uAE4C\uC694."
  _nemoLine: "\uC637\uAC10\uC740 \uB0A1\uC558\uC9C0\uB9CC, \uC544\uC9C1 \uC644\uC804\uD788
    \uC0C1\uD558\uC9C0\uB294 \uC54A\uC740 \uC0C1\uD0DC\uC600\uB2E4."
