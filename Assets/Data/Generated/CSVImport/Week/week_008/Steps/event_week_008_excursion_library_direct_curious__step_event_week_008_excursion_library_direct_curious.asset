  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_excursion_library_direct_curious__step_event_week_008_excursion_library_direct_curious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC45\uC0C1 \uC704\uC758 \uD3B8\uC9C0\uB97C
      \uB450 \uC190\uC73C\uB85C \uB4E4\uACE0, \uBC00\uB78D \uBD09\uC778\uC744 \uC870\uC2EC\uC2A4\uB7FD\uAC8C
      \uB72F\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC885\uC774\uB97C \uD3BC\uCE58\uACE0, \uCCAB \uC904\uBD80\uD130 \uD55C
      \uAE00\uC790\uC529 \uCC9C\uCC9C\uD788 \uB530\uB77C\uAC14\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB124\uAC00 \uC774 \uD3B8\uC9C0\uB97C \uC77D\uB294\uB2E4\uBA74, \uC774\uBBF8
      \uB124\uAC00 \uC120\uD0DD\uD574\uC57C \uD560 \uC2DC\uAC04\uC774 \uC654\uB2E4\uB294
      \uB73B\uC774\uB2E4. \uC0AC\uB791\uD55C\uB2E4.'"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "...\uC0AC\uB791\uD55C\uB2E4, \uB77C\uACE0 \uC801\uD600 \uC788\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC608."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C8\uC9C0\uB9C9 \uC904\uC744 \uD55C \uBC88 \uB354 \uC77D\uC5B4\uBCFC\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD3B8\uC9C0\uC758 \uB9C8\uC9C0\uB9C9
      \uC904\uC5D0 \uC190\uAC00\uB77D\uC744 \uAC00\uB9CC\uD788 \uC5B9\uC5C8\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC45\uC0C1 \uC704\uC758 \uD3B8\uC9C0\uB97C
    \uB450 \uC190\uC73C\uB85C \uB4E4\uACE0, \uBC00\uB78D \uBD09\uC778\uC744 \uC870\uC2EC\uC2A4\uB7FD\uAC8C
    \uB72F\uC5C8\uB2E4."
