--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_night_sleepless_night__step_event_week_008_night_sleepless_night_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC7A0\uC774 \uC624\uC9C0 \uC54A\uB294 \uBC24"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC57C\uACBD\uCD08\uAC00 \uD55C \uBC88 \uB354 \uD754\uB4E4\uB838\uB2E4.
      \uBA40\uB9AC\uC11C \uB204\uAD70\uAC00 \uB4F1\uBD88\uC744 \uB044\uB294 \uC18C\uB9AC\uAC00
      \uC791\uAC8C \uB4E4\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0AC\uC2E4\uC740\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uAE4C\uBD80\uD130 \uC190\uC774 \uC880 \uB5A8\uB824\uC694. \uCC28\uB3C4
      \uB9C8\uC168\uACE0, \uB9C8\uB9AC\uAC00 \uB530\uB73B\uD55C \uC6B0\uC720\uB3C4
      \uAC00\uC838\uC654\uB294\uB370."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298 \uBC24 \uC7A0\uC744 \uC798 \uC218 \uC788\uC744\uAE4C\uC694?"
  _nemoLine: "\uC57C\uACBD\uCD08\uAC00 \uD55C \uBC88 \uB354 \uD754\uB4E4\uB838\uB2E4.
    \uBA40\uB9AC\uC11C \uB204\uAD70\uAC00 \uB4F1\uBD88\uC744 \uB044\uB294 \uC18C\uB9AC\uAC00
    \uC791\uAC8C \uB4E4\uB838\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uC544\uBCA8\uB9AC\uC544, \uB108\uBB34 \uAC71\uC815\uD558\uC9C0\uB9D0\uAC70\uB77C.
      \uC606\uC5D0 \uC0BC\uCD0C\uC774 \uC788\uC744 \uD14C\uB2C8."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC606\uC5D0 \uC788\uC5B4\uC904 \uAC70\uC608\uC694?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uACE0\uB9C8\uC6CC\uC694, \uC0BC\uCD0C. \uD798\uC774 \uB3FC\uC694."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC758\uC790 \uB4F1\uBC1B\uC774\uC5D0
        \uCC9C\uCC9C\uD788 \uAE30\uB314\uB2E4. \uC190\uC758 \uB5A8\uB9BC\uC774 \uC644\uC804\uD788
        \uBA4E\uC740 \uAC74 \uC544\uB2C8\uC5C8\uC9C0\uB9CC, \uD638\uD761\uC774 \uD3B8\uD574\uC84C\uB2E4."
    _responseLine: "\u2026\uC606\uC5D0 \uC788\uC5B4\uC904 \uAC70\uC608\uC694?"
    _interactions:
    - {fileID: 11400000, guid: d6a5e766052d89c428f1743b91d1f5ed, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: b526bde7ae5751c458868ac8002c0cb9, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uC624\uB298\uC740 \uC77C\uCC0D \uB4E4\uC5B4\uAC00\uC11C \uC790\uB3C4\uB85D
      \uD574. \uB0B4\uC77C \uCEE8\uB514\uC158\uC774 \uC911\uC694\uD558\uB2C8\uAE4C."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uB124."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC790\uC57C \uD55C\uB2E4\uB294 \uAC74 \uC54C\uC544\uC694. \uC548 \uC640\uC11C
        \uADF8\uB807\uC9C0."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC758\uC790\uC5D0\uC11C \uC77C\uC5B4\uB098
        \uBC29\uC73C\uB85C \uAC00\uBC84\uB838\uB2E4."
    _responseLine: "\u2026\uB124."
    _interactions:
    - {fileID: 11400000, guid: 1dd13bdd8eaf9ce4592aeb8a484f9fba, type: 2}
    - {fileID: 11400000, guid: 5567f538fa6f95541b83bef514683358, type: 2}
    _nextStep: {fileID: 11400000, guid: b526bde7ae5751c458868ac8002c0cb9, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uADF8\uB7FC \uC591\uC744 \uD55C \uB9C8\uB9AC, \uB450 \uB9C8\uB9AC \uC138\uACE0
      \uC790\uB834."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC0BC\uCD0C, \uC9C4\uC9DC."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8 \uC591\uC744 12\uB144\uC9F8 \uC6B0\uB824\uBA39\uB294 \uAC70
        \uC54C\uC544\uC694?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uADFC\uB370 \uC624\uB298\uC740 \uC880 \uB3C4\uC6C0\uC774 \uB418\uB124\uC694."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC5B4\uC774\uC5C6\uB2E4\uB294 \uB4EF
        \uC791\uAC8C \uC6C3\uC5C8\uB2E4. \uC6C3\uC740 \uB2E4\uC74C\uC5D0 \uD638\uD761\uC774
        \uD55C \uBC15\uC790 \uAE38\uC5B4\uC84C\uB2E4. \uC190\uC758 \uB5A8\uB9BC\uC740
        \uC5B4\uB290\uC0C8 \uBA4E\uC5B4 \uC788\uC5C8\uB2E4."
    _responseLine: "\u2026\uC0BC\uCD0C, \uC9C4\uC9DC."
    _interactions:
    - {fileID: 11400000, guid: 1dd13bdd8eaf9ce4592aeb8a484f9fba, type: 2}
    _nextStep: {fileID: 11400000, guid: b526bde7ae5751c458868ac8002c0cb9, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
