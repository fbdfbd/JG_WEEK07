--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_rumor_blocked__step_event_week_008_rumor_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC232 \uC785\uAD6C \uCABD\uC5D0\uC11C \uC0AC\uB78C \uC5EC\uB7FF\uC774
      \uC624\uAC00\uACE0 \uC788\uC5C8\uB2E4. \uD3C9\uC18C\uBCF4\uB2E4 \uBC1C\uAC78\uC74C\uC774
      \uBE68\uB790\uB2E4. \uACBD\uBE44\uB300\uC7A5\uC774 \uBD80\uD558\uB4E4\uC5D0\uAC8C
      \uC9E7\uAC8C \uC9C0\uC2DC\uB97C \uB0B4\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACBD\uBE44\uB300\uC7A5\uB2D8."
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC608, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC232 \uCABD\uC774 \uC5B4\uC218\uC120\uD55C \uAC83 \uAC19\uC740\uB370,
      \uBB34\uC2A8 \uC77C \uC788\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uD3C9\uC18C\uC640 \uAC19\uC740 \uC810\uAC80\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0AC\uB78C\uC774 \uD3C9\uC18C\uBCF4\uB2E4 \uB9CE\uC544 \uBCF4\uC5EC\uC694."
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC624\uB298\uC740 \uC190\uB2D8\uC774 \uB9CE\uC774 \uC624\uB294 \uB0A0\uC774\uB77C,
      \uADF8\uB9CC\uD07C \uC0AC\uB78C\uC744 \uB354 \uD480\uC5B4\uB450\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0C8\uBCBD\uBD80\uD130\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC608. \uC77C\uCC0D \uC2DC\uC791\uD574\uB450\uB294 \uD3B8\uC774 \uB0AB\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uC2A8 \uC77C\uC774 \uC788\uB294 \uAC8C \uC544\uB2C8\uACE0\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC77C\uC774 \uC0DD\uAE30\uC9C0 \uC54A\uAC8C \uD558\uB824\uACE0 \uBBF8\uB9AC
      \uB3C4\uB294 \uAC81\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB300\uC7A5\uB2D8. \uC815\uB9D0 \uADF8\uAC83\uBFD0\uC774\uC5D0\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC624\uB298\uC740 \uC804\uC57C\uC81C \uCC44\uBE44\uC5D0 \uC9D1\uC911\uD558\uC2DC\uBA74
      \uB429\uB2C8\uB2E4. \uC232 \uCABD\uC740 \uC800\uD76C\uAC00 \uB9E1\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C\uACA0\uC5B4\uC694."
  _nemoLine: "\uC232 \uC785\uAD6C \uCABD\uC5D0\uC11C \uC0AC\uB78C \uC5EC\uB7FF\uC774
    \uC624\uAC00\uACE0 \uC788\uC5C8\uB2E4. \uD3C9\uC18C\uBCF4\uB2E4 \uBC1C\uAC78\uC74C\uC774
    \uBE68\uB790\uB2E4. \uACBD\uBE44\uB300\uC7A5\uC774 \uBD80\uD558\uB4E4\uC5D0\uAC8C
    \uC9E7\uAC8C \uC9C0\uC2DC\uB97C \uB0B4\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
