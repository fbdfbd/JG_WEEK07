MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_excursion_garden_direct_anxious__step_event_week_008_excursion_garden_direct_anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00-\uBD88\uC548"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC0C8\uC7A5\uC740 \uBC14\uB78C\uC5D0 \uD55C \uBC88, \uB610 \uD55C \uBC88
      \uD754\uB4E4\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC0C8\uC7A5 \uAC00\uAE4C\uC774\uB85C
      \uB2E4\uAC00\uAC14\uB2E4. \uACBD\uCCA9\uC5D0\uB294 \uB179\uC774 \uB450\uAECD\uAC8C
      \uC549\uC558\uACE0, \uBC1B\uCE68\uB300\uB294 \uD480\uC5D0 \uBC18\uCBE4 \uBB3B\uD600
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC70, \uD55C\uCC38 \uC190\uB3C4 \uC548 \uB304 \uAC83 \uAC19\uC740\uB370\uC694."
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uC815\uC6D0 \uB05D\uCABD\uC774\uB77C \uC0AC\uB78C \uC190\uC774 \uC798
      \uB2FF\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD55C\uB450 \uD574 \uC77C\uC774 \uC544\uB2C8\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC1B\uCE68\uB300 \uC8FC\uBCC0\uC758
      \uD480\uC744 \uC190\uB05D\uC73C\uB85C \uD5E4\uCCD0 \uBCF4\uC558\uB2E4. \uBC1B\uCE68
      \uB2E4\uB9AC\uB294 \uBFCC\uB9AC\uC5D0 \uD718\uAC10\uACA8 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAD70\uAC00 \uC77C\uBD80\uB7EC \uB454 \uAC8C \uC544\uB2C8\uB77C,
      \uADF8\uB0E5 \uC78A\uD614\uB358 \uAC70\uC600\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC14\uB78C\uC774 \uB2E4\uC2DC \uBD88\uC5C8\uB2E4. \uBB38\uC774 \uB610
      \uD754\uB4E4\uB838\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294 \uB2EB\uC9C0 \uC54A\uC558\uB2E4."
  _nemoLine: "\uC0C8\uC7A5\uC740 \uBC14\uB78C\uC5D0 \uD55C \uBC88, \uB610 \uD55C
    \uBC88 \uD754\uB4E4\uB838\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
