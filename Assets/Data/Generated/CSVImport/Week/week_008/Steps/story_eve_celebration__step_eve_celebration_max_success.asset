  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_eve_celebration__step_eve_celebration_max_success
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uAC00\uBB38 \uC5B4\uB978\uB4E4\uC774 \uC544\uBCA8\uB9AC\uC544\uC758
      \uC790\uB9AC \uAC00\uAE4C\uC774\uC5D0 \uB9C9\uC2A4\uC758 \uC790\uB9AC\uD45C\uB97C
      \uB193\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uADF8 \uBAA8\uC2B5\uC744 \uBCF4\uACE0 \uC544\uBCA8\uB9AC\uC544
      \uCABD\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C \uC790\uB9AC \uC606\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB124. \uAC00\uAE4C\uC6B4 \uCABD\uC73C\uB85C \uC870\uC815\uD55C \uAC83
      \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC00\uAE4C\uC774 \uC788\uB294 \uAC74 \uAD1C\uCC2E\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB300\uC2E0 \uC81C \uC55E\uC774 \uC544\uB2C8\uB77C, \uC81C \uC606\uC774\uBA74
      \uC88B\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC7A0\uC2DC \uBA48\uCDC4\uB2E4\uAC00 \uACE0\uAC1C\uB97C
      \uB044\uB355\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uC606\uC5D0 \uC788\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB124. \uC606\uC774\uBA74 \uB3FC\uC694."
  _nemoLine: "\uAC00\uBB38 \uC5B4\uB978\uB4E4\uC774 \uC544\uBCA8\uB9AC\uC544\uC758
    \uC790\uB9AC \uAC00\uAE4C\uC774\uC5D0 \uB9C9\uC2A4\uC758 \uC790\uB9AC\uD45C\uB97C
    \uB193\uACE0 \uC788\uC5C8\uB2E4."
