  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_rian_4__step_event_week_008_rian_4
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC624\uB298 \uC804\uC57C\uC81C\uC5D0\uC11C\uB294 \uC800\uB294 \uB9AC\uC548
      \uC5D8\uBC14\uB860\uC73C\uB85C \uBD88\uB9B4 \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uC81C\uB294 \uBAA8\uB450\uAC00 \uB2E4\uB974\uAC8C \uBD80\uB974\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9AC\uC548\uC740 \uAD1C\uCC2E\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "...\uADF8\uB798\uB3C4 \uD53C\uD558\uC9C0\uB294 \uC54A\uC73C\uB824\uACE0
      \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC7A0\uC2DC \uB9D0\uC744 \uBA48\uCDC4\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB2E4\uB9CC, \uADF8 \uC774\uB984\uC73C\uB85C \uC11C \uC788\uC5B4\uB3C4
      \uC81C\uAC00 \uD588\uB358 \uB9D0\uAE4C\uC9C0 \uB2EC\uB77C\uC9C0\uB294 \uAC74
      \uC544\uB2D9\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB5A4 \uB9D0\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C \uBA3C\uC800 \uB9D0\uD558\uACE0
      \uC2F6\uC5C8\uB2E4\uB294 \uAC83. \uBAA8\uB974\uB294 \uCC99\uD558\uAC8C \uB9CC\uB4E4\uACE0
      \uC2F6\uC9C0 \uC54A\uC558\uB2E4\uB294 \uAC83..."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uACE0\uAC1C\uB97C \uC0B4\uC9DD \uC219\uC774\uACE4
      \uC2DC\uC120\uC744 \uD53C\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uBC18\uB4DC\uC2DC \uAE30\uC5B5\uD574 \uC8FC\uC138\uC694."
  _nemoLine: "\uC624\uB298 \uC804\uC57C\uC81C\uC5D0\uC11C\uB294 \uC800\uB294 \uB9AC\uC548
    \uC5D8\uBC14\uB860\uC73C\uB85C \uBD88\uB9B4 \uAC81\uB2C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
