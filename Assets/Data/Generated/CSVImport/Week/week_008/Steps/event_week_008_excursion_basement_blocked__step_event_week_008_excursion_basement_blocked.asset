  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_excursion_basement_blocked__step_event_week_008_excursion_basement_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC9C0\uD558\uC2E4 \uC548\uCABD \uB05D\uC5D0 \uB0A1\uC740 \uC637\uC7A5\uC774
      \uB193\uC5EC \uC788\uC5C8\uB2E4. \uADF8 \uC0AC\uC774\uB85C \uBD80\uC11C\uC9C4
      \uAC00\uAD6C\uC640 \uC0C1\uC790\uB4E4\uC774 \uC5B4\uC9C0\uB7FD\uAC8C \uC313\uC5EC
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800 \uC548\uCABD\uC5D0 \uC788\uB294 \uC637\uC7A5, \uD55C \uBC88 \uC5F4\uC5B4\uBCF4\uACE0
      \uC2F6\uC740\uB370\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uAE38\uC774 \uB9C9\uD600 \uC788\uC5B4\uC11C \uB4E4\uC5B4\uAC00\uC2DC\uAE30
      \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD55C\uB450 \uAC78\uC74C \uC548\uCABD\uC73C\uB85C
      \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4. \uBD80\uB7EC\uC9C4 \uC758\uC790 \uB2E4\uB9AC\uC640
      \uBABB\uC774 \uD280\uC5B4\uB098\uC628 \uC0C1\uC790\uAC00 \uAE38 \uC704\uC5D0
      \uC5B4\uC9C0\uB7FD\uAC8C \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "...\uBB34\uB9AC\uD574\uC11C \uAC08 \uAE38\uC740 \uC544\uB2C8\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAE38\uC774 \uC815\uB9AC\uB418\uBA74 \uADF8\uB54C \uAC00\uBCFC\uAC8C\uC694."
  _nemoLine: "\uC9C0\uD558\uC2E4 \uC548\uCABD \uB05D\uC5D0 \uB0A1\uC740 \uC637\uC7A5\uC774
    \uB193\uC5EC \uC788\uC5C8\uB2E4. \uADF8 \uC0AC\uC774\uB85C \uBD80\uC11C\uC9C4
    \uAC00\uAD6C\uC640 \uC0C1\uC790\uB4E4\uC774 \uC5B4\uC9C0\uB7FD\uAC8C \uC313\uC5EC
    \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
