--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_excursion_garden_direct_curious__step_event_week_008_excursion_garden_direct_curious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00-\uD638\uAE30\uC2EC"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC0C8\uC7A5\uC740 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uBB38\uC774 \uBC14\uB78C\uC5D0
      \uB35C\uCEF9\uAC70\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774 \uC0C8\uC7A5, \uC608\uC804\uBD80\uD130 \uC788\uC5C8\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uC624\uB798\uC804\uBD80\uD130 \uC788\uC5C8\uC2B5\uB2C8\uB2E4, \uC544\uAC00\uC528.
      \uB9C8\uB2D8\uAED8\uC11C \uACC4\uC2E4 \uB54C\uBD80\uD130\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uC5D0 \uC788\uB358 \uC0C8\uB294\uC694?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uB9C8\uB2D8\uAED8\uC11C \uAE30\uB974\uC2DC\uB358 \uC0C8\uAC00 \uC788\uC5C8\uB2E4\uACE0
      \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \uB9C8\uB2D8\uAED8\uC11C \uB3CC\uC544\uAC00\uC2E0
      \uB4A4 \uC5BC\uB9C8 \uC9C0\uB098\uC9C0 \uC54A\uC544 \uC8FD\uC5C8\uB2E4\uACE0
      \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC0C8\uC7A5 \uBC14\uB2E5, \uC624\uB798\uB41C \uBA3C\uC9C0 \uC704\uC5D0
      \uC791\uC740 \uD68C\uC0C9 \uAE43\uD138 \uD558\uB098\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAE43\uD138\uC740 \uC544\uC9C1 \uB0A8\uC544 \uC788\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uC791\uC740 \uAC83\uB4E4\uC740 \uC758\uC678\uB85C \uC624\uB798 \uB0A8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0C8\uB294 \uC5C6\uB294\uB370, \uC788\uB358 \uD754\uC801\uC740 \uB0A8\uB294\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAE43\uD138\uC744 \uC190\uB05D\uC73C\uB85C
      \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uC9D1\uC5B4 \uC62C\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC00\uC838\uAC00\uB3C4 \uB420\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uC6D0\uD558\uC2E0\uB2E4\uBA74 \uADF8\uB7EC\uC154\uB3C4 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAE43\uD138\uC744 \uC190\uC218\uAC74\uC5D0
      \uC2F8\uC11C \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uC77C \uAC19\uC774 \uAC00\uC57C\uACA0\uB2E4."
  _nemoLine: "\uC0C8\uC7A5\uC740 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uBB38\uC774 \uBC14\uB78C\uC5D0
    \uB35C\uCEF9\uAC70\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
