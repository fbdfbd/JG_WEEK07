  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_eve_celebration__step_eve_celebration_yuffie_fail
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD6C4\uC791\uAC00\uC5D0\uC11C \uBCF4\uB0B8 \uC758\uC804 \uC548\uB0B4\uC11C\uAC00
      \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uC758 \uC790\uB9AC \uC606\uC5D0\uB294 \uD6C4\uC791\uAC00
      \uCE21 \uC790\uB9AC\uAC00 \uC791\uAC8C \uD45C\uC2DC\uB418\uC5B4 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB0B4\uC77C\uC740 \uD6C4\uC791\uAC00 \uCABD\uC5D0\uC11C\uB3C4 \uAC00\uAE4C\uC774
      \uC788\uC744 \uAC70\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB798\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uD63C\uC790\uCC98\uB7FC \uBCF4\uC774\uC9C0 \uC54A\uB294 \uAC8C
      \uC88B\uC73C\uB2C8\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC548\uB0B4\uC11C\uB97C \uBCF4\uB2E4\uAC00
      \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC88B\uC740 \uB73B\uC774\uACA0\uC8E0."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uADF8 \uC790\uB9AC\uAC00 \uBB34\uC5C7\uC744 \uB73B\uD558\uB294\uC9C0\uB294
      \uB354 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
  _nemoLine: "\uD6C4\uC791\uAC00\uC5D0\uC11C \uBCF4\uB0B8 \uC758\uC804 \uC548\uB0B4\uC11C\uAC00
    \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
