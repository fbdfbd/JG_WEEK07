  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_max_blocked__step_event_week_008_max_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uC804\uC57C\uC81C \uCC38\uC11D \uBA85\uB2E8\uACFC
      \uC790\uB9AC \uBC30\uCE58\uD45C\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC1C\uD14C\uB9AC\uC628\uAC00\uB3C4 \uC624\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC608. \uBC31\uC791\uAC00\uC758 \uBD09\uC2E0 \uAC00\uBB38 \uC790\uACA9\uC73C\uB85C
      \uCC38\uC11D\uD558\uC2E4 \uC608\uC815\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBD09\uC2E0 \uAC00\uBB38..."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uB0B4\uC77C\uC740 \uC544\uAC00\uC528 \uAC00\uAE4C\uC6B4 \uC790\uB9AC\uC5D0\uB3C4
      \uBC30\uCE58\uB420 \uAC83\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC00\uAE4C\uC6B4 \uC790\uB9AC\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uD544\uC694\uD560 \uB54C \uBC14\uB85C \uC6C0\uC9C1\uC77C \uC218 \uC788\uB294
      \uC704\uCE58\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC790\uB9AC \uBC30\uCE58\uD45C \uD55C\uCABD\uC5D0
      \uC801\uD78C \uBC1C\uD14C\uB9AC\uC628\uC758 \uC774\uB984\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uC624\uB294\uC9C0\uB294 \uC801\uD600 \uC788\uC9C0 \uC54A\uB124\uC694."
  _nemoLine: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uC804\uC57C\uC81C \uCC38\uC11D \uBA85\uB2E8\uACFC
    \uC790\uB9AC \uBC30\uCE58\uD45C\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
