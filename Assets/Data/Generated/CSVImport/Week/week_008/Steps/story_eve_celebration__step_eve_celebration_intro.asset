--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_eve_celebration__step_eve_celebration_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800\uC758 \uB300\uC5F0\uD68C\uC2E4\uC5D0\uB294 \uCD1B\uBD88\uACFC
      \uAF43\uC7A5\uC2DD\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4. \n\uC775\uC219\uD55C
      \uD640\uC778\uB370\uB3C4, \uC624\uB298\uC740 \uC190\uB2D8\uB4E4\uC774 \uB4E4\uC5B4\uC624\uC790
      \uB0AF\uC120 \uC7A5\uC18C\uCC98\uB7FC \uBCF4\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD14C\uC774\uBE14\uB9C8\uB2E4 \uC774\uB984\uD45C\uAC00 \uB193\uC600\uACE0,
      \uD3B8\uC9C0\uB4E4\uACFC \uC120\uBB3C \uC0C1\uC790\uAC00 \uD55C\uCABD\uC5D0
      \uC313\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD640 \uC785\uAD6C\uC5D0 \uC11C\uC11C
      \uC548\uCABD\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4. \n\uB0B4\uC77C \uC790\uC2E0\uC758
      \uC774\uB984\uC73C\uB85C \uC5F4\uB9B4 \uC790\uB9AC\uAC00, \uBC8C\uC368 \uB2E4\uB978
      \uC0AC\uB78C\uB4E4\uC758 \uC774\uB984\uC73C\uB85C \uCC44\uC6CC\uC9C0\uACE0
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC804\uC57C\uC81C\uC778\uB370, \uBC8C\uC368 \uB05D\uB09C \uAC83 \uAC19\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uD669\uC2E4 \uC0AC\uB78C\uB4E4 \uAC00\uAE4C\uC774\uC5D0
      \uC788\uC5C8\uACE0, \uB9C9\uC2A4\uB294 \uAC00\uBB38 \uC5B4\uB978\uB4E4 \uACC1\uC5D0\uC11C
      \uC790\uB9AC\uD45C\uB97C \uD655\uC778\uD558\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758
      \uC120\uBB3C \uC0C1\uC790 \uC606\uC5D0\uC11C \uBB3C\uD488 \uBAA9\uB85D\uC744
      \uC0B4\uD53C\uACE0 \uC788\uC5C8\uACE0, \uC720\uD53C\uB294 \uD6C4\uC791\uAC00\uC5D0\uC11C
      \uBCF4\uB0B8 \uC758\uC804 \uC548\uB0B4\uC11C\uB97C \uB4E4\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC624\uB298 \uBC24 \uC790\uC2E0\uC5D0\uAC8C
      \uC624\uB294 \uAC83\uC774 \uCD95\uD558\uB9CC\uC740 \uC544\uB2C8\uB77C\uB294
      \uAC78 \uB290\uAF08\uB2E4."
  _nemoLine: "\uBC31\uC791\uC800\uC758 \uB300\uC5F0\uD68C\uC2E4\uC5D0\uB294 \uCD1B\uBD88\uACFC
    \uAF43\uC7A5\uC2DD\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4. \n\uC775\uC219\uD55C
    \uD640\uC778\uB370\uB3C4, \uC624\uB298\uC740 \uC190\uB2D8\uB4E4\uC774 \uB4E4\uC5B4\uC624\uC790
    \uB0AF\uC120 \uC7A5\uC18C\uCC98\uB7FC \uBCF4\uC600\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
