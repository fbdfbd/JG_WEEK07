  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_millia_3__step_event_week_008_millia_3
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uC811\uD78C \uBB38\uC11C \uD55C \uC7A5\uC744
      \uB4E4\uACE0 \uC8FC\uBCC0\uC744 \uC0B4\uD3C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC774\uAC74 \uC9C0\uAE08 \uC11C\uBA85\uD558\uBA74 \uC548 \uB3FC\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uC720\uAC00 \uC788\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uBC31\uC791\uAC00 \uC8FC\uC694 \uACB0\uC815\uC744 \uC0C1\uB2E8\uACFC
      \uD611\uC758\uD574\uC57C \uD55C\uB2E4\uB294 \uB0B4\uC6A9\uC774 \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD611\uC758\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB9D0\uC740 \uD611\uC758\uC778\uB370, \uB098\uC911\uC5D0\uB294 \uD5C8\uB77D\uCC98\uB7FC
      \uC4F0\uC77C \uC218 \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC00\uB9AC\uC544\uAC00 \uC774\uAC78 \uB9D0\uD574\uB3C4 \uAD1C\uCC2E\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uBC14\uB85C \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC548 \uAD1C\uCC2E\uC744 \uC218\uB3C4 \uC788\uC5B4\uC694. \uADF8\uB798\uB3C4
      \uC544\uBCA8\uB9AC\uC544\uAC00 \uBAA8\uB974\uACE0 \uC11C\uBA85\uD558\uB294
      \uAC74 \uB354 \uC2EB\uC5B4\uC694."
  _nemoLine: "\uBC00\uB9AC\uC544\uB294 \uC811\uD78C \uBB38\uC11C \uD55C \uC7A5\uC744
    \uB4E4\uACE0 \uC8FC\uBCC0\uC744 \uC0B4\uD3C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
