  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_excursion_garden_direct_default__step_event_week_008_excursion_garden_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC0C8\uC7A5\uC740 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uBB38\uC774 \uBC14\uB78C\uC5D0
      \uB35C\uCEF9\uAC70\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uC5D0, \uC0C8\uAC00 \uC788\uC5C8\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uB9C8\uB2D8\uAED8\uC11C \uAE30\uB974\uC2DC\uB358 \uC0C8\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC624\uB798\uC804 \uC77C\uC774\uC9C0\uB9CC\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "...\uADF8\uB807\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD734\uACE0\uB294 \uD55C \uAC78\uC74C \uB5A8\uC5B4\uC9C4 \uACF3\uC5D0
      \uC11C \uC788\uC5C8\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294 \uC0C8\uC7A5 \uC55E\uC5D0
      \uADF8\uB300\uB85C \uBA48\uCDB0 \uC788\uC5C8\uB2E4. \uBB38\uC740 \uACC4\uC18D
      \uB35C\uCEF9\uAC70\uB838\uC9C0\uB9CC \uB2EB\uC9C0 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD55C\uCC38 \uB4A4\uC5D0\uC57C \uC544\uBCA8\uB9AC\uC544\uB294 \uB4F1\uC744
      \uB3CC\uB838\uB2E4."
  _nemoLine: "\uC0C8\uC7A5\uC740 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uBB38\uC774 \uBC14\uB78C\uC5D0
    \uB35C\uCEF9\uAC70\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
