  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_yuffie_4__step_event_week_008_yuffie_4
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uAF2D \uD63C\uC790 \uC11C\uC9C0 \uC54A\uC73C\uC154\uB3C4 \uB3FC\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4\uB4E4 \uD63C\uC790 \uC11C\uC57C \uD55C\uB2E4\uACE0 \uB9D0\uD558\uB294
      \uAC83 \uAC19\uC740\uB370\uC694."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uD63C\uC790 \uACB0\uC815\uD558\uB294 \uAC83\uACFC, \uD63C\uC790 \uAC10\uB2F9\uD558\uB294
      \uAC74 \uB2E4\uB974\uB2E4\uACE0 \uC0DD\uAC01\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC10\uB2F9\uD55C\uB2E4\uB294 \uAC74\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB9D0\uC774\uB098 \uC2DC\uC120 \uAC19\uC740 \uAC83\uB4E4\uC774\uC694.
      \uADF8\uB7F0 \uAC74 \uD63C\uC790 \uB2E4 \uBC1B\uC9C0 \uC54A\uC544\uB3C4 \uB3FC\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD6C4\uC791\uAC00\uAC00 \uB300\uC2E0 \uBC1B\uC544\uC900\uB2E4\uB294
      \uB73B\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uC804\uBD80\uB294 \uC544\uB2C8\uC5D0\uC694. \uADF8\uB798\uB3C4 \uC7A0\uAE50
      \uC228\uC744 \uACE0\uB97C \uC2DC\uAC04\uC740 \uB9CC\uB4E4\uC5B4 \uC904 \uC218
      \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8 \uC2DC\uAC04\uC758 \uB300\uAC00\uB3C4 \uC788\uACA0\uC8E0."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uADF8\uB798\uB3C4 \uC800\uB294 \uC544\uBCA8\uB9AC\uC544 \uB2D8\uC774
      \uBA3C\uC800 \uB2E4\uCE58\uC9C0 \uC54A\uC558\uC73C\uBA74 \uC88B\uACA0\uC5B4\uC694."
  _nemoLine: "\uAF2D \uD63C\uC790 \uC11C\uC9C0 \uC54A\uC73C\uC154\uB3C4 \uB3FC\uC694."
  _useCustomVisualState: 0
  _visualState: 0
