  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_night_uncle_time__step_event_week_008_night_uncle_time_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC0BC\uCD0C\uC774\uB77C\uB294 \uC0AC\uB78C\uC758 \uC2DC\uAC04"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD14C\uB77C\uC2A4\uC5D0 \uC758\uC790 \uB450 \uAC1C. \uC544\uBCA8\uB9AC\uC544\uB294
      \uB2E4\uB9AC\uB97C \uBAA8\uC73C\uACE0 \uC549\uC544 \uC788\uB2E4. \uC815\uC6D0\uC758
      \uC5B4\uB460 \uB108\uBA38\uC5D0\uC11C \uC57C\uACBD\uCD08\uAC00 \uD754\uB4E4\uB9B0\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C\uC774 \uCC98\uC74C \uC5EC\uAE30 \uC654\uC744 \uB54C\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "12\uB144 \uC804\uC774\uC796\uC544\uC694. \uC800 \uC5EC\uC12F \uC0B4\uC774\uC5C8\uB358
      \uADF8 \uACA8\uC6B8\uC774\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB54C \uC0BC\uCD0C\uC740 \uBB34\uC2A8 \uC0DD\uAC01\uC774\uC5C8\uC5B4\uC694?"
  _nemoLine: "\uD14C\uB77C\uC2A4\uC5D0 \uC758\uC790 \uB450 \uAC1C. \uC544\uBCA8\uB9AC\uC544\uB294
    \uB2E4\uB9AC\uB97C \uBAA8\uC73C\uACE0 \uC549\uC544 \uC788\uB2E4. \uC815\uC6D0\uC758
    \uC5B4\uB460 \uB108\uBA38\uC5D0\uC11C \uC57C\uACBD\uCD08\uAC00 \uD754\uB4E4\uB9B0\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uC194\uC9C1\uD788 \uADF8\uB0A0\uC740 \uB108\uBB34 \uCD94\uC6CC\uC11C
      \uB2E4\uB978 \uC0DD\uAC01\uC774 \uC548 \uB0AC\uB2E8\uB2E4. \uB208\uB3C4 \uC624\uACE0."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uADF8\uAC8C \uBB50\uC57C."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uD558\uB098\uB3C4 \uAC10\uB3D9\uC801\uC774\uC9C0 \uC54A\uB124\uC694."
    _responseLine: "\u2026\uADF8\uAC8C \uBB50\uC57C."
    _interactions:
    - {fileID: 11400000, guid: 07a82ea2eb4e69d47b46715d83afdd61, type: 2}
    _nextStep: {fileID: 11400000, guid: 2d98a169b3baed1439d82aaa31000bdc, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uADF8\uC800 \uC758\uBB34\uB97C \uB2E4 \uD574\uC57C\uACA0\uB2E4\uB294
      \uC0DD\uAC01\uBFD0\uC774\uC5C8\uC5B4."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uADF8\uB807\uAD70\uC694."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "12\uB144 \uB3D9\uC548 \uACE0\uC0DD\uD558\uC168\uC5B4\uC694."
    _responseLine: "\u2026\uADF8\uB807\uAD70\uC694."
    _interactions:
    - {fileID: 11400000, guid: 49d60b6de82ff6d499a3921eb28eb77f, type: 2}
    - {fileID: 11400000, guid: 5567f538fa6f95541b83bef514683358, type: 2}
    _nextStep: {fileID: 11400000, guid: 2d98a169b3baed1439d82aaa31000bdc, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uB0B4 \uC18C\uB9E4\uB97C \uAF2D \uC950\uACE0 \uC7A0\uB4E0 \uB108\uB97C
      \uC9C0\uCF1C\uC57C\uACA0\uB2E4\uB294 \uC0DD\uAC01\uBFD0\uC774\uC5C8\uC5B4."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC81C\uAC00 \uC7A1\uC558\uC5B4\uC694?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8\uAC74 \uAE30\uC5B5 \uC548 \uB098\uB294\uB370."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC7A1\uAE38 \uC798 \uD588\uB124\uC694, \uADF8\uB7FC."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC791\uAC8C \uC6C3\uC5C8\uB2E4. \uD45C\uC815\uC744
        \uB4E4\uD0A4\uC9C0 \uC54A\uC73C\uB824\uB294 \uB4EF, \uC2DC\uC120\uC744 \uC815\uC6D0\uC73C\uB85C
        \uB3CC\uB838\uB2E4."
    _responseLine: "\u2026\uC81C\uAC00 \uC7A1\uC558\uC5B4\uC694?"
    _interactions:
    - {fileID: 11400000, guid: d6a5e766052d89c428f1743b91d1f5ed, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: 2d98a169b3baed1439d82aaa31000bdc, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
