  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD3B8\uC9C0\uB97C \uC55E\uC5D0 \uB450\uACE0
      \uC624\uB798 \uC549\uC544 \uC788\uC5C8\uB2E4. \uBD09\uC778\uC740 \uB72F\uAE30\uC9C0
      \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC77D\uC73C\uBA74, \uC9C4\uC9DC \uB05D\uB098\uB294 \uAC83 \uAC19\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uB05D\uC774 \uC544\uB2D0 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uC9C0\uAE08\uC740 \uBABB \uC77D\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD3B8\uC9C0\uB97C \uC11C\uB78D \uC548\uC5D0
      \uB123\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uC800 \uB208\uC55E\uC5D0 \uB454 \uCC44
      \uC790\uB9AC\uC5D0\uC11C \uC77C\uC5B4\uB0AC\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD3B8\uC9C0\uB97C \uC55E\uC5D0 \uB450\uACE0
    \uC624\uB798 \uC549\uC544 \uC788\uC5C8\uB2E4. \uBD09\uC778\uC740 \uB72F\uAE30\uC9C0
    \uC54A\uC558\uB2E4."
