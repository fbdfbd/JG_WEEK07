MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_excursion_library_direct_anxious__step_event_week_008_excursion_library_direct_anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC45\uC0C1 \uC704\uC758 \uD3B8\uC9C0\uB97C
      \uB450 \uC190\uC73C\uB85C \uB4E4\uACE0, \uBC00\uB78D \uBD09\uC778\uC744 \uAC00\uB9CC\uD788
      \uB4E4\uC5EC\uB2E4\uBD24\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBD09\uC778\uC740 \uB450\uAECD\uAC8C \uAD73\uC5B4 \uC788\uC5C8\uACE0,
      \uAC00\uC7A5\uC790\uB9AC\uC5D0 \uC885\uC774\uAC00 \uBBF8\uC138\uD558\uAC8C
      \uB20C\uB824 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC70, \uC798\uBABB \uB72F\uC73C\uBA74 \uC885\uC774\uAE4C\uC9C0
      \uCC22\uC5B4\uC9C8 \uAC83 \uAC19\uC740\uB370\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uADF8\uB7EC\uC2DC\uBA74 \uB3C4\uAD6C\uB97C \uAC00\uC838\uB2E4\uB4DC\uB9B4\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uB2C8\uC694. \uCC9C\uCC9C\uD788 \uD560\uAC8C\uC694. \uB0B4\uC77C\uC774\uB77C\uB3C4
      \uAD1C\uCC2E\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD3B8\uC9C0\uB97C \uCC45\uC0C1 \uAC00\uC6B4\uB370\uC5D0
      \uAC00\uC9C0\uB7F0\uD788 \uB193\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uC5D0\uB294, \uBD84\uBA85 \uC88B\uC740 \uB9D0\uC774 \uC788\uC744
      \uAC70\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD3B8\uC9C0 \uC606\uC5D0 \uCC28\uB97C
      \uD55C \uC794 \uB450\uACE0 \uC790\uB9AC\uC5D0 \uC549\uC558\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC45\uC0C1 \uC704\uC758 \uD3B8\uC9C0\uB97C
    \uB450 \uC190\uC73C\uB85C \uB4E4\uACE0, \uBC00\uB78D \uBD09\uC778\uC744 \uAC00\uB9CC\uD788
    \uB4E4\uC5EC\uB2E4\uBD24\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
