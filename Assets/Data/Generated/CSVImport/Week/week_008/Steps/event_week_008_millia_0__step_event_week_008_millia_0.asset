  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_millia_0__step_event_week_008_millia_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uBC00\uB9AC\uC544 \uBCA0\uB974\uB514\uC544\uC785\uB2C8\uB2E4. \uBCA0\uB974\uB514\uC544
      \uC0C1\uB2E8\uC5D0\uC11C \uC131\uC778\uC2DD \uCD95\uD558 \uD6C4\uC6D0\uC744
      \uC81C\uC548\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uCD95\uD558 \uD6C4\uC6D0\uC774\uC694? \uC124\uBA85\uD574\uC8FC\uC2E4
      \uC218 \uC788\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC81C\uAC00 \uC804\uBD80 \uC124\uBA85\uD560 \uC218\uB294 \uC5C6\uC5B4\uC694.
      \uC800\uB294 \uC804\uB2EC\uD558\uB7EC \uC628 \uAC70\uB2C8\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uBB38\uC11C \uBB36\uC74C\uC744 \uAC00\uBCCD\uAC8C
      \uC815\uB9AC\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC790\uC138\uD55C \uAC74 \uBC31\uC791\uC800 \uCABD\uC5D0\uC11C \uAC80\uD1A0\uD558\uC2DC\uBA74
      \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uC77D\uC5B4\uBD24\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC870\uAE08\uC694. \uC0C1\uB2E8 \uBB38\uC11C\uB294 \uC6D0\uB798 \uB05D\uAE4C\uC9C0
      \uC77D\uB294 \uAC8C \uC88B\uC544\uC694."
  _nemoLine: "\uBC00\uB9AC\uC544 \uBCA0\uB974\uB514\uC544\uC785\uB2C8\uB2E4. \uBCA0\uB974\uB514\uC544
    \uC0C1\uB2E8\uC5D0\uC11C \uC131\uC778\uC2DD \uCD95\uD558 \uD6C4\uC6D0\uC744 \uC81C\uC548\uD569\uB2C8\uB2E4."
