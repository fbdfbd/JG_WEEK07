  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC804\uC57C\uC81C \uC900\uBE44\uB85C \uB3C4\uC11C\uAD00 \uBB38\uC774
      \uB2EB\uD600 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC544\uAC00\uC528. \uC624\uB298\uC740 \uC804\uC57C\uC81C \uC900\uBE44\uB85C
      \uB3C4\uC11C\uAD00\uB3C4 \uB2EB\uC544\uB450\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC544\uBE60\uAC00 \uB0A8\uAE34 \uD3B8\uC9C0\uAC00 \uC788\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC131\uC778\uC2DD\uC774 \uB05D\uB098\uBA74 \uBC14\uB85C \uAEBC\uB0B4\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB2EB\uD78C \uBB38\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uC77C \uC804\uC5D0 \uC77D\uACE0 \uC2F6\uC5C8\uB294\uB370."
  _nemoLine: "\uC804\uC57C\uC81C \uC900\uBE44\uB85C \uB3C4\uC11C\uAD00 \uBB38\uC774
    \uB2EB\uD600 \uC788\uC5C8\uB2E4."
