  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_eve_celebration__step_eve_celebration_yuffie_success
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD6C4\uC791\uAC00\uC5D0\uC11C \uBCF4\uB0B8 \uC758\uC804 \uC548\uB0B4\uC11C\uAC00
      \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uC758 \uC790\uB9AC \uC606\uC5D0\uB294 \uD6C4\uC791\uAC00
      \uCE21 \uC790\uB9AC\uAC00 \uC791\uAC8C \uD45C\uC2DC\uB418\uC5B4 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C \uC790\uB9AC \uC606\uC5D0\uB3C4 \uD45C\uC2DC\uAC00 \uC788\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uC5B4\uBA38\uB2C8\uAED8\uC11C \uADF8\uB807\uAC8C \uC900\uBE44\uD558\uC168\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C\uAC00 \uD63C\uC790\uCC98\uB7FC \uBCF4\uC774\uC9C0 \uC54A\uAC8C
      \uD558\uB824\uACE0\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uACE0\uAC1C\uB97C
      \uB044\uB355\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uC800\uB294 \uADF8\uAC8C \uB098\uC058\uC9C0\uB9CC\uC740 \uC54A\uB2E4\uACE0
      \uC0DD\uAC01\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0\uB370 \uC81C\uAC00 \uACE0\uB978 \uC790\uB9AC \uBC30\uCE58\uB294
      \uC544\uB2C8\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uBC14\uB85C \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uD63C\uC790\uCC98\uB7FC \uBCF4\uC774\uC9C0 \uC54A\uB294
      \uAC8C \uC88B\uB2E4\uACE0 \uC0DD\uAC01\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uADF8 \uB9D0\uC740 \uC870\uAE08 \uD754\uB4E4\uB9AC\uB124\uC694."
  _nemoLine: "\uD6C4\uC791\uAC00\uC5D0\uC11C \uBCF4\uB0B8 \uC758\uC804 \uC548\uB0B4\uC11C\uAC00
    \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
