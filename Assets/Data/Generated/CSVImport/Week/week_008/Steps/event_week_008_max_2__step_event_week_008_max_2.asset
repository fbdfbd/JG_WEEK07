  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_max_2__step_event_week_008_max_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uC791\uC740 \uC751\uC811\uC2E4. \uB2A6\uC740 \uC624\uD6C4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB0B4\uC77C \uC798\uD558\uC2E4 \uC218 \uC788\uACA0\uC2B5\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB807\uAC8C \uBB3C\uC73C\uBA74, \uC798\uD574\uC57C \uD560 \uAC83
      \uAC19\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB300\uB2F5\uD558\uAE30 \uC5B4\uB835\uB2E4\uBA74 \uC548 \uD558\uC154\uB3C4
      \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uB0B4\uC77C \uBB34\uC5C7\uC744 \uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uAC00\uAE4C\uC6B4 \uACF3\uC5D0 \uC788\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC83\uBFD0\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC7A0\uC2DC \uC190\uC744 \uC950\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB124. \uC81C\uAC00 \uD560 \uC218 \uC788\uB294 \uAC74 \uADF8\uAC83\uBFD0\uC77C\uC9C0\uB3C4
      \uBAA8\uB985\uB2C8\uB2E4."
  _nemoLine: "\uBC31\uC791\uC800 \uC791\uC740 \uC751\uC811\uC2E4. \uB2A6\uC740 \uC624\uD6C4."
