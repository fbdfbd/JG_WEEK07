  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_rian_1__step_event_week_008_rian_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC624\uB298\uC740 \uC81C \uC774\uB984\uC774 \uC5EC\uB7EC \uBC88 \uBD88\uB9B4
      \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9AC\uC548 \uC5D8\uBC14\uB860\uC73C\uB85C\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB124. \uC544\uB9C8 \uADF8\uB7F4 \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9AC\uC548\uC740 \uAD1C\uCC2E\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uAD1C\uCC2E\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4. \uADF8\uB798\uB3C4
      \uB180\uB77C\uC9C0\uB294 \uC54A\uC73C\uB824\uACE0 \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0AC\uB78C\uB4E4\uC774 \uB9AC\uC548\uC744 \uB2E4\uB974\uAC8C \uBCF4\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC7A0\uC2DC \uC815\uC6D0 \uCABD\uC744 \uBC14\uB77C\uBCF4\uB2E4
      \uC544\uBCA8\uB9AC\uC544\uB97C \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC774\uB984 \uD558\uB098\uAC00 \uBD99\uC5C8\uC744 \uBFD0\uC778\uB370,
      \uBAA8\uB4E0\uAC8C \uB2EC\uB77C\uC9C0\uB2C8\uAE4C\uC694."
  _nemoLine: "\uC624\uB298\uC740 \uC81C \uC774\uB984\uC774 \uC5EC\uB7EC \uBC88 \uBD88\uB9B4
    \uAC81\uB2C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
