--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_excursion_forest_blocked__step_event_week_008_excursion_forest_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC0AC\uB0E5\uD130\uC9C0\uAE30 \uB301\uC5D0 \uAC00\uBCF4\uACE0 \uC2F6\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uADF8\uCABD \uAE38\uC740 \uC624\uB298 \uB9C9\uD600 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C\uC694?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uC804\uC57C\uC81C \uC900\uBE44\uB85C, \uC678\uBD80\uB85C \uB098\uAC00\uB294
      \uAE38\uC740 \uD1B5\uC81C \uC911\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0AC\uB0E5\uD130\uC9C0\uAE30 \uB301\uC774 \uC678\uBD80\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: ...
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uC81C\uAE4C\uC9C0\uB294 \uB2E4\uB2D0 \uC218 \uC788\uC5C8\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uC8C4\uC1A1\uD569\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uB9C9\uC73C\uB77C\uACE0 \uD588\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "...\uC784\uC2DC\uAC00\uC8FC\uB2D8 \uC9C0\uC2DC\uC600\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC3D\uBC16\uC744 \uBC14\uB77C\uBD24\uB2E4.
      \uC232 \uCABD \uAD74\uB69D\uC774 \uBCF4\uC600\uB2E4. \uC5F0\uAE30\uB294 \uC5C6\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC790\uB9AC\uC5D0\uC11C \uC77C\uC5B4\uB098\uC9C0\uB3C4,
      \uC2DC\uC120\uC744 \uAC70\uB450\uC9C0\uB3C4 \uC54A\uC558\uB2E4."
  _nemoLine: "\uC0AC\uB0E5\uD130\uC9C0\uAE30 \uB301\uC5D0 \uAC00\uBCF4\uACE0 \uC2F6\uC5B4\uC694."
  _useCustomVisualState: 0
  _visualState: 0
