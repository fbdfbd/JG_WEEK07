  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_excursion_garden_blocked__step_event_week_008_excursion_garden_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uCC3D\uBC16\uC5D0\uC11C \uC0C8\uC7A5 \uBB38\uC774 \uB35C\uCEF9\uAC70\uB9AC\uB294
      \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uC77C\uC815\uD55C \uAC04\uACA9\uC774\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC18C\uB9AC\uAC00 \uAC70\uC2AC\uB9AC\uC2DC\uBA74 \uB2EB\uC544\uB458\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uB2C8\uC694, \uAD1C\uCC2E\uC544\uC694. \uBC14\uB78C \uC18C\uB9AC\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C8\uB9AC\uB294 \uB530\uB73B\uD55C \uCC28\uB97C \uCC45\uC0C1 \uC704\uC5D0
      \uC62C\uB824\uB450\uACE0 \uB098\uAC14\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC45\uC7A5\uC5D0\uC11C \uCC45 \uD55C
      \uAD8C\uC744 \uAEBC\uB0B4 \uC790\uB9AC\uC5D0 \uC549\uC558\uB2E4. \uCC3D\uBB38\uC740
      \uADF8\uB300\uB85C \uC5F4\uB824 \uC788\uC5C8\uACE0, \uC0C8\uC7A5 \uC18C\uB9AC\uB3C4
      \uADF8\uB300\uB85C \uB4E4\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uC5D0 \uC788\uC73C\uBA74 \uB2E4 \uB4E4\uB824\uB3C4 \uAD1C\uCC2E\uB124\uC694."
  _nemoLine: "\uCC3D\uBC16\uC5D0\uC11C \uC0C8\uC7A5 \uBB38\uC774 \uB35C\uCEF9\uAC70\uB9AC\uB294
    \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uC77C\uC815\uD55C \uAC04\uACA9\uC774\uC5C8\uB2E4."
