  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_008_excursion_library_direct_default__step_event_week_008_excursion_library_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uCC45\uC0C1 \uC704\uC5D0 \uBD09\uC778\uB41C \uD3B8\uC9C0\uAC00 \uB193\uC5EC
      \uC788\uC5C8\uB2E4. \uC544\uBC84\uC9C0\uAC00 \uB0A8\uAE34 \uB9C8\uC9C0\uB9C9
      \uD3B8\uC9C0\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD3B8\uC9C0\uB97C \uB450 \uC190\uC73C\uB85C
      \uC9D1\uC5B4 \uB4E4\uC5C8\uB2E4. \uBC00\uB78D \uBD09\uC778\uC740 \uC544\uC9C1
      \uB2E8\uB2E8\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uBC84\uC9C0\uAC00 \uB9C8\uC9C0\uB9C9\uC5D0 \uBB50\uB77C\uACE0
      \uC801\uC5B4\uB450\uC168\uC744\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: ...
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBD84\uBA85\uD788 \uC88B\uC740 \uB9D0\uC500\uC774\uC168\uC744 \uAC70\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD3B8\uC9C0\uB97C \uAC00\uC2B4 \uAC00\uAE4C\uC774
      \uC62C\uB824\uB450\uACE0, \uBD09\uC778\uC744 \uAC00\uB9CC\uD788 \uB4E4\uC5EC\uB2E4\uBD24\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uC77C, \uC2DD\uC774 \uB05D\uB098\uACE0 \uC81C\uC77C \uBA3C\uC800
      \uC5F4\uC5B4\uBCFC\uAC8C\uC694."
  _nemoLine: "\uCC45\uC0C1 \uC704\uC5D0 \uBD09\uC778\uB41C \uD3B8\uC9C0\uAC00 \uB193\uC5EC
    \uC788\uC5C8\uB2E4. \uC544\uBC84\uC9C0\uAC00 \uB0A8\uAE34 \uB9C8\uC9C0\uB9C9
    \uD3B8\uC9C0\uC600\uB2E4."
