  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD669\uC2E4 \uBB38\uC7A5\uC774 \uCC0D\uD78C \uC11C\uC2E0\uC774 \uC740\uC7C1\uBC18
      \uC704\uC5D0 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uADF8\uAC83\uC774 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
      \uC804\uD574\uC9C0\uAE30 \uC804, \uBB38\uC7A5 \uBD80\uBD84\uC744 \uBC14\uB77C\uBCF4\uACE0
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC11C\uC2E0\uC744 \uBCF4\uACE0\uB3C4
      \uC548\uC5D0 \uBB34\uC5C7\uC774 \uC801\uD600 \uC788\uB294\uC9C0 \uBB3B\uC9C0
      \uBABB\uD588\uB2E4."
  _nemoLine: "\uD669\uC2E4 \uBB38\uC7A5\uC774 \uCC0D\uD78C \uC11C\uC2E0\uC774 \uC740\uC7C1\uBC18
