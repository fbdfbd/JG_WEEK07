  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_festival_street__step_festival_street_millia_success
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uAC00\uD310\uB300\uC5D0\uB294
      \uC791\uC740 \uC7A5\uC2DD\uD488\uB4E4\uC774 \uC904\uC9C0\uC5B4 \uB193\uC5EC
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC0C1\uC778\uC774 \uBC18\uC9DD\uC774\uB294 \uBA38\uB9AC\uC7A5\uC2DD\uC744
      \uC544\uBCA8\uB9AC\uC544 \uCABD\uC73C\uB85C \uB0B4\uBC00\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c8695888329edac49b5385c0e157a3e9, type: 2}
    _text: "\uC544\uAC00\uC528\uAED8 \uC798 \uC5B4\uC6B8\uB9B4 \uAC81\uB2C8\uB2E4.
      \uC81C\uC77C \uACE0\uC6B4 \uBB3C\uAC74\uC774\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC7A5\uC2DD\uC744 \uBC1B\uC544 \uB4E4\uC5C8\uB2E4.
      \uC55E\uC740 \uBC18\uC9DD\uC600\uC9C0\uB9CC, \uB4A4\uCABD \uB9E4\uB4ED\uC740
      \uC870\uAE08 \uD5D0\uAC70\uC6E0\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC608\uC058\uAE34 \uD574."
  - _speaker: {fileID: 11400000, guid: c8695888329edac49b5385c0e157a3e9, type: 2}
    _text: "\uADF8\uB807\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0\uB370 \uAE08\uBC29 \uD480\uB9B4 \uAC83 \uAC19\uC544."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uAC00 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC5B4\uB514?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5EC\uAE30. \uBB36\uC740 \uB370\uAC00 \uC57D\uD574."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB9DE\uC544. \uC774\uAC74 \uC624\uB798 \uBABB \uC4F0\uACA0\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC0C1\uC778\uC740 \uC7A0\uAE50 \uC6C3\uC74C\uC744 \uBA48\uCDC4\uB2E4\uAC00,
      \uB2E4\uB978 \uC7A5\uC2DD\uC744 \uAEBC\uB0C8\uB2E4."
  _nemoLine: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uAC00\uD310\uB300\uC5D0\uB294
    \uC791\uC740 \uC7A5\uC2DD\uD488\uB4E4\uC774 \uC904\uC9C0\uC5B4 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions:
  - {fileID: 11400000, guid: 07a82ea2eb4e69d47b46715d83afdd61, type: 2}
  - {fileID: 11400000, guid: 156a3b33297a73c469970f297857e022, type: 2}
