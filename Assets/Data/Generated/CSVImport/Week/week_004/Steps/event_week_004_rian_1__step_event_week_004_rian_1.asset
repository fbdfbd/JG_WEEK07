  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_rian_1__step_event_week_004_rian_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uC815\uC6D0. \uB0AE."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uD6C4\uC791\uAC00\uC5D0\uB294 \uC0AC\uB78C\uC774 \uB9CE\uC774 \uC624\uACA0\uC9C0?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uCD95\uC81C\uB2C8\uAE4C \uB9CE\uC744 \uAC83 \uAC19\uC544."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB098\uB294 \uC0AC\uB78C\uC774 \uB9CE\uC73C\uBA74 \uC870\uAE08 \uD798\uB4E4\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uD30C\uC11C?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uB7F0 \uAC83\uB3C4 \uC788\uACE0, \uBAA8\uB974\uB294 \uC0AC\uB78C\uC774
      \uB9CE\uC73C\uBA74 \uC228\uC774 \uB9C9\uD788\uB294 \uB290\uB08C\uC774 \uB4E4\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC870\uAE08 \uC54C \uAC83 \uAC19\uC544."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC815\uC6D0 \uCABD\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uB798\uC11C \uC0AC\uB78C \uC801\uC740 \uAE38\uC744 \uC54C\uBA74
      \uC88B\uC744 \uAC83 \uAC19\uC544."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAE38\uC744 \uBBF8\uB9AC \uC54C\uC544\uB450\uB294 \uAC70\uC57C?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC751. \uBABB \uB3C4\uB9DD\uAC00\uBA74 \uB354 \uBB34\uC12D\uC796\uC544."
  _nemoLine: "\uBC31\uC791\uC800 \uC815\uC6D0. \uB0AE."
  _useCustomVisualState: 0
  _visualState: 0
