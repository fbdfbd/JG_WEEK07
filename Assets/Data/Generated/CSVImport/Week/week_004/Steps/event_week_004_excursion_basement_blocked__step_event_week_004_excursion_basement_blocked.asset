  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_excursion_basement_blocked__step_event_week_004_excursion_basement_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBB38 \uC548\uCABD\uC5D0\uB294 \uBB34\uC5B8\uAC00\uB97C \uC62E\uAE30\uB294
      \uC18C\uB9AC\uAC00 \uD76C\uBBF8\uD558\uAC8C \uB4E4\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uC5D0\uC11C \uBB50 \uD574?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC624\uB798\uB41C \uBB3C\uAC74\uB4E4\uC744 \uC815\uB9AC\uD558\uB294
      \uC911\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098\uB3C4 \uBCFC\uB798."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC624\uB298\uC740 \uAE68\uC9C0\uAE30 \uC26C\uC6B4 \uBB3C\uAC74\uB4E4\uC774
      \uB9CE\uC774 \uB098\uC640\uC788\uC2B5\uB2C8\uB2E4. \uC704\uD5D8\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0C8\uB85C\uC6B4 \uBB3C\uAC74\uB4E4\uC774\uC796\uC544! \uB108\uBB34
      \uAD81\uAE08\uD574!"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC815\uB9AC\uB418\uBA74 \uBCF4\uC5EC\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uCE58, \uB2E4\uC74C\uC5D4 \uBAB0\uB798 \uB4E4\uC5B4\uAC08 \uAC70\uC57C."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB2EB\uD78C \uBB38\uC5D0 \uADC0\uB97C
      \uAC00\uAE4C\uC774 \uB314\uB2E4."
  _nemoLine: "\uBB38 \uC548\uCABD\uC5D0\uB294 \uBB34\uC5B8\uAC00\uB97C \uC62E\uAE30\uB294
    \uC18C\uB9AC\uAC00 \uD76C\uBBF8\uD558\uAC8C \uB4E4\uB838\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
