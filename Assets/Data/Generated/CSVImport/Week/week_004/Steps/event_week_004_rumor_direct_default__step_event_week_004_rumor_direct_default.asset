--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_rumor_direct_default__step_event_week_004_rumor_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC18C\uBB38 \uD5C8\uAC00"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBE44\uC11C\uAC00 \uBA85\uB2E8 \uD55C \uC7A5\uC744 \uB4E4\uACE0 \uB4E4\uC5B4\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC74 \uBB50\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uD6C4\uC791\uAC00 \uCD95\uC81C\uC758 \uC88C\uC11D \uBC30\uCE58\uB3C4\uC785\uB2C8\uB2E4,
      \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4 \uC790\uB9AC\uB3C4 \uC788\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uC608. \u2026\uADF8\uB7F0\uB370 \uD55C \uBC88 \uBC14\uB00C\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC14\uB00C\uC5C8\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uCC98\uC74C \uBC30\uCE58\uB41C \uC790\uB9AC\uC5D0\uC11C, \uD6C4\uC791
      \uC601\uC560 \uACC1\uC73C\uB85C \uC62E\uACA8 \uB2EC\uB77C\uB294 \uCCAD\uC774
      \uB4E4\uC5B4\uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC720\uD53C\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\u2026\uADF8\uB807\uAC8C \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uADF8\uAC74 \uC801\uD600 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB0E5 \uC606\uC5D0 \uC788\uACE0 \uC2F6\uC5B4\uC11C\uC77C\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uADF8\uB7F4 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0\uB370 \uC65C \uC720\uD53C\uAC00 \uC815\uD574\uC694. \uB0B4
      \uC790\uB9AC\uC778\uB370."
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uADF8\uAC83\uC740 \uC800\uB3C4 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4,
      \uC544\uAC00\uC528."
  _nemoLine: "\uBE44\uC11C\uAC00 \uBA85\uB2E8 \uD55C \uC7A5\uC744 \uB4E4\uACE0 \uB4E4\uC5B4\uC654\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
