--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_millia_2__step_event_week_004_millia_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uBB3C\uD488\uB4E4\uC774
      \uD6C4\uC791\uAC00\uB85C \uC62E\uACA8\uC9C0\uAE30 \uC804 \uC904\uC9C0\uC5B4
      \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC774 \uC7A5\uC2DD\uD488\uC740 \uC544\uB9C8 \uC548\uD314\uB9B4 \uAC70\uC57C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD314\uB7EC \uAC00\uB294 \uAC70 \uC544\uB2C8\uC57C?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB9DE\uC544. \uADF8\uB798\uB3C4 \uC548 \uD314\uB9B4 \uAC8C \uC788\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB5BB\uAC8C \uC54C\uC544?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB108\uBB34 \uD06C\uACE0, \uB108\uBB34 \uBB34\uAC70\uC6CC."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uC791\uC740 \uC7A5\uC2DD\uC744 \uBC1C\uB05D\uC73C\uB85C
      \uD22D \uAC74\uB4DC\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC774\uB7F0 \uAC74 \uAE08\uBC29 \uB098\uAC08 \uAC70\uACE0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uB0A8\uB294 \uAC74 \uBC84\uB824?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC544\uB2C8. \uB2E4\uC2DC \uD314\uC544. \uC548 \uD314\uB9AC\uBA74 \uB2E4\uB978
      \uB370\uC11C \uD314\uBA74 \uB3FC."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB3C\uAC74\uB3C4 \uC81C\uC790\uB9AC\uAC00 \uC788\uAD6C\uB098."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC751. \uC0AC\uB78C\uBCF4\uB2E4 \uBB3C\uAC74\uC774 \uB354 \uBA40\uB9AC
      \uAC08 \uB54C\uB3C4 \uC788\uC5B4."
  _nemoLine: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uBB3C\uD488\uB4E4\uC774
    \uD6C4\uC791\uAC00\uB85C \uC62E\uACA8\uC9C0\uAE30 \uC804 \uC904\uC9C0\uC5B4 \uB193\uC5EC
    \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
