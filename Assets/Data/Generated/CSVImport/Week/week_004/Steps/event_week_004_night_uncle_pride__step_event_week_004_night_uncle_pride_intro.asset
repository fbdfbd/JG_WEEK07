  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_night_uncle_pride__step_event_week_004_night_uncle_pride_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC0BC\uCD0C\uC758 \uC790\uB9AC"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB178\uC744\uC774 \uAC70\uC758 \uB2E4 \uC84C\uB2E4. \uC815\uC6D0\uC5D0
      \uB4F1\uBD88\uC774 \uD558\uB098\uB458 \uCF1C\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298 \uCD95\uC81C\uC5D0\uC11C \uB2E4\uB978 \uBD80\uBAA8\uB2D8\uB4E4\uC740
      \uC560\uB4E4\uC744 \uC790\uB791\uD558\uB358\uB370"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C\uC740 \uC5B4\uB514\uAC00\uC11C \uB098 \uC790\uB791\uD55C
      \uC801 \uC788\uC5B4?"
  _nemoLine: "\uB178\uC744\uC774 \uAC70\uC758 \uB2E4 \uC84C\uB2E4. \uC815\uC6D0\uC5D0
    \uB4F1\uBD88\uC774 \uD558\uB098\uB458 \uCF1C\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uADF8\uB7FC \uC788\uC9C0. \uB098\uB294 \uB124 \uC790\uB791\uC744 \uC785\uC5D0
      \uB2EC\uACE0 \uC0B0\uB2E8\uB2E4."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC9C4\uC9DC?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uAE30\uBD84 \uC88B\uB2E4. \uBD80\uB044\uB7FD\uB124."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC637\uC790\uB77D\uC744 \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4."
    _responseLine: "\uC9C4\uC9DC?"
    _interactions:
    - {fileID: 11400000, guid: d6a5e766052d89c428f1743b91d1f5ed, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: 761e7befce19691479cb9cfb2c4ae142, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uB0A8\uB4E4 \uC55E\uC5D0\uC11C\uB294 \uC548 \uD588\uC5B4. \uADF8\uAC74
      \uB108\uD55C\uD14C \uC9C1\uC811 \uB9D0\uD558\uB294 \uAC8C \uB354 \uB0AB\uB354\uB77C\uACE0."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8\uB798..?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC9C1\uC811 \uB9D0\uD55C \uC801\uB3C4 \uC5C6\uB294 \uAC83 \uAC19\uC740\uB370?"
    _responseLine: "\uADF8\uB798..?"
    _interactions:
    - {fileID: 11400000, guid: 07a82ea2eb4e69d47b46715d83afdd61, type: 2}
    _nextStep: {fileID: 11400000, guid: 761e7befce19691479cb9cfb2c4ae142, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uC790\uB791\uC740 \uC5B4\uC6B8\uB9AC\uC9C0 \uC54A\uC544. \uB108\uB294
      \uBC31\uC791\uAC00\uC758 \uD6C4\uACC4\uC790\uB2C8\uAE4C \uADF8\uB7F0 \uC2DD\uC73C\uB85C
      \uBCF4\uC5EC\uC9C0\uBA74 \uC548 \uB3FC."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC544...\uADF8\uB807\uAD6C\uB098."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC637\uC790\uB77D\uC744 \uB9CC\uC9C0\uC791 \uAC70\uB9AC\uB358 \uC544\uBCA8\uB9AC\uC544\uC758
        \uC190\uC774 \uBA48\uCDC4\uB2E4."
    _responseLine: "\uC544...\uADF8\uB807\uAD6C\uB098."
    _interactions:
    - {fileID: 11400000, guid: 1dd13bdd8eaf9ce4592aeb8a484f9fba, type: 2}
