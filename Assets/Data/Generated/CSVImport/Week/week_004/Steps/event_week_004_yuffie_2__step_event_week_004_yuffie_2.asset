  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_yuffie_2__step_event_week_004_yuffie_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC778\uD615\uADF9\uC740 \uAD11\uC7A5 \uCABD\uC5D0\uC11C \uD55C\uB300\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0AC\uB78C \uB9CE\uACA0\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uADF8\uB798\uC11C \uC88B\uC740 \uC790\uB9AC\uB97C \uC54C\uC544\uC654\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB514\uC778\uB370?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC7A5\uC2DD \uCC9C\uB9C9 \uC606\uC774\uC694. \uC815\uBA74\uC740 \uC544\uB2C8\uC9C0\uB9CC,
      \uC0AC\uB78C\uC774 \uC801\uC744\uAC70\uC5D0\uC694"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0AC\uB78C \uB9CE\uC544\uC9C0\uBA74 \uCC9C\uB9C9 \uC548\uC5D0 \uC228\uC5B4\uB3C4
      \uB3FC?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uADF8\uB7FC \uC800\uB294 \uCC9C\uB9C9 \uC55E\uC5D0 \uC11C \uC788\uC744\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC544\uBB34\uB3C4 \uCC9C\uC744 \uB4E4\uCD94\uC9C0 \uBABB\uD558\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC720\uD53C\uAC00 \uB9C9\uC544\uC904 \uC218 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC608\uC758 \uC788\uAC8C \uB9D0\uD558\uBA74\uC694. \uADF8\uB7EC\uBA74
      \uC0AC\uB78C\uB4E4\uC740 \uBA48\uCDB0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC791\uAC8C \uC6C3\uC5C8\uB2E4."
  _nemoLine: "\uC778\uD615\uADF9\uC740 \uAD11\uC7A5 \uCABD\uC5D0\uC11C \uD55C\uB300\uC694."
  _useCustomVisualState: 0
  _visualState: 0
