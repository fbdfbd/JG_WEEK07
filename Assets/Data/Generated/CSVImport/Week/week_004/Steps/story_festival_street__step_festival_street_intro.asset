  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_festival_street__step_festival_street_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD6C4\uC791\uAC00 \uC601\uC9C0\uC758 \uCD95\uC81C \uAC70\uB9AC. \uB0AE."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD6C4\uC791\uAC00 \uC601\uC9C0\uC758 \uAC70\uB9AC\uB294 \uBC31\uC791\uC800\uC758
      \uC55E\uAE38\uBCF4\uB2E4 \uD6E8\uC52C \uB113\uC5C8\uB2E4. \uC0AC\uB78C\uB4E4\uC740
      \uAC00\uD310\uB300\uC640 \uACF5\uC5F0\uB300 \uC0AC\uC774\uB97C \uC624\uAC00\uBA70
      \uC6C3\uACE0 \uB5A0\uB4E4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC70\uB9AC \uCD08\uC785\uC5D0\uC11C
      \uAC78\uC74C\uC744 \uBA48\uCDB0 \uC130\uB2E4. \uC5B4\uB514\uBD80\uD130 \uBD10\uC57C
      \uD560\uC9C0 \uC54C \uC218 \uC5C6\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC0AC\uB78C\uC774 \uB9CE\uB124."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBB34\uB3C4 \uBC14\uB85C \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758
      \uC0C1\uC790 \uC606\uC5D0 \uC788\uC5C8\uACE0, \uB9C9\uC2A4\uB294 \uAC00\uBB38
      \uC5B4\uB978\uB4E4 \uACC1\uC5D0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uD6C4\uC791\uAC00 \uC0AC\uB78C\uB4E4 \uC0AC\uC774\uC5D0\uC11C
      \uC190\uB2D8\uC744 \uB9DE\uC774\uD558\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uCD95\uC81C \uAC70\uB9AC \uB05D, \uC870\uAE08 \uC870\uC6A9\uD574
      \uBCF4\uC774\uB294 \uAE38\uBAA9\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB124 \uC0AC\uB78C\uC774 \uAC19\uC740
      \uCD95\uC81C \uC548\uC5D0\uC11C\uB3C4 \uC11C\uB85C \uB2E4\uB978 \uC790\uB9AC\uC5D0
      \uC11C \uC788\uB2E4\uB294 \uAC78 \uAE68\uB2EC\uC558\uB2E4."
  _nemoLine: "\uD6C4\uC791\uAC00 \uC601\uC9C0\uC758 \uCD95\uC81C \uAC70\uB9AC. \uB0AE."
  _useCustomVisualState: 0
  _visualState: 0
