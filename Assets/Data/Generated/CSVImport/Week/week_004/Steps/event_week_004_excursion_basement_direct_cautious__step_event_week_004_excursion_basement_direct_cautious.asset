  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_excursion_basement_direct_cautious__step_event_week_004_excursion_basement_direct_cautious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uCCAD\uC18C \uC911\uC778 \uC9C0\uD558\uC2E4
      \uCCAD\uC18C \uC911\uC778 \uB9C8\uB9AC\uB97C \uBCF4\uBA70 \uB9D0\uD55C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uCC9C\uC5D0 \uBA3C\uC9C0\uAC00 \uB9CE\uB124."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uAC00 \uCC9C \uD130\uB294 \uAC70 \uB3C4\uC640\uC904\uAC8C!"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uAD1C\uCC2E\uC2B5\uB2C8\uB2E4, \uC544\uAC00\uC528. \uBA3C\uC9C0\uAC00
      \uB9CE\uC774 \uB0A0 \uAC70\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uB2C8\uC57C, \uAC19\uC774 \uD558\uBA74 \uBE68\uB9AC \uB05D\uB098\uC796\uC544."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uCC9C\uC5D0 \uAC10\uC2F8\uC838 \uC788\uB358
      \uBB3C\uAC74\uC744 \uCC9C\uCC9C\uD788 \uB0B4\uB824\uB193\uC73C\uBA70 \uB9D0\uD55C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uADF8\uB798\uC8FC\uC2DC\uBA74 \uAC10\uC0AC\uD558\uC8E0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC, \uB098\uB97C \uB530\uB77C \uCCAD\uC18C\uB97C \uC2DC\uC791\uD558\uC790
      \uB9C8\uB9AC!"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC88B\uC2B5\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C8\uB9AC\uB294 \uBFCC\uB4EF\uD55C \uC5BC\uAD74\uB85C \uC544\uBCA8\uB9AC\uC544\uB97C
      \uBC14\uB77C\uBCF8\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uCCAD\uC18C \uC911\uC778 \uC9C0\uD558\uC2E4
    \uCCAD\uC18C \uC911\uC778 \uB9C8\uB9AC\uB97C \uBCF4\uBA70 \uB9D0\uD55C\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
