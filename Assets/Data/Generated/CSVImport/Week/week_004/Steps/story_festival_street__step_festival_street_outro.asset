  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_festival_street__step_festival_street_outro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD6C4\uC791\uAC00 \uC601\uC9C0\uC758 \uCD95\uC81C \uAC70\uB9AC. \uD574\uC9C8
      \uBB34\uB835."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC624\uB298 \uC9C0\uB098\uC628 \uAE38\uC744
      \uB3CC\uC544\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC870\uC6A9\uD55C \uAE38\uBAA9, \uBD90\uBE44\uB294 \uACF5\uC5F0\uB300
      \uC55E, \uC774\uB984\uC774 \uC801\uD78C \uC88B\uC740 \uC790\uB9AC, \uBC18\uC9DD\uC774\uB294
      \uAC00\uD310\uB300."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4\uC74C\uC5D0\uB294\u2026"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD6C4\uC791\uAC00\uC758 \uCD95\uC81C
      \uAC70\uB9AC\uB97C \uB2E4\uC2DC \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uAC00 \uBA3C\uC800 \uBCF4\uACE0 \uC2F6\uC740 \uB370\uB97C \uB9D0\uD574\uB3C4
      \uB3FC?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBB34\uB3C4 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uC9C0\uB9CC,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uACE0\uAC1C\uB97C \uC219\uC774\uC9C0 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C8\uCC28\uC5D0 \uC624\uB974\uAE30 \uC804, \uC544\uBCA8\uB9AC\uC544\uB294
      \uCD95\uC81C \uAC70\uB9AC\uB97C \uD55C \uBC88 \uB354 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  _nemoLine: "\uD6C4\uC791\uAC00 \uC601\uC9C0\uC758 \uCD95\uC81C \uAC70\uB9AC. \uD574\uC9C8
    \uBB34\uB835."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
