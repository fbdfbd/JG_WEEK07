    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uAF43\uB4E4\uB3C4 \uCD95\uC81C\uB97C
      \uAE30\uB2E4\uB9AC\uB294 \uC190\uB2D8\uCC98\uB7FC \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uC758 \uC21C\uC9C4\uACFC \uC548\uC815\uC774
      \uB192\uC544\uC9D1\uB2C8\uB2E4."
  _nemoLine: "\uC774\uB984 \uBAA8\uB97C \uB4E4\uAF43\uB4E4\uC774 \uC815\uC6D0 \uD55C\uCABD\uC5D0
