--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_excursion_garden_direct_innocent__step_event_week_004_excursion_garden_direct_innocent
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00-\uC21C\uC9C4"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAF43 \uC55E\uC5D0 \uC624\uB798 \uCABC\uADF8\uB824
      \uC549\uC544 \uC788\uB2E4\uAC00, \uACB0\uC2EC\uD55C \uB4EF \uACE0\uAC1C\uB97C
      \uB4E4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774 \uAF43\uB4E4 \uC774\uB984\uC774 \uBB50\uC57C?"
  - _speaker: {fileID: 11400000, guid: 3f7713609b39db74c98a5b754e5eaf5e, type: 2}
    _text: "\uC800\uB3C4 \uC798 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uB0B4\uAC00 \uC9C0\uC744\uB798!"
  - _speaker: {fileID: 11400000, guid: 3f7713609b39db74c98a5b754e5eaf5e, type: 2}
    _text: "\uC88B\uC9C0\uC694. \uBB50\uB77C\uACE0 \uC9C0\uC73C\uC2DC\uACA0\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC74C\u2026 \uD587\uBE5B\uAF43."
  - _speaker: {fileID: 11400000, guid: 3f7713609b39db74c98a5b754e5eaf5e, type: 2}
    _text: "\uD587\uBE5B\uAF43."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB178\uB797\uC796\uC544\uC694. \uB178\uB780 \uAC74 \uD587\uBE5B\uC774\uB2C8\uAE4C."
  - _speaker: {fileID: 11400000, guid: 3f7713609b39db74c98a5b754e5eaf5e, type: 2}
    _text: "\uB9DE\uB294 \uB9D0\uC500\uC774\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB9AC\uACE0 \uD770 \uAC74\u2026 \uAD6C\uB984\uAF43."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD55C \uC1A1\uC774\uC529 \uC190\uAC00\uB77D\uC73C\uB85C
      \uAC00\uB9AC\uD0A4\uBA70 \uC911\uC5BC\uAC70\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD587\uBE5B\uAF43, \uAD6C\uB984\uAF43, \uD587\uBE5B\uAF43, \uD587\uBE5B\uAF43,
      \uAD6C\uB984\uAF43."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC84\uC9C8\uC740 \uC870\uC6A9\uD788 \uC6C3\uC5C8\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAF43 \uC55E\uC5D0 \uC624\uB798 \uCABC\uADF8\uB824
    \uC549\uC544 \uC788\uB2E4\uAC00, \uACB0\uC2EC\uD55C \uB4EF \uACE0\uAC1C\uB97C
    \uB4E4\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
