  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uD604\uAD00 \uC55E. \uB0AE."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBD09\uC2E0\uAC00\uBB38 \uC0AC\uB78C\uB4E4\uC774 \uD6C4\uC791\uAC00
      \uCD95\uC81C\uC5D0 \uAC00\uAE30 \uC804 \uBC31\uC791\uC800\uC5D0 \uB4E4\uB800\uB2E4.
      \uB9C9\uC2A4\uB294 \uC5B4\uB978\uB4E4 \uC606\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC548\uB155. \uB098\uB294 \uB9C9\uC2A4\uC57C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC544\uBCA8\uB9AC\uC544\uC57C."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC544\uBC84\uC9C0\uAC00 \uBA3C\uC800 \uC778\uC0AC\uD558\uB77C\uACE0
      \uD588\uC5B4. \uC624\uB298 \uAC19\uC740 \uACF3\uC5D0 \uAC00\uB2C8\uAE4C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC19\uC740 \uACF3?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uD6C4\uC791\uAC00 \uCD95\uC81C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB108\uB3C4 \uAC00?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC751. \uC6B0\uB9AC \uAC00\uC871\uB3C4 \uAC00\uC57C\uB41C\uB300."
  _nemoLine: "\uBC31\uC791\uC800 \uD604\uAD00 \uC55E. \uB0AE."
