--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_rumor_blocked__step_event_week_004_rumor_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBE44\uC11C\uAC00 \uC791\uC740 \uC218\uCCA9 \uD558\uB098\uB97C \uB4E4\uACE0
      \uB4E4\uC5B4\uC654\uB2E4. \uC544\uBCA8\uB9AC\uC544\uAC00 \uB4E4\uC5B4\uC624\uC790\uB9C8\uC790
      \uC218\uCCA9\uC744 \uB36E\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBE44\uC11C\uB2D8, \uD6C4\uC791\uAC00 \uCD95\uC81C \uC77C\uC815 \uB098\uC654\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uC77C\uC815\uC740 \uC815\uB9AC\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4,
      \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4 \uB05D\uB0AC\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uAC70\uC758\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uC54C\uB824\uC918\uC694."
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uC624\uB298\uC740 \uC758\uBCF5\uBD80\uD130 \uC0B4\uD3B4\uBCF4\uC2DC\uB294
      \uAC8C \uC88B\uACA0\uC2B5\uB2C8\uB2E4. \uC7AC\uBD09\uC0AC\uAC00 \uACE7 \uC635\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC77C\uC815\uC774 \uBA3C\uC800\uC778 \uAC83 \uAC19\uC740\uB370."
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uC608\uBCF5 \uC190\uBCFC \uC2DC\uAC04\uC774 \uC9E7\uC2B5\uB2C8\uB2E4.
      \uC624\uB298\uC740 \uADF8\uCABD\uC774 \uC6B0\uC120\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC77C\uC815\uC5D0 \uBB34\uC2A8 \uBB38\uC81C \uC788\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uC544\uB2D9\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uBCF4\uC5EC\uC8FC\uBA74 \uB418\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uC815\uB9AC\uAC00 \uB05D\uB098\uBA74 \uD55C\uAEBC\uBC88\uC5D0 \uBCF4\uACE0
      \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4, \uC544\uAC00\uC528. \uADF8\uAC8C \uB354
      \uAE54\uB054\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC54C\uACA0\uC5B4\uC694."
  _nemoLine: "\uBE44\uC11C\uAC00 \uC791\uC740 \uC218\uCCA9 \uD558\uB098\uB97C \uB4E4\uACE0
    \uB4E4\uC5B4\uC654\uB2E4. \uC544\uBCA8\uB9AC\uC544\uAC00 \uB4E4\uC5B4\uC624\uC790\uB9C8\uC790
    \uC218\uCCA9\uC744 \uB36E\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
