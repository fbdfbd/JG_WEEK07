--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_excursion_garden_direct_clever__step_event_week_004_excursion_garden_direct_clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00-\uC601\uBBFC"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAF43\uC744 \uD55C\uCC38 \uB4E4\uC5EC\uB2E4\uBCF4\uB2E4\uAC00,
      \uAC11\uC790\uAE30 \uC77C\uC5B4\uB0AC\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC7A0\uAE50\uB9CC!"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC5B4\uB514\uB860\uAC00 \uB6F0\uC5B4\uAC04 \uC544\uBCA8\uB9AC\uC544\uB294
      \uB450\uAEBC\uC6B4 \uC2DD\uBB3C\uB3C4\uAC10\uC744 \uD488\uC5D0 \uC548\uACE0
      \uB3CC\uC544\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB178\uB780\uC0C9. \uAF43\uC78E \uB2E4\uC12F \uC7A5. \uC78E\uC740 \uAE38\uCB49\uD574."
  - _speaker: {fileID: 11400000, guid: 3f7713609b39db74c98a5b754e5eaf5e, type: 2}
    _text: "\uC9C1\uC811 \uCC3E\uC544\uBCF4\uC2DC\uAC8C\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC751."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD480\uBC2D\uC5D0 \uCC45\uC744 \uD3BC\uCCD0\uB193\uACE0
      \uD55C \uC7A5\uC529 \uB118\uACA8\uAC00\uBA70 \uAF43\uACFC \uC0BD\uD654\uB97C
      \uBE44\uAD50\uD588\uB2E4. \uD55C\uCC38 \uB4A4\uC5D0 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5C6\uC5B4."
  - _speaker: {fileID: 11400000, guid: 3f7713609b39db74c98a5b754e5eaf5e, type: 2}
    _text: "\uC5C6\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774 \uCC45\uC5D0\uB294 \uC5C6\uC5B4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC7A0\uC2DC \uC0DD\uAC01\uD558\uB2E4\uAC00,
      \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC5F0\uD544\uC744 \uAEBC\uB0C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uB204\uAC00 \uCC3E\uC544\uBCFC \uC218
      \uC788\uAC8C \uADF8\uB824 \uB458\uB798."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAF43\uC744 \uD55C\uCC38 \uB4E4\uC5EC\uB2E4\uBCF4\uB2E4\uAC00,
    \uAC11\uC790\uAE30 \uC77C\uC5B4\uB0AC\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
