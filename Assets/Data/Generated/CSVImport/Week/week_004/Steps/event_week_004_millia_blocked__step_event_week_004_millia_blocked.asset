--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_millia_blocked__step_event_week_004_millia_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uCD95\uC81C\uC5D0 \uAC00\uC838\uAC08
      \uC791\uC740 \uC7A5\uC2DD\uD488\uB4E4\uC774 \uAC00\uC9C0\uB7F0\uD788 \uB193\uC5EC
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC774 \uBB3C\uAC74\uB4E4\uC740 \uD6C4\uC791\uAC00 \uCD95\uC81C\uC758
      \uD310\uB9E4\uB300\uC5D0 \uC62C\uB77C\uAC08 \uC608\uC815\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4 \uD30C\uB294 \uAC70\uC57C?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC608. \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC5D0\uC11C \uC900\uBE44\uD55C
      \uBB3C\uAC74\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC74 \uB108\uBB34 \uBB34\uAC70\uC6CC \uBCF4\uC5EC."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC7A5\uC2DD\uD488\uC740 \uBB34\uAC8C\uBCF4\uB2E4 \uC544\uB984\uB2E4\uC6C0\uC774
      \uC911\uC694\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADFC\uB370 \uB4E4\uACE0 \uB2E4\uB2C8\uAE30 \uD798\uB4E4\uBA74 \uC548
      \uC0B4 \uAC83 \uAC19\uC740\uB370."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uADF8 \uD310\uB2E8\uC740 \uC0C1\uB2E8\uC5D0\uC11C \uD560 \uAC83\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC791\uC740 \uC7A5\uC2DD\uD488 \uD558\uB098\uB97C
      \uC190\uB05D\uC73C\uB85C \uAC74\uB4DC\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uB098\uB294 \uBCF4\uBA74 \uC548 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uBCF4\uC2E4 \uC218\uB294 \uC788\uC9C0\uB9CC, \uBB3C\uAC74\uC744 \uACE0\uB974\uC2E4
      \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACE0\uB974\uB294 \uAC8C \uC7AC\uBC0C\uB294 \uAC74\uB370."
  _nemoLine: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uCD95\uC81C\uC5D0 \uAC00\uC838\uAC08
    \uC791\uC740 \uC7A5\uC2DD\uD488\uB4E4\uC774 \uAC00\uC9C0\uB7F0\uD788 \uB193\uC5EC
    \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
