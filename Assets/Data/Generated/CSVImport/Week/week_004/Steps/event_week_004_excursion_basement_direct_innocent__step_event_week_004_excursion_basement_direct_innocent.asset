  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_excursion_basement_direct_innocent__step_event_week_004_excursion_basement_direct_innocent
