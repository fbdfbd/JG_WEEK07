  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_max_blocked__step_event_week_004_max_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD6C4\uC791\uAC00\uB85C \uD5A5\uD558\uB294 \uB9C8\uCC28\uB4E4\uC774
      \uC904\uC9C0\uC5B4 \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: fa0a52ca28fa9e14780e4a40b6bca1a5, type: 2}
    _text: "\uC0AC\uB78C\uC774 \uB9CE\uC740 \uACF3\uC5D0\uC11C\uB294 \uAC00\uC6B4\uB370\uB85C
      \uAC00\uC9C0 \uB9C8\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C?"
  - _speaker: {fileID: 11400000, guid: fa0a52ca28fa9e14780e4a40b6bca1a5, type: 2}
    _text: "\uBC00\uB824\uC11C \uB2E4\uCE60 \uC218 \uC788\uC73C\uB2C8\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uC5B4\uB514\uB85C \uAC00\uC57C\uB3FC?"
  - _speaker: {fileID: 11400000, guid: fa0a52ca28fa9e14780e4a40b6bca1a5, type: 2}
    _text: "\uC5B4\uB978\uB4E4 \uACC1\uC5D0 \uACC4\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uBC00\uB9B4\uC218\uB3C4 \uC788\uC796\uC544."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9C8\uCC28 \uC190\uC7A1\uC774\uB97C
      \uC7A1\uACE0 \uC7A0\uC2DC \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uAC19\uC774 \uC788\uC73C\uBA74 \uB35C \uBB34\uC11C\uC6B8
      \uAC83\uAC19\uC740\uB370."
  _nemoLine: "\uD6C4\uC791\uAC00\uB85C \uD5A5\uD558\uB294 \uB9C8\uCC28\uB4E4\uC774
    \uC904\uC9C0\uC5B4 \uC11C \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
