--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_excursion_forest_direct_clever__step_event_week_004_excursion_forest_direct_clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5EC\uAE30 \uBD10. \uBC1C\uC790\uAD6D\uC774\uC57C."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC544\uAC00\uC528, \uADF8\uB0E5 \uC9C0\uB098\uCE58\uC2DC\uC8E0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9D0 \uBC1C\uC790\uAD6D\uC774\uC796\uC544. \uC5B4\uC82F\uBC24 \uAC70
      \uB9DE\uC9C0?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\u2026\uADF8\uB7F4 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC31\uC791\uAC00 \uB9D0\uC774\uC57C?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uBC31\uC791\uAC00 \uB9D0\uC740 \uC544\uB2D9\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uB204\uAD6C \uB9D0\uC774\uC57C?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uADF8\uAC74\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uCABD\uC5D0\uC11C \uC654\uC5B4, \uC800\uCABD\uC5D0\uC11C \uC654\uC5B4?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD558\uC778\uC758 \uB300\uB2F5\uC744
      \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uACE0 \uBC1C\uC790\uAD6D\uC744 \uB530\uB77C
      \uC2DC\uC120\uC744 \uC62E\uACBC\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uCABD\uC5D0\uC11C \uB4E4\uC5B4\uC640\uC11C \uC800\uCABD\uC73C\uB85C
      \uB098\uAC14\uB124. \uB2F4\uC7A5 \uCABD\uC774 \uC544\uB2C8\uC57C."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\u2026\uC608, \uB9DE\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uC232 \uC548\uCABD\uC5D0 \uB2E4\uB978 \uAE38\uC774 \uC788\uB2E4\uB294
      \uAC70\uC796\uC544."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC544\uAC00\uC528, \uC624\uB298\uC740 \uC774\uB9CC \uB3CC\uC544\uAC00\uC2DC\uC8E0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC54C\uC558\uC5B4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC1C\uC790\uAD6D\uC744 \uD55C \uBC88
      \uB354 \uB0B4\uB824\uB2E4\uBCF4\uACE0 \uB3CC\uC544\uC130\uB2E4."
  _nemoLine: "\uC5EC\uAE30 \uBD10. \uBC1C\uC790\uAD6D\uC774\uC57C."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
