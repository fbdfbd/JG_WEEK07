  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_festival_street__step_festival_street_yuffie_fail
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD6C4\uC791\uAC00 \uC0AC\uB78C\uB4E4\uC774 \uB9C8\uB828\uD55C \uC190\uB2D8\uC11D\uC740
      \uADF8\uB298\uC774 \uC88B\uACE0, \uACF5\uC5F0\uB300\uB3C4 \uC798 \uBCF4\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC791\uC740 \uD45C\uC2DD\uC5D0\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uC774\uB984\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uC5EC\uAE30\uAC00 \uC544\uBCA8\uB9AC\uC544 \uC790\uB9AC\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4 \uC790\uB9AC?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uC5B4\uBA38\uB2C8\uAC00 \uC900\uBE44\uD588\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uB984\uD45C\uB97C \uBCF4\uACE0
      \uC870\uC6A9\uD788 \uC790\uB9AC\uC5D0 \uC549\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC88B\uC740 \uC790\uB9AC\uB124."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uC798 \uBCF4\uC77C \uAC70\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4.
      \uADF8 \uC790\uB9AC\uAC00 \uC65C \uC790\uC2E0\uC5D0\uAC8C \uC900\uBE44\uB418\uC5C8\uB294\uC9C0\uB294
      \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uACF5\uC5F0\uC774 \uB05D\uB098\uC790 \uC0AC\uB78C\uB4E4\uC740 \uB2E4\uC2DC
      \uAC70\uB9AC\uB85C \uD769\uC5B4\uC84C\uB2E4. \uC190\uB2D8\uC11D \uC606\uC5D0\uB294
      \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uAC00\uD310\uB300\uAC00 \uC788\uC5C8\uB2E4."
  _nemoLine: "\uD6C4\uC791\uAC00 \uC0AC\uB78C\uB4E4\uC774 \uB9C8\uB828\uD55C \uC190\uB2D8\uC11D\uC740
    \uADF8\uB298\uC774 \uC88B\uACE0, \uACF5\uC5F0\uB300\uB3C4 \uC798 \uBCF4\uC600\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
