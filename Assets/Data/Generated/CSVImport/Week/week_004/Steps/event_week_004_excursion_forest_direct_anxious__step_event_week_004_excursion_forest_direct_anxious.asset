  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_excursion_forest_direct_anxious__step_event_week_004_excursion_forest_direct_anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uAC70, \uBC1C\uC790\uAD6D\uC774\uC57C?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uB9D0 \uBC1C\uC790\uAD6D\uC785\uB2C8\uB2E4. \uC5B4\uC82F\uBC24 \uAC83\uC73C\uB85C
      \uBCF4\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uBC24\uC5D0 \uC232\uC5D0 \uB4E4\uC5B4\uC654\uC5B4?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC544\uC9C1 \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9C0\uAE08\uB3C4 \uC788\uC744 \uC218\uB3C4 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uADF8\uB7F4 \uAC00\uB2A5\uC131\uC740 \uB0AE\uC2B5\uB2C8\uB2E4\uB9CC\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0AE\uB2E4\uB294 \uAC8C \uC5C6\uB2E4\uB294 \uAC74 \uC544\uB2C8\uC796\uC544."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB3CC\uC544\uAC00\uC790."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC1C\uC790\uAD6D\uC5D0\uC11C \uC2DC\uC120\uC744
      \uAC70\uB450\uC9C0 \uBABB\uD55C \uCC44 \uB4B7\uAC78\uC74C\uC9C8\uCCE4\uB2E4."
  _nemoLine: "\uC800\uAC70, \uBC1C\uC790\uAD6D\uC774\uC57C?"
  _useCustomVisualState: 0
  _visualState: 0
