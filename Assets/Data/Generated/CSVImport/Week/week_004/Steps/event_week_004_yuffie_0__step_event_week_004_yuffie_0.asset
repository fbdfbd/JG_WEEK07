  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_004_yuffie_0__step_event_week_004_yuffie_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uB9AC\uBCF8 \uC0C1\uC790\uB97C \uC5F4\uC5B4 \uC544\uBCA8\uB9AC\uC544
      \uCABD\uC73C\uB85C \uB3CC\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC548\uB155\uD558\uC138\uC694. \uC800\uB294 \uC720\uD53C\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC5B4\uBA38\uB2C8\uAED8\uC11C \uB9AC\uBCF8\uC744 \uBCF4\uB0B4\uC168\uC5B4\uC694.
      \uC624\uB298 \uC4F0\uBA74 \uC88B\uACA0\uB2E4\uACE0 \uD558\uC168\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC78 \uB0B4\uAC00 \uACE8\uB77C?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC0C1\uC790\uB97C \uC5F4\uC5C8\uB2E4. \uC5EC\uB7EC
      \uC0C9\uC758 \uB9AC\uBCF8\uC774 \uAC00\uC9C0\uB7F0\uD788 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4 \uC608\uC058\uB124."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uC0C9\uC774 \uC788\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC70. \uC81C\uC77C \uC548 \uBC18\uC9DD\uC774\uB294 \uAC70."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC54C\uACA0\uC5B4\uC694."
  _nemoLine: "\uC720\uD53C\uB294 \uB9AC\uBCF8 \uC0C1\uC790\uB97C \uC5F4\uC5B4 \uC544\uBCA8\uB9AC\uC544
    \uCABD\uC73C\uB85C \uB3CC\uB838\uB2E4."
