  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_excursion_garden_blocked__step_event_week_003_excursion_garden_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC815\uC6D0\uC73C\uB85C \uAC00\uB294 \uAE38\uBAA9\uC5D0 \uC5D0\uB2E8\uC774
      \uC11C \uC788\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBA40\uB9AC\uC11C\uB77C\uB3C4 \uBCF4\uBA74 \uC548 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: 6df200cf2bc61f541b9a6e6cd6484c7b, type: 2}
    _text: "\uD639\uC2DC\uB77C\uB3C4 \uB2E4\uCE58\uC2DC\uBA74 \uC81C\uAC00 \uACE4\uB780\uD574\uC9D1\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C\uACA0\uC5B4.."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098 \uB54C\uBB38\uC5D0 \uD63C\uB098\uB294 \uAC74 \uC2EB\uC73C\uB2C8\uAE4C."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB3CC\uC544 \uC130\uC9C0\uB9CC, \uCC3D\uBB38\uB108\uBA38\uB85C
      \uC815\uC6D0 \uCABD\uC744 \uD55C\uCC38 \uBD24\uB2E4."
  - _speaker: {fileID: 11400000, guid: 6df200cf2bc61f541b9a6e6cd6484c7b, type: 2}
    _text: "\uC544\uAC00\uC528, \uBD84\uC218 \uCABD \uBC14\uB2E5\uC774 \uBBF8\uB044\uB7FD\uC2B5\uB2C8\uB2E4.
      \uC624\uB298\uC740 \uB3CC\uC544\uAC00\uC2DC\uC9C0\uC694."
  _nemoLine: "\uC815\uC6D0\uC73C\uB85C \uAC00\uB294 \uAE38\uBAA9\uC5D0 \uC5D0\uB2E8\uC774
    \uC11C \uC788\uB2E4."
