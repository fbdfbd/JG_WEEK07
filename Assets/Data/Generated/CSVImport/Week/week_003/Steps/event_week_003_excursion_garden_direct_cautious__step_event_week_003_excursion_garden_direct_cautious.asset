  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_excursion_garden_direct_cautious__step_event_week_003_excursion_garden_direct_cautious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00-\uC2E0\uC911"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBD84\uC218 \uAC00\uC7A5\uC790\uB9AC\uC5D0
      \uC11C\uC11C, \uB099\uC5FD\uACFC \uBB3C\uC744 \uD55C\uCC38 \uB0B4\uB824\uB2E4\uBD24\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC190 \uB123\uC5B4 \uBD10\uB3C4 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: 6df200cf2bc61f541b9a6e6cd6484c7b, type: 2}
    _text: "\uCC28\uAC11\uC9C0 \uC54A\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD760\u2026\uADF8\uB7FC \uC548 \uB123\uC744\uB798."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC190\uC218\uAC74\uC744
      \uAEBC\uB0B4 \uBD84\uC218 \uAC00\uC7A5\uC790\uB9AC\uC758 \uBA3C\uC9C0\uB97C
      \uB2E6\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 6df200cf2bc61f541b9a6e6cd6484c7b, type: 2}
    _text: "\uC65C \uB2E6\uC73C\uC2ED\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBD84\uC218\uB3C4 \uC88B\uC544\uD558\uC9C0 \uC54A\uC744\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 6df200cf2bc61f541b9a6e6cd6484c7b, type: 2}
    _text: "\uADF8\uB807\uC9C0\uC694, \uC544\uAC00\uC528."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBD84\uC218 \uAC00\uC7A5\uC790\uB9AC\uC5D0
    \uC11C\uC11C, \uB099\uC5FD\uACFC \uBB3C\uC744 \uD55C\uCC38 \uB0B4\uB824\uB2E4\uBD24\uB2E4."
