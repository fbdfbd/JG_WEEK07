--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_rumor_direct_default__step_event_week_003_rumor_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC18C\uBB38 \uD5C8\uAC00"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD1A0\uB9C8\uC2A4\uAC00 \uB3C4\uC11C\uAD00 \uCABD\uC5D0\uC11C \uAC78\uC5B4
      \uB098\uC624\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD1A0\uB9C8\uC2A4, \uB3C4\uC11C\uAD00\uC5D0 \uB2E4\uB140\uC640?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC608, \uC544\uAC00\uC528. \uC11C\uACE0\uAD00\uB9AC\uC778 \uC5B4\uB978\uAED8
      \uC7A0\uAE50 \uB2E4\uB140\uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uC2A8 \uC77C\uB85C?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC548\uCABD \uC11C\uAC00 \uC815\uB9AC\uB97C \uB3C4\uC640\uB4DC\uB9B4
      \uC0AC\uB78C\uC774 \uD544\uC694\uD558\uC2DC\uB2E4 \uD574\uC11C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC815\uB9AC?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC608. \uD55C\uCC38 \uC190\uC774 \uC548 \uB2FF\uB358 \uC548\uCABD\uC774\uB77C
      \uC2DC\uAC04\uC774 \uC880 \uAC78\uB9AC\uC2DC\uB294 \uBAA8\uC591\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC70\uAE30 \uBB50 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC624\uB298 \uD55C \uAD8C \uB098\uC654\uB2E4\uACE0 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD55C \uAD8C?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC608. \uC790\uBB3C\uC1E0\uAC00 \uAC78\uB9B0 \uCC45\uC774\uB77C\uACE0
      \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC7A0\uACA8 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC608."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAD6C \uAC70\uC57C?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC800\uB3C4 \uC798\uC740 \uBAA8\uB985\uB2C8\uB2E4\uB9CC \uC5B4\uB5A4
      \uC5EC\uC778\uC758 \uC77C\uAE30\uC7A5 \uAC19\uC544 \uBCF4\uC600\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD639\uC2DC \uC5C4\uB9C8?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uADF8\uB7F4\uC9C0\uB3C4 \uBAA8\uB974\uC8E0."
  _nemoLine: "\uD1A0\uB9C8\uC2A4\uAC00 \uB3C4\uC11C\uAD00 \uCABD\uC5D0\uC11C \uAC78\uC5B4
    \uB098\uC624\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
