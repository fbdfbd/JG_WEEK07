  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_night_father_book__step_event_week_003_night_father_book_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uCC45\uC7A5\uC5D0 \uC190\uC774 \uB2FF\uC740 \uB0A0"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC11C\uC7AC \uC758\uC790\uC5D0 \uC549\uC544
      \uCC45\uC744 \uB4E4\uC5EC\uB2E4\uBCF4\uACE0 \uC788\uB2E4. \uB108\uBB34 \uC5B4\uB824\uC6CC\uC11C
      \uAE00\uC790\uB97C \uB530\uB77C\uAC00\uB294 \uAC83\uC870\uCC28 \uBC84\uAC70\uC6B4
      \uCC45\uC774\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774 \uCC45, \uC544\uBE60\uAC00 \uBCF4\uB358 \uAC70\uC57C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD45C\uC9C0\uC5D0 \uC544\uBE60 \uC774\uB984\uC774 \uC788\uC5B4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC11C\uC7AC \uC758\uC790\uC5D0 \uC549\uC544
    \uCC45\uC744 \uB4E4\uC5EC\uB2E4\uBCF4\uACE0 \uC788\uB2E4. \uB108\uBB34 \uC5B4\uB824\uC6CC\uC11C
    \uAE00\uC790\uB97C \uB530\uB77C\uAC00\uB294 \uAC83\uC870\uCC28 \uBC84\uAC70\uC6B4
    \uCC45\uC774\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uB9DE\uC544. \uB124 \uC544\uBE60\uAC00 \uC88B\uC544\uD558\uB358 \uCC45\uC774\uB780\uB2E4.
      \uB108\uB3C4 \uC77D\uACE0 \uC2F6\uC73C\uBA74 \uC77D\uC5B4\uB3C4 \uB3FC."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC815\uB9D0?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC5B4\uB824\uC6B4 \uB2E8\uC5B4 \uB098\uC624\uBA74 \uC0BC\uCD0C\uD55C\uD14C
        \uBB3C\uC5B4\uBD10\uB3C4 \uB3FC?"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC45\uC744 \uAC00\uC2B4\uC5D0 \uB04C\uC5B4\uC548\uC558\uB2E4.
        \uD45C\uC9C0\uC758 \uC774\uB984\uC744 \uC190\uAC00\uB77D\uC73C\uB85C \uCC9C\uCC9C\uD788
        \uB530\uB77C \uADF8\uB838\uB2E4."
    _responseLine: "\uC815\uB9D0?"
    _interactions:
    - {fileID: 11400000, guid: d090616150871a540b234c9482e2e144, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: b2a2b20028b1f4344a80e83ba28b2b32, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uADF8\uAC74 \uC5B4\uB978 \uCC45\uC774\uC57C. \uC880 \uB354 \uD06C\uBA74
      \uBCF4\uC790\uAFB8\uB098."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uB124."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC45\uC744 \uC6D0\uB798 \uC790\uB9AC\uC5D0
        \uAF42\uC558\uB2E4. \uD558\uC9C0\uB9CC \uC790\uB9AC\uC5D0\uC11C \uC27D\uAC8C
        \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uB2E4."
    _responseLine: "\u2026\uB124."
    _interactions:
    - {fileID: 11400000, guid: 49d60b6de82ff6d499a3921eb28eb77f, type: 2}
    - {fileID: 11400000, guid: 5567f538fa6f95541b83bef514683358, type: 2}
    _nextStep: {fileID: 11400000, guid: b2a2b20028b1f4344a80e83ba28b2b32, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uADF8 \uCC45 \uD45C\uC9C0\uC5D0 \uCE68 \uC790\uAD6D\uC774 \uC788\uB358\uB370,
      \uB124 \uC544\uBE60\uAC00 \uCC45\uC744 \uBCA0\uACE0 \uC7A4\uC5C8\uB098\uBCF4\uAD6C\uB098."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC544\uBE60\uAC00\uC694?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC5B4\uB514\uC694? \uC5B4\uB514 \uC790\uAD6D\uC774\uC694?"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC45\uC744 \uB2E4\uC2DC \uD3BC\uCCD0\uC11C
        \uD45C\uC9C0\uB97C \uB4F1\uBD88 \uAC00\uAE4C\uC774 \uAC00\uC838\uAC14\uB2E4.
        \uD55C\uCC38 \uB3D9\uC548 \uC790\uAD6D\uC744 \uCC3E\uC558\uB2E4."
    _responseLine: "\u2026\uC544\uBE60\uAC00\uC694?"
    _interactions:
    - {fileID: 11400000, guid: d090616150871a540b234c9482e2e144, type: 2}
    _nextStep: {fileID: 11400000, guid: b2a2b20028b1f4344a80e83ba28b2b32, type: 2}
