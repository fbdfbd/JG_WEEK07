--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_excursion_basement_direct_curious__step_event_week_003_excursion_basement_direct_curious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBA3C\uC9C0\uAC00 \uAC00\uB4DD\uD55C \uC0C1\uC790\uB4E4\uC774 \uB192\uC774
      \uC313\uC5EC \uC788\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC00\uC7A5 \uC544\uB798\uCABD\uC758
      \uC791\uC740 \uC0C1\uC790\uB97C \uAC00\uB9AC\uCF30\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uAC70 \uBA3C\uC800 \uC5F4\uC5B4\uBCF4\uC790."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC65C \uC800 \uC0C1\uC790\uC785\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C\uC77C \uC544\uB798 \uC788\uC796\uC544. \uC5C4\uCCAD \uC624\uB798
      \uB410\uC744 \uAC70 \uC544\uB0D0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C8\uB9AC, \uAEBC\uB0B4\uC918!"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C8\uB9AC\uAC00 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uC0C1\uC790\uB97C
      \uAEBC\uB0B4 \uBA3C\uC9C0\uB97C \uD134\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC815\uB9D0 \uC5C4\uCCAD\uB09C \uAC8C \uB4E4\uC5B4\uC788\uACA0\uC9C0?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC800\uB3C4 \uAD81\uAE08\uD558\uB124\uC694. \uC5BC\uB978 \uC5F4\uC5B4\uBCF4\uC2DC\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC83\uC740! 2000\uB144\uC758 \uC5ED\uC0AC\uB97C \uAC00\uC9C4
      \uC6B0\uB9AC \uC704\uB300\uD55C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uAC00\uBB38\uC5D0
      \uB300\uB300\uB85C \uB0B4\uB824\uC628\uB2E4\uB294 \uC815\uB9D0 \uAD49\uC7A5\uD558\uACE0
      \uC5C4\uCCAD\uB09C..."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uADF8\uB0E5 \uC624\uB798\uB41C \uB2E8\uCD94\uC640 \uB048 \uBB49\uCE58\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8 \uC815\uB3C4\uB294 \uB098\uB3C4 \uC54C\uC544."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC544\uC27D\uB2E4\uB294 \uD45C\uC815\uC73C\uB85C
      \uC9C0\uD558\uC2E4\uC744 \uB098\uAC04\uB2E4."
  _nemoLine: "\uBA3C\uC9C0\uAC00 \uAC00\uB4DD\uD55C \uC0C1\uC790\uB4E4\uC774 \uB192\uC774
    \uC313\uC5EC \uC788\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
