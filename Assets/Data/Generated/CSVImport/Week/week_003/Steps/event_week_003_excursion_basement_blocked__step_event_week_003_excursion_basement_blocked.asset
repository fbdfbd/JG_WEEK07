  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_excursion_basement_blocked__step_event_week_003_excursion_basement_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC9C0\uD558\uC2E4 \uBB38 \uC55E\uC5D0\uB294 \uC815\uB9AC \uC911\uC774\uB77C\uB294
      \uD33B\uB9D0\uC774 \uAC78\uB824 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098\uB3C4 \uC0C1\uC790 \uBCFC \uC218 \uC788\uB294\uB370."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC548\uCABD \uC0C1\uC790\uB4E4\uC774 \uBD88\uC548\uC815\uD558\uAC8C
      \uC313\uC5EC \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uAC00 \uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uC73C\uBA74 \uB418\uC796\uC544."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uC704\uD5D8\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9E8\uB0A0 \uC704\uD5D8\uD558\uB300."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC544\uAC00\uC528\uB97C \uC0DD\uAC01\uD574\uC11C\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098\uB3C4 \uB098\uB97C \uC0DD\uAC01\uD560 \uC218 \uC788\uC5B4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD33B\uB9D0\uC744 \uBABB\uB9C8\uB545\uD558\uAC8C
      \uBC14\uB77C\uBCF4\uC558\uB2E4."
  _nemoLine: "\uC9C0\uD558\uC2E4 \uBB38 \uC55E\uC5D0\uB294 \uC815\uB9AC \uC911\uC774\uB77C\uB294
    \uD33B\uB9D0\uC774 \uAC78\uB824 \uC788\uC5C8\uB2E4."
