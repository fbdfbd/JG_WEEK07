MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_excursion_forest_direct_default__step_event_week_003_excursion_forest_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC232 \uC548\uCABD. \uC624\uB450\uB9C9\uC774 \uBCF4\uC774\uB294 \uAC70\uB9AC."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uAE30 \uC5F0\uAE30 \uB098."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC0AC\uB0E5\uC9C0\uAE30 \uC624\uB450\uB9C9\uC785\uB2C8\uB2E4. \uC0AC\uB0E5\uC9C0\uAE30
      \uC601\uAC10\uC774 \uC694\uB9AC\uB97C \uD574\uBA39\uB098 \uBD05\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uC11C\uC6B4 \uC0AC\uB78C\uC774\uC57C?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC544\uB2D9\uB2C8\uB2E4. \uC5EC\uAE30\uC11C \uC624\uB798 \uC77C\uD558\uC2E0
      \uBD84\uC774\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uAC00\uBB38\uC758 \uC232\uC744 \uC9C0\uCF1C\uC8FC\uC8E0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC, \uC778\uC0AC\uD558\uB7EC \uAC00\uC790!"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC9C0\uAE08\uC740 \uBC14\uC05C \uAC83 \uAC19\uC73C\uB2C8 \uB2E4\uC74C\uC5D0
      \uAC00\uBCF4\uC2DC\uC8E0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB798, \uC54C\uACA0\uC5B4!"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC624\uB450\uB9C9 \uCABD\uC744 \uD55C
      \uBC88 \uB3CC\uC544\uBD24\uB2E4. \uC5F0\uAE30\uB294 \uACC4\uC18D \uAC00\uB298\uAC8C
      \uC62C\uB77C\uC624\uACE0 \uC788\uC5C8\uB2E4."
  _nemoLine: "\uC232 \uC548\uCABD. \uC624\uB450\uB9C9\uC774 \uBCF4\uC774\uB294 \uAC70\uB9AC."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
