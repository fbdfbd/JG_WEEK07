  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_millia_blocked__step_event_week_003_millia_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD0C1\uC790 \uC704\uC5D0 \uB0AF\uC120 \uAE00\uC790\uAC00 \uC801\uD78C
      \uB450\uAEBC\uC6B4 \uCC45 \uD55C \uAD8C\uC774 \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC74 \uBB50\uC57C?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC624\uB298 \uC77D\uC5B4\uBCF4\uC2E4 \uCC45\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uC2A8 \uAE00\uC790\uC778\uB370?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uBA3C \uB098\uB77C\uC758 \uAE00\uC790\uB77C\uACE0 \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098 \uC774\uAC70 \uBAB0\uB77C."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uBAA8\uB974\uB294 \uAE00\uC790\uB294 \uCC9C\uCC9C\uD788 \uC9DA\uC5B4\uAC00\uBA70
      \uC77D\uC73C\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC45\uC7A5\uC744 \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC74 \uBB50\uB77C\uACE0 \uC77D\uC5B4?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC800\uB3C4 \uC815\uD655\uD788\uB294 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9D1\uC0AC\uB3C4 \uBAB0\uB77C? \uADF8\uB7FC \uC548\uBCFC\uB798."
  _nemoLine: "\uD0C1\uC790 \uC704\uC5D0 \uB0AF\uC120 \uAE00\uC790\uAC00 \uC801\uD78C
    \uB450\uAEBC\uC6B4 \uCC45 \uD55C \uAD8C\uC774 \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4."
