MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_night_carriage_crest__step_event_week_003_night_carriage_crest_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uB9C8\uCC28\uC5D0 \uC0C8\uACA8\uC9C4 \uBB38\uC7A5"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC11C\uC7AC \uCC3D\uBC16\uC73C\uB85C \uB9C8\uCC28 \uD55C \uB300\uAC00
      \uC9C0\uB098\uAC14\uB2E4. \uB9C8\uCC28 \uC606\uBA74\uC5D0 \uB0AF\uC120 \uAC00\uBB38
      \uBB38\uC7A5\uC774 \uC0C8\uACA8\uC838 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800 \uB9C8\uCC28 \uC606\uC5D0 \uADF8\uB824\uC9C4 \uADF8\uB9BC,"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB290 \uC9D1 \uAC70\uC57C? \uC6B0\uB9AC \uC9D1 \uAC70\uB791 \uB2E4\uB974\uAC8C
      \uC0DD\uACBC\uC5B4."
  _nemoLine: "\uC11C\uC7AC \uCC3D\uBC16\uC73C\uB85C \uB9C8\uCC28 \uD55C \uB300\uAC00
    \uC9C0\uB098\uAC14\uB2E4. \uB9C8\uCC28 \uC606\uBA74\uC5D0 \uB0AF\uC120 \uAC00\uBB38
    \uBB38\uC7A5\uC774 \uC0C8\uACA8\uC838 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uC800\uAC74 \uC606 \uC601\uC9C0 \uC790\uC791\uAC00 \uBB38\uC7A5\uC774\uC57C.
      \uAC00\uAE4C\uC6B4 \uACF3\uC774\uB77C \uC885\uC885 \uC9C0\uB098\uAC00."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC790\uC791\uAC00."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC9D1\uB4E4\uB9C8\uB2E4 \uADF8\uB9BC\uC774 \uB2E4\uB974\uAD6C\uB098!"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC3D\uBB38\uC5D0 \uAC00\uAE4C\uC774
        \uB2E4\uAC00\uAC14\uB2E4. \uB9C8\uCC28\uAC00 \uC0AC\uB77C\uC9C4 \uBC29\uD5A5\uC744
        \uD55C\uCC38 \uBD24\uB2E4."
    _responseLine: "\u2026\uC790\uC791\uAC00."
    _interactions:
    - {fileID: 11400000, guid: 07a82ea2eb4e69d47b46715d83afdd61, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: fe479da0410a2a1488520a0d581c5e40, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uC5B4\uB290 \uC9D1\uC778\uC9C0\uB294 \uC54C \uD544\uC694 \uC5C6\uC5B4.
      \uADF8\uB0E5 \uC9C0\uB098\uAC00\uB294 \uB9C8\uCC28\uC57C."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC751, \uC54C\uACA0\uC5B4."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC3D\uBB38\uC5D0\uC11C \uD55C \uBC1C
        \uBB3C\uB7EC\uC130\uB2E4. \uADF8\uB0A0 \uBC24 \uC7A0\uB4E4 \uB54C\uAE4C\uC9C0
        \uB9C8\uCC28 \uC598\uAE30\uB294 \uB354 \uAEBC\uB0B4\uC9C0 \uC54A\uC558\uB2E4."
    _responseLine: "\u2026\uC751, \uC54C\uACA0\uC5B4."
    _interactions:
    - {fileID: 11400000, guid: deb0ce5818482394cbd8341c67eafeb7, type: 2}
    - {fileID: 11400000, guid: 5567f538fa6f95541b83bef514683358, type: 2}
    _nextStep: {fileID: 11400000, guid: fe479da0410a2a1488520a0d581c5e40, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uADF8\uAC74 \uB108\uD76C \uC544\uBE60\uAC00 \uBCC4\uB85C \uC548 \uC88B\uC544\uD558\uB358
      \uC9D1\uC774\uC57C. \uC774\uC720\uB294 \uC78A\uC5B4\uBC84\uB838\uC9C0\uB9CC."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC544\uBE60\uAC00?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC65C? \uC2F8\uC6E0\uC5B4?"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC9C4\uC9C0\uD558\uAC8C \uC606 \uC601\uC9C0\uC758
        \uC790\uC791\uAC00\uAC00 \uBB34\uC2A8 \uC798\uBABB\uC744 \uD588\uAE38\uB798
        \uC544\uBE60\uAC00 \uC2EB\uC5B4\uD588\uC744\uC9C0 \uCD94\uCE21\uD574\uBCF4\uB294
        \uAC83 \uAC19\uC558\uB2E4."
    _responseLine: "\u2026\uC544\uBE60\uAC00?"
    _interactions:
    - {fileID: 11400000, guid: d090616150871a540b234c9482e2e144, type: 2}
    _nextStep: {fileID: 11400000, guid: fe479da0410a2a1488520a0d581c5e40, type: 2}
