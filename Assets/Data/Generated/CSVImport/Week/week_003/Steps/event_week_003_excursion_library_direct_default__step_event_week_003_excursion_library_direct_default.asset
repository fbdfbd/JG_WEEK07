  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC11C\uACE0\uAD00\uB9AC\uC778\uC774 \uC11C\uAC00\uB97C \uC815\uB9AC\uD558\uB2E4
      \uC624\uB798\uB41C \uC77C\uAE30\uC7A5\uC744 \uAEBC\uB0B4 \uBCF4\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC5B4\uBA38\uB2D8\uC758 \uC77C\uAE30\uC7A5\uC778 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC5C4\uB9C8 \uAC70\uC57C?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC77C\uAE30\uC7A5\uC744 \uC7A0\uAE50
      \uB4E4\uC5EC\uB2E4\uBCF4\uB2E4\uAC00 \uB3C4\uB85C \uB0B4\uB824\uB193\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC790, \uB2E4\uC2DC \uC815\uB9AC\uD574\uC918."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9C0\uAE08 \uBCF4\uBA74 \uC2AC\uD37C\uC9C8 \uAC83 \uAC19\uC544."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC11C\uACE0\uAD00\uB9AC\uC778\uC740 \uB9D0\uC5C6\uC774 \uC77C\uAE30\uC7A5\uC744
      \uC0C1\uC790\uC5D0 \uB3C4\uB85C \uB123\uC5C8\uB2E4."
  _nemoLine: "\uC11C\uACE0\uAD00\uB9AC\uC778\uC774 \uC11C\uAC00\uB97C \uC815\uB9AC\uD558\uB2E4
    \uC624\uB798\uB41C \uC77C\uAE30\uC7A5\uC744 \uAEBC\uB0B4 \uBCF4\uC600\uB2E4."
