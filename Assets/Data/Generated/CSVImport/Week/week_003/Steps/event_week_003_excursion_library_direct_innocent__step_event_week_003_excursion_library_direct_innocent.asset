MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_excursion_library_direct_innocent__step_event_week_003_excursion_library_direct_innocent
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC11C\uACE0\uAD00\uB9AC\uC778\uC774 \uC11C\uAC00 \uC548\uCABD\uC5D0\uC11C
      \uC624\uB798\uB41C \uC0C1\uC790\uB97C \uAEBC\uB0C8\uB2E4  \uC790\uBB3C\uC1E0\uAC00
      \uAC78\uB9B0 \uAC00\uC8FD \uC77C\uAE30\uC7A5\uC774 \uB4E4\uC5B4\uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\u2026\uC5B4\uBA38\uB2D8\uC758 \uBB3C\uAC74\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5C4\uB9C8 \uAC70\uB77C\uACE0?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC77C\uAE30\uC7A5\uC744 \uBC1B\uC544
      \uB4E4\uC5C8\uB2E4. \uC790\uBB3C\uC1E0\uB97C \uC774\uB9AC\uC800\uB9AC \uB9CC\uC838\uBD24\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5F4\uC1E0\uB294 \uC5B4\uB514 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uCC3E\uC544\uBCF4\uBA74 \uB418\uC796\uC544. \uC5C4\uB9C8
      \uBC29\uC5D0 \uC788\uC744\uAE4C?"
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\u2026\uAE00\uC384\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5F4\uC5B4\uBCF4\uACE0 \uC2F6\uC5B4. \uC5C4\uB9C8\uAC00 \uBB58 \uC37C\uB294\uC9C0
      \uBCF4\uACE0 \uC2F6\uC5B4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC5F4\uC1E0\uB97C \uCC3E\uC544, \uC77C\uAE30\uC7A5\uC744
      \uC870\uC2EC\uD788 \uC5F4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uACE7 \uD0DC\uC5B4\uB0A0 \uB098\uC758 \uBCA8\uC5D0\uAC8C - \uC774\uC790\uBCA8
      -'"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5C4\uB9C8 \uAE00\uC528 \uCC98\uC74C \uBD10..."
  _nemoLine: "\uC11C\uACE0\uAD00\uB9AC\uC778\uC774 \uC11C\uAC00 \uC548\uCABD\uC5D0\uC11C
    \uC624\uB798\uB41C \uC0C1\uC790\uB97C \uAEBC\uB0C8\uB2E4  \uC790\uBB3C\uC1E0\uAC00
    \uAC78\uB9B0 \uAC00\uC8FD \uC77C\uAE30\uC7A5\uC774 \uB4E4\uC5B4\uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
