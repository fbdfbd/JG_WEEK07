  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_rian_blocked__step_event_week_003_rian_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBCF5\uB3C4 \uBCBD \uC544\uB798\uC5D0 \uC0C9\uC5F0\uD544\uB4E4\uACFC
      \uCABD\uC9C0\uAC00 \uB110\uBD80\uB7EC\uC838\uC788\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC74 \uBB50\uC57C?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uB9AC\uC548 \uB2D8\uAED8\uC11C \uB450\uACE0 \uAC00\uC2E0 \uAC83\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCABD\uC9C0\uB97C \uD3BC\uCCD0 \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB50\uB77C\uACE0 \uC368 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uB2E4\uC74C\uC5D0 \uB9CC\uB098\uBA74 \uD0A4\uB97C \uC7AC\uBCF4\uC790\uACE0
      \uC801\uD600 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBCBD\uC5D0 \uB4F1\uC744 \uBD99\uC600\uB2E4\uAC00,
      \uC774\uB0B4 \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD63C\uC790\uC11C\uB294 \uBABB\uC7AC\uC796\uC544"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC5F0\uD544\uC744 \uC9D1\uC5C8\uB2E4\uAC00,
      \uB2E4\uC2DC \uB0B4\uB824\uB193\uC558\uB2E4."
  _nemoLine: "\uBCF5\uB3C4 \uBCBD \uC544\uB798\uC5D0 \uC0C9\uC5F0\uD544\uB4E4\uACFC
    \uCABD\uC9C0\uAC00 \uB110\uBD80\uB7EC\uC838\uC788\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
