--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_max_blocked__step_event_week_003_max_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD6C8\uB828\uC7A5 \uC548\uCABD\uC5D0\uC11C \uBAA9\uAC80\uC774 \uBD80\uB52A\uD788\uB294
      \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uD718\uB450\uB974\uB294 \uC18C\uB9AC\uC57C?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC758 \uB9C9\uC2A4 \uB2D8\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098\uB3C4 \uAC19\uC774 \uD560\uB798."
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC548\uB429\uB2C8\uB2E4. \uC544\uAC00\uC528\uAED8\uC11C\uB294 \uAE30\uBCF8\uBD80\uD130
      \uD558\uC154\uC57C \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC791\uC740 \uBAA9\uAC80\uC744 \uBC1B\uC544
      \uB4E4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC190\uBAA9\uC744 \uC870\uAE08 \uB354 \uC138\uC6B0\uC2ED\uC2DC\uC624."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uB807\uAC8C?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uBC1C\uC740 \uC5B4\uAE68\uB9CC\uD07C \uBC8C\uB9AC\uC2DC\uACE0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD798\uB4E4\uC5B4.."
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC608. \uB2E4\uC2DC \uCC98\uC74C\uBD80\uD130 \uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBAA9\uAC80\uC744 \uC544\uB798\uB85C
      \uB0B4\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC7AC\uBBF8\uC5C6\uB2E4."
  _nemoLine: "\uD6C8\uB828\uC7A5 \uC548\uCABD\uC5D0\uC11C \uBAA9\uAC80\uC774 \uBD80\uB52A\uD788\uB294
    \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
