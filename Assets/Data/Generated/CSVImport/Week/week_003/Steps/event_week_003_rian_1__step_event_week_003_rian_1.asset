MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_rian_1__step_event_week_003_rian_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uBCF5\uB3C4 \uBCBD\uC5D0 \uB0A8\uC740 \uC791\uC740
      \uD760\uC9D1\uB4E4\uC744 \uBCF4\uACE0 \uBA48\uCDC4\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC5EC\uAE30 \uD0A4 \uC7AC\uB294 \uC790\uAD6D \uAC19\uC544."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0 \uAC83\uB3C4 \uD574?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC751. \uB0B4\uAC00 \uC5BC\uB9C8\uB098 \uCEF8\uB294\uC9C0 \uBCF4\uB824\uACE0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098\uB294 \uD574\uBCF8 \uC801 \uC5C6\uC5B4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uB7FC \uC9C0\uAE08 \uD558\uBA74 \uB418\uC796\uC544."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uBCBD \uC606\uC5D0 \uB611\uBC14\uB85C \uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uBA3C\uC800 \uB098."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBCBD\uC5D0 \uADF8\uC5B4\uB3C4 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC791\uAC8C \uD558\uBA74 \uAD1C\uCC2E\uC9C0 \uC54A\uC744\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC758 \uD0A4\uB97C \uC791\uAC8C
      \uD45C\uC2DC\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC774\uC81C \uB108\uB3C4 \uD574."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uAC00 \uB354 \uC791\uC73C\uBA74?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uB354 \uD06C\uBA74 \uB3FC."
  _nemoLine: "\uB9AC\uC548\uC740 \uBCF5\uB3C4 \uBCBD\uC5D0 \uB0A8\uC740 \uC791\uC740
    \uD760\uC9D1\uB4E4\uC744 \uBCF4\uACE0 \uBA48\uCDC4\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
