  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uCC45 \uAC19\uC774 \uC77D\uC790."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC19\uC774?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC774 \uB2E8\uC5B4 \uBAA8\uB974\uACA0\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB108\uB3C4 \uBAB0\uB77C?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC751. \uBAA8\uB974\uBA74 \uC544\uBE60.. \uC544\uB2C8 \uB611\uB611\uD55C
      \uC0AC\uB78C\uD55C\uD14C \uBB3C\uC5B4\uBCF4\uBA74 \uB3FC."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC45 \uC18D \uADF8\uB9BC\uC744 \uAC00\uB9AC\uCF30\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC74 \uBB50\uC57C?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uBC30 \uAC19\uC544. \uC544\uB9C8 \uBA40\uB9AC \uAC00\uB294 \uBC30."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBA40\uB9AC?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC751. \uC0C1\uB2E8\uC740 \uBA40\uB9AC \uAC00\uC57C \uB3C8\uC744 \uBC88\uB300."
  _nemoLine: "\uCC45 \uAC19\uC774 \uC77D\uC790."
