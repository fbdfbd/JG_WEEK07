--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_003_rumor_blocked__step_event_week_003_rumor_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD1A0\uB9C8\uC2A4\uAC00 \uBE48 \uC190\uC73C\uB85C \uB3C4\uC11C\uAD00
      \uCABD\uC5D0\uC11C \uAC78\uC5B4 \uB098\uC624\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD1A0\uB9C8\uC2A4."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC608, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB3C4\uC11C\uAD00\uC5D0 \uB2E4\uB140\uC640?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC608. \uC7A0\uAE50 \uB2E4\uB140\uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC11C\uACE0\uAD00\uB9AC\uC778 \uC5B4\uB978\uC774 \uBB54\uAC00 \uCC3E\uC558\uB2E4\uACE0
      \uD558\uB294 \uAC83 \uAC19\uB358\uB370."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uADF8\uB7F0 \uC774\uC57C\uAE30\uAC00 \uB3C4\uC2DC\uB098\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC751. \uC548\uCABD \uC11C\uAC00\uC5D0\uC11C \uC624\uB798\uB41C \uAC8C
      \uB098\uC654\uB2E4\uACE0."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uAE00\uC384\uC694, \uC544\uAC00\uC528. \uC800\uB294 \uC798 \uBABB \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD1A0\uB9C8\uC2A4 \uB3C4\uC11C\uAD00\uC5D0\uC11C \uC624\uB294 \uAE38\uC774\uC796\uC544."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC548\uC5D0\uC11C\uB294 \uB2E4\uB4E4 \uC790\uAE30 \uC77C\uC5D0 \uBC14\uBE60\uC11C\uC694.
      \uC800\uB3C4 \uC2DC\uD0A8 \uC77C\uB9CC \uD558\uACE0 \uB098\uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC815\uB9D0 \uC544\uBB34\uAC83\uB3C4 \uBABB \uB4E4\uC5C8\uC5B4?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC798 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C\uACA0\uC5B4. \uB354 \uC548 \uBB3C\uC744\uAC8C."
  _nemoLine: "\uD1A0\uB9C8\uC2A4\uAC00 \uBE48 \uC190\uC73C\uB85C \uB3C4\uC11C\uAD00
    \uCABD\uC5D0\uC11C \uAC78\uC5B4 \uB098\uC624\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
