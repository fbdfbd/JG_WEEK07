  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC5EC\uC12F \uC0B4\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB2F9\uC2E0\uC740 \uC784\uC2DC\uAC00\uC8FC\uB85C\uC11C \uBC31\uC791\uAC00\uB97C
      \uB9E1\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB2F9\uC2E0\uC774 \uD5C8\uAC00\uD558\uB294 \uAC83\uACFC \uD1B5\uC81C\uD558\uB294
      \uAC83\uC774, \uC774 \uC544\uC774\uC758 \uC138\uACC4\uAC00 \uB429\uB2C8\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC5EC\uC12F \uC0B4\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
