  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD615\uC758 \uBC29."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBB38\uACE0\uB9AC\uB97C \uC7A1\uC740 \uCC44, \uADF8\uB294 \uD55C\uCC38\uC744
      \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uCE68\uB300 \uC704\uC758 \uC5BC\uAD74\uC740 \uD3C9\uC628\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB108\uBB34 \uD3C9\uC628\uD574\uC11C, \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC774\uC790\uBCA8\uC774 \uC8FD\uC740 \uB4A4\uBD80\uD130 \uD615\uC740
      \uC870\uAE08\uC529 \uBA48\uCDB0 \uAC14\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC758\uC0AC\uB294 \uBA87 \uBC88\uC774\uB098 \uACBD\uACE0\uD588\uC9C0\uB9CC,
      \uD615\uC740 \uBC14\uB00C\uC9C0 \uC54A\uC558\uB2E4."
  _nemoLine: "\uD615\uC758 \uBC29."
  _useCustomVisualState: 0
  _visualState: 0
