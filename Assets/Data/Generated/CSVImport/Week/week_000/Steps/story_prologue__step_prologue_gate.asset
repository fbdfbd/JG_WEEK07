  _titleOverride: "\uD504\uB864\uB85C\uADF8"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uC815\uBB38. \uACA8\uC6B8."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9D0\uC5D0\uC11C \uB0B4\uB838\uB2E4. 12\uB144 \uB9CC\uC774\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD558\uB298\uC740 \uACE7 \uB208\uC774 \uC62C \uAC83\uCC98\uB7FC \uB0AE\uAC8C
      \uAC00\uB77C\uC549\uC544 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC624\uC168\uC2B5\uB2C8\uAE4C."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uADF8\uB294 \uC778\uC0AC\uB97C \uBC1B\uC9C0 \uC54A\uACE0 \uC548\uC73C\uB85C
      \uB4E4\uC5B4\uAC14\uB2E4."
  _nemoLine: "\uBC31\uC791\uC800 \uC815\uBB38. \uACA8\uC6B8."
