  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_prologue__step_prologue_after_choice
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uC774\uB294 \uB300\uB2F5\uC744 \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uADF8\uB7FC \uB098\uB294."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9D0\uC740 \uAC70\uAE30\uC11C \uB04A\uACBC\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uC774\uB294 \uB05D\uAE4C\uC9C0 \uB9D0\uD558\uC9C0 \uC54A\uC558\uACE0,
      \uADF8\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uC774\uB294 \uC790\uAE30 \uBC29\uC73C\uB85C \uB3CC\uC544\uAC00\uC9C0
      \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC18C\uD30C\uC5D0 \uC549\uC544 \uC788\uB2E4\uAC00, \uB9D0\uC5C6\uC774
      \uADF8\uC758 \uC18C\uB9E4\uB97C \uC7A1\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uC774\uB294 \uADF8 \uC790\uC138\uB85C \uC7A0\uC774 \uB4E4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC7A1\uC740 \uC190\uC740 \uB05D\uAE4C\uC9C0 \uB290\uC2A8\uD574\uC9C0\uC9C0
      \uC54A\uC558\uB2E4."
  _nemoLine: "\uC544\uC774\uB294 \uB300\uB2F5\uC744 \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
