  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_millia_blocked__step_event_week_002_millia_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD0C1\uC790 \uC704\uC5D0 \uC791\uC740 \uACFC\uC790 \uC0C1\uC790\uAC00
      \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC74 \uBB50\uC57C?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC624\uB298 \uC190\uB2D8\uC0C1\uC5D0 \uC62C\uB9B4 \uACFC\uC790\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC5D0\uC11C \uAC00\uC838\uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC0C1\uC790\uB97C \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uAC00 \uACE8\uB77C\uB3C4 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC624\uB298\uC740 \uC544\uC9C1 \uC548 \uB429\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uAC00 \uBA39\uC744 \uAC74\uB370\uB3C4?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC0C1\uC790\uB97C \uB36E\uACE0, \uC190\uC744
      \uAC70\uB450\uC5C8\uB2E4."
  _nemoLine: "\uD0C1\uC790 \uC704\uC5D0 \uC791\uC740 \uACFC\uC790 \uC0C1\uC790\uAC00
    \uB193\uC5EC \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
