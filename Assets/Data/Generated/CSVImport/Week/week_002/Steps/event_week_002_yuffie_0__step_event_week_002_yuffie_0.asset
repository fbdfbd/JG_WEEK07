  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_yuffie_0__step_event_week_002_yuffie_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC811\uC2DC\uB97C \uC870\uC2EC\uC2A4\uB7FD\uAC8C
      \uC55E\uC73C\uB85C \uBC00\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC774\uAC70 \uC81C\uAC00 \uC88B\uC544\uD558\uB294 \uACFC\uC790\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB108\uAC00 \uC88B\uC544\uD574?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uAC19\uC774 \uBA39\uACE0 \uC2F6\uC5C8\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC0C1\uC790\uB97C \uC870\uC2EC\uD788 \uC5F4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB108\uBB34 \uB9CE\uC774 \uBA39\uC73C\uBA74 \uC548 \uB41C\uB300\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uBCF4\uAE30\uC5D0 \uC548\uC88B\uB300\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBCF4\uAE30?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC5B4\uB978\uB4E4\uC774 \uADF8\uB807\uAC8C \uB9D0\uD574\uC694."
  _nemoLine: "\uC720\uD53C\uB294 \uC811\uC2DC\uB97C \uC870\uC2EC\uC2A4\uB7FD\uAC8C
    \uC55E\uC73C\uB85C \uBC00\uC5C8\uB2E4."
