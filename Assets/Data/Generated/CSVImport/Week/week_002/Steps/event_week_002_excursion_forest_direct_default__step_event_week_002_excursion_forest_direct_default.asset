  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_excursion_forest_direct_default__step_event_week_002_excursion_forest_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC232 \uC785\uAD6C \uCABD\uC5D0\uC11C \uD558\uC778 \uB458\uC774 \uBC14\uAD6C\uB2C8\uB97C
      \uB4E4\uACE0 \uB4E4\uC5B4\uAC00\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800 \uC0AC\uB78C\uB4E4 \uC5B4\uB514 \uAC00?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uB2E4\uACFC\uD68C \uC900\uBE44 \uB54C\uBB38\uC5D0 \uAF43\uC744 \uAD6C\uD558\uB7EC
      \uAC11\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC6B0\uC640, \uB098\uB3C4 \uAC08\uB798! \uC7AC\uBC0C\uACA0\uB2E4!"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC544\uAC00\uC528\uB294 \uC5EC\uAE30\uC11C \uC800\uB791 \uAF43 \uB180\uC774
      \uD558\uC2DC\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC74C..\uC88B\uC544! \uADF8\uB7FC \uB0B4\uAC00 \uAF43 \uBC18\uC9C0 \uB9CC\uB4E4\uC5B4\uC904\uAC8C."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uAF43\uB4E4\uC744 \uC5EE\uC5B4 \uBC18\uC9C0\uB97C
      \uB9CC\uB4E0\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9E0! \uC120\uBB3C\uC774\uC57C."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC815\uB9D0 \uC608\uC058\uB124\uC694. \uAC10\uC0AC\uD569\uB2C8\uB2E4,
      \uC544\uAC00\uC528."
  _nemoLine: "\uC232 \uC785\uAD6C \uCABD\uC5D0\uC11C \uD558\uC778 \uB458\uC774 \uBC14\uAD6C\uB2C8\uB97C
    \uB4E4\uACE0 \uB4E4\uC5B4\uAC00\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
