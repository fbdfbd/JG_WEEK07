--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_excursion_forest_direct_default__step_event_week_002_excursion_forest_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC232 \uC785\uAD6C \uCABD\uC5D0\uC11C \uD558\uC778 \uB458\uC774 \uBC14\uAD6C\uB2C8\uB97C
      \uB4E4\uACE0 \uB4E4\uC5B4\uAC00\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800 \uC0AC\uB78C\uB4E4 \uC5B4\uB514 \uAC00?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uB2E4\uACFC\uD68C \uC900\uBE44 \uB54C\uBB38\uC5D0 \uAF43\uC744 \uAD6C\uD558\uB7EC
      \uAC11\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC232\uC5D0 \uAF43\uC774 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC774\uB9D8\uB54C \uD53C\uB294 \uAC8C \uBA87 \uAC00\uC9C0 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098\uB3C4 \uAC00\uBA74 \uC548 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC624\uB798 \uAC78\uB9AC\uC9C0 \uC54A\uC744 \uAC81\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC751."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC785\uAD6C \uC55E\uC5D0 \uC11C\uC11C
      \uC232 \uC548\uCABD\uC744 \uBC14\uB77C\uBD24\uB2E4. \uD558\uC778\uB4E4\uC758
      \uBC1C\uC18C\uB9AC\uAC00 \uC810\uC810 \uBA40\uC5B4\uC84C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC870\uC6A9\uD558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBB34\uB3C4 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8 \uC790\uB9AC\uC5D0 \uC11C\uC11C \uD558\uC778\uB4E4\uC774 \uB3CC\uC544\uC624\uAE30\uB97C
      \uAE30\uB2E4\uB838\uB2E4."
  _nemoLine: "\uC232 \uC785\uAD6C \uCABD\uC5D0\uC11C \uD558\uC778 \uB458\uC774 \uBC14\uAD6C\uB2C8\uB97C
    \uB4E4\uACE0 \uB4E4\uC5B4\uAC00\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
