--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_teaparty__step_teaparty_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uC791\uC740 \uB2E4\uACFC\uD68C\uC7A5. \uB0AE. \uB465\uADFC
      \uD14C\uC774\uBE14 \uC704\uC5D0\uB294 \uC791\uC740 \uCC3B\uC794\uACFC \uACFC\uC790\uAC00
      \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uCC3D\uAC00 \uCABD\uC5D0\uB294 \uB9AC\uC548\uC774 \uC885\uC774\uB97C
      \uC811\uACE0 \uC788\uC5C8\uACE0, \uBC00\uB9AC\uC544\uB294 \uACFC\uC790 \uC811\uC2DC\uB97C
      \uC720\uC2EC\uD788 \uBCF4\uACE0 \uC788\uC5C8\uB2E4. \uB9C9\uC2A4\uB294 \uC758\uC790
      \uB4A4\uC5D0 \uC11C\uC11C \uC5B4\uB978\uB4E4\uC758 \uB208\uCE58\uB97C \uC0B4\uD3C8\uACE0,
      \uC720\uD53C\uB294 \uC790\uAE30 \uC55E\uC758 \uCC3B\uC794\uC744 \uB450 \uC190\uC73C\uB85C
      \uAC00\uC9C0\uB7F0\uD788 \uC7A1\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uB4E4\uC5B4\uC624\uC790, \uB124 \uC544\uC774\uC758
      \uC2DC\uC120\uC774 \uC7A0\uAE50 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C \uBAA8\uC600\uB2E4\uAC00
      \uD769\uC5B4\uC84C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC790\uAE30 \uC774\uB984\uC774 \uC801\uD78C
      \uC790\uB9AC\uB97C \uCC3E\uC558\uB2E4. \uD14C\uC774\uBE14 \uD55C\uAC00\uC6B4\uB370\uB294
      \uB108\uBB34 \uC870\uC6A9\uD588\uACE0, \uACFC\uC790\uB294 \uB108\uBB34 \uC608\uC058\uAC8C
      \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC5EC\uAE30 \uC549\uC73C\uBA74 \uB418\uB294 \uAC70\uC57C?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC751. \uC774\uB984\uC774 \uC788\uC73C\uB2C8\uAE4C!"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC758\uC790\uAC00 \uB192\uC73C\uBA74 \uB9D0\uD574. \uBC00\uC5B4\uC904\uAC8C."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\u2026\uB098\uB3C4 \uC544\uC9C1 \uC548 \uC549\uC558\uC5B4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC811\uB358 \uC885\uC774\uB97C \uB0B4\uB824\uB193\uACE0
      \uC758\uC790\uC5D0 \uC549\uC558\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB3C4 \uCC9C\uCC9C\uD788
      \uC790\uB9AC\uC5D0 \uC549\uC558\uB2E4."
  _nemoLine: "\uBC31\uC791\uC800 \uC791\uC740 \uB2E4\uACFC\uD68C\uC7A5. \uB0AE. \uB465\uADFC
    \uD14C\uC774\uBE14 \uC704\uC5D0\uB294 \uC791\uC740 \uCC3B\uC794\uACFC \uACFC\uC790\uAC00
    \uB193\uC5EC \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
