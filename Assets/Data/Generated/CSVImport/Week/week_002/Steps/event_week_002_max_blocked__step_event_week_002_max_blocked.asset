MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_max_blocked__step_event_week_002_max_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC5B4\uB978\uB4E4\uC774 \uC548\uC5D0\uC11C \uC774\uC57C\uAE30\uD558\uB294
      \uB3D9\uC548, \uC815\uC6D0 \uAD6C\uC11D \uD480\uC232\uC774 \uC791\uAC8C \uD754\uB4E4\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC29\uAE08 \uBB50\uAC00 \uC6C0\uC9C1\uC600\uC5B4?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD480\uC78E \uC0AC\uC774\uB85C \uAC00\uB290\uB2E4\uB780 \uBC40\uC774
      \uC2A4\uCCD0 \uC9C0\uB098\uAC14\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "...\uBC40\uC774\uC57C?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB180\uB77C \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: fa0a52ca28fa9e14780e4a40b6bca1a5, type: 2}
    _text: "\uC544\uAC00\uC528, \uC774\uCABD\uC73C\uB85C \uC624\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBA40\uC9C0 \uC54A\uC740 \uACF3\uC5D0 \uC11C \uC788\uB358 \uB9C9\uC2A4\uAC00
      \uC774\uCABD\uC744 \uB3CC\uC544\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uAE08\uBC29\uC774\uB77C\uB3C4 \uB2EC\uB824\uC62C
      \uB4EF \uC6C0\uC9C1\uC600\uC9C0\uB9CC, \uACE7 \uACC1\uC758 \uC5B4\uB978\uC774
      \uC5B4\uAE68\uB97C \uC9DA\uC5C8\uB2E4."
  _nemoLine: "\uC5B4\uB978\uB4E4\uC774 \uC548\uC5D0\uC11C \uC774\uC57C\uAE30\uD558\uB294
    \uB3D9\uC548, \uC815\uC6D0 \uAD6C\uC11D \uD480\uC232\uC774 \uC791\uAC8C \uD754\uB4E4\uB838\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
