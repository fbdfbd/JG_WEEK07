  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_excursion_library_direct_default__step_event_week_002_excursion_library_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD750\uB728\uB7EC\uC9C4 \uCC45\uB4E4 \uC911 \uAC19\uC740 \uD398\uC774\uC9C0\uAC00
      \uC5EC\uB7EC \uBC88 \uC811\uD600 \uC788\uB294 \uCC45\uC774 \uC788\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5EC\uAE30\uB9CC \uC811\uD600 \uC788\uC5B4."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC5EC\uAE30\uAE4C\uC9C0 \uBCF4\uC2E0 \uBAA8\uC591\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC811\uD78C \uD398\uC774\uC9C0\uB97C
      \uC870\uC2EC\uD788 \uD3BC\uCE5C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD3BC\uCE5C \uD398\uC774\uC9C0\uC5D0\uB294 \uC6B0\uC2A4\uAF5D\uC2A4\uB7FD\uAC8C
      \uCDA4\uC744 \uCD94\uB294 \uAD11\uB300 \uADF8\uB9BC\uC774 \uC788\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD06C\uD06C\uD06C, \uC774\uAC70 \uBB50 \uD558\uACE0 \uC788\uB294 \uAC70\uC57C?"
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uAD11\uB300\uAC00 \uCDA4\uC744 \uCD94\uB294 \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uAD11\uB300 \uC2DC\uB289\uC744 \uB0B4\uBA70
      \uCDA4\uC744 \uCD94\uAE30 \uC2DC\uC791\uD55C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uB807\uAC8C?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC11C\uACE0\uAD00\uB9AC\uC778\uACFC \uC544\uBCA8\uB9AC\uC544\uAC00 \uD06C\uAC8C
      \uC6C3\uB294\uB2E4."
  _nemoLine: "\uD750\uB728\uB7EC\uC9C4 \uCC45\uB4E4 \uC911 \uAC19\uC740 \uD398\uC774\uC9C0\uAC00
    \uC5EC\uB7EC \uBC88 \uC811\uD600 \uC788\uB294 \uCC45\uC774 \uC788\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
