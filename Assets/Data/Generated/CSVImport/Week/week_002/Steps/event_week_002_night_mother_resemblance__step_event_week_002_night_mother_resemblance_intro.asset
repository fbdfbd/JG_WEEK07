  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_night_mother_resemblance__step_event_week_002_night_mother_resemblance_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC5B4\uBA38\uB2C8\uB97C \uB2EE\uC558\uB2E4\uB294 \uB9D0"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C8\uB9AC\uAC00 \uBA38\uB9AC\uB97C \uBE57\uACA8\uC8FC\uACE0 \uB098\uAC14\uB2E4.
      \uC544\uBCA8\uB9AC\uC544\uB294 \uBCA0\uAC1C\uC5D0 \uBA38\uB9AC\uB97C \uBB3B\uACE0
      \uC788\uB2E4\uAC00 \uCC9C\uCC9C\uD788 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298 \uB2E4\uACFC\uD68C\uC5D0\uC11C \uC0AC\uB78C\uB4E4\uC774
      \uB098 \uBCF4\uACE0 \uC5C4\uB9C8 \uB2EE\uC558\uB300."
  _nemoLine: "\uB9C8\uB9AC\uAC00 \uBA38\uB9AC\uB97C \uBE57\uACA8\uC8FC\uACE0 \uB098\uAC14\uB2E4.
    \uC544\uBCA8\uB9AC\uC544\uB294 \uBCA0\uAC1C\uC5D0 \uBA38\uB9AC\uB97C \uBB3B\uACE0
    \uC788\uB2E4\uAC00 \uCC9C\uCC9C\uD788 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uADF8\uB798. \uC815\uB9D0 \uB9CE\uC774 \uB2EE\uC558\uC5B4. \uD2B9\uD788
      \uC6C3\uC744 \uB54C."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC9C4\uC9DC?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8\uB7FC \uC5C4\uB9C8\uB3C4 \uB098\uCC98\uB7FC \uC6C3\uC5C8\uC5B4?"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBCA0\uAC1C\uB97C \uB04C\uC5B4\uC548\uACE0
        \uC791\uAC8C \uB530\uB77C \uC6C3\uC5B4\uBCF4\uC600\uB2E4. \uC5B4\uC0C9\uD588\uC9C0\uB9CC,
        \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
    _responseLine: "\u2026\uC9C4\uC9DC?"
    _interactions:
    - {fileID: 11400000, guid: d6a5e766052d89c428f1743b91d1f5ed, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: a0c8407d4f8fe284ea0a89a9379b23cb, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uADF8\uB7F0 \uB9D0\uC740 \uB108\uBB34 \uC2E0\uACBD \uC4F0\uC9C0 \uB9C8.
      \uB108\uB294 \uB108\uC57C."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC751."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADFC\uB370 \uB2E4\uB4E4 \uADF8\uB7EC\uB294\uB370."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB354 \uBB3B\uC9C0 \uC54A\uC558\uB2E4.
        \uBCA0\uAC1C\uC5D0 \uC5BC\uAD74\uC744 \uC808\uBC18\uCBE4 \uBB3B\uC5C8\uB2E4."
    _responseLine: "\u2026\uC751."
    _interactions:
    - {fileID: 11400000, guid: 07a82ea2eb4e69d47b46715d83afdd61, type: 2}
    - {fileID: 11400000, guid: 5567f538fa6f95541b83bef514683358, type: 2}
    _nextStep: {fileID: 11400000, guid: a0c8407d4f8fe284ea0a89a9379b23cb, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uADF8\uB7FC \uC591 \uD55C \uB9C8\uB9AC, \uB450 \uB9C8\uB9AC \uAC19\uC774
      \uC138\uC5B4\uBCFC\uAE4C?"
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC591?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC6B0\uB9AC \uC9D1\uC5D0 \uC591 \uC5C6\uB294\uB370."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC7A0\uAE50 \uC9C4\uC9C0\uD558\uAC8C
        \uCC9C\uC7A5\uC744 \uC62C\uB824\uB2E4\uBD24\uB2E4."
    _responseLine: "\u2026\uC591?"
    _interactions:
    - {fileID: 11400000, guid: 1dd13bdd8eaf9ce4592aeb8a484f9fba, type: 2}
    _nextStep: {fileID: 11400000, guid: a0c8407d4f8fe284ea0a89a9379b23cb, type: 2}
