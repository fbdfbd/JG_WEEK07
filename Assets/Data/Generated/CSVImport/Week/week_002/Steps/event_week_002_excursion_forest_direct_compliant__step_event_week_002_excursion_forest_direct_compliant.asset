%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_excursion_forest_direct_compliant__step_event_week_002_excursion_forest_direct_compliant
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC232 \uC785\uAD6C \uCABD\uC5D0\uC11C \uD558\uC778 \uB458\uC774 \uBC14\uAD6C\uB2C8\uB97C
      \uB4E4\uACE0 \uB4E4\uC5B4\uAC00\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800 \uC0AC\uB78C\uB4E4 \uC5B4\uB514 \uAC00?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uB2E4\uACFC\uD68C \uC900\uBE44 \uB54C\uBB38\uC5D0 \uAF43\uC744 \uAD6C\uD558\uB7EC
      \uAC11\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC232\uC5D0 \uAF43\uC774 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC774\uB9D8\uB54C \uD53C\uB294 \uAC8C \uBA87 \uAC00\uC9C0 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098\uB3C4 \uAC00\uBA74 \uC548 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC624\uB798 \uAC78\uB9AC\uC9C0 \uC54A\uC744 \uAC81\uB2C8\uB2E4, \uC544\uAC00\uC528.
      \uC5EC\uAE30\uC11C \uAE30\uB2E4\uB824 \uC8FC\uC2DC\uACA0\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC751."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC785\uAD6C \uC606 \uB3CC \uC704\uC5D0
      \uC549\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB5A4 \uAF43 \uAC00\uC838\uC640?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uB178\uB8E8\uADC0\uB77C\uACE0, \uC774\uB9D8\uB54C \uC232\uC5D0\uC11C
      \uD53C\uB294 \uC791\uC740 \uD770 \uAF43\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC608\uBED0?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC18C\uBC15\uD558\uAC8C \uC608\uC069\uB2C8\uB2E4. \uC544\uAC00\uC528
      \uC606\uC5D0 \uB450\uBA74 \uC798 \uC5B4\uC6B8\uB9B4 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uADF8\uB798?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC785\uAD6C\uC5D0\uC11C \uAE30\uB2E4\uB838\uB2E4.
      \uD558\uC778\uC774 \uAC00\uC838\uC628 \uAF43\uC744 \uB450 \uC190\uC73C\uB85C
      \uBC1B\uC544\uB4E4\uC5C8\uB2E4."
  _nemoLine: "\uC232 \uC785\uAD6C \uCABD\uC5D0\uC11C \uD558\uC778 \uB458\uC774 \uBC14\uAD6C\uB2C8\uB97C
    \uB4E4\uACE0 \uB4E4\uC5B4\uAC00\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
  _cinematicCues:
    _enterCue: {fileID: 0}
    _exitCue: {fileID: 0}
