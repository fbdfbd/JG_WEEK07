MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_night_tea_party__step_event_week_002_night_tea_party_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uB2E4\uACFC\uD68C \uC790\uB9AC"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC7A0\uC2DC \uCE68\uBB35. \uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uBD88\uC744
      \uB9CC\uC9C0\uC791\uAC70\uB9AC\uB2E4\uAC00 \uB2E4\uC2DC \uC785\uC744 \uC5F4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4\uACFC\uD68C\uC5D0 \uC0AC\uB78C\uB4E4\uC774 \uB108\uBB34 \uB9CE\uC558\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298 \uB098 \uC798 \uD588\uC5B4?"
  _nemoLine: "\uC7A0\uC2DC \uCE68\uBB35. \uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uBD88\uC744
    \uB9CC\uC9C0\uC791\uAC70\uB9AC\uB2E4\uAC00 \uB2E4\uC2DC \uC785\uC744 \uC5F4\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uC815\uB9D0 \uC798 \uD588\uC5B4. \uC0BC\uCD0C\uC774 \uB2E4 \uBCF4\uACE0
      \uC788\uC5C8\uB2E8\uB2E4."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uB2E4\uD589\uC774\uB2E4! \uC0AC\uC2E4 \uC870\uAE08 \uBB34\uC11C\uC6E0\uC5B4"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC548\uB3C4\uD55C \uB4EF \uAE38\uAC8C
        \uC228\uC744 \uB0B4\uC26C\uC5C8\uB2E4. \uC774\uBD88\uC744 \uC5B4\uAE68\uAE4C\uC9C0
        \uC62C\uB838\uB2E4."
    _responseLine: "\uB2E4\uD589\uC774\uB2E4! \uC0AC\uC2E4 \uC870\uAE08 \uBB34\uC11C\uC6E0\uC5B4"
    _interactions:
    - {fileID: 11400000, guid: d6a5e766052d89c428f1743b91d1f5ed, type: 2}
    _nextStep: {fileID: 11400000, guid: 9391983eab73c50419178f56c3c22082, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uC0BC\uCD0C\uC740 \uB124\uAC00 \uC778\uC0AC\uD560 \uB54C \uBA38\uB9AC\uC5D0
      \uB9AC\uBCF8\uC774 \uBE44\uB6A4\uC5B4\uC9C4 \uAC8C \uB354 \uC2E0\uACBD \uC4F0\uC600\uC5B4."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uB9AC\uBCF8\uC774?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC5B4\uB514\uAC00? \uC5B4\uB290 \uCABD\uC774?"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC11\uC790\uAE30 \uC774\uBD88 \uBC16\uC73C\uB85C
        \uB098\uC640\uC11C \uB9AC\uBCF8\uC744 \uCC3E\uC73C\uB824\uB2E4 \uADF8\uB9CC
        \uB450\uC5C8\uB2E4."
    _responseLine: "\u2026\uB9AC\uBCF8\uC774?"
    _interactions:
    - {fileID: 11400000, guid: 49d60b6de82ff6d499a3921eb28eb77f, type: 2}
    _nextStep: {fileID: 11400000, guid: 9391983eab73c50419178f56c3c22082, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uB2E4\uC74C\uC5D4 \uB354 \uC798\uD560 \uC218 \uC788\uC744 \uAC70\uB780\uB2E4."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: ...
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8\uB7FC \uC624\uB298\uC740 \uC798 \uBABB \uD55C \uAC70\uC57C?"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC791\uAC8C \uC785\uC744 \uB2E4\uBB3C\uC5C8\uB2E4.
        \uC774\uBD88 \uB05D\uC744 \uB2E4\uC2DC \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4."
    _responseLine: ...
    _interactions:
    - {fileID: 11400000, guid: b0acdf54f7c36774fbadc86a7ef5a9d2, type: 2}
    _nextStep: {fileID: 11400000, guid: 9391983eab73c50419178f56c3c22082, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
