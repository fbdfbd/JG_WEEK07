--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_rian_blocked__step_event_week_002_rian_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBCA4\uCE58 \uC704\uC5D0 \uC190\uC218\uAC74\uC73C\uB85C \uC2FC \uC791\uC740
      \uBD09\uC9C0\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uAC70 \uBB50\uC57C?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uB9AC\uC548 \uB2D8\uAED8\uC11C \uB450\uACE0 \uAC00\uC2E0 \uAC83\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9AC\uC548\uC774 \uC654\uC5B4?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uC608. \uC544\uAC00\uC528\uB97C \uBD59\uACE0 \uC2F6\uC5B4 \uD558\uC168\uC9C0\uB9CC,
      \uC624\uB298\uC740 \uC624\uB798 \uBA38\uBB3C\uC9C0 \uC54A\uACE0 \uB3CC\uC544\uAC00\uC168\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uBAB8\uC774 \uC57D\uD558\uC2E0 \uB370\uB2E4, \uC624\uB298\uC740 \uC190\uB2D8\uB3C4
      \uB9CE\uC544 \uC870\uC6A9\uD788 \uC778\uC0AC\uB9CC \uB0A8\uAE30\uACE0 \uAC00\uC168\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBD09\uC9C0\uB97C \uC870\uC2EC\uC2A4\uB7FD\uAC8C
      \uD480\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC548\uC5D0\uB294 \uC870\uAE08 \uD0C0\uACE0 \uBAA8\uC591\uC774 \uCC0C\uADF8\uB7EC\uC9C4
      \uC791\uC740 \uCFE0\uD0A4\uAC00 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC70, \uB9AC\uC548\uC774 \uB9CC\uB4E0 \uAC70\uC57C?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uADF8\uB7F0 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCFE0\uD0A4\uB97C \uD55C \uC785 \uBCA0\uC5B4
      \uBB3C\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB531\uB531\uD574..."
  _nemoLine: "\uBCA4\uCE58 \uC704\uC5D0 \uC190\uC218\uAC74\uC73C\uB85C \uC2FC \uC791\uC740
    \uBD09\uC9C0\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
