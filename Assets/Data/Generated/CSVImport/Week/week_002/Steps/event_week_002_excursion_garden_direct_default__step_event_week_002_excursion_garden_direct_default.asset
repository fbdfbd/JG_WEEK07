  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_excursion_garden_direct_default__step_event_week_002_excursion_garden_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBE44\uAC00 \uC624\uB294 \uC815\uC6D0, \uB2EC\uD33D\uC774 \uC138 \uB9C8\uB9AC\uAC00
      \uC904\uC744 \uC9C0\uC5B4 \uAE30\uC5B4\uAC00\uACE0 \uC788\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4, \uB290\uB824."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5C4\uCCAD \uB290\uB824."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC544\uAC00\uC528, \uC637 \uC816\uC73C\uC2ED\uB2C8\uB2E4. \uADF8\uB9CC
      \uC77C\uC5B4\uB098\uC2DC\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC870\uAE08\uB9CC \uB354."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC00\uC7A5 \uC55E\uC11C \uAC00\uB358
      \uB2EC\uD33D\uC774\uAC00 \uB3CC \uD2C8 \uC548\uC73C\uB85C \uC0AC\uB77C\uC9C8
      \uB54C\uAE4C\uC9C0 \uC9C0\uCF1C\uBD24\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB514 \uAC00\uB294 \uAC78\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC9D1\uC73C\uB85C \uAC00\uB294 \uAC70\uACA0\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9D1\uC774 \uC5B4\uB514 \uC788\uB294\uB370?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uB4F1\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "...\uADF8\uB7FC \uC5B4\uB514\uB4E0 \uC9D1\uC774\uB124."
  _nemoLine: "\uBE44\uAC00 \uC624\uB294 \uC815\uC6D0, \uB2EC\uD33D\uC774 \uC138 \uB9C8\uB9AC\uAC00
    \uC904\uC744 \uC9C0\uC5B4 \uAE30\uC5B4\uAC00\uACE0 \uC788\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
