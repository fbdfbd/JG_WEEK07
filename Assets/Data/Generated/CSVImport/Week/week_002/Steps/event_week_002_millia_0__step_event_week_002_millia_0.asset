  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_millia_0__step_event_week_002_millia_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uC791\uC740 \uACFC\uC790 \uC0C1\uC790\uB97C
      \uB4E4\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC774\uAC70 \uB2E4\uACFC\uD68C\uC5D0 \uB0BC \uAC70\uB798."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB124\uAC00 \uAC00\uC838\uC654\uC5B4?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC751. \uC6B0\uB9AC\uAC00 \uD30C\uB294 \uAC70\uC57C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD30C\uB294\uAC70?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC544\uBE60\uAC00 \uC77C\uD558\uB294 \uACF3\uC5D0\uC11C \uD314\uC544."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uC0C1\uC790\uB97C \uC5F4\uC5B4 \uACFC\uC790\uB97C
      \uBCF4\uC5EC\uC8FC\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB108\uB3C4 \uBA39\uB294 \uAC70\uB2C8\uAE4C \uB124\uAC00 \uB9DB\uBD10\uB3C4
      \uB41C\uB300."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uAC00 \uACE8\uB77C\uB3C4 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC751. \uB9DB\uC5C6\uC73C\uBA74 \uB9DB\uC5C6\uB2E4\uACE0 \uD574."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uADF8\uB798\uC57C \uB2E4\uC74C\uC5D0 \uC548 \uAC00\uC838\uC624\uC9C0."
  _nemoLine: "\uBC00\uB9AC\uC544\uB294 \uC791\uC740 \uACFC\uC790 \uC0C1\uC790\uB97C
    \uB4E4\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
