  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_rian_1__step_event_week_002_rian_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC190\uC218\uAC74\uC5D0 \uC2FC \uC791\uC740 \uCFE0\uD0A4\uB97C
      \uAEBC\uB0C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC774\uAC70 \uB0B4\uAC00 \uB9CC\uB4E4\uC5C8\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB124\uAC00?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC751. \uC870\uAE08 \uD0D4\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBA39\uC5B4\uB3C4 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC544\uB9C8\uB3C4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCFE0\uD0A4\uB97C \uC870\uAE08 \uBCA0\uC5B4
      \uBB3C\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB531\uB531\uD574."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uB2EC\uC544?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC751. \uC870\uAE08."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uB7FC \uC131\uACF5\uC774\uC57C."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC548\uC2EC\uD55C \uB4EF \uC6C3\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB2E4\uC74C\uC5D4 \uB35C \uD0DC\uC6B8\uAC8C."
  _nemoLine: "\uB9AC\uC548\uC740 \uC190\uC218\uAC74\uC5D0 \uC2FC \uC791\uC740 \uCFE0\uD0A4\uB97C
    \uAEBC\uB0C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
