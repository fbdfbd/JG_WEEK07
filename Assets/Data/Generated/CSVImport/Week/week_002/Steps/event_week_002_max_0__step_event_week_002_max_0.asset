  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_max_0__step_event_week_002_max_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uD604\uAD00 \uC55E. \uB0AE."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBD09\uC2E0\uAC00\uBB38\uC5D0\uC11C \uB2E4\uACFC\uD68C \uC900\uBE44
      \uC778\uC0AC\uB97C \uD558\uB7EC \uC654\uB2E4. \uADF8 \uC606\uC5D0 \uB9C9\uC2A4\uAC00
      \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC548\uB155. \uB098\uB294 \uB9C9\uC2A4\uC57C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC544\uBCA8\uB9AC\uC544\uC57C."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB2E4\uACFC\uD68C\uC5D0\uC120 \uC544\uC774\uB4E4\uB07C\uB9AC \uC549\uC744\uAC70\uB798.
      \uADF8\uB798\uC11C \uBA3C\uC800 \uC778\uC0AC\uD558\uB798."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0 \uAC83\uB3C4 \uC815\uD574\uC838 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB098\uB3C4 \uC798 \uBAB0\uB77C. \uADF8\uB798\uB3C4 \uC58C\uC804\uD788
      \uC788\uC73C\uBA74 \uB41C\uB2E4\uB294\uB370?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC7A0\uAE50 \uB9DD\uC124\uC774\uB2E4\uAC00 \uB9D0\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uD639\uC2DC \uBD88\uD3B8\uD558\uBA74 \uB098\uD55C\uD14C \uB9D0\uD574.
      \uAC00\uAE4C\uC774 \uC788\uC744 \uC218\uB3C4 \uC788\uC73C\uB2C8\uAE4C."
  _nemoLine: "\uBC31\uC791\uC800 \uD604\uAD00 \uC55E. \uB0AE."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
