  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_rian_0__step_event_week_002_rian_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC811\uC740 \uC885\uC774\uC640 \uC791\uC740 \uADF8\uB9BC\uC744
      \uB4E4\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC800\uBC88\uC5D0 \uB2F5\uC7A5 \uC548 \uC654\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uBC88\uC5D0?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uAD1C\uCC2E\uC544. \uADF8\uB798\uC11C \uB0B4\uAC00 \uB610 \uC654\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uAE30\uB2E4\uB9AC\uBA74 \uC2EC\uC2EC\uD558\uB2C8\uAE4C."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC885\uC774\uB97C \uD3BC\uCCE4\uB2E4. \uC0C8 \uB450
      \uB9C8\uB9AC\uAC00 \uB098\uB780\uD788 \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC74 \uBB50\uC57C?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC6B0\uB9AC."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0C8\uAC00?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC751. \uD55C \uB9C8\uB9AC\uB9CC \uC788\uC73C\uBA74 \uC678\uB86D\uC796\uC544."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uADF8\uB9BC\uC744 \uC624\uB798 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uB458\uC774\uBA74 \uB35C \uC678\uB85C\uC6CC?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC870\uAE08\uC740."
  _nemoLine: "\uB9AC\uC548\uC740 \uC811\uC740 \uC885\uC774\uC640 \uC791\uC740 \uADF8\uB9BC\uC744
    \uB4E4\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
