--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_rumor_direct_default__step_event_week_002_rumor_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC18C\uBB38 \uD5C8\uAC00"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C8\uB9AC\uAC00 \uCCAD\uC18C \uB3C4\uAD6C\uB97C \uB4E0 \uCC44 \uC9C0\uD558\uC2E4
      \uC785\uAD6C \uCABD\uC5D0\uC11C \uB098\uC624\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C8\uB9AC, \uAC70\uAE30\uC11C \uBB50 \uD574?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC9C0\uD558\uC2E4 \uCABD\uC744 \uC7A0\uAE50 \uC0B4\uD3B4\uBCF4\uACE0
      \uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\u2026\uC5B4\uC82F\uBC24\uC5D0 \uC548\uCABD\uC5D0\uC11C \uC790\uAFB8
      \uC18C\uB9AC\uAC00 \uB0AC\uB2E4\uACE0 \uD574\uC11C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uC2A8 \uC18C\uB9AC?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC791\uC740 \uBC1C\uD1B1\uC774 \uBC14\uB2E5\uC744 \uAE01\uB294 \uB4EF\uD55C
      \uC18C\uB9AC\uC600\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC1C\uD1B1?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608. \uBC24\uC5D0\uB9CC \uB4E4\uB9B0\uB2E4\uACE0 \uD558\uB354\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uADF8\uAC8C \uBB58\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uAE00\uC384\uC694. \uC950\uC77C \uC218\uB3C4 \uC788\uACE0, \uC544\uB2D0
      \uC218\uB3C4 \uC788\uACE0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uB2D0 \uC218\uB3C4 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\u2026\uBAA8\uB985\uB2C8\uB2E4, \uC544\uAC00\uC528."
  _nemoLine: "\uB9C8\uB9AC\uAC00 \uCCAD\uC18C \uB3C4\uAD6C\uB97C \uB4E0 \uCC44 \uC9C0\uD558\uC2E4
    \uC785\uAD6C \uCABD\uC5D0\uC11C \uB098\uC624\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
