  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_teaparty__step_teaparty_outro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB2E4\uACFC\uD68C\uAC00 \uB05D\uB0A0 \uB54C\uCBE4, \uCC3B\uC794\uC740
      \uD55C \uBC88 \uB354 \uCC44\uC6CC\uC84C\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
      \uC790\uAE30 \uC55E\uC758 \uC794\uC744 \uBC14\uB77C\uBCF4\uB2E4\uAC00 \uB124
      \uC544\uC774\uB97C \uCC28\uB840\uB85C \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uC774\uB4E4\uC740 \uC7A0\uAE50 \uC11C\uB85C\uB97C \uBCF4\uC558\uB2E4.
      \uADF8\uB9AC\uACE0 \uC544\uC8FC \uC791\uAC8C \uC6C3\uC5C8\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
      \uC870\uAE08 \uC804\uBCF4\uB2E4 \uCC9C\uCC9C\uD788, \uD558\uC9C0\uB9CC \uC2A4\uC2A4\uB85C
      \uCC3B\uC794\uC744 \uB4E4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB2E4\uACFC\uD68C\uB294 \uB05D\uB0AC\uB2E4. \uCC3B\uC794\uC740 \uC870\uAE08
      \uC2DD\uC5B4 \uC788\uC5C8\uC9C0\uB9CC, \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8\uB300\uB85C
      \uB0A8\uACA8\uB450\uACE0 \uC2F6\uC9C0 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC70, \uC870\uAE08 \uB354 \uB9C8\uC2DC\uACE0 \uAC00\uB3C4 \uB3FC?"
  _nemoLine: "\uB2E4\uACFC\uD68C\uAC00 \uB05D\uB0A0 \uB54C\uCBE4, \uCC3B\uC794\uC740
    \uD55C \uBC88 \uB354 \uCC44\uC6CC\uC84C\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
    \uC790\uAE30 \uC55E\uC758 \uC794\uC744 \uBC14\uB77C\uBCF4\uB2E4\uAC00 \uB124
    \uC544\uC774\uB97C \uCC28\uB840\uB85C \uBCF4\uC558\uB2E4."
