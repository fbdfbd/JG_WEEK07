MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_002_rumor_blocked__step_event_week_002_rumor_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C8\uB9AC\uAC00 \uCCAD\uC18C \uB3C4\uAD6C\uB97C \uB4E0 \uCC44 \uC9C0\uD558\uC2E4
      \uC785\uAD6C \uCABD\uC5D0\uC11C \uB098\uC624\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C8\uB9AC."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uB124, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9C0\uD558\uC2E4\uC5D0\uC11C \uBB34\uC2A8 \uC18C\uB9AC \uB098\uC9C0
      \uC54A\uC558\uC5B4?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\u2026\uC9D1\uC774 \uC624\uB798\uB418\uBA74 \uC5EC\uAE30\uC800\uAE30
      \uC18C\uB9AC\uAC00 \uB0A9\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB514\uC11C?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uBC14\uB78C\uB3C4 \uC788\uACE0, \uB098\uBB34 \uB9C8\uB8E8\uB3C4 \uC788\uACE0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0 \uAC70\uC57C?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uB2E4\uACFC\uD68C \uC190\uB2D8\uB4E4 \uACE7 \uC624\uC2ED\uB2C8\uB2E4,
      \uC544\uAC00\uC528. \uC637\uBD80\uD130 \uAC08\uC544\uC785\uC73C\uC2DC\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC751."
  _nemoLine: "\uB9C8\uB9AC\uAC00 \uCCAD\uC18C \uB3C4\uAD6C\uB97C \uB4E0 \uCC44 \uC9C0\uD558\uC2E4
    \uC785\uAD6C \uCABD\uC5D0\uC11C \uB098\uC624\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
