  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB450 \uC190\uC73C\uB85C \uB2E4\uC2DC \uB4E4\uC5B4\uB3C4 \uB3FC\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uB807\uAC8C?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uADF8\uB807\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 2af885eedf1120f4ebe3ea9e3df21afd, type: 2}
    _text: "\uB124. \uADF8\uAC8C \uC88B\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACE0\uB9C8\uC6CC."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uAD1C\uCC2E\uC544\uC694. \uCC98\uC74C\uC5D4 \uC5B4\uB824\uC6CC\uC694."
  _nemoLine: "\uB450 \uC190\uC73C\uB85C \uB2E4\uC2DC \uB4E4\uC5B4\uB3C4 \uB3FC\uC694."
