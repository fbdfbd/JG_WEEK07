  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_rian_0__step_event_week_006_rian_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD669\uC2E4 \uBB38\uC7A5\uC774 \uCC0D\uD78C \uCD08\uB300\uC7A5\uC774
      \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uBD09\uD22C
      \uC544\uB798\uC5D0\uB294 \uB0AF\uC120 \uC774\uB984\uC774 \uC791\uAC8C \uC11C\uBA85\uB418\uC5B4
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774 \uC11C\uBA85\uC740 \uB204\uAD6C\uC778\uAC00\uC694? \uCC98\uC74C
      \uBCF4\uB294\uB370."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uCD08\uB300\uC7A5\uC744 \uC804\uB2EC\uD55C \uBD84\uC758 \uC774\uB984\uC73C\uB85C
      \uBCF4\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBB38\uAC00\uC5D0\uC11C \uC870\uC6A9\uD55C \uBAA9\uC18C\uB9AC\uAC00
      \uB4E4\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC81C \uC774\uB984\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544, \uCC98\uC74C\uBD59\uB124\uC694. \uB9AC\uC548\uC774\uB77C\uACE0
      \uBD80\uB974\uBA74 \uB420\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC7A0\uC2DC \uB9DD\uC124\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\u2026\uADF8\uB807\uAC8C \uBD88\uB7EC \uC8FC\uC138\uC694. \uC801\uC5B4\uB3C4
      \uC9C0\uAE08\uC740\uC694."
  _nemoLine: "\uD669\uC2E4 \uBB38\uC7A5\uC774 \uCC0D\uD78C \uCD08\uB300\uC7A5\uC774
    \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uBD09\uD22C
    \uC544\uB798\uC5D0\uB294 \uB0AF\uC120 \uC774\uB984\uC774 \uC791\uAC8C \uC11C\uBA85\uB418\uC5B4
    \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
