MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_excursion_forest_direct_clever__step_event_week_006_excursion_forest_direct_clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uACBD\uBE44\uAC00 \uD3C9\uC18C\uBCF4\uB2E4 \uB9CE\uC740\uB370."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC624\uB298 \uAD50\uB300\uAC00 \uC77C\uCC0D \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC77C\uC815 \uC870\uC815\uC774 \uC788\uC5C8\uB358 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uB3C4\uD68C \uB54C\uBB38\uC774\uACA0\uC8E0. \uC678\uBD80 \uC190\uB2D8\uC774
      \uC624\uB2C8\uAE4C \uC232 \uCABD\uB3C4 \uC2E0\uACBD \uC4F0\uB294 \uAC70\uACE0."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uADF8\uB7F4 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD639\uC2DC \uC5B4\uC82F\uBC24\uC5D0 \uBB54\uAC00 \uC788\uC5C8\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uD2B9\uBCC4\uD55C \uC77C\uC740 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0\uB370 \uAD50\uB300\uB97C \uC65C \uC55E\uB2F9\uACBC\uC744\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uADF8\uAC74\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB410\uC5B4\uC694. \uB354 \uBB3B\uC9C0 \uC54A\uC744\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC232 \uC548\uCABD\uC744 \uD55C \uBC88
      \uB354 \uBC14\uB77C\uBCF4\uACE0 \uB3CC\uC544\uC130\uB2E4. \uC11C\uB450\uB974\uC9C0
      \uC54A\uC558\uB2E4."
  _nemoLine: "\uACBD\uBE44\uAC00 \uD3C9\uC18C\uBCF4\uB2E4 \uB9CE\uC740\uB370."
  _useCustomVisualState: 0
  _visualState: 0
