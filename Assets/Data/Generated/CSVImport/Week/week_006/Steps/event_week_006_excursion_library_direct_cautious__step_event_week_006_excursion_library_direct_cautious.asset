MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_excursion_library_direct_cautious__step_event_week_006_excursion_library_direct_cautious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC608\uBC95\uC11C\uC5D0 \uADF8\uB824\uC9C4
      \uBB34\uB3C4\uD68C\uC7A5 \uD3C9\uBA74\uB3C4\uB97C \uBE64\uD788 \uCCD0\uB2E4\uBCF8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC190\uAC00\uB77D\uC774 \uAC19\uC740 \uC790\uB9AC\uB97C \uACC4\uC18D
      \uB9F4\uB3CC\uACE0 \uC788\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C \uC774\uB984\uC774 \uBD88\uB9AC\uBA74 \uC774 \uAE38\uB85C \uB098\uAC00\uB294
      \uAC70\uC8E0?"
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uB124, \uC774\uBBF8 \uD655\uC778\uD558\uC2E0 \uB300\uB85C\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD55C \uBC88\uB9CC \uB354 \uD655\uC778\uD560\uAC8C\uC694. \uB3D9\uC120\uC774
      \uC0DD\uAC01\uBCF4\uB2E4 \uAE38\uC5B4\uC11C \uC790\uAFB8 \uC78A\uC5B4\uBC84\uB824\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uB108\uBB34 \uAE34\uC7A5\uD558\uC2E4 \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4,
      \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD639\uC2DC\uB77C\uB3C4 \uC81C\uAC00 \uB2A6\uAC8C \uB3C4\uCC29\uD558\uBA74
      \uC5B4\uB5A1\uD574\uC694. \uC2E4\uC218\uD558\uAE30 \uC2EB\uB2E8 \uB9D0\uC774\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC608\uBC95\uC11C \uC704\uB85C \uACE0\uAC1C\uB97C
      \uB354 \uAE4A\uAC8C \uC219\uC774\uACE0 \uB2E4\uC2DC \uCCAB \uC904\uBD80\uD130
      \uC77D\uC5B4 \uB0B4\uB824\uAC14\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC608\uBC95\uC11C\uC5D0 \uADF8\uB824\uC9C4
    \uBB34\uB3C4\uD68C\uC7A5 \uD3C9\uBA74\uB3C4\uB97C \uBE64\uD788 \uCCD0\uB2E4\uBCF8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
