  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC608\uBC95\uC11C\uC758 \uC21C\uC11C\uB97C
      \uC190\uAC00\uB77D\uC73C\uB85C \uC9DA\uC5C8\uB2E4. \uC778\uC0AC, \uC2DC\uC120,
      \uC190 \uC704\uCE58, \uBB3C\uB7EC\uB098\uB294 \uBC29\uD5A5."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uBCF4\uC9C4 \uC54A\uC744\uAC8C\uC694.
      \uD5F7\uAC08\uB9AC\uB294 \uB370\uB9CC \uBCFC\uB798\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uADF8\uAC8C \uC88B\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD45C\uC2DC\uD55C \uBD80\uBD84\uB9CC
      \uC870\uC6A9\uD788 \uD655\uC778\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774 \uC815\uB3C4\uBA74 \uB3FC\uC694."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC608\uBC95\uC11C\uC758 \uC21C\uC11C\uB97C
    \uC190\uAC00\uB77D\uC73C\uB85C \uC9DA\uC5C8\uB2E4. \uC778\uC0AC, \uC2DC\uC120,
    \uC190 \uC704\uCE58, \uBB3C\uB7EC\uB098\uB294 \uBC29\uD5A5."
