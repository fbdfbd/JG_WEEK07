  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_max_blocked__step_event_week_006_max_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uBB34\uB3C4\uD68C \uC785\uC7A5 \uC21C\uC11C\uAC00
      \uC801\uD78C \uC885\uC774\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: e4d7e54a5ce433a498734ab4f137b35a, type: 2}
    _text: "\uC785\uC7A5\uD558\uC2E4 \uB54C\uB294 \uC0C1\uB300\uC758 \uC190 \uC704\uC5D0
      \uC190\uC744 \uAC00\uBCCD\uAC8C \uC62C\uB9AC\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0C1\uB300\uAC00 \uBA3C\uC800 \uC190\uC744 \uB0B4\uBC00\uBA74\uC694?"
  - _speaker: {fileID: 11400000, guid: e4d7e54a5ce433a498734ab4f137b35a, type: 2}
    _text: "\uADF8\uB54C \uB9DE\uCDB0 \uC62C\uB9AC\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD5C8\uACF5\uC5D0 \uC190\uC744 \uC62C\uB824
      \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC190\uC774 \uC5B4\uB514 \uC788\uB294\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370\uC694."
  - _speaker: {fileID: 11400000, guid: e4d7e54a5ce433a498734ab4f137b35a, type: 2}
    _text: "\uC808\uCC28\uB9CC \uAE30\uC5B5\uD558\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC808\uCC28\uB294 \uC190\uC744 \uC7A1\uC544\uC8FC\uC9C0 \uC54A\uC796\uC544\uC694."
  _nemoLine: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uBB34\uB3C4\uD68C \uC785\uC7A5 \uC21C\uC11C\uAC00
    \uC801\uD78C \uC885\uC774\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
