--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_excursion_library_blocked__step_event_week_006_excursion_library_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB3C4\uC11C\uAD00 \uBB38\uC774 \uB2EB\uD600 \uC788\uACE0 \uB0B4\uBD80\uC5D0\uC11C\uB294
      \uC9D1\uAE30\uB4E4\uC744 \uC62E\uAE30\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB824\uC628\uB2E4.
      \uC544\uBCA8\uB9AC\uC544\uB294 \uB2EB\uD78C \uBB38\uC744 \uBCF4\uBA70 \uAC78\uC74C\uC744
      \uBA48\uCD98\uB2E4."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC544\uAC00\uC528, \uBB34\uB3C4\uD68C \uC900\uBE44\uB85C \uB0B4\uBD80\uAC00
      \uC18C\uB780\uC2A4\uB7EC\uC6CC \uC624\uB298\uC740 \uCD9C\uC785\uC774 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uC5D0\uC11C \uB2E4\uB4E4 \uBC14\uC058\uAC8C \uC6C0\uC9C1\uC774\uACE0
      \uC788\uB098 \uBD10\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uB124, \uC544\uAC00\uC528\uC758 \uC18C\uC911\uD55C \uB0A0\uC744 \uC644\uBCBD\uD558\uAC8C
      \uC900\uBE44\uD558\uB824\uACE0 \uBAA8\uB450 \uC560\uC4F0\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800 \uB54C\uBB38\uC5D0 \uB2E4\uB4E4 \uACE0\uC0DD\uD558\uC2DC\uB294\uB370
      \uC81C\uAC00 \uBC29\uD574\uD558\uBA74 \uC548 \uB418\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC774\uD574\uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uB098\uC911\uC5D0 \uB2E4\uC2DC \uC62C\uAC8C\uC694. \uB2E4\uB4E4
      \uD798\uB0B4\uC2DC\uB77C\uACE0 \uC804\uD574\uC8FC\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB2EB\uD78C \uBB38 \uB108\uBA38\uB97C
      \uD55C \uBC88 \uB354 \uC0B4\uD540 \uB4A4, \uAC00\uBCBC\uC6B4 \uBC1C\uAC78\uC74C\uC73C\uB85C
      \uBCF5\uB3C4\uB97C \uB3CC\uC544 \uB098\uAC14\uB2E4."
  _nemoLine: "\uB3C4\uC11C\uAD00 \uBB38\uC774 \uB2EB\uD600 \uC788\uACE0 \uB0B4\uBD80\uC5D0\uC11C\uB294
    \uC9D1\uAE30\uB4E4\uC744 \uC62E\uAE30\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB824\uC628\uB2E4.
    \uC544\uBCA8\uB9AC\uC544\uB294 \uB2EB\uD78C \uBB38\uC744 \uBCF4\uBA70 \uAC78\uC74C\uC744
    \uBA48\uCD98\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
