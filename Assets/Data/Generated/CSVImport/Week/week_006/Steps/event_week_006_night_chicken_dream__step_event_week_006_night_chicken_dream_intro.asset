%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_night_chicken_dream__step_event_week_006_night_chicken_dream_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uAC19\uC740 \uAFC8"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBCC4\uC774 \uD55C\uB458 \uBCF4\uC774\uAE30 \uC2DC\uC791\uD588\uB2E4.
      \uBB34\uC5B8\uAC00\uB97C \uD55C\uCC38 \uB9DD\uC124\uC774\uB2E4\uAC00 \uC785\uC744
      \uC5F4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uC0C1\uD55C \uC598\uAE30\uC778\uB370\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC694\uC998 \uAC19\uC740 \uAFC8\uC744 \uC790\uAFB8 \uAFD4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB5A4 \uAFC8\uC774\uB0D0\uBA74\u2026 \uAC70\uB300\uD55C \uB2ED\uC774
      \uC800\uB97C \uCAD3\uC544\uC624\uB294 \uAFC8\uC774\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC9C4\uC9C0\uD588\uB2E4. \uC815\uB9D0
      \uC9C4\uC9C0\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uC81C\uB3C4 \uADF8 \uAFC8\uC744 \uAFE8\uC5B4\uC694. \uADF8\uC800\uAED8\uB3C4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2ED\uC774 \uC800\uBCF4\uB2E4 \uCEE4\uC694. \uBC1C\uC774 \uC774\uB9CC\uD574\uC694.
      (\uC190\uC73C\uB85C \uD06C\uAE30\uB97C \uBCF4\uC5EC\uC900\uB2E4)"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC8C \uBB34\uC2A8 \uC758\uBBF8\uAC00 \uC788\uB294 \uAC78\uAE4C\uC694?"
  _nemoLine: "\uBCC4\uC774 \uD55C\uB458 \uBCF4\uC774\uAE30 \uC2DC\uC791\uD588\uB2E4.
    \uBB34\uC5B8\uAC00\uB97C \uD55C\uCC38 \uB9DD\uC124\uC774\uB2E4\uAC00 \uC785\uC744
    \uC5F4\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uD558\uD558\uD558, \uADF8\uB798, \uBB34\uC11C\uC6E0\uACA0\uAD6C\uB098.
      \uB2ED\uC774 \uADF8\uB807\uAC8C \uD06C\uBA74 \uBB34\uC12D\uC9C0."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC0BC\uCD0C \uC9C0\uAE08 \uC6C3\uC5C8\uC5B4\uC694?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC9C4\uC9DC \uBB34\uC12D\uB2E4\uB2C8\uAE4C\uC694. \uBD80\uB9AC\uB3C4
        \uC5C4\uCCAD \uD06C\uACE0."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD55C\uCC38 \uB2ED\uC758 \uD06C\uAE30\uB97C
        \uC190\uC73C\uB85C \uB2E4\uC2DC \uADF8\uB824\uBCF4\uC600\uB2E4."
    _responseLine: "\u2026\uC0BC\uCD0C \uC9C0\uAE08 \uC6C3\uC5C8\uC5B4\uC694?"
    _interactions:
    - {fileID: 11400000, guid: d6a5e766052d89c428f1743b91d1f5ed, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: 1073bd73838955941b4924f3b0d1e8f1, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uAFC8\uC740 \uADF8\uB0E5 \uAFC8\uC774\uC57C. \uC758\uBBF8\uB97C \uBD80\uC5EC\uD560
      \uD544\uC694 \uC5C6\uB2E8\uB2E4."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uB124..."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8\uC800 \uAFC8\uC774\uB77C\uB294 \uAC70 \uC800\uB3C4 \uC54C\uC544\uC694."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADFC\uB370 \uB9E4\uC77C \uAC19\uC740 \uB2ED\uC774 \uB098\uC624\uBA74
        \uC880 \uB2E4\uB974\uC796\uC544\uC694."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC791\uAC8C \uD55C\uC228\uC744 \uC26C\uC5C8\uB2E4.
        \uADF8 \uD55C\uC228\uC5D0\uB294 \uC57D\uAC04\uC758 \uC5B5\uC6B8\uD568\uC774
        \uC11E\uC5EC \uC788\uC5C8\uB2E4."
    _responseLine: "\uB124..."
    _interactions:
    - {fileID: 11400000, guid: 07a82ea2eb4e69d47b46715d83afdd61, type: 2}
    - {fileID: 11400000, guid: 5567f538fa6f95541b83bef514683358, type: 2}
    _nextStep: {fileID: 11400000, guid: 1073bd73838955941b4924f3b0d1e8f1, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uADF8\uB7EC\uAC8C \uB2ED \uC880 \uADF8\uB9CC \uBA39\uC73C\uB77C \uD558\uC9C0
      \uC54A\uC558\uB2C8. \uBA70\uCE60 \uC804\uC5D0\uB3C4 \uD1B5\uAD6C\uC774 \uD55C
      \uB9C8\uB9AC\uB97C \uB2E4 \uBA39\uB354\uB2C8.."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC124\uB9C8 \uADF8 \uB2ED\uC774..."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8 \uB2ED \uC9C4\uC9DC \uB9DB\uC788\uAE34 \uD588\uB294\uB370."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC7A0\uC2DC \uD1B5\uAD6C\uC774 \uB2ED\uC758
        \uD06C\uAE30\uC640 \uAFC8 \uC18D \uB2ED\uC758 \uD06C\uAE30\uB97C \uBE44\uAD50\uD574\uBCF4\uB294
        \uAC83 \uAC19\uC558\uB2E4."
    _responseLine: "\uC124\uB9C8 \uADF8 \uB2ED\uC774..."
    _interactions:
    - {fileID: 11400000, guid: d090616150871a540b234c9482e2e144, type: 2}
    _nextStep: {fileID: 11400000, guid: 1073bd73838955941b4924f3b0d1e8f1, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
