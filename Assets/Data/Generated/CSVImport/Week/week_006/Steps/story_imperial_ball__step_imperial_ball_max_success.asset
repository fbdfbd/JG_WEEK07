  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_imperial_ball__step_imperial_ball_max_success
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uCCAB \uCDA4 \uC21C\uC11C\uAC00 \uAC00\uAE4C\uC6CC\uC9C0\uC790, \uC544\uC774\uB4E4\uC774
      \uD558\uB098\uB458 \uBB34\uB3C4\uD68C\uC7A5 \uAC00\uC6B4\uB370\uB85C \uB098\uAC14\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC14\uB2E5\uC5D0 \uADF8\uC5B4\uC9C4
      \uC6D0\uD615 \uBB34\uB2AC\uB97C \uBCF4\uC558\uB2E4. \uADF8 \uC548\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\uBA74 \uBAA8\uB450\uC758 \uC2DC\uC120\uC774 \uBAA8\uC77C
      \uAC83 \uAC19\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uAC00 \uC870\uAE08 \uB5A8\uC5B4\uC9C4 \uACF3\uC5D0\uC11C
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uAD1C\uCC2E\uC73C\uC138\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAD1C\uCC2E\uC9C0\uB294 \uC54A\uC544\uC694. \uADF8\uB798\uB3C4 \uAC81\uB0B4\uC9C0
      \uC54A\uC744\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uBA3C\uC800 \uD55C \uAC78\uC74C \uC55E\uC73C\uB85C
      \uB098\uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uADF8\uC81C\uC57C \uC190\uC744 \uB0B4\uBC00\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC81C\uAC00 \uB9DE\uCD9C\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB124. \uCC9C\uCC9C\uD788\uC694."
  _nemoLine: "\uCCAB \uCDA4 \uC21C\uC11C\uAC00 \uAC00\uAE4C\uC6CC\uC9C0\uC790, \uC544\uC774\uB4E4\uC774
    \uD558\uB098\uB458 \uBB34\uB3C4\uD68C\uC7A5 \uAC00\uC6B4\uB370\uB85C \uB098\uAC14\uB2E4."
