MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_excursion_library_direct_default__step_event_week_006_excursion_library_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC608\uBC95\uC11C\uC5D0\uB294 \uAC00\uBB38\uBCC4 \uC785\uC7A5 \uC21C\uC11C\uAC00
      \uBE7D\uBE7D\uD558\uAC8C \uC801\uD600 \uC788\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC790\uC2E0\uC758 \uAC00\uBB38\uBA85\uC774
      \uC801\uD78C \uC904\uC744 \uC190\uAC00\uB77D\uC73C\uB85C \uAC00\uB9CC\uD788
      \uC9DA\uC5B4\uBCF8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C \uC774\uB984\uC774 \uBD88\uB9AC\uBA74, \uC81C \uC55E\uB4A4\uB85C
      \uC5B4\uB5A4 \uAC00\uBB38\uC774 \uC11C\uB294\uC9C0 \uB2E4 \uC54C\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uBC8C\uC368 \uC21C\uC11C\uB97C \uB2E4 \uD30C\uC545\uD558\uC168\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0\uB370... \uC81C \uC774\uB984\uC774 \uBD88\uB9AC\uB294 \uC21C\uAC04\uC5D0
      \uBAA8\uB450\uAC00 \uC800\uB9CC \uCCD0\uB2E4\uBCF4\uACA0\uC8E0?"
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC544\uAC00\uC528\uAED8 \uC9D1\uC911\uD558\uB294 \uAC74 \uB2F9\uC5F0\uD55C
      \uC77C\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC2E4\uC218\uD558\uBA74 \uC548 \uB418\uB294\uB370. \uC790\uAFB8 \uADF8
      \uC7A5\uBA74\uC774 \uB5A0\uC62C\uB77C\uC11C \uBB34\uC11C\uC6CC\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC608\uBC95\uC11C\uB97C \uB36E\uC5C8\uC9C0\uB9CC,
      \uCC28\uAC00\uC6CC\uC9C4 \uC190\uC744 \uB4DC\uB808\uC2A4 \uC790\uB77D \uB4A4\uB85C
      \uC228\uACBC\uB2E4."
  _nemoLine: "\uC608\uBC95\uC11C\uC5D0\uB294 \uAC00\uBB38\uBCC4 \uC785\uC7A5 \uC21C\uC11C\uAC00
    \uBE7D\uBE7D\uD558\uAC8C \uC801\uD600 \uC788\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
