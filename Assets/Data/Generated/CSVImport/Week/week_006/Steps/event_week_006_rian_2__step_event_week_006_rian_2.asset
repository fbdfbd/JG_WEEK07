  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_rian_2__step_event_week_006_rian_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC624\uB298\uC740 \uC800\uB97C \uBD80\uB97C \uB54C \uC870\uAE08 \uC870\uC2EC\uD574
      \uC8FC\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC870\uC6A9\uD788 \uB9D0\uD558\uB77C\uB294 \uAC74\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB458\uC774 \uC788\uC744 \uB54C\uB294 \uAD1C\uCC2E\uC544\uC694. \uADF8\uB7F0\uB370
      \uC0AC\uB78C\uC774 \uB9CE\uC73C\uBA74 \uC544\uB2D0 \uC218\uB3C4 \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8 \uC774\uB984\uC774 \uBB38\uC81C\uAC00 \uB418\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC774\uB984\uBCF4\uB2E4, \uADF8 \uC774\uB984\uC744 \uB4E3\uB294 \uC0AC\uB78C\uB4E4\uC774
      \uBB38\uC81C\uC77C \uAC83 \uAC19\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB835\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB124. \uC800\uB3C4 \uC544\uC9C1 \uC5B4\uB824\uC6CC\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC18C\uB9E4 \uB05D\uC744 \uB9CC\uC84C\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uC544\uBCA8\uB9AC\uC544 \uC55E\uC5D0\uC11C\uB294
      \uB9AC\uC548\uC774\uACE0 \uC2F6\uC5B4\uC694."
  _nemoLine: "\uC624\uB298\uC740 \uC800\uB97C \uBD80\uB97C \uB54C \uC870\uAE08 \uC870\uC2EC\uD574
    \uC8FC\uC138\uC694."
  _useCustomVisualState: 0
  _visualState: 0
