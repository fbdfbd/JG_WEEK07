  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_max_1__step_event_week_006_max_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uD640. \uBB34\uB3C4\uD68C \uCD9C\uBC1C \uC804."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC7A5\uAC11 \uB080 \uC190\uC744 \uB0B4\uB824\uB2E4\uBCF4\uACE0
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uAE34\uC7A5\uB418\uC2ED\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC870\uAE08\uC694. \uB9C9\uC2A4\uB294\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB9CE\uC774 \uB429\uB2C8\uB2E4. \uC548 \uADF8\uB7F0 \uCC99\uD558\uB294
      \uC5F0\uC2B5\uC744 \uB9CE\uC774 \uD588\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0 \uAC83\uB3C4 \uC5F0\uC2B5\uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC21C\uC11C\uAC00 \uC624\uBA74 \uC81C\uAC00 \uBA3C\uC800 \uC190\uC744
      \uB0B4\uBC00\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uADF8\uB7FC \uC544\uBCA8\uB9AC\uC544\uAC00 \uBA3C\uC800 \uB9DD\uC124\uC774\uC9C0
      \uC54A\uC544\uB3C4 \uB418\uB2C8\uAE4C\uC694."
  _nemoLine: "\uBC31\uC791\uC800 \uD640. \uBB34\uB3C4\uD68C \uCD9C\uBC1C \uC804."
  _useCustomVisualState: 0
  _visualState: 0
