  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_excursion_forest_direct_defiant__step_event_week_006_excursion_forest_direct_defiant
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC544\uAC00\uC528, \uC624\uB298\uC740 \uC548\uCABD\uAE4C\uC9C0\uB294
      \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uACBD\uBE44 \uAD50\uB300\uAC00 \uC788\uC5B4\uC11C \uC7A0\uC2DC \uD1B5\uC81C
      \uC911\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uAC00 \uB4E4\uC5B4\uAC00\uB294 \uAC8C \uACBD\uBE44 \uAD50\uB300\uB791
      \uBB34\uC2A8 \uC0C1\uAD00\uC774\uC8E0?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC808\uCC28\uC0C1\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098\uB294 \uBC31\uC791\uAC00 \uC0AC\uB78C\uC774\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC544\uAC00\uC528, \uC624\uB298\uC740 \uBB34\uB3C4\uD68C\uB3C4 \uC788\uC73C\uC2DC\uACE0\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC8C \uC9C0\uAE08 \uC232\uC774\uB791 \uBB34\uC2A8 \uC0C1\uAD00\uC774\uC8E0?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC544\uAC00\uC528, \uC624\uB298\uC740 \uC785\uAD6C \uCABD\uB9CC \uB458\uB7EC\uBCF4\uC2DC\uC8E0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC54C\uACA0\uC5B4\uC694."
  _nemoLine: "\uC544\uAC00\uC528, \uC624\uB298\uC740 \uC548\uCABD\uAE4C\uC9C0\uB294
    \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
