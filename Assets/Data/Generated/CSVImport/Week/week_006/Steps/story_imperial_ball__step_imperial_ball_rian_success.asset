--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_imperial_ball__step_imperial_ball_rian_success
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD669\uC2E4 \uC2DC\uC885\uC774 \uB9AC\uC548\uC5D0\uAC8C \uB2E4\uAC00\uC640
      \uB0AE\uAC8C \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 2af885eedf1120f4ebe3ea9e3df21afd, type: 2}
    _text: "\uB9AC\uC548 \uC5D8\uBC14\uB860 \uB2D8, \uC774\uCABD\uC73C\uB85C \uC624\uC2DC\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC7A0\uAE50 \uBA48\uCDC4\uB2E4\uAC00 \uC2DC\uC885\uC744
      \uB530\uB77C\uAC00\uB824 \uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uC774\uB984\uC744 \uB4E3\uACE0
      \uB9AC\uC548\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5D8\uBC14\uB860\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uAC78\uC74C\uC744 \uBA48\uCDC4\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC624\uB298\uC740 \uADF8\uB807\uAC8C \uBD88\uB824\uC57C \uD558\uB098
      \uBD10\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uB294 \uBB50\uB77C\uACE0 \uBD80\uB974\uBA74 \uB3FC\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uBC14\uB85C \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB458\uC774 \uC788\uC744 \uB54C\uB294\u2026 \uB9AC\uC548\uC774\uBA74
      \uC88B\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uC9C0\uAE08\uC740 \uB9AC\uC548\uC774\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC544\uC8FC \uC791\uAC8C \uC6C3\uC5C8\uB2E4."
  _nemoLine: "\uD669\uC2E4 \uC2DC\uC885\uC774 \uB9AC\uC548\uC5D0\uAC8C \uB2E4\uAC00\uC640
    \uB0AE\uAC8C \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
