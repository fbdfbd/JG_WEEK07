  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298 \uC232 \uAC00\uB3C4 \uB418\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC624\uB298\uC740 \uBB34\uB3C4\uD68C \uC900\uBE44\uAC00 \uC788\uC5B4\uC11C
      \uCC44\uBE44\uB97C \uC77C\uCC0D \uC2DC\uC791\uD574\uC57C \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uC9C1 \uC2DC\uAC04 \uB9CE\uC774 \uB0A8\uC558\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uBA38\uB9AC \uC190\uC9C8\uBD80\uD130 \uC2DC\uC791\uD574\uC57C \uD574\uC11C\uC694.
      \uC5BC\uB978 \uB3CC\uC544\uAC00\uC2DC\uC8E0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC232\uC740 \uC7A0\uAE50\uC778\uB370."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC544\uAC00\uC528 \uC624\uB298\uB9CC\uD07C\uC740 \uCC38\uC544\uC8FC\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC54C\uACA0\uC5B4\uC694."
  _nemoLine: "\uC624\uB298 \uC232 \uAC00\uB3C4 \uB418\uB098\uC694?"
