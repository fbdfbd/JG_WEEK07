  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_imperial_ball__step_imperial_ball_rian_fail
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD669\uC2E4 \uC2DC\uC885\uC774 \uB9AC\uC548\uC5D0\uAC8C \uB2E4\uAC00\uC640
      \uB0AE\uAC8C \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 2af885eedf1120f4ebe3ea9e3df21afd, type: 2}
    _text: "\uC5D8\uBC14\uB860 \uB2D8, \uC774\uCABD\uC73C\uB85C \uC624\uC2DC\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC7A0\uAE50 \uBA48\uCDC4\uB2E4\uAC00 \uC2DC\uC885\uC744
      \uB530\uB77C\uAC14\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uC774\uB984\uC744 \uB4E4\uC5C8\uC9C0\uB9CC
      \uBB3B\uC9C0 \uBABB\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uD669\uC2E4 \uC0AC\uB78C\uB4E4 \uC0AC\uC774\uB85C
      \uB4E4\uC5B4\uAC14\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uC774\uB984\uC774
      \uC65C \uB9AC\uC548\uC5D0\uAC8C \uBD99\uC5C8\uB294\uC9C0 \uC54C \uC218 \uC5C6\uC5C8\uB2E4."
  _nemoLine: "\uD669\uC2E4 \uC2DC\uC885\uC774 \uB9AC\uC548\uC5D0\uAC8C \uB2E4\uAC00\uC640
    \uB0AE\uAC8C \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
