  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_excursion_garden_blocked__step_event_week_006_excursion_garden_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBE44\uC11C\uAC00 \uB4DC\uB808\uC2A4 \uAC00\uBD09\uC744 \uBC14\uB78C\uC774
      \uAC15\uD558\uB2E4\uB294 \uC774\uC720\uB85C \uC815\uC6D0\uC5D0\uC11C \uD558\uC9C0
      \uC54A\uAE30\uB85C \uD588\uB2E4.  \uAC00\uBD09\uC740 \uC544\uBCA8\uB9AC\uC544\uC758
      \uBC29\uC5D0\uC11C \uC774\uB8E8\uC5B4\uC84C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC29\uC758 \uAC70\uC6B8\uC740 \uC791\uC558\uB2E4. \uC5BC\uAD74\uC744
      \uBCF4\uBA74 \uB4DC\uB808\uC2A4 \uC790\uB77D\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC558\uACE0,
      \uB4DC\uB808\uC2A4\uB97C \uBCF4\uBA74 \uC5BC\uAD74\uC774 \uBCF4\uC774\uC9C0
      \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBA54\uC774."
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uB124."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC815\uC6D0 \uAC70\uC6B8\uC774 \uB354 \uCEF8\uC8E0."
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\u2026\uB124."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298\uC740 \uADF8 \uAC70\uC6B8 \uBABB \uBCF4\uB294 \uAC70\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uC774\uBBF8 \uCE58\uC6E0\uC744 \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298 \uB0B4\uAC00 \uC5B4\uB5BB\uAC8C \uBCF4\uC77C\uC9C0\uB294,
      \uC624\uB298 \uBC24\uC5D0\uC57C \uC54C\uACA0\uB124\uC694."
  _nemoLine: "\uBE44\uC11C\uAC00 \uB4DC\uB808\uC2A4 \uAC00\uBD09\uC744 \uBC14\uB78C\uC774
    \uAC15\uD558\uB2E4\uB294 \uC774\uC720\uB85C \uC815\uC6D0\uC5D0\uC11C \uD558\uC9C0
    \uC54A\uAE30\uB85C \uD588\uB2E4.  \uAC00\uBD09\uC740 \uC544\uBCA8\uB9AC\uC544\uC758
    \uBC29\uC5D0\uC11C \uC774\uB8E8\uC5B4\uC84C\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
