--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_excursion_garden_direct_clever__step_event_week_006_excursion_garden_direct_clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00-\uC601\uBBFC"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC70\uC6B8 \uC55E\uC5D0 \uC11C\uC11C
      \uC790\uC2E0\uC758 \uBAB8\uC744 \uBC1C\uB05D \uBD80\uD130 \uBA38\uB9AC\uAE4C\uC9C0
      \uD6D1\uC5B4\uBD24\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBA54\uC774."
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uB124."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774 \uB4DC\uB808\uC2A4, \uD5C8\uB9AC\uC120\uC774 \uD55C\uCABD\uC774
      \uC870\uAE08 \uB192\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uB124?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC67C\uCABD\uC774 \uC624\uB978\uCABD\uBCF4\uB2E4 \uD55C \uBF18 \uC815\uB3C4
      \uB354 \uC62C\uB77C\uAC00 \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBA54\uC774\uB294 \uAC00\uAE4C\uC774 \uB2E4\uAC00\uC640 \uB4DC\uB808\uC2A4\uB97C
      \uC0B4\uD3C8\uB2E4. \uADF8\uB9AC\uACE0 \uC791\uAC8C \uC228\uC744 \uB4E4\uC774\uB9C8\uC168\uB2E4."
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uC815\uB9D0\uC774\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC7AC\uBD09\uC0AC \uBD80\uB97C\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uC9C0\uAE08 \uBD80\uB974\uBA74 \uB2E4\uC2DC \uC190\uB300\uAE30\uC5D4
      \uC2DC\uAC04\uC774 \uBAA8\uC790\uB985\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uC800 \uCABD\uC73C\uB85C \uC11C\uBA74 \uD2F0\uAC00 \uC548
      \uB0A0 \uAC70\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uC5B4\uB290 \uCABD\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB978\uCABD \uC5B4\uAE68\uB97C \uC55E\uC73C\uB85C \uBC18 \uBC1C\uC9DD.
      \uADF8\uB7EC\uBA74 \uC67C\uCABD \uD5C8\uB9AC\uAC00 \uAC00\uB824\uC838\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC9C1\uC811 \uC790\uC138\uB97C \uC7A1\uC544
      \uBCF4\uC600\uB2E4. \uAC70\uC6B8 \uC18D\uC758 \uB4DC\uB808\uC2A4\uB294 \uAC10\uCABD\uAC19\uC774
      \uADE0\uD615 \uC7A1\uD600 \uBCF4\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uC544\uAC00\uC528, \uC5B8\uC81C \uC774\uB7F0 \uAC78 \uB2E4 \uBCF4\uC2DC\uB294
      \uAC70\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC70\uC6B8\uC774 \uC788\uC73C\uB2C8\uAE4C\uC694,  \uAC70\uC6B8\uC740
      \uAC70\uC9D3\uB9D0\uC744 \uC548 \uD574\uC694."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC70\uC6B8 \uC55E\uC5D0 \uC11C\uC11C
    \uC790\uC2E0\uC758 \uBAB8\uC744 \uBC1C\uB05D \uBD80\uD130 \uBA38\uB9AC\uAE4C\uC9C0
    \uD6D1\uC5B4\uBD24\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
