--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_millia_blocked__step_event_week_006_millia_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uBB34\uB3C4\uD68C \uB4A4 \uD30C\uD2F0
      \uCC38\uC11D\uC790 \uBA85\uB2E8\uC774 \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBB34\uB3C4\uD68C\uAC00 \uB05D\uB09C \uB4A4\uC5D0\uB294 \uBCA0\uB974\uB514\uC544
      \uC0C1\uB2E8\uC758 \uD30C\uD2F0\uAC00 \uC608\uC815\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD30C\uD2F0\uB3C4 \uC678\uC6CC\uC57C \uD574\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC0AC\uB78C\uC744 \uC54C\uC544\uB450\uC2DC\uB294 \uD3B8\uC774 \uC88B\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774 \uC0AC\uB78C\uC740 \uB204\uAD6C\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC0C1\uB2E8\uACFC \uAC70\uB798\uAC00 \uB9CE\uC740 \uADC0\uC871\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC88B\uC740 \uC0AC\uB78C\uC774\uC5D0\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC88B\uC740 \uC0AC\uB78C\uC778\uC9C0\uBCF4\uB2E4, \uC5B4\uB5A4 \uAD00\uACC4\uC778\uC9C0\uAC00
      \uC911\uC694\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBA85\uB2E8 \uC704\uC758 \uC774\uB984\uB4E4\uC744
      \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0AC\uB78C \uC774\uB984\uC778\uB370, \uBB3C\uAC74 \uC124\uBA85 \uAC19\uC544\uC694."
  _nemoLine: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uBB34\uB3C4\uD68C \uB4A4 \uD30C\uD2F0
    \uCC38\uC11D\uC790 \uBA85\uB2E8\uC774 \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
