  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uBB34\uB3C4\uD68C\uB3C4 \uC788\uC73C\uB2C8\uAE4C\uC694. \uC624\uB298\uC740
