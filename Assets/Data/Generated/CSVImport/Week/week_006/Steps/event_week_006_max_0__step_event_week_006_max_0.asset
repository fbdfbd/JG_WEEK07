MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_max_0__step_event_week_006_max_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uC751\uC811\uC2E4. \uBB34\uB3C4\uD68C \uC804."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBD09\uC2E0\uAC00\uBB38\uC5D0\uC11C \uBCF4\uB0B8 \uD30C\uD2B8\uB108
      \uC2E0\uCCAD\uC11C\uAC00 \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC5EC \uC788\uC5C8\uB2E4.
      \uB9C9\uC2A4\uB294 \uADF8 \uC606\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC548\uB155\uD558\uC138\uC694. \uB9C9\uC2A4 \uBC1C\uD14C\uB9AC\uC628\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uB155\uD558\uC138\uC694, \uC544\uBA5C\uB9AC\uC544\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC624\uB298\uC740 \uC815\uB9D0 \uADF8\uB798\uC57C \uD560 \uAC83 \uAC19\uC544\uC11C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD30C\uD2B8\uB108 \uC2E0\uCCAD\uC11C\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB124. \uAC00\uBB38\uC5D0\uC11C \uACF5\uC2DD\uC73C\uB85C \uC62C\uB9B0
      \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C9\uC2A4\uB3C4 \uADF8\uB807\uAC8C \uC11C\uC57C \uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB124. \uC624\uB298\uC740 \uBC1C\uD14C\uB9AC\uC628\uAC00\uBB38 \uB300\uD45C\uB85C
      \uC11C\uAC8C \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC7A0\uAE50 \uB9D0\uC744 \uBA48\uCDC4\uB2E4\uAC00
      \uB367\uBD99\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uBD88\uD3B8\uD558\uBA74 \uB9D0\uD574 \uC8FC\uC138\uC694.
      \uADF8\uAC74 \uAC00\uBB38 \uB9D0\uACE0 \uC81C\uAC00 \uB4E3\uACE0 \uC2F6\uC5B4\uC694."
  _nemoLine: "\uBC31\uC791\uC800 \uC751\uC811\uC2E4. \uBB34\uB3C4\uD68C \uC804."
  _useCustomVisualState: 0
  _visualState: 0
