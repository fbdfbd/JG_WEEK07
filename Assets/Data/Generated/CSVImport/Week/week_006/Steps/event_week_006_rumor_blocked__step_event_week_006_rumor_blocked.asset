  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_rumor_blocked__step_event_week_006_rumor_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBE44\uC11C\uAC00 \uC88C\uC11D\uD45C\uB97C \uC811\uACE0 \uC788\uC5C8\uB2E4.
      \uC544\uBCA8\uB9AC\uC544\uAC00 \uB4E4\uC5B4\uC624\uC790 \uC190\uC744 \uBA48\uCDC4\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD669\uC2E4 \uC88C\uC11D \uB2E4 \uC815\uD574\uC84C\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uC608. \uC774\uBBF8 \uD1B5\uBCF4 \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBCF4\uC5EC\uC8FC\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uD669\uC2E4 \uC790\uB9AC\uB294 \uB530\uB85C \uBCF4\uC2E4 \uD544\uC694
      \uC5C6\uC2B5\uB2C8\uB2E4. \uC544\uAC00\uC528 \uC790\uB9AC\uB9CC \uC54C\uACE0
      \uACC4\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB798\uB3C4"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uBB34\uB3C4\uD68C\uB294 \uBCF4\uACE0 \uB4E3\uB294 \uC790\uB9AC\uC774\uC9C0,
      \uBBF8\uB9AC \uB530\uC9C0\uB294 \uC790\uB9AC\uAC00 \uC544\uB2D9\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB798\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uC608. \uB2F9\uC77C \uC798 \uBCF4\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C\uACA0\uC5B4\uC694..."
  _nemoLine: "\uBE44\uC11C\uAC00 \uC88C\uC11D\uD45C\uB97C \uC811\uACE0 \uC788\uC5C8\uB2E4.
    \uC544\uBCA8\uB9AC\uC544\uAC00 \uB4E4\uC5B4\uC624\uC790 \uC190\uC744 \uBA48\uCDC4\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
