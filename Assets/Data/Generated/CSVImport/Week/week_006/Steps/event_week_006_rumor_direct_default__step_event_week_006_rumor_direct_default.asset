--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_rumor_direct_default__step_event_week_006_rumor_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC18C\uBB38 \uD5C8\uAC00"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBE44\uC11C\uAC00 \uD669\uC2E4 \uC88C\uC11D\uD45C\uB97C \uD3BC\uCCD0\uB193\uACE0
      \uC788\uC5C8\uB2E4. \uC544\uBCA8\uB9AC\uC544\uAC00 \uC606\uC5D0 \uC640\uC11C
      \uB4E4\uC5EC\uB2E4\uBD24\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC70 \uD669\uC2E4 \uC88C\uC11D\uC774\uC5D0\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uC608. \uC815\uC2DD \uBC30\uCE58\uB3C4\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD669\uC871 \uC790\uB9AC\uAC00 \uC5EC\uC12F \uAC1C\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\u2026\uC77C\uACF1 \uAC1C\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC77C\uACF1\uC774\uC694? \uD55C \uC790\uB9AC\uB294 \uBE44\uC5B4 \uC788\uB294\uB370."
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uBE44\uC5B4 \uC788\uB294 \uAC8C \uC544\uB2D9\uB2C8\uB2E4. \uC774\uB984\uC774
      \uC801\uD600 \uC788\uC9C0 \uC54A\uC744 \uBFD0\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC774\uB984\uC774 \uC5C6\uB294\uB370 \uC790\uB9AC\uAC00 \uC788\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uC608."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uC549\uC744 \uC790\uB9AC\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uADF8\uAC74 \uC801\uD600 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBE44\uC11C\uB2D8\uC740 \uC9D0\uC791\uB3C4 \uC548 \uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\u2026\uC9D0\uC791\uC740 \uC9D0\uC791\uC77C \uBFD0\uC785\uB2C8\uB2E4,
      \uC544\uAC00\uC528. \uB9D0\uC500\uB4DC\uB9AC\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uADF8\uB0A0 \uAC00\uC11C \uBCF4\uBA74 \uC54C\uACA0\uB124\uC694."
  _nemoLine: "\uBE44\uC11C\uAC00 \uD669\uC2E4 \uC88C\uC11D\uD45C\uB97C \uD3BC\uCCD0\uB193\uACE0
    \uC788\uC5C8\uB2E4. \uC544\uBCA8\uB9AC\uC544\uAC00 \uC606\uC5D0 \uC640\uC11C
    \uB4E4\uC5EC\uB2E4\uBD24\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
