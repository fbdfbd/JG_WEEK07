  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC815\uC6D0\uC5D0 \uB193\uC778 \uAE34 \uAC70\uC6B8\uC744 \uBCF4\uACE0
