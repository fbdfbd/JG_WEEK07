--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_excursion_garden_direct_defiant__step_event_week_006_excursion_garden_direct_defiant
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00-\uBC18\uD56D"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC70\uC6B8 \uC55E\uC5D0\uC11C \uD314\uC744
      \uC774\uB9AC\uC800\uB9AC \uC6C0\uC9C1\uC5EC \uBCF8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB4DC\uB808\uC2A4 \uC5B4\uAE68 \uBD80\uBD84\uC774 \uD33D\uD33D\uD558\uAC8C
      \uB2F9\uACA8\uC9C0\uBA70 \uC8FC\uB984\uC774 \uC7A1\uD78C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBA54\uC774, \uC7AC\uBD09\uC0AC\uAC00 \uCE58\uC218\uB97C \uC798\uBABB
      \uC7B0 \uAC83 \uAC19\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uADF8\uB7F4 \uB9AC\uAC00\uC694. \uC9C0\uB09C\uC8FC\uC5D0 \uC9C1\uC811
      \uC7AC\uACE0 \uAC00\uC168\uB294\uAC78\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC77C\uC8FC\uC77C \uB9CC\uC5D0 \uC81C \uC5B4\uAE68\uAC00 \uC774\uB807\uAC8C
      \uB113\uC5B4\uC9C8 \uB9AC \uC5C6\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uC637\uC774 \uC870\uAE08 \uB07C\uC2DC\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC7AC\uBD09\uC0AC\uAC00 \uC878\uC558\uAC70\uB098, \uC81C \uBAB8\uC774
      \uC544\uB2C8\uB77C \uC790\uAE30\uAC00 \uC785\uACE0 \uC2F6\uC740 \uB300\uB85C
      \uB9CC\uB4E4\uC5C8\uB098 \uBD10\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC70\uC6B8 \uC18D \uC790\uC2E0\uC758
      \uC5B4\uAE68\uC120\uC744 \uC190\uAC00\uB77D\uC73C\uB85C \uC9DA\uC73C\uBA70
      \uC778\uC0C1\uC744 \uCC0C\uD478\uB9B0\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4\uC74C\uC5D4 \uC81C\uAC00 \uC9C1\uC811 \uC7B0 \uC22B\uC790\uB97C
      \uC904 \uAC70\uC608\uC694. \uADF8\uAC8C \uD6E8\uC52C \uC815\uD655\uD560 \uD14C\uB2C8\uAE4C."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC70\uC6B8 \uC55E\uC5D0\uC11C \uD314\uC744
    \uC774\uB9AC\uC800\uB9AC \uC6C0\uC9C1\uC5EC \uBCF8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
