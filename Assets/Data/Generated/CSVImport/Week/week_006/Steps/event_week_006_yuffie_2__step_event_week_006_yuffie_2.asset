  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_yuffie_2__step_event_week_006_yuffie_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC624\uB298 \uBD88\uD3B8\uD558\uBA74 \uC2E0\uD638\uB97C \uC815\uD574
      \uB450\uB294 \uAC8C \uC88B\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC2E0\uD638\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uB9D0\uB85C \uD558\uAE30 \uC5B4\uB824\uC6B8 \uC218\uB3C4 \uC788\uC73C\uB2C8\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC190\uC218\uAC74 \uB05D\uC744 \uC0B4\uC9DD \uB9CC\uC84C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC774\uB807\uAC8C \uD558\uBA74 \uC790\uB9AC\uB97C \uC62E\uAE30\uC790\uB294
      \uB73B\uC73C\uB85C \uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC720\uD53C\uAC00 \uC54C\uC544\uBCFC \uC218 \uC788\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uACC4\uC18D \uBCFC\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACC4\uC18D \uBCF4\uBA74 \uC720\uD53C\uB3C4 \uD798\uB4E4\uC9C0 \uC54A\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uAD1C\uCC2E\uC544\uC694. \uC800\uB3C4 \uB204\uAC00 \uC54C\uC544\uBD10
      \uC8FC\uBA74 \uC88B\uC744 \uB54C\uAC00 \uC788\uC73C\uB2C8\uAE4C\uC694."
  _nemoLine: "\uC624\uB298 \uBD88\uD3B8\uD558\uBA74 \uC2E0\uD638\uB97C \uC815\uD574
    \uB450\uB294 \uAC8C \uC88B\uACA0\uC5B4\uC694."
  _useCustomVisualState: 0
  _visualState: 0
