  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_imperial_ball__step_imperial_ball_yuffie_success
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD55C \uADC0\uC871 \uBD80\uC778\uC774 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
      \uB2E4\uAC00\uC640 \uBD80\uB4DC\uB7FD\uAC8C \uC6C3\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c8695888329edac49b5385c0e157a3e9, type: 2}
    _text: "\uC624\uB298 \uBB34\uB3C4\uD68C\uB294 \uB9C8\uC74C\uC5D0 \uB4DC\uC2DC\uB098\uC694,
      \uC544\uAC00\uC528?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9D0\uC740 \uAC00\uBCBC\uC6E0\uC9C0\uB9CC, \uC8FC\uBCC0\uC758 \uC2DC\uC120\uC774
      \uD568\uAED8 \uB530\uB77C\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uAC00 \uBA40\uB9AC\uC11C \uCC3B\uC794\uC744 \uCC9C\uCC9C\uD788
      \uB0B4\uB824\uB193\uC558\uB2E4. \uBBF8\uB9AC \uC815\uD55C \uC2E0\uD638\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uC9C1\uC740 \uC798 \uBAA8\uB974\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: c8695888329edac49b5385c0e157a3e9, type: 2}
    _text: "\uBAA8\uB974\uACA0\uB2E4?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB124. \uCC98\uC74C \uC628 \uC790\uB9AC\uB77C\uC11C, \uC870\uAE08 \uB354
      \uBCF4\uACE0 \uC2F6\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uADC0\uC871 \uBD80\uC778\uC740 \uC7A0\uC2DC \uC544\uBCA8\uB9AC\uC544\uB97C
      \uBCF4\uB2E4\uAC00 \uC6C3\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c8695888329edac49b5385c0e157a3e9, type: 2}
    _text: "\uC2E0\uC911\uD558\uC2DC\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC791\uAC8C \uC228\uC744 \uB0B4\uC26C\uC5C8\uB2E4."
  _nemoLine: "\uD55C \uADC0\uC871 \uBD80\uC778\uC774 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
    \uB2E4\uAC00\uC640 \uBD80\uB4DC\uB7FD\uAC8C \uC6C3\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
