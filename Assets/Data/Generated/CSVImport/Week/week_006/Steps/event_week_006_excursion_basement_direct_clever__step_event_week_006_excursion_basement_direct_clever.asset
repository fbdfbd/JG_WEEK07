  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_excursion_basement_direct_clever__step_event_week_006_excursion_basement_direct_clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC190\uC218\uAC74\uC740 \uB0A1\uC558\uC9C0\uB9CC, \uC811\uD78C \uBAA8\uC591\uC740
      \uBE44\uAD50\uC801 \uD750\uD2B8\uB7EC\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC790\uC218\uAC00 \uC788\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608. \uAF43\uBB34\uB2AC\uC778 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC70\uC758 \uC9C0\uC6CC\uC84C\uB294\uB370\uB3C4 \uB0A8\uC544 \uC788\uB294
      \uAC78 \uBCF4\uBA74, \uAF64 \uC815\uC131 \uB4E4\uC5EC \uC218\uB193\uC558\uB098
      \uBD10\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uADF8\uB7F4 \uC218\uB3C4 \uC788\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB798\uB41C \uBB3C\uAC74\uC744 \uBCF4\uBA74 \uC774\uC0C1\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC5B4\uB5A4 \uC810\uC774 \uADF8\uB7EC\uC2ED\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9D0\uC740 \uC548 \uD558\uB294\uB370, \uBB3C\uAC74\uC774 \uC8FC\uC778\uC744
      \uC124\uBA85\uD574\uC918\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "...\uC798 \uBCF4\uC2DC\uB294\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB798\uC11C \uB354 \uC870\uC2EC\uD788 \uB2E4\uB904\uC57C\uACA0\uB2E4\uB294
      \uC0DD\uAC01\uC774 \uB4E4\uC5B4\uC694."
  _nemoLine: "\uC190\uC218\uAC74\uC740 \uB0A1\uC558\uC9C0\uB9CC, \uC811\uD78C \uBAA8\uC591\uC740
    \uBE44\uAD50\uC801 \uD750\uD2B8\uB7EC\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
