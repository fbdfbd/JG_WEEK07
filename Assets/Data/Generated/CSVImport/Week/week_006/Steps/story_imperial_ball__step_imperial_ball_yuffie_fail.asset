  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_imperial_ball__step_imperial_ball_yuffie_fail
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD55C \uADC0\uC871 \uBD80\uC778\uC774 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
      \uB2E4\uAC00\uC640 \uBD80\uB4DC\uB7FD\uAC8C \uC6C3\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: bb92d18cb19ba9944ac71077eb8aa4c5, type: 2}
    _text: "\uC624\uB298 \uBB34\uB3C4\uD68C\uB294 \uB9C8\uC74C\uC5D0 \uB4DC\uC2DC\uB098\uC694,
      \uC544\uAC00\uC528?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9D0\uC740 \uAC00\uBCBC\uC6E0\uC9C0\uB9CC, \uC8FC\uBCC0\uC758 \uC2DC\uC120\uC774
      \uD568\uAED8 \uB530\uB77C\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC14\uB85C \uB300\uB2F5\uD558\uC9C0
      \uBABB\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uCC98\uC74C \uC624\uC2E0 \uC790\uB9AC\uB77C, \uC544\uC9C1 \uB458\uB7EC\uBCF4\uACE0
      \uACC4\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uAC00 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB300\uC2E0 \uB9D0\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uADC0\uC871 \uBD80\uC778\uC740 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uACE0,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8\uC81C\uC57C \uC791\uAC8C \uC228\uC744
      \uC26C\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uACE0\uB9C8\uC6CC\uC694."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uAD1C\uCC2E\uC544\uC694. \uC774\uB7F0 \uB9D0\uC740 \uCC9C\uCC9C\uD788
      \uB300\uB2F5\uD574\uB3C4 \uB3FC\uC694."
  _nemoLine: "\uD55C \uADC0\uC871 \uBD80\uC778\uC774 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
    \uB2E4\uAC00\uC640 \uBD80\uB4DC\uB7FD\uAC8C \uC6C3\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
