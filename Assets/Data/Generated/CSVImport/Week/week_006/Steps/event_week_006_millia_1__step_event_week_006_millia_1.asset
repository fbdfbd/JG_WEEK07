  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_006_millia_1__step_event_week_006_millia_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uC791\uC740 \uBA85\uB2E8\uC744 \uD3BC\uCCD0
      \uB193\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC774 \uC0AC\uB78C\uC740 \uC778\uC0AC\uD574\uB3C4 \uB3FC\uC694. \uC774
      \uC0AC\uB78C\uC740 \uC624\uB798 \uB9D0\uD558\uC9C0 \uC54A\uB294 \uAC8C \uC88B\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC6C3\uC73C\uBA74\uC11C \uBE5A \uC774\uC57C\uAE30\uB97C \uAEBC\uB0B4\uB294
      \uC0AC\uB78C\uC774\uB798\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC6C3\uC73C\uBA74\uC11C\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB124. \uADF8\uB798\uC11C \uB354 \uC870\uC2EC\uD574\uC57C \uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uC774\uB984 \uBA87 \uAC1C\uC5D0 \uC791\uAC8C
      \uD45C\uC2DC\uB97C \uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC800\uB294 \uC544\uBE60 \uC606\uC5D0\uC11C \uC774\uB7F0 \uAC78 \uB9CE\uC774
      \uBD24\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB3C4 \uC2EB\uC5B4\uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC2EB\uB2E4\uAE30\uBCF4\uB2E4\uB294 \uD53C\uACE4\uD574\uC694. \uB3C8
      \uC774\uC57C\uAE30\uD558\uB294 \uC5B4\uB978\uB4E4\uC740 \uB05D\uC774 \uC5C6\uAC70\uB4E0\uC694."
  _nemoLine: "\uBC00\uB9AC\uC544\uB294 \uC791\uC740 \uBA85\uB2E8\uC744 \uD3BC\uCCD0
    \uB193\uC558\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
