  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_inheritance_ceremony__step_inheritance_ceremony_rian_success
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD669\uC2E4 \uC0AC\uC808\uC774 \uC55E\uC73C\uB85C \uB098\uC654\uB2E4.
      \uADF8\uC758 \uB4A4\uC5D0\uB294 \uB9AC\uC548\uC774 \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD669\uC2E4 \uBB38\uC7A5\uC774 \uCC0D\uD78C \uC11C\uC2E0\uC774 \uD3BC\uCCD0\uC84C\uB2E4."
  - _speaker: {fileID: 11400000, guid: bb92d18cb19ba9944ac71077eb8aa4c5, type: 2}
    _text: "\uD669\uC2E4\uC740 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uBC31\uC791\uAC00\uC758
      \uC815\uB2F9\uD55C \uACC4\uC2B9\uC744 \uC778\uC815\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD640 \uC548\uC774 \uC870\uC6A9\uD574\uC84C\uB2E4. \uAE30\uC0AC\uAC00\uBB38
      \uCABD\uC5D0\uC11C \uB0AE\uC740 \uC6C5\uC131\uAC70\uB9BC\uC774 \uC77C\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC774 \uACC4\uC2B9\uC740 \uC544\uBCA8\uB9AC\uC544 \uBCF8\uC778\uC758
      \uD798\uC73C\uB85C \uC774\uB8E8\uC5B4\uC9C4 \uAC83\uC784\uC744 \uC120\uC5B8\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC758 \uC2DC\uC120\uC744
      \uB9C8\uC8FC\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB124. \uC774 \uC790\uB9AC\uB294 \uC81C\uAC00 \uC11C\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC791\uAC8C \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
  _nemoLine: "\uD669\uC2E4 \uC0AC\uC808\uC774 \uC55E\uC73C\uB85C \uB098\uC654\uB2E4.
    \uADF8\uC758 \uB4A4\uC5D0\uB294 \uB9AC\uC548\uC774 \uC11C \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
