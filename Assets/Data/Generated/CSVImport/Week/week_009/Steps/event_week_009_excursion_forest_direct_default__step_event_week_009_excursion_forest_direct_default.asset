  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5EC\uAE30 \uB364\uBD88\uC774 \uCE58\uC6CC\uC84C\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC815\uBE44\uAC00 \uB410\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uCABD\uC73C\uB85C \uAC00\uB3C4 \uB418\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\u2026\uC608."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5EC\uAE34 \uC5B4\uB5A4 \uACF3\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC5B4\uBA38\uB2D8\uAED8\uC11C \uC7A0\uB4E4\uC5B4 \uACC4\uC2E0 \uC790\uB9AC\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uADF8\uB807\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB3CC \uC55E\uC5D0\uC11C \uD55C\uCC38
      \uC11C \uC788\uC5C8\uB2E4. \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC00\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC608, \uC544\uAC00\uC528."
  _nemoLine: "\uC5EC\uAE30 \uB364\uBD88\uC774 \uCE58\uC6CC\uC84C\uB124\uC694."
