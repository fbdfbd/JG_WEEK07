  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_garden_direct_default__step_event_week_009_excursion_garden_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC11C\uC57D\uB300\uB294 \uD06C\uB808\uC774\uD504 \uBA38\uD2C0 \uBC14\uB85C
      \uC544\uB798\uC5D0 \uC138\uC6CC\uC838 \uC788\uC5C8\uB2E4. \uC78E \uC0AC\uC774\uB85C
      \uB4E0 \uD587\uC0B4\uC774 \uB2E8\uC0C1 \uC704\uC5D0 \uC587\uAC8C \uAE54\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB2E8\uC0C1 \uC55E\uC5D0 \uC11C\uC11C,
      \uC758\uC2DD\uC758 \uC21C\uC11C\uB97C \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC
      \uD55C \uBC88 \uB5A0\uC62C\uB838\uB2E4. \uCCAB \uC808\uC740 \uAC00\uC6B4\uB370\uB85C,
      \uC190\uC740 \uB2E8\uC0C1 \uC704\uC5D0, \uC2DC\uC120\uC740 \uC815\uBA74."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "...\uB410\uC5B4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB2E8\uC0C1 \uC704\uC5D0 \uB450 \uC190\uC744
      \uAC00\uC9C0\uB7F0\uD788 \uC5B9\uC5C8\uB2E4."
  _nemoLine: "\uC11C\uC57D\uB300\uB294 \uD06C\uB808\uC774\uD504 \uBA38\uD2C0 \uBC14\uB85C
    \uC544\uB798\uC5D0 \uC138\uC6CC\uC838 \uC788\uC5C8\uB2E4. \uC78E \uC0AC\uC774\uB85C
    \uB4E0 \uD587\uC0B4\uC774 \uB2E8\uC0C1 \uC704\uC5D0 \uC587\uAC8C \uAE54\uB838\uB2E4."
