--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_rian_4__step_event_week_009_rian_4
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uD669\uC2E4 \uC608\uBCF5\uC744 \uB2E4 \uAC16\uCD94\uACE0
      \uC788\uC5C8\uB2E4. \uD718\uC7A5\uAE4C\uC9C0 \uB450\uB978 \uBAA8\uC2B5\uC740
      \uB354 \uC774\uC0C1 \uC228\uACA8\uC9C4 \uC0AC\uB78C\uCC98\uB7FC \uBCF4\uC774\uC9C0
      \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC624\uB298, \uD669\uC2E4 \uB300\uD45C\uB85C \uC11C\uB294 \uAC74 \uC815\uD574\uC84C\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C\uACE0 \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uD558\uC9C0\uB9CC \uC81C\uAC00 \uBB34\uC2A8 \uB9D0\uC744 \uD560\uC9C0\uB294
      \uC81C\uAC00 \uC815\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uB97C \uB611\uBC14\uB85C
      \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uC758 \uACC4\uC2B9\uC744 \uACF5\uC2DD\uC801\uC73C\uB85C
      \uC9C0\uC9C0\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uD669\uC2E4 \uC774\uB984\uC73C\uB85C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9AC\uC548\uC5D0\uAC8C \uC704\uD5D8\uD55C \uC77C \uC544\uB2CC\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC870\uAE08\uC740\uC694. \uADF8\uB798\uB3C4 \uD53C\uD558\uACE0 \uC2F6\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC7A0\uAE50 \uC6C3\uC5C8\uB2E4. \uCC98\uC74C\uBCF4\uB2E4
      \uC870\uAE08 \uD3B8\uD55C \uC5BC\uAD74\uC774\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uBCF8\uC2DD\uC5D0\uC11C \uBD59\uACA0\uC2B5\uB2C8\uB2E4, \uC544\uBCA8\uB9AC\uC544."
  _nemoLine: "\uB9AC\uC548\uC740 \uD669\uC2E4 \uC608\uBCF5\uC744 \uB2E4 \uAC16\uCD94\uACE0
    \uC788\uC5C8\uB2E4. \uD718\uC7A5\uAE4C\uC9C0 \uB450\uB978 \uBAA8\uC2B5\uC740
    \uB354 \uC774\uC0C1 \uC228\uACA8\uC9C4 \uC0AC\uB78C\uCC98\uB7FC \uBCF4\uC774\uC9C0
    \uC54A\uC558\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
