--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_inheritance_ceremony__step_inheritance_ceremony_outro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB124 \uBC29\uD5A5\uC5D0\uC11C \uC628 \uB9D0\uB4E4\uC774 \uD640 \uC548\uC5D0
      \uB0A8\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD669\uC2E4\uC758 \uC9C0\uC9C0, \uAC00\uBB38 \uC5B4\uB978\uB4E4\uC758
      \uBCF4\uC88C, \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uC81C\uC548, \uD6C4\uC791\uAC00\uC758
      \uBCF4\uD638."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBAA8\uB450 \uC544\uBCA8\uB9AC\uC544\uB97C \uD5A5\uD574 \uC788\uC5C8\uC9C0\uB9CC,
      \uBAA8\uB450 \uC544\uBCA8\uB9AC\uC544\uC758 \uAC83\uC740 \uC544\uB2C8\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: bb92d18cb19ba9944ac71077eb8aa4c5, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uB984\uC774 \uBD88\uB9AC\uB294
      \uCABD\uC73C\uB85C \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: bb92d18cb19ba9944ac71077eb8aa4c5, type: 2}
    _text: "\uC55E\uC73C\uB85C \uB098\uC640 \uC8FC\uC2ED\uC2DC\uC624."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB2E8\uC0C1 \uC55E\uC5D0 \uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC5B4\uC81C \uBCF4\uC558\uB358 \uC790\uB9AC\uC600\uB2E4. \uD558\uC9C0\uB9CC
      \uC624\uB298\uC740 \uC885\uC774\uAC00 \uC544\uB2C8\uB77C, \uC0AC\uB78C\uB4E4\uC758
      \uC2DC\uC120\uC774 \uADF8 \uC790\uB9AC\uB97C \uB458\uB7EC\uC2F8\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: bb92d18cb19ba9944ac71077eb8aa4c5, type: 2}
    _text: "\uACC4\uC2B9\uC744 \uBC1B\uC544\uB4E4\uC774\uACA0\uC2B5\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uACC4\uC2B9 \uBB38\uC11C \uC704\uC5D0
      \uC190\uC744 \uC62C\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB124. \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uBC31\uC791\uAC00\uC758 \uC774\uB984\uC744
      \uC787\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC758\uC804\uAD00\uC740 \uCC9C\uCC9C\uD788 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: bb92d18cb19ba9944ac71077eb8aa4c5, type: 2}
    _text: "\uACC4\uC2B9\uC744 \uC2B9\uC778\uD569\uB2C8\uB2E4."
  _nemoLine: "\uB124 \uBC29\uD5A5\uC5D0\uC11C \uC628 \uB9D0\uB4E4\uC774 \uD640 \uC548\uC5D0
    \uB0A8\uC558\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
