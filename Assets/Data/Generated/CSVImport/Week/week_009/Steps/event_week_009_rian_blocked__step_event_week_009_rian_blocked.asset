  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_rian_blocked__step_event_week_009_rian_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD669\uC2E4 \uBB38\uC7A5\uC774 \uC0C8\uACA8\uC9C4 \uC608\uBCF5\uC744
      \uC785\uC740 \uC758\uC804\uAD00\uC774 \uC870\uC6A9\uD788 \uACE0\uAC1C\uB97C
      \uC219\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: bb92d18cb19ba9944ac71077eb8aa4c5, type: 2}
    _text: "\uD669\uC2E4\uC740 \uC544\uBCA8\uB9AC\uC544 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uB2D8\uC758 \uC131\uC778\uC2DD\uC744 \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD669\uC2E4\uC740\uC694?"
  - _speaker: {fileID: 11400000, guid: bb92d18cb19ba9944ac71077eb8aa4c5, type: 2}
    _text: "\uC608. \uD669\uC2E4\uC744 \uB300\uD45C\uD558\uC5EC \uCD95\uC0AC\uB97C
      \uC804\uD558\uB7EC \uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: bb92d18cb19ba9944ac71077eb8aa4c5, type: 2}
    _text: "\uCD95\uC0AC\uB294 \uC2DD\uC7A5\uC5D0\uC11C \uB0AD\uB3C5\uB420 \uC608\uC815\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC758\uC804\uAD00\uC758 \uC190\uC5D0
      \uB4E4\uB9B0 \uCD95\uC11C\uB97C \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uC800\uB294, \uADF8 \uB9D0\uC744 \uB4E3\uACE0 \uACE0\uAC1C\uB97C
      \uC219\uC774\uBA74 \uB418\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: bb92d18cb19ba9944ac71077eb8aa4c5, type: 2}
    _text: "\uC608. \uADF8\uB807\uAC8C \uD558\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC791\uAC8C \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
  _nemoLine: "\uD669\uC2E4 \uBB38\uC7A5\uC774 \uC0C8\uACA8\uC9C4 \uC608\uBCF5\uC744
    \uC785\uC740 \uC758\uC804\uAD00\uC774 \uC870\uC6A9\uD788 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
