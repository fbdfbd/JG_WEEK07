MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_basement_direct_stable__step_event_week_009_excursion_basement_direct_stable
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC624\uB798\uB41C \uC0C1\uC790\uB4E4\uC774 \uBB38 \uC8FC\uBCC0\uC5D0
      \uD769\uC5B4\uC838 \uC788\uC5C8\uB2E4. \uD06C\uAE30\uB3C4, \uBB34\uAC8C\uB3C4
      \uC81C\uAC01\uAC01\uC774\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC0C1\uC790
      \uC55E\uC5D0 \uC549\uC544 \uB69C\uAED1\uC744 \uC5F4\uC5C8\uB2E4. \uC548\uC5D0\uB294
      \uC0C9\uC774 \uBC14\uB79C \uB178\uD2B8\uB4E4\uC774 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC74 \uC5B4\uBA38\uB2C8 \uAE00\uC528\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uADF8\uCABD\uC73C\uB85C \uC62E\uAE30\uC2E4\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uB2C8\uC694, \uC81C\uAC00 \uB458\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB178\uD2B8\uB97C \uD55C \uAD8C\uC529
      \uB118\uACA8\uBCF4\uACE0, \uAC00\uC9C0\uB7F0\uD788 \uCD94\uB824 \uC120\uBC18
      \uC704\uC5D0 \uC62C\uB838\uB2E4. \uB2E4\uC74C \uC0C1\uC790\uB3C4 \uAC19\uC740
      \uBC29\uC2DD\uC73C\uB85C \uC5F4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC74 \uBB58\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC548\uC744 \uB4E4\uC5EC\uB2E4\uBCF4\uB2E4
      \uC791\uAC8C \uC6C3\uC5C8\uB2E4."
  _nemoLine: "\uC624\uB798\uB41C \uC0C1\uC790\uB4E4\uC774 \uBB38 \uC8FC\uBCC0\uC5D0
    \uD769\uC5B4\uC838 \uC788\uC5C8\uB2E4. \uD06C\uAE30\uB3C4, \uBB34\uAC8C\uB3C4
    \uC81C\uAC01\uAC01\uC774\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
