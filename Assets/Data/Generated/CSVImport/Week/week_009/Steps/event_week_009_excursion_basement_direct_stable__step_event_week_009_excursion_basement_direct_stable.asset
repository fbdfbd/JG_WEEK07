  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_basement_direct_stable__step_event_week_009_excursion_basement_direct_stable
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB2EB\uD78C \uC0C1\uC790\uB4E4\uC774 \uAC00\uC9C0\uB7F0\uD788 \uC815\uB9AC\uB418\uC5B4
      \uC788\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uC81C\uB294 \uC5B4\uB514\uC5D0 \uBB50\uAC00 \uC788\uB294\uC9C0
      \uC54C \uC218 \uC788\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uBD84\uB958\uD45C\uB3C4 \uD568\uAED8 \uB9CC\uB4E4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uC783\uC5B4\uBC84\uB9AC\uB294 \uAC74 \uC544\uB2C8\uAD70\uC694.
      \uC790\uB9AC\uB97C \uC62E\uAE30\uB294 \uAC83\uACFC \uC0AC\uB77C\uC9C0\uB294
      \uAC74 \uB2E4\uB974\uC8E0."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uB9DE\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC815\uB9AC\uB41C\uB2E4\uB294 \uAC74 \uB05D\uB09C\uB2E4\uB294 \uB73B\uBCF4\uB2E4,
      \uB0A8\uAE30\uB294 \uBC29\uC2DD\uC744 \uBC14\uAFB8\uB294 \uAC70\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uADF8\uB807\uAC8C \uBCF4\uC154\uB3C4 \uC88B\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB807\uB2E4\uBA74 \uC774\uAC74 \uB098\uC05C \uC77C\uB9CC\uC740
      \uC544\uB2C8\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC0C1\uC790\uB4E4\uC758 \uC904\uC744
      \uCC9C\uCC9C\uD788 \uB530\uB77C \uAC78\uC5C8\uB2E4."
  _nemoLine: "\uB2EB\uD78C \uC0C1\uC790\uB4E4\uC774 \uAC00\uC9C0\uB7F0\uD788 \uC815\uB9AC\uB418\uC5B4
    \uC788\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
