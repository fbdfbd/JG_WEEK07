  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_basement_direct_anxious__step_event_week_009_excursion_basement_direct_anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC5F4\uB9B0 \uBB38 \uB108\uBA38\uC758 \uC9C0\uD558\uC2E4 \uC548\uCABD\uC740
      \uD3C9\uC18C\uBCF4\uB2E4 \uB354 \uBE44\uC5B4 \uBCF4\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4 \uC62E\uAE30\uBA74, \uC548\uCABD\uC740 \uD145 \uBE44\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608. \uC815\uB9AC\uAC00 \uB05D\uB098\uBA74 \uB9CE\uC774 \uB2EC\uB77C\uC9C8
      \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0 \uAC8C \uC2EB\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5C6\uC560\uB294 \uAC74 \uC544\uB2C8\uB77C\uACE0 \uD574\uB3C4, \uC790\uB9AC\uAC00
      \uBE44\uBA74 \uC5C6\uB294 \uAC83\uCC98\uB7FC \uB290\uAEF4\uC9C0\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: ...
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBE44\uC6CC\uC9C4 \uACF3\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uB354 \uD06C\uAC8C
      \uBCF4\uC774\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC0C1\uC790\uB4E4\uC774 \uC62E\uACA8\uC9C0\uB294
      \uBAA8\uC2B5\uC744 \uAC00\uB9CC\uD788 \uC9C0\uCF1C\uBCF4\uC558\uB2E4."
  _nemoLine: "\uC5F4\uB9B0 \uBB38 \uB108\uBA38\uC758 \uC9C0\uD558\uC2E4 \uC548\uCABD\uC740
    \uD3C9\uC18C\uBCF4\uB2E4 \uB354 \uBE44\uC5B4 \uBCF4\uC600\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
