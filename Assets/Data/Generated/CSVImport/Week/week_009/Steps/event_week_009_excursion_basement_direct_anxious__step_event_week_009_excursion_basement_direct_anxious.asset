MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_basement_direct_anxious__step_event_week_009_excursion_basement_direct_anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC9C0\uD558\uC2E4 \uC548\uCABD\uC5D0\uC11C \uC0C1\uC790\uB4E4\uC774
      \uD558\uB098\uC529 \uC62E\uACA8\uC838 \uB098\uAC00\uACE0 \uC788\uC5C8\uB2E4.
      \uB4E4\uACE0 \uB098\uAC00\uB294 \uC0AC\uB78C\uB3C4 \uB9E4\uBC88 \uB2EC\uB790\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800 \uC0C1\uC790, \uC5B4\uB514\uB85C \uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uBCF4\uAD00\uACE0\uB85C \uAC11\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB290 \uBCF4\uAD00\uACE0\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "...\uC784\uC2DC\uAC00\uC8FC\uB2D8\uAED8\uC11C \uB530\uB85C \uC9C0\uC815\uD558\uC2E0
      \uACF3\uC774 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC70\uAE30\uAC00 \uC5B4\uB514\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "...\uC8C4\uC1A1\uD569\uB2C8\uB2E4, \uC800\uB3C4 \uAC70\uAE30\uAE4C\uC9C0\uB294."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC62E\uACA8\uC9C0\uB358 \uC0C1\uC790
      \uD558\uB098\uB97C \uC190\uC73C\uB85C \uC9DA\uC5C8\uB2E4. \uB4E4\uACE0 \uAC00\uB358
      \uC0AC\uB78C\uC758 \uC190\uC774 \uBA48\uCDC4\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544: \uC774\uAC74 \uC7A0\uAE50 \uB450\uC138\uC694."
  _nemoLine: "\uC9C0\uD558\uC2E4 \uC548\uCABD\uC5D0\uC11C \uC0C1\uC790\uB4E4\uC774
    \uD558\uB098\uC529 \uC62E\uACA8\uC838 \uB098\uAC00\uACE0 \uC788\uC5C8\uB2E4.
    \uB4E4\uACE0 \uB098\uAC00\uB294 \uC0AC\uB78C\uB3C4 \uB9E4\uBC88 \uB2EC\uB790\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
