  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_max_1__step_event_week_009_max_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC131\uC778\uC2DD\uC7A5 \uC606 \uD68C\uB791. \uC131\uC778\uC2DD \uC804."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC131\uC778\uC2DD\uC744 \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACE0\uB9D9\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB450 \uC0AC\uB78C \uC0AC\uC774\uC5D0 \uC9E7\uC740 \uCE68\uBB35\uC774
      \uB193\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC6D0\uB798\uB294 \uB354 \uBA4B\uC9C0\uAC8C \uB9D0\uD558\uB824\uACE0
      \uD588\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9C0\uAE08\uB3C4 \uCDA9\uBD84\uD788 \uACA9\uC2DD \uC788\uC5C8\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uADF8\uAC74 \uAC00\uBB38\uC5D0\uC11C \uC900\uBE44\uD55C \uB9D0\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uB9C9\uC2A4\uC758 \uB9D0\uC740\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uCD95\uD558\uD569\uB2C8\uB2E4. \uC131\uC778\uC774 \uB418\uC2E0\uAC83\uB3C4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uACE0\uB9C8\uC6CC\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC9E7\uC740 \uC778\uC0AC\uC600\uC9C0\uB9CC, \uB9C9\uC2A4\uB294 \uC27D\uAC8C
      \uC790\uB9AC\uB97C \uB728\uC9C0 \uBABB\uD588\uB2E4."
  _nemoLine: "\uC131\uC778\uC2DD\uC7A5 \uC606 \uD68C\uB791. \uC131\uC778\uC2DD \uC804."
  _useCustomVisualState: 0
  _visualState: 0
