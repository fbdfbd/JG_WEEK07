  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_garden_blocked__step_event_week_009_excursion_garden_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBE44\uC11C\uAC00 \uC758\uC2DD \uC804\uC5D0\uB294 \uC815\uC6D0\uC5D0
      \uB098\uAC08 \uC218 \uC5C6\uB2E4\uACE0 \uC54C\uB824\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: 22a4c5e895307e74fae01c9ccdc97b8f, type: 2}
    _text: "\uC608\uBCF5\uC774 \uC0C1\uD560 \uC218 \uC788\uACE0, \uC190\uB2D8\uB4E4\uB3C4
      \uC774\uBBF8 \uB3C4\uCC29\uD558\uACE0 \uACC4\uC2ED\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC70\uC6B8 \uC55E\uC73C\uB85C \uB3CC\uC544\uC640,
      \uC608\uBCF5\uC758 \uB9E4\uBB34\uC0C8\uB97C \uC5B4\uAE68\uBD80\uD130 \uB2E8\uAE4C\uC9C0
      \uCC9C\uCC9C\uD788 \uD655\uC778\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBA54\uC774, \uC21C\uC11C \uD55C \uBC88\uB9CC \uB354 \uC9DA\uC5B4\uC904\uB798\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBA54\uC774\uAC00 \uC758\uC2DD \uC21C\uC11C\uB97C \uCC98\uC74C\uBD80\uD130
      \uC77D\uC5B4 \uB0B4\uB824\uAC00\uB294 \uB3D9\uC548, \uC544\uBCA8\uB9AC\uC544\uB294
      \uD55C \uB2E8\uACC4\uC529 \uB530\uB77C\uAC00\uBA70 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
  _nemoLine: "\uBE44\uC11C\uAC00 \uC758\uC2DD \uC804\uC5D0\uB294 \uC815\uC6D0\uC5D0
    \uB098\uAC08 \uC218 \uC5C6\uB2E4\uACE0 \uC54C\uB824\uC654\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
