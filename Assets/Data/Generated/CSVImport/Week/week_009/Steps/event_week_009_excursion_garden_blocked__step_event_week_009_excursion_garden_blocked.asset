  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_garden_blocked__step_event_week_009_excursion_garden_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBE44\uC11C\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC131\uC778\uC2DD
      \uC804\uC5D0 \uC815\uC6D0\uC5D0 \uB098\uAC00\uB294 \uAC83\uC744 \uD5C8\uB77D\uD558\uC9C0
      \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uC758\uC2DD \uC804\uC5D0\uB294 \uC608\uBCF5\uC774 \uC0C1\uD560 \uC218
      \uC788\uC73C\uB2C8, \uBCF8\uC2DD \uB54C \uB098\uAC00\uC2DC\uB294 \uAC83\uC774
      \uC88B\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC7A0\uAE50\uB9CC \uBCF4\uACE0 \uC624\uBA74 \uC548 \uB3FC\uC694?"
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uC190\uB2D8\uB4E4\uC774 \uC774\uBBF8 \uB3C4\uCC29\uD558\uACE0 \uACC4\uC2ED\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC3D\uAC00\uC5D0 \uC11C\uC11C \uC815\uC6D0
      \uCABD\uC744 \uBD24\uB2E4. \uD06C\uB808\uC774\uD504 \uBA38\uD2C0\uC774 \uBA40\uB9AC
      \uBCF4\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBA54\uC774, \uC800 \uB098\uBB34 \uC62C\uD574 \uAF43 \uD3C8\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 139777b36d46b234ca8c06c758cad573, type: 2}
    _text: "\uC798 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB807\uAD6C\uB098."
  _nemoLine: "\uBE44\uC11C\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC131\uC778\uC2DD
    \uC804\uC5D0 \uC815\uC6D0\uC5D0 \uB098\uAC00\uB294 \uAC83\uC744 \uD5C8\uB77D\uD558\uC9C0
    \uC54A\uC558\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
