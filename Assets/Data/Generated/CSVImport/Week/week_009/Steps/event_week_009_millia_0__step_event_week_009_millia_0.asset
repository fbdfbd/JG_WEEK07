  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_millia_0__step_event_week_009_millia_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uC778\uC7A5\uC774 \uCC0D\uD78C
      \uBB38\uC11C\uAC00 \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC5D0\uC11C \uBC31\uC791\uAC00
      \uBD80\uCC44 \uC815\uB9AC\uC548\uC744 \uAC00\uC838\uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298\uAC19\uC740 \uB0A0 \uCC98\uB9AC\uD574\uC57C \uD558\uB294
      \uAC74\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC0C1\uB2E8 \uCABD\uC5D0\uC11C\uB294 \uADF8\uB807\uAC8C \uC6D0\uD558\uACE0
      \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uBB38\uC11C \uB05D\uC744 \uC870\uC2EC\uC2A4\uB7FD\uAC8C
      \uB20C\uB800\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC790\uC138\uD55C \uAC80\uD1A0\uB294 \uBC31\uC791\uAC00\uC5D0\uC11C
      \uD558\uC154\uC57C \uD569\uB2C8\uB2E4."
  _nemoLine: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uC778\uC7A5\uC774 \uCC0D\uD78C
    \uBB38\uC11C\uAC00 \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC5EC \uC788\uC5C8\uB2E4."
