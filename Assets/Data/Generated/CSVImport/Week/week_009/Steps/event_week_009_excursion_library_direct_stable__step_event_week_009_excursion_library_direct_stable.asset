  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uCE68 \uD587\uC0B4\uC774 \uCC45\uC0C1 \uC704\uC5D0 \uAE38\uAC8C
      \uB4E4\uC5B4\uC640 \uC788\uC5C8\uB2E4. \uB3C4\uC11C\uAD00 \uC548\uC740 \uC870\uC6A9\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC544\uBC84\uC9C0\uC758 \uCC45\uC0C1
      \uC55E\uC5D0 \uC130\uB2E4. \uC190\uB05D\uC73C\uB85C \uC758\uC790 \uB4F1\uBC1B\uC774\uB97C
      \uAC00\uBCCD\uAC8C \uC9DA\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uBC84\uC9C0, \uB2E4\uB140\uC62C\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC7A0\uAE50 \uCC45\uC0C1 \uC704\uB97C \uB208\uC73C\uB85C \uB458\uB7EC\uBCF8
      \uB4A4, \uAC00\uBCBC\uC6B4 \uAC78\uC74C\uC73C\uB85C \uB3C4\uC11C\uAD00\uC744
      \uB098\uC130\uB2E4."
  _nemoLine: "\uC544\uCE68 \uD587\uC0B4\uC774 \uCC45\uC0C1 \uC704\uC5D0 \uAE38\uAC8C
    \uB4E4\uC5B4\uC640 \uC788\uC5C8\uB2E4. \uB3C4\uC11C\uAD00 \uC548\uC740 \uC870\uC6A9\uD588\uB2E4."
