  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_forest_direct_innocent__step_event_week_009_excursion_forest_direct_innocent
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAE38\uC774 \uAE68\uB057\uD574\uC84C\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC608. \uC815\uBE44\uAC00 \uB410\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uCABD\uC73C\uB85C \uAC00\uB3C4 \uB418\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\u2026\uC608, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC804\uC5D0 \uC654\uB358 \uACF3\uC774\uC5D0\uC694. \uD480\uC774 \uB9CE\uB358
      \uACF3."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC608."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5EC\uAE30\uC5D0 \uBB54\uAC00 \uC788\uC5C8\uB358 \uAC70\uC8E0?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC5B4\uBA38\uB2D8\uAED8\uC11C \uC7A0\uB4E4\uC5B4 \uACC4\uC2E0 \uC790\uB9AC\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uBA38\uB2C8\uAC00\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC608."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0
      \uC54A\uC558\uB2E4. \uCC9C\uCC9C\uD788 \uAC78\uC5B4 \uB4E4\uC5B4\uAC00\uC11C
      \uB3CC \uC55E\uC5D0 \uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC804\uC5D0\uB3C4 \uC654\uC5C8\uB294\uB370, \uBAB0\uB790\uC5B4\uC694.
      \uADF8\uB54C \uC5EC\uAE30 \uC549\uC544 \uC788\uC5C8\uB294\uB370\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\u2026\uC608, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC624\uB798 \uADF8 \uC790\uB9AC\uC5D0
      \uC788\uC5C8\uB2E4."
  _nemoLine: "\uAE38\uC774 \uAE68\uB057\uD574\uC84C\uB124\uC694."
  _useCustomVisualState: 0
  _visualState: 0
