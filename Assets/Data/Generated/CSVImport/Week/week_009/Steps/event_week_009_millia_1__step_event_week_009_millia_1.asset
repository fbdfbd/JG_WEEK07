--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_millia_1__step_event_week_009_millia_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uBD80\uCC44 \uC815\uB9AC\uC548\uC774
      \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC624\uB298 \uC774\uAC78 \uC11C\uBA85\uD558\uBA74, \uADF8\uB0E5 \uC11C\uB958
      \uD558\uB098 \uCC98\uB9AC\uD558\uB294 \uAC8C \uC544\uB2C8\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC131\uC778\uC2DD \uB0A0, \uBAA8\uB450\uAC00 \uBCF4\uB294 \uB0A0\uC5D0
      \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uC190\uC744 \uC7A1\uB294\uB2E4\uB294
      \uB73B\uC774 \uB3FC\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBD80\uCC44\uB97C \uC815\uB9AC\uD558\uB294 \uAC83\uBFD0\uC778\uB370\uB3C4\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC0AC\uB78C\uB4E4\uC740 \uADF8\uB807\uAC8C \uC548 \uBD10\uC694. \uB204\uAC00
      \uC624\uB298 \uC606\uC5D0 \uC788\uC5C8\uB294\uC9C0, \uB204\uAC00 \uBB38\uC11C\uB97C
      \uAC00\uC838\uC654\uB294\uC9C0\uAE4C\uC9C0 \uBD10\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB3C4 \uADF8\uAC78 \uC54C\uACE0 \uC628 \uAC74\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB124. \uADF8\uB798\uC11C \uC9C0\uAE08 \uB9D0\uD558\uB294 \uAC70\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0C1\uB2E8 \uCABD\uC5D0\uC11C\uB294 \uC81C\uAC00 \uC11C\uBA85\uD558\uAE38
      \uC6D0\uD558\uACA0\uC8E0."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4."
  _nemoLine: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uBD80\uCC44 \uC815\uB9AC\uC548\uC774
    \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
