--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_basement_blocked__step_event_week_009_excursion_basement_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC9C0\uD558\uC2E4 \uBB38\uC740 \uB2EB\uD600 \uC788\uC5C8\uACE0, \uBE57\uC7A5\uC774
      \uAC78\uB824 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uC5D0 \uC788\uB358 \uAC8C \uB2E4 \uC815\uB9AC\uB41C \uAC70\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608. \uC544\uCE68 \uC77C\uCC0D \uB9C8\uBB34\uB9AC\uB410\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB50\uAC00 \uC62E\uACA8\uC9C0\uACE0 \uBB50\uAC00 \uB0A8\uC558\uB294\uC9C0,
      \uBAA9\uB85D\uC740 \uC788\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "...\uB530\uB85C \uBC1B\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB807\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB2EB\uD78C \uBB38 \uC55E\uC5D0 \uC7A0\uC2DC
      \uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC5B4\uBA38\uB2C8\uC758 \uB178\uD2B8\uAC00 \uB4E4\uC5B4 \uC788\uB358
      \uC0C1\uC790, \uD45C\uC2DD\uC774 \uC5C6\uB358 \uC0C1\uC790, \uC190\uC774 \uD55C
      \uBC88 \uBA4E\uC5C8\uB358 \uC0C1\uC790. \uBA38\uB9BF\uC18D\uC5D0\uC11C \uD558\uB098\uC529
      \uC9DA\uC5B4 \uB0B4\uB824\uAC14\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB514\uC5D0 \uBB50\uAC00 \uAC14\uB294\uC9C0, \uCC9C\uCC9C\uD788
      \uC54C\uC544\uBCFC\uAC8C\uC694."
  _nemoLine: "\uC9C0\uD558\uC2E4 \uBB38\uC740 \uB2EB\uD600 \uC788\uC5C8\uACE0, \uBE57\uC7A5\uC774
    \uAC78\uB824 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
