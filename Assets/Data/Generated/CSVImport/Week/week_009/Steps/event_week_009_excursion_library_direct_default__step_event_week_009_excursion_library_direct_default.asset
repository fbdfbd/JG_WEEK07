  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uCE68 \uD587\uC0B4\uC774 \uCC45\uC0C1 \uC704\uC5D0 \uAE38\uAC8C
      \uB4E4\uC5B4\uC640 \uC788\uC5C8\uB2E4. \uCC45\uC0C1, \uC758\uC790, \uB2EB\uD78C
      \uC11C\uB78D. \uBAA8\uB450 \uADF8\uB300\uB85C\uC600\uC9C0\uB9CC \uC5B4\uC81C\uC640
      \uAC19\uC9C0\uB294 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC544\uBC84\uC9C0\uC758 \uC758\uC790
      \uC55E\uC5D0 \uC7A0\uC2DC \uC130\uB2E4\uAC00, \uC758\uC790\uB97C \uBE7C\uACE0
      \uC870\uC6A9\uD788 \uC549\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBE48 \uC790\uB9AC\uAC00 \uC544\uB2C8\uC5C8\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uCC45\uC0C1 \uC704\uC5D0 \uC190\uC744 \uAC00\uC9C0\uB7F0\uD788 \uC5B9\uC5C8\uB2E4.
      \uC190\uBC14\uB2E5 \uC544\uB798\uB85C \uB098\uBB34\uC758 \uACB0\uC774 \uADF8\uB300\uB85C
      \uB290\uAEF4\uC84C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C\uAC00 \uC549\uC744 \uC790\uB9AC\uC600\uC5B4\uC694."
  _nemoLine: "\uC544\uCE68 \uD587\uC0B4\uC774 \uCC45\uC0C1 \uC704\uC5D0 \uAE38\uAC8C
    \uB4E4\uC5B4\uC640 \uC788\uC5C8\uB2E4. \uCC45\uC0C1, \uC758\uC790, \uB2EB\uD78C
    \uC11C\uB78D. \uBAA8\uB450 \uADF8\uB300\uB85C\uC600\uC9C0\uB9CC \uC5B4\uC81C\uC640
    \uAC19\uC9C0\uB294 \uC54A\uC558\uB2E4."
