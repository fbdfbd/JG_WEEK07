  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_forest_direct_clever__step_event_week_009_excursion_forest_direct_clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB364\uBD88\uC740 \uAE38\uC744 \uB530\uB77C \uC548\uCABD\uAE4C\uC9C0
      \uAE54\uB054\uD558\uAC8C \uCE58\uC6CC\uC838 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC7A0\uAE50, \uB4E4\uC5B4\uAC00 \uBCFC\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAE38\uC744 \uB530\uB77C \uD55C\uCC38\uC744
      \uAC78\uC5B4 \uB4E4\uC5B4\uAC14\uB2E4. \uD3ED\uC774 \uC881\uC544\uC9C0\uC9C0
      \uC54A\uC558\uB2E4. \uC0AC\uB78C \uD55C \uBA85\uC774 \uC544\uB2C8\uB77C \uB9D0\uC774
      \uC9C0\uB098\uAC08 \uB9CC\uD55C \uD3ED\uC774\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB098\uBB34 \uC0AC\uC774\uB85C \uBA40\uB9AC, \uB9D0 \uD0C4 \uC0AC\uB78C
      \uBA87\uC774 \uC904\uC9C0\uC5B4 \uC11C \uC788\uB294 \uAC8C \uBCF4\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC1C\uAC78\uC74C\uC744 \uBA48\uCD94\uACE0,
      \uB098\uBB34 \uB4A4\uB85C \uD55C \uAC78\uC74C \uBE44\uAEF4\uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "...\uB364\uBD88\uC744 \uCE58\uC6B4 \uAC74 \uAE38\uC744 \uB0B4\uB824\uB358
      \uAC8C \uC544\uB2C8\uC5C8\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uB2E4\uB2D0 \uAE38\uC778\uC9C0\uAC00 \uC911\uC694\uD55C
      \uAC70\uC600\uC5B4\uC694."
  _nemoLine: "\uB364\uBD88\uC740 \uAE38\uC744 \uB530\uB77C \uC548\uCABD\uAE4C\uC9C0
    \uAE54\uB054\uD558\uAC8C \uCE58\uC6CC\uC838 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
