  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_rumor_blocked__step_event_week_009_rumor_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC9D1\uC0AC\uC7A5\uC774 \uBA85\uB2E8 \uD55C \uC7A5\uC744 \uB4E4\uACE0
      \uB4E4\uC5B4\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC8C \uBB50\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC624\uB298 \uC624\uC2E4 \uBD84\uB4E4\uC758 \uBA85\uB2E8\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4 \uC654\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uAC70\uC758 \uB2E4 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC83\uBFD0\uC774\uC5D0\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\u2026\uC608, \uC544\uAC00\uC528. \uC624\uB298\uC740 \uBA85\uB2E8\uBD80\uD130
      \uCC59\uAE30\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4\uB978 \uAC74 \uC5C6\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC624\uB298\uC740 \uC2E0\uACBD \uC4F0\uC2E4 \uC77C\uC774 \uB9CE\uC2B5\uB2C8\uB2E4.
      \uD55C \uAC00\uC9C0\uC529 \uCC28\uBD84\uD788 \uAC00\uC2DC\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uADF8\uB798\uC694."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC608\uBCF5 \uCC44\uBE44\uBD80\uD130 \uD558\uC2DC\uB294 \uAC8C \uC88B\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C\uACA0\uC5B4\uC694."
  _nemoLine: "\uC9D1\uC0AC\uC7A5\uC774 \uBA85\uB2E8 \uD55C \uC7A5\uC744 \uB4E4\uACE0
    \uB4E4\uC5B4\uC654\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
