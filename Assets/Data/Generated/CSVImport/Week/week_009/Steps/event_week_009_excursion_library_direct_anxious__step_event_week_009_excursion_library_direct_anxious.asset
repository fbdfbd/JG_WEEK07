  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC544\uBC84\uC9C0\uC758 \uBE48 \uC758\uC790
      \uC55E\uC5D0 \uBA48\uCDB0 \uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD587\uC0B4\uC774 \uC758\uC790 \uC704\uC5D0\uB9CC \uBC1D\uAC8C \uB5A8\uC5B4\uC838
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C\uAC00 \uC549\uC544\uB3C4 \uB418\uB294 \uC790\uB9AC\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB204\uAD6C\uB3C4 \uBC14\uB85C \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uC9C1 \uB108\uBB34 \uD070 \uAC83 \uAC19\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC758\uC790\uC5D0 \uC190\uC744 \uBED7\uB2E4\uAC00,
      \uB2FF\uAE30 \uC804\uC5D0 \uAC70\uB450\uC5C8\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC544\uBC84\uC9C0\uC758 \uBE48 \uC758\uC790
    \uC55E\uC5D0 \uBA48\uCDB0 \uC130\uB2E4."
