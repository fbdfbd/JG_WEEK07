  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC624\uB298 \uC800\uB294 \uD669\uC790\uB85C\uC11C \uD589\uB3D9\uD560\uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC2E4\uC81C\uB85C\uB3C4 \uADF8\uB807\uC9C0 \uC54A\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB9DE\uC2B5\uB2C8\uB2E4. \uBD80\uC815\uD560 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0\uB370\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uB807\uB2E4\uACE0 \uC81C \uB9D0\uC774 \uC804\uBD80 \uD669\uC2E4\uC758
      \uC758\uACAC\uCC98\uB7FC \uBCF4\uC774\uB294 \uAC83\uC740 \uC2EB\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uB97C \uC870\uC6A9\uD788
      \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "...\uC624\uB298 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC5B4\uB5A4 \uC120\uD0DD\uC744
      \uD558\uB358 \uC874\uC911\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  _nemoLine: "\uC624\uB298 \uC800\uB294 \uD669\uC790\uB85C\uC11C \uD589\uB3D9\uD560\uAC81\uB2C8\uB2E4."
