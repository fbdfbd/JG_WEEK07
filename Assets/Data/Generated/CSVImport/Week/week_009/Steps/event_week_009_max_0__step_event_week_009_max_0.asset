  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC131\uC778\uC2DD\uC7A5."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C. \uB9C9\uC2A4 \uBC1C\uD14C\uB9AC\uC628
      \uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC18\uAC00\uC6CC\uC694, \uB9C9\uC2A4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uBC1C\uD14C\uB9AC\uC628\uC740 \uBCA8\uB9AC\uC6B0\uC2A4 \uBC31\uC791\uAC00\uC758
      \uC0C8\uB85C\uC6B4 \uC2DC\uB300\uB97C \uD658\uC601\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC7A0\uC2DC \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC624\uB798 \uBD99\uC7A1\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uC131\uC778\uC2DD\uC744
      \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4."
  _nemoLine: "\uC131\uC778\uC2DD\uC7A5."
