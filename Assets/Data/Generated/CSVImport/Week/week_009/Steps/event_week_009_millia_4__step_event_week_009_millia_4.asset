--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_millia_4__step_event_week_009_millia_4
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758
      \uC778\uC7A5\uC774 \uCC0D\uD788\uC9C0 \uC54A\uC740 \uC791\uC740 \uBD09\uD22C\uB97C
      \uAEBC\uB0C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC74 \uBB54\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC81C \uC815\uB9AC\uBCF8\uC774\uC5D0\uC694. \uC0C1\uB2E8 \uACF5\uC2DD
      \uBB38\uC11C \uC544\uB2C8\uACE0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC00\uC838\uC640\uB3C4 \uB418\uB294 \uAC74\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB4E4\uD0A4\uBA74 \uACE4\uB780\uD558\uAE34 \uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uBD09\uD22C\uB97C \uD14C\uC774\uBE14 \uC704\uC5D0
      \uC62C\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uC7A5\uAE30 \uACC4\uC57D\uC740
      \uBC1B\uC9C0 \uC54A\uB294 \uAC8C \uC88B\uC544\uC694. \uB3C4\uC6C0\uC740 \uBC1B\uC744
      \uC218 \uC788\uC5B4\uB3C4, \uACB0\uC815\uAD8C\uAE4C\uC9C0 \uB118\uAE30\uBA74
      \uC548 \uB3FC\uC694."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC624\uB298\uC740 \uBCA0\uB974\uB514\uC544\uAC00 \uC804\uD558\uB294
      \uB9D0 \uB9D0\uACE0, \uBC00\uB9AC\uC544\uB85C\uC11C \uD558\uB294 \uB9D0\uB3C4
      \uC788\uC5B4\uC57C \uD560 \uAC83 \uAC19\uC544\uC11C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC00\uB9AC\uC544\uC758 \uB9D0\uC740 \uBB54\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uBE5A\uC740 \uAC1A\uC73C\uBA74 \uB05D\uB098\uC694. \uADF8\uB7F0\uB370
      \uC2B5\uAD00\uCC98\uB7FC \uB0A8\uC5D0\uAC8C \uAE30\uB300\uAE30 \uC2DC\uC791\uD558\uBA74,
      \uADF8\uAC74 \uC798 \uC548 \uB05D\uB098\uC694."
  _nemoLine: "\uBC00\uB9AC\uC544\uB294 \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758
    \uC778\uC7A5\uC774 \uCC0D\uD788\uC9C0 \uC54A\uC740 \uC791\uC740 \uBD09\uD22C\uB97C
    \uAEBC\uB0C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
