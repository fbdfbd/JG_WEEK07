--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_millia_blocked__step_event_week_009_millia_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uC778\uC7A5\uC774 \uCC0D\uD78C
      \uBB38\uC11C\uAC00 \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC0C1\uB2E8 \uC11C\uAE30\uAD00\uC740 \uBB38\uC11C \uB05D\uC758 \uC11C\uBA85\uB780\uC744
      \uC544\uBCA8\uB9AC\uC544 \uCABD\uC73C\uB85C \uB3CC\uB824\uB193\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: d693069163a29774ebfd242bd0e8d1ba, type: 2}
    _text: "\uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uBC31\uC791\uAC00 \uBD80\uCC44 \uC815\uB9AC\uC548\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298 \uCC98\uB9AC\uD574\uC57C \uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: d693069163a29774ebfd242bd0e8d1ba, type: 2}
    _text: "\uC131\uC778\uC2DD \uC774\uD6C4 \uBC31\uC791\uAC00 \uC6B4\uC601\uC744
      \uC548\uC815\uC2DC\uD0A4\uAE30 \uC704\uD55C \uC808\uCC28\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC808\uCC28\uC694."
  - _speaker: {fileID: 11400000, guid: d693069163a29774ebfd242bd0e8d1ba, type: 2}
    _text: "\uC11C\uBA85\uD558\uC2DC\uBA74 \uAE30\uC874 \uBD80\uCC44\uB294 \uC7A5\uAE30
      \uD611\uB825 \uACC4\uC57D\uC73C\uB85C \uC804\uD658\uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBE5A\uC774 \uC5C6\uC5B4\uC9C0\uB294 \uAC74\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: d693069163a29774ebfd242bd0e8d1ba, type: 2}
    _text: "\uD615\uD0DC\uAC00 \uBC14\uB00C\uB294 \uAC83\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC11C\uBA85\uB780 \uC55E\uC5D0\uC11C
      \uC190\uC744 \uBA48\uCDC4\uB2E4."
  - _speaker: {fileID: 11400000, guid: d693069163a29774ebfd242bd0e8d1ba, type: 2}
    _text: "\uAC80\uD1A0\uD558\uC2E4 \uC2DC\uAC04\uC740 \uCDA9\uBD84\uD788 \uB4DC\uB838\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC2DC\uAC04\uC740 \uC788\uC5C8\uC9C0\uB9CC, \uCDA9\uBD84\uD55C \uC124\uBA85\uC740
      \uC5C6\uC5C8\uB124\uC694."
  _nemoLine: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uC778\uC7A5\uC774 \uCC0D\uD78C
    \uBB38\uC11C\uAC00 \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
