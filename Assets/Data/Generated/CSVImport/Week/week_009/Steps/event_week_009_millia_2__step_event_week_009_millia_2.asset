  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_millia_2__step_event_week_009_millia_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC120\uD0DD\uC9C0\uB294 \uB450 \uAC1C\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBD80\uCC44\uB97C \uAC1A\uAC70\uB098, \uBB36\uC774\uAC70\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB124. \uAE54\uB054\uD558\uAC8C \uCCAD\uC0B0\uD558\uBA74 \uB2F9\uC7A5\uC740
      \uD798\uB4E4\uACE0, \uC7A5\uAE30 \uACC4\uC57D\uC744 \uB9FA\uC73C\uBA74 \uB2F9\uC7A5\uC740
      \uD3B8\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB300\uC2E0 \uB098\uC911\uC774 \uBB38\uC81C\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB9DE\uC544\uC694, \uBCA0\uB974\uB514\uC544 \uAC00\uBB38\uC740 \uC7A5\uAE30\uACC4\uC57D\uC744
      \uCD94\uCC9C\uB4DC\uB824\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC00\uB9AC\uC544 \uAC1C\uC778\uC73C\uB85C\uC11C\uB294 \uC5B4\uB290
      \uCABD\uC774 \uB0AB\uB2E4\uACE0 \uC0DD\uAC01\uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uBC31\uC791\uAC00\uAC00 \uBC84\uD2F8 \uC218 \uC788\uB2E4\uBA74, \uBE5A\uC740
      \uBE5A\uC73C\uB85C \uB05D\uB0B4\uB294 \uAC8C \uB098\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACC4\uC57D\uC73C\uB85C \uBC14\uAFB8\uC9C0 \uB9D0\uACE0\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB124. \uACC4\uC57D\uC740 \uBE5A\uBCF4\uB2E4 \uC624\uB798 \uB0A8\uC744
      \uB54C\uAC00 \uB9CE\uC544\uC694."
  _nemoLine: "\uC120\uD0DD\uC9C0\uB294 \uB450 \uAC1C\uC608\uC694."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
