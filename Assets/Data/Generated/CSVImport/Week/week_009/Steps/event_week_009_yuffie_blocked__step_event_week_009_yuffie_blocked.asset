--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_yuffie_blocked__step_event_week_009_yuffie_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD558\uB140\uB294 \uD6C4\uC791\uAC00\uC758 \uBCF4\uD638 \uC81C\uC548\uC774
      \uC801\uD78C \uBB38\uC11C\uB97C \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uD3BC\uCCE4\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uD6C4\uC791\uAC00\uC758 \uBCF4\uD638 \uC81C\uC548\uC774 \uACF5\uC2DD\uC801\uC73C\uB85C
      \uC5B8\uAE09\uB420 \uC608\uC815\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBCF4\uD638 \uC81C\uC548\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608. \uBC31\uC791\uAC00\uAC00 \uC548\uC815\uB420 \uB54C\uAE4C\uC9C0
      \uD6C4\uC791\uAC00\uAC00 \uACC1\uC5D0\uC11C \uB3D5\uACA0\uB2E4\uB294 \uB73B\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB3C4\uC6C0\uC774 \uB418\uBA74 \uC88B\uC740 \uAC70 \uC544\uB2CC\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uB300\uCCB4\uB85C\uB294 \uADF8\uB807\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "..\uB300\uCCB4\uB85C\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uD6C4\uC791\uAC00\uAC00 \uB3D5\uAC8C \uB418\uBA74, \uB354 \uB9CE\uC740
      \uBD84\uB4E4\uC774 \uC544\uAC00\uC528\uC758 \uD589\uB3D9 \uD558\uB098\uD558\uB098\uB97C
      \uC9C0\uCF1C\uBCF4\uAC8C \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB3C4\uC640\uC900\uB2E4\uB294 \uB9D0\uC774, \uC9C0\uCF1C\uBCF8\uB2E4\uB294
      \uB9D0\uCC98\uB7FC \uB4E4\uB9AC\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBB38\uC11C\uB97C \uB0B4\uB824\uB193\uC9C0
      \uBABB\uD558\uACE0 \uD55C\uCC38 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  _nemoLine: "\uD558\uB140\uB294 \uD6C4\uC791\uAC00\uC758 \uBCF4\uD638 \uC81C\uC548\uC774
    \uC801\uD78C \uBB38\uC11C\uB97C \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uD3BC\uCCE4\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
