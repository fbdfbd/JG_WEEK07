%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_yuffie_4__step_event_week_009_yuffie_4
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uD6C4\uC791\uAC00 \uC0AC\uB78C\uB4E4\uBCF4\uB2E4
      \uC870\uAE08 \uB5A8\uC5B4\uC9C4 \uACF3\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC624\uB298\uC740 \uC5B4\uBA38\uB2C8\uC758 \uB9D0\uBCF4\uB2E4, \uC81C
      \uB9D0\uC744 \uBA3C\uC800 \uB4DC\uB9AC\uACE0 \uC2F6\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC720\uD53C\uC758 \uB9D0\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC608\uBC95\uC5D0 \uB9DE\uAC8C \uACE0\uAC1C\uB97C
      \uC219\uC600\uB2E4\uAC00 \uCC9C\uCC9C\uD788 \uB4E4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC131\uC778\uC2DD\uC744 \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4, \uC544\uBCA8\uB9AC\uC544
      \uB2D8."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACE0\uB9C8\uC6CC\uC694."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uADF8\uB9AC\uACE0\u2026 \uD6C4\uC791\uAC00\uC758 \uBCF4\uD638\uB97C
      \uBC1B\uC544\uB4E4\uC774\uC168\uC73C\uBA74 \uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC720\uD53C\uB3C4 \uADF8\uAC78 \uBC14\uB77C\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uD6C4\uC791\uAC00\uC758 \uB73B\uC774\uAE30\uB3C4 \uD558\uC9C0\uB9CC,
      \uC81C \uB9C8\uC74C\uC774\uAE30\uB3C4 \uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD6C4\uC791\uAC00 \uC548\uC73C\uB85C \uB4E4\uC5B4\uC624\uB77C\uB294
      \uB9D0\uC774\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uD558\uC9C0\uB9CC \uD63C\uC790 \uC624\uC2DC\uB77C\uB294 \uB73B\uC740
      \uC544\uB2C8\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC190\uB05D\uC744 \uAF2D \uBAA8\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC81C\uAC00 \uAC19\uC774 \uC788\uC744\uAC8C\uC694. \uADF8\uB798\uC11C
      \uC640 \uC8FC\uC168\uC73C\uBA74 \uD574\uC694."
  _nemoLine: "\uC720\uD53C\uB294 \uD6C4\uC791\uAC00 \uC0AC\uB78C\uB4E4\uBCF4\uB2E4
    \uC870\uAE08 \uB5A8\uC5B4\uC9C4 \uACF3\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
