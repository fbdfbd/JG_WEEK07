--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_yuffie_1__step_event_week_009_yuffie_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uD6C4\uC791\uAC00\uC758 \uBCF4\uD638\uB97C \uBC1B\uC544\uB4E4\uC774\uB294
      \uAC83\uB3C4 \uD558\uB098\uC758 \uC120\uD0DD\uC774\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC720\uD53C\uB294 \uC81C\uAC00 \uADF8\uAC78 \uACE0\uB974\uAE38 \uBC14\uB77C\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uD558\uC9C0\uB9CC \uAC15\uC694\uD558\uACE0 \uC2F6\uC9C0\uB294
      \uC54A\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C \uADF8\uCABD\uC774 \uB0AB\uB2E4\uACE0 \uC0DD\uAC01\uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB35C \uB2E4\uCE60 \uC218 \uC788\uC73C\uB2C8\uAE4C\uC694. \uADF8\uB9AC\uACE0
      \uD63C\uC790 \uB0AF\uC120 \uACF3\uC5D0 \uC11C\uB294 \uAC83\uBCF4\uB2E4\uB294
      \uB098\uC744 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD6C4\uC791\uAC00\uAC00 \uB0AF\uC120 \uACF3\uC774 \uC544\uB2C8\uAC8C
      \uB41C\uB2E4\uB294 \uB73B\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uC81C\uAC00 \uC788\uC73C\uB2C8\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC870\uAE08 \uB9DD\uC124\uC774\uB2E4\uAC00 \uB367\uBD99\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uADF8 \uB9D0\uC774 \uD754\uB4DC\uB294 \uB9D0\uC774\uB77C\uB294 \uAC83\uB3C4
      \uC54C\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C\uACE0\uB3C4 \uB9D0\uD558\uB294\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uC624\uB298\uC740 \uC228\uAE30\uACE0 \uC2F6\uC9C0 \uC54A\uC558\uC5B4\uC694."
  _nemoLine: "\uD6C4\uC791\uAC00\uC758 \uBCF4\uD638\uB97C \uBC1B\uC544\uB4E4\uC774\uB294
    \uAC83\uB3C4 \uD558\uB098\uC758 \uC120\uD0DD\uC774\uC5D0\uC694."
  _useCustomVisualState: 0
  _visualState: 0
