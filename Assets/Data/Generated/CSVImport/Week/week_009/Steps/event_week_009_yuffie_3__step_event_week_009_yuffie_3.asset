  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_yuffie_3__step_event_week_009_yuffie_3
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC5B4\uBA38\uB2C8\uAED8\uC11C\uB294 \uC624\uB298 \uC548\uC5D0 \uB300\uB2F5\uC744
      \uB4E3\uACE0 \uC2F6\uC5B4 \uD558\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC720\uD53C\uB3C4\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uC800\uB3C4 \uB4E3\uACE0 \uC2F6\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB5A4 \uB300\uB2F5\uC744 \uBC14\uB77C\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uBC1B\uC544\uB4E4\uC774\uC168\uC73C\uBA74 \uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD6C4\uC791\uAC00\uC758 \uBCF4\uD638\uB97C\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uC544\uBCA8\uB9AC\uC544 \uB2D8\uC774 \uD63C\uC790 \uBAA8\uB4E0
      \uC2DC\uC120\uC744 \uBC1B\uC9C0 \uC54A\uC73C\uC168\uC73C\uBA74 \uC88B\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB300\uC2E0 \uD6C4\uC791\uAC00\uC758 \uC774\uB984\uC774 \uC81C \uC606\uC5D0
      \uC11C\uACA0\uC8E0."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB9DE\uC544\uC694. \uADF8\uAC8C \uBD80\uB2F4\uC774\uB77C\uB294 \uAC83\uB3C4
      \uC54C\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0\uB370\uB3C4 \uAD8C\uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uC800\uB294 \uADF8 \uBD80\uB2F4\uBCF4\uB2E4, \uD63C\uC790 \uB2E4\uCE58\uB294
      \uCABD\uC774 \uB354 \uBB34\uC12D\uB2E4\uACE0 \uC0DD\uAC01\uD574\uC694."
  _nemoLine: "\uC5B4\uBA38\uB2C8\uAED8\uC11C\uB294 \uC624\uB298 \uC548\uC5D0 \uB300\uB2F5\uC744
    \uB4E3\uACE0 \uC2F6\uC5B4 \uD558\uC138\uC694."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
