  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_forest_blocked__step_event_week_009_excursion_forest_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298 \uC232\uC5D0 \uAC00\uB3C4 \uB418\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC131\uC778\uC2DD \uC900\uBE44\uAC00 \uC788\uC5B4\uC11C \uC624\uB298\uC740
      \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC7A0\uAE50\uC774\uBA74 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uCC44\uBE44\uB97C \uC9C0\uAE08 \uC2DC\uC791\uD574\uC57C \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC232\uAE38 \uB364\uBD88\uC774 \uCE58\uC6CC\uC84C\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\u2026\uC608."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC70\uAE30\uC5D0 \uBB50\uAC00 \uC788\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC544\uAC00\uC528, \uC624\uB298 \uC2DD\uC774 \uB05D\uB098\uACE0 \uB098\uC11C\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298\uC774 \uC9C0\uB098\uBA74 \uB610 \uBBF8\uB904\uC9C8 \uAC70\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC8C4\uC1A1\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C\uACA0\uC5B4\uC694."
  _nemoLine: "\uC624\uB298 \uC232\uC5D0 \uAC00\uB3C4 \uB418\uB098\uC694?"
  _useCustomVisualState: 0
  _visualState: 0
