MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_forest_blocked__step_event_week_009_excursion_forest_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC232\uAE38 \uC815\uBE44, \uC5B4\uB514\uAE4C\uC9C0 \uB410\uB2E4\uACE0
      \uD588\uC8E0?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC785\uAD6C \uCABD\uAE4C\uC9C0\uB9CC \uC815\uB9AC\uB410\uACE0, \uC548\uCABD\uC740
      \uADF8\uB300\uB85C\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uCABD\uC774 \uADF8\uB300\uB85C\uBA74 \uB204\uAC00 \uB4DC\uB098\uB4E4\uC5B4\uB3C4
      \uBAA8\uB974\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: ...
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC2DD \uB05D\uB098\uACE0 \uB9C8\uC800 \uC815\uB9AC\uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uADF8\uAC74 \uB530\uB85C \uC9C0\uC2DC\uAC00 \uC5C6\uC73C\uC2ED\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9C0\uC2DC\uAC00 \uC5C6\uC73C\uBA74 \uC548 \uD55C\uB2E4\uB294 \uAC70\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC3D\uBC16 \uC232 \uCABD\uC744 \uD55C\uCC38
      \uBD24\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC2DD \uB05D\uB098\uBA74 \uC81C\uAC00 \uC9C1\uC811 \uD655\uC778\uD558\uB7EC
      \uAC08\uAC8C\uC694."
  _nemoLine: "\uC232\uAE38 \uC815\uBE44, \uC5B4\uB514\uAE4C\uC9C0 \uB410\uB2E4\uACE0
    \uD588\uC8E0?"
  _useCustomVisualState: 0
  _visualState: 0
