  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_library_blocked__step_event_week_009_excursion_library_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB3C4\uC11C\uAD00 \uBB38\uC740 \uB2EB\uD600 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC8C4\uC1A1\uD569\uB2C8\uB2E4, \uC544\uAC00\uC528. \uC608\uC2DD \uC804\uAE4C\uC9C0\uB294
      \uB204\uAD6C\uB3C4 \uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uB3C4\uB85D \uB418\uC5B4
      \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544, \uADF8\uB798\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBB38 \uC190\uC7A1\uC774\uC5D0 \uB2FF\uC73C\uB824\uB358
      \uC190\uC744 \uAC70\uB450\uACE0, \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB450 \uC190\uC744 \uC55E\uC73C\uB85C
      \uAC00\uC9C0\uB7F0\uD788 \uBAA8\uC73C\uACE0 \uC790\uB9AC\uB97C \uB5B4\uB2E4."
  _nemoLine: "\uB3C4\uC11C\uAD00 \uBB38\uC740 \uB2EB\uD600 \uC788\uC5C8\uB2E4."
