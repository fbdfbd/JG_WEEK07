MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_basement_direct_default__step_event_week_009_excursion_basement_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC624\uB798\uB41C \uC0C1\uC790\uB4E4\uC774 \uBB38 \uC8FC\uBCC0\uC5D0
      \uD769\uC5B4\uC838 \uC788\uC5C8\uB2E4. \uD45C\uC2DD\uC774 \uBD99\uC740 \uAC83\uB3C4,
      \uC548 \uBD99\uC740 \uAC83\uB3C4 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC74 \uC5B4\uB5BB\uAC8C \uB418\uB294 \uAC70\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uD45C\uC2DD\uC774 \uBD99\uC740 \uAC74 \uBCF4\uAD00\uACE0\uB85C \uC62E\uAE30\uACE0,
      \uB098\uBA38\uC9C0\uB294 \uCC98\uBD84\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD45C\uC2DD\uC740 \uB204\uAC00 \uBD99\uC600\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "...\uC784\uC2DC\uAC00\uC8FC\uB2D8 \uC9C0\uC2DC\uC600\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uB294 \uBAB0\uB790\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD45C\uC2DD \uC5C6\uB294 \uC0C1\uC790
      \uC55E\uC5D0 \uC7A0\uC2DC \uC130\uB2E4. \uB69C\uAED1\uC774 \uC0B4\uC9DD \uB4E4\uB5A0
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "...\uBB58 \uB0A8\uAE30\uACE0 \uBB58 \uBC84\uB9B4\uC9C0, \uB204\uAC00
      \uC815\uD574\uB3C4 \uC815\uD574\uC57C \uD558\uB294 \uAC70\uC600\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD45C\uC2DD \uC5C6\uB294 \uC0C1\uC790\uC758
      \uB69C\uAED1\uC744 \uC5F4\uACE0 \uC548\uC744 \uB4E4\uC5EC\uB2E4\uBD24\uB2E4.
      \uC190\uC774 \uD55C \uBC88 \uBA4E\uC5C8\uB2E4."
  _nemoLine: "\uC624\uB798\uB41C \uC0C1\uC790\uB4E4\uC774 \uBB38 \uC8FC\uBCC0\uC5D0
    \uD769\uC5B4\uC838 \uC788\uC5C8\uB2E4. \uD45C\uC2DD\uC774 \uBD99\uC740 \uAC83\uB3C4,
    \uC548 \uBD99\uC740 \uAC83\uB3C4 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
