MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_basement_direct_default__step_event_week_009_excursion_basement_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC0C1\uC790\uB9C8\uB2E4 \uC791\uC740 \uD45C\uC2DD\uC774 \uBD99\uC5B4
      \uC788\uC5C8\uACE0, \uC774\uC804\uBCF4\uB2E4 \uD6E8\uC52C \uAC00\uC9C0\uB7F0\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4 \uC62E\uAE30\uB824\uB294 \uAC74\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608. \uBCF4\uAD00\uACE0\uB85C \uC815\uB9AC\uD574 \uC62E\uAE38 \uC608\uC815\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9C0\uD558\uC2E4\uC740 \uAC70\uC758 \uBE44\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC815\uB9AC\uB41C\uB2E4\uB294 \uB9D0\uC740 \uB298 \uC774\uC0C1\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC5B4\uB5A4 \uC810\uC774 \uADF8\uB7EC\uC2ED\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0AC\uB77C\uC9C0\uB294 \uAC74 \uC544\uB2C8\uB77C\uB294\uB370, \uB208\uC55E\uC5D0\uC11C\uB294
      \uC5C6\uC5B4\uC9C0\uB2C8\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC00\uC7A5 \uC704 \uC0C1\uC790\uC5D0
      \uBD99\uC740 \uD45C\uC2DD\uC744 \uC870\uC6A9\uD788 \uC77D\uC5B4 \uB0B4\uB824\uAC14\uB2E4."
  _nemoLine: "\uC0C1\uC790\uB9C8\uB2E4 \uC791\uC740 \uD45C\uC2DD\uC774 \uBD99\uC5B4
    \uC788\uC5C8\uACE0, \uC774\uC804\uBCF4\uB2E4 \uD6E8\uC52C \uAC00\uC9C0\uB7F0\uD588\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
