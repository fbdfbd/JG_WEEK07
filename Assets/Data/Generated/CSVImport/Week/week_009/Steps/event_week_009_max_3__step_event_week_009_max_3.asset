  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_max_3__step_event_week_009_max_3
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC131\uC778\uC2DD\uC7A5."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uAC00 \uD638\uC704 \uC790\uACA9\uC73C\uB85C \uC544\uBCA8\uB9AC\uC544
      \uC606\uC5D0 \uC130\uB2E4. \uADC0\uC871\uB4E4\uC758 \uC2DC\uC120\uC774 \uC7A0\uC2DC
      \uB450 \uC0AC\uB78C\uC5D0\uAC8C \uBA38\uBB3C\uB800\uC9C0\uB9CC, \uB9C9\uC2A4\uB294
      \uBB3C\uB7EC\uB098\uC9C0 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C9\uC2A4\uAC00 \uC5EC\uAE30 \uC11C\uB3C4 \uAD1C\uCC2E\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uD5C8\uAC00\uB97C \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAE30\uC0AC\uAC00\uBB38 \uB300\uD45C\uB85C\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC624\uB298\uC740 \uD638\uC704 \uC790\uACA9\uB3C4 \uACB8\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC8FC\uBCC0\uC744 \uD55C \uBC88 \uC0B4\uD53C\uACE0,
      \uB2E4\uC2DC \uC544\uBCA8\uB9AC\uC544\uB97C \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uBD88\uD3B8\uD558\uC2DC\uBA74 \uBC14\uB85C \uBB3C\uB7EC\uB098\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uB2C8\uC694. \uAD1C\uCC2E\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uADF8\uB7FC \uC81C\uAC00 \uC606\uC5D0 \uC788\uACA0\uC2B5\uB2C8\uB2E4.
      \uC55E\uC73C\uB85C\uB3C4."
  _nemoLine: "\uC131\uC778\uC2DD\uC7A5."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
