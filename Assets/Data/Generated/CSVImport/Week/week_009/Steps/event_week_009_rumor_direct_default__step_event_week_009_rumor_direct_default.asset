--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_rumor_direct_default__step_event_week_009_rumor_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC18C\uBB38 \uD5C8\uAC00"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC9D1\uC0AC\uC7A5\uC774 \uBD09\uC778\uB41C \uBD09\uD22C \uD55C \uC7A5\uACFC
      \uBA85\uB2E8 \uD55C \uC7A5\uC744 \uD568\uAED8 \uB4E4\uACE0 \uB4E4\uC5B4\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9D1\uC0AC\uC7A5\uB2D8, \uADF8\uAC8C \uBB50\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\u2026\uC624\uB298 \uC544\uCE68\uC5D0 \uB3C4\uCC29\uD55C \uAC83\uB4E4\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB450 \uAC1C\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC608. \uD558\uB098\uB294 \uCD95\uD558\uAC1D \uBA85\uB2E8\uC774\uACE0,
      \uB2E4\uB978 \uD558\uB098\uB294\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4\uB978 \uD558\uB098\uB294\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC774\uC758 \uC81C\uAE30 \uBB38\uC11C\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uC758 \uC81C\uAE30?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\u2026\uC608. \uBC31\uC791\uC704 \uACC4\uC2B9\uC5D0 \uB300\uD574 \uC815\uC2DD\uC73C\uB85C
      \uC774\uC758\uB97C \uC81C\uAE30\uD55C\uB2E4\uB294 \uB0B4\uC6A9\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uBCF4\uB0C8\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\u2026\uBD09\uC778\uC740 \uC788\uB294\uB370, \uBC1C\uC2E0\uC790\uAC00
      \uC801\uD600 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBA85\uB2E8\uBCF4\uB2E4 \uBA3C\uC800 \uC654\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC608. \uC0C8\uBCBD\uC5D0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4. \uBA85\uB2E8\uBCF4\uB2E4
      \uD55C \uC2DC\uAC04\uCBE4 \uC55E\uC130\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uD55C \uC2DC\uAC04\uC774\uC694."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC608."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uD588\uB294\uC9C0 \uC9D0\uC791\uB3C4 \uBABB \uD558\uC138\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\u2026\uC544\uAC00\uC528, \uC624\uB298\uC740 \uC9D0\uC791\uC73C\uB85C
      \uC6C0\uC9C1\uC774\uC2E4 \uC790\uB9AC\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uC9C1\uC811
      \uBCF4\uACE0 \uC9C1\uC811 \uB4E4\uC73C\uC154\uC57C \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC54C\uACA0\uC5B4\uC694."
  _nemoLine: "\uC9D1\uC0AC\uC7A5\uC774 \uBD09\uC778\uB41C \uBD09\uD22C \uD55C \uC7A5\uACFC
    \uBA85\uB2E8 \uD55C \uC7A5\uC744 \uD568\uAED8 \uB4E4\uACE0 \uB4E4\uC5B4\uC654\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
