  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_max_blocked__step_event_week_009_max_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC758 \uAE30\uC0AC\uB4E4\uC774
      \uC785\uAD6C \uC591\uCABD\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC740 \uC624\uB298 \uBC31\uC791\uAC00
      \uC55E\uC5D0 \uAC80\uC758 \uB9F9\uC57D\uC744 \uB2E4\uC2DC \uBC14\uCE60 \uC608\uC815\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC80\uC758 \uB9F9\uC57D\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC608. \uC55E\uC73C\uB85C\uB3C4 \uBC31\uC791\uAC00\uB97C \uC9C0\uD0A4\uACA0\uB2E4\uB294
      \uB73B\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uB9D0\uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uAC00\uBB38 \uB300\uD45C\uAC00 \uB9F9\uC138\uBB38\uC744 \uC77D\uC744
      \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC785\uAD6C\uC5D0 \uC120 \uAE30\uC0AC\uB4E4\uC744
      \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4\uB4E4 \uC800\uB97C \uC9C0\uD0A4\uB7EC \uC628 \uAC70\uC8E0?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uAE30\uC0AC\uB4E4\uC758 \uAC11\uC637\uC740 \uBC18\uB4EF\uD558\uAC8C
      \uBE5B\uB0AC\uC9C0\uB9CC, \uB204\uAD6C\uB3C4 \uBA3C\uC800 \uB2E4\uAC00\uC624\uC9C0
      \uC54A\uC558\uB2E4."
  _nemoLine: "\uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC758 \uAE30\uC0AC\uB4E4\uC774
    \uC785\uAD6C \uC591\uCABD\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
