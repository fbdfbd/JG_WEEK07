  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_rian_1__step_event_week_009_rian_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC624\uB298 \uC800\uB294 \uD669\uC2E4 \uC774\uB984\uC73C\uB85C \uCD95\uD558\uB97C
      \uC804\uD558\uAC8C \uB420 \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9AC\uC548 \uC5D8\uBC14\uB860\uC73C\uB85C\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB124. \uD558\uC9C0\uB9CC \uC9C0\uAE08\uC740 \uADF8\uB0E5 \uB9AC\uC548\uC73C\uB85C
      \uB9D0\uD558\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB58\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC131\uC778\uC2DD\uC744 \uCD95\uD558\uD569\uB2C8\uB2E4, \uC544\uBCA8\uB9AC\uC544."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC870\uC6A9\uD788 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC624\uB298 \uC774\uD6C4\uB85C \uB9CE\uC740 \uAC83\uC774 \uB2EC\uB77C\uC9C8\uC9C0\uB3C4
      \uBAA8\uB985\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "...\uADF8\uB798\uB3C4 \uC774 \uB9D0\uC740 \uBA3C\uC800 \uD558\uACE0 \uC2F6\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB2EC\uB77C\uC9C0\uB354\uB77C\uB3C4\uC694."
  _nemoLine: "\uC624\uB298 \uC800\uB294 \uD669\uC2E4 \uC774\uB984\uC73C\uB85C \uCD95\uD558\uB97C
    \uC804\uD558\uAC8C \uB420 \uAC81\uB2C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
