--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_max_4__step_event_week_009_max_4
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC131\uC778\uC2DD \uC9C1\uD6C4 \uC815\uC6D0."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC131\uC778\uC2DD\uC774 \uB05D\uB09C \uB4A4, \uC815\uC6D0\uC5D0\uB294
      \uC544\uC9C1 \uCD95\uD558 \uC778\uC0AC\uC758 \uC5EC\uC6B4\uC774 \uB0A8\uC544
      \uC788\uC5C8\uB2E4. \uB9C9\uC2A4\uB294 \uC870\uAE08 \uB5A8\uC5B4\uC9C4 \uACF3\uC5D0\uC11C
      \uAE30\uB2E4\uB9AC\uB2E4 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C \uB2E4\uAC00\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4, \uBC31\uC791\uB2D8."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC775\uC219\uD558\uC9C0 \uC54A\uC740 \uD638\uCE6D\uC774\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC774\uC81C\uB294 \uADF8\uB807\uAC8C \uBD80\uB974\uB294 \uAC8C \uB9DE\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C9\uC2A4\uAE4C\uC9C0 \uADF8\uB7EC\uB2C8\uAE4C \uC774\uC0C1\uD558\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uD55C \uAC78\uC74C \uAC00\uAE4C\uC774 \uB2E4\uAC00\uC654\uB2E4.
      \uACF5\uC2DD\uC801\uC778 \uD45C\uC815\uC774 \uC870\uAE08 \uD480\uB824 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uC9C0\uAE08\uC740 \uB9C9\uC2A4\uB85C \uB9D0\uD574\uB3C4
      \uB418\uACA0\uC2B5\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB124."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC5B4\uC81C \uD55C \uB9D0, \uAE30\uC5B5\uD558\uC2ED\uB2C8\uAE4C? \uBC1C\uD14C\uB9AC\uC628\uC774
      \uB3C4\uC6B8 \uC218 \uC788\uB2E4\uACE0 \uD588\uB358 \uB9D0.."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAE30\uC5B5\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uAF2D \uAE30\uC5B5\uD574\uC8FC\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4.
      \uB2F9\uC2E0\uC744 \uB3D5\uB294 \uC77C\uC785\uB2C8\uB2E4."
  _nemoLine: "\uC131\uC778\uC2DD \uC9C1\uD6C4 \uC815\uC6D0."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
