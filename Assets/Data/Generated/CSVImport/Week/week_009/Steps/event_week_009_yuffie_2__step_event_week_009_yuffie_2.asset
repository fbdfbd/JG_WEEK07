--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_yuffie_2__step_event_week_009_yuffie_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uC624\uB298, \uD6C4\uC791\uAC00\uC758 \uBCF4\uD638\uB97C \uBC1B\uC544\uB4E4\uC774\uC168\uC73C\uBA74
      \uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC720\uD53C\uB294 \uADF8\uAC8C \uC88B\uC740 \uC120\uD0DD\uC774\uB77C\uACE0
      \uBBFF\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uB35C \uC678\uB86D\uACE0, \uB35C \uB2E4\uCE58\uACE0, \uB35C
      \uBB34\uC11C\uC6B8 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB300\uC2E0 \uD6C4\uC791\uAC00 \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uAC8C
      \uB418\uACA0\uC8E0."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uADF8\uAC74 \uB9DE\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC720\uD53C\uB294 \uADF8\uAC8C \uAD1C\uCC2E\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uBC14\uB85C \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uC644\uC804\uD788 \uAD1C\uCC2E\uB2E4\uACE0\uB294 \uBABB \uD574\uC694.
      \uADF8\uB798\uB3C4 \uC544\uC8FC \uB098\uC05C \uACF3\uC774\uB77C\uACE0\uB3C4
      \uC0DD\uAC01\uD558\uC9C0 \uC54A\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC720\uD53C\uB2F5\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uADF8\uB798\uC11C \uC774\uB807\uAC8C \uB9D0\uC500\uB4DC\uB9AC\uB294
      \uAC70\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB450 \uC0AC\uB78C \uC0AC\uC774\uC5D0 \uB300\uB2F5\uBCF4\uB2E4 \uBB34\uAC70\uC6B4
      \uCE68\uBB35\uC774 \uB0B4\uB824\uC549\uC558\uB2E4."
  _nemoLine: "\uC624\uB298, \uD6C4\uC791\uAC00\uC758 \uBCF4\uD638\uB97C \uBC1B\uC544\uB4E4\uC774\uC168\uC73C\uBA74
    \uD574\uC694."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
