  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_excursion_garden_direct_stable__step_event_week_009_excursion_garden_direct_stable
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00-\uC548\uC815"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD06C\uB808\uC774\uD504 \uBA38\uD2C0 \uAC00\uC9C0 \uB05D\uC5D0 \uAF43
      \uBA87 \uC1A1\uC774\uAC00 \uD53C\uC5B4 \uC788\uC5C8\uB2E4. \uC804\uBD80\uB294
      \uC544\uB2C8\uC5C8\uC9C0\uB9CC, \uBA87 \uC1A1\uC774\uB294 \uBD84\uBA85\uD788
      \uD53C\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E8\uD14C."
  - _speaker: {fileID: 11400000, guid: 31350c3de27bb9c43a5cd19e30d43ba8, type: 2}
    _text: "\uB124, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5EC\uC12F \uC0B4 \uB54C, \uC81C\uAC00 \uC774 \uB098\uBB34\uB97C \uBCF4\uBA74\uC11C
      \uB098\uB791 \uC788\uC73C\uBA74 \uB2E4 \uC544\uD30C\uC9C4\uB2E4\uACE0 \uD588\uC5C8\uB294\uB370,
      \uAE30\uC5B5\uD558\uC138\uC694?"
  - _speaker: {fileID: 11400000, guid: 31350c3de27bb9c43a5cd19e30d43ba8, type: 2}
    _text: "\uAE30\uC5B5\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB54C \uC26C\uACE0 \uC788\uB294 \uAC70\uB77C\uACE0 \uD558\uC168\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E8\uD14C \uB9D0\uC774 \uB9DE\uC558\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB098\uBB34\uB97C \uC62C\uB824\uB2E4\uBD24\uB2E4.
      \uAF43 \uD55C \uC1A1\uC774\uAC00 \uC544\uCE68 \uBC14\uB78C\uC5D0 \uC544\uC8FC
      \uC0B4\uC9DD \uD754\uB4E4\uB838\uB2E4."
  _nemoLine: "\uD06C\uB808\uC774\uD504 \uBA38\uD2C0 \uAC00\uC9C0 \uB05D\uC5D0 \uAF43
    \uBA87 \uC1A1\uC774\uAC00 \uD53C\uC5B4 \uC788\uC5C8\uB2E4. \uC804\uBD80\uB294
    \uC544\uB2C8\uC5C8\uC9C0\uB9CC, \uBA87 \uC1A1\uC774\uB294 \uBD84\uBA85\uD788
    \uD53C\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
