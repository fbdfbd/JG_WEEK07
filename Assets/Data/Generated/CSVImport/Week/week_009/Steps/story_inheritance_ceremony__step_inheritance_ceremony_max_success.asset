--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: story_inheritance_ceremony__step_inheritance_ceremony_max_success
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uACC4\uC2B9 \uC120\uC5B8\uC744 \uC55E\uB450\uACE0, \uAC00\uBB38 \uC5B4\uB978\uB4E4
      \uC911 \uD55C \uBA85\uC774 \uC55E\uC73C\uB85C \uB098\uC130\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uADF8 \uC606\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: bb92d18cb19ba9944ac71077eb8aa4c5, type: 2}
    _text: "\uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uBC31\uC791\uAC00\uC758 \uC548\uC815\uC801\uC778
      \uACC4\uC2B9\uC744 \uC704\uD574, \uBC1C\uD14C\uB9AC\uC628\uC740 \uAC00\uAE4C\uC774\uC5D0\uC11C
      \uBCF4\uC88C\uD560 \uC900\uBE44\uAC00 \uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBA87\uBA87 \uADC0\uC871\uC758 \uC2DC\uC120\uC774 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
      \uD5A5\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uAC00 \uD55C \uAC78\uC74C \uC55E\uC73C\uB85C \uB098\uC624\uB824\uB294
      \uC21C\uAC04, \uC544\uBCA8\uB9AC\uC544\uAC00 \uBA3C\uC800 \uB9D0\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACE0\uB9D9\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uC81C \uC55E\uC5D0
      \uC11C\uC2E4 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uAC00 \uBA48\uCDC4\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uB2E4\uBA74 \uC81C\uAC00 \uCCAD\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC7A0\uC2DC \uC544\uBCA8\uB9AC\uC544\uB97C \uBCF4\uB2E4\uAC00
      \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uC606\uC5D0 \uC788\uACA0\uC2B5\uB2C8\uB2E4."
  _nemoLine: "\uACC4\uC2B9 \uC120\uC5B8\uC744 \uC55E\uB450\uACE0, \uAC00\uBB38 \uC5B4\uB978\uB4E4
    \uC911 \uD55C \uBA85\uC774 \uC55E\uC73C\uB85C \uB098\uC130\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
