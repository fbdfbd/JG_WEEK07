  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_009_yuffie_0__step_event_week_009_yuffie_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC624\uB298\uC740 \uD6C4\uC791\uAC00\uC758 \uB73B\uC744 \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uC804\uD558\uB7EC \uC654\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uC2A8 \uB73B\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uD6C4\uC791\uAC00\uB294 \uC544\uBCA8\uB9AC\uC544\uB2D8\uC744 \uB192\uC774
      \uD3C9\uAC00\uD558\uACE0 \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "..\uACE0\uB9D9\uB2E4\uACE0 \uD574\uC57C\uD558\uB294 \uAC74\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uD6C4\uC791\uAC00\uB294 \uADF8\uB798\uC11C \uC544\uBCA8\uB9AC\uC544\uB2D8\uC774
      \uD640\uB85C \uBC84\uD2F0\uAC8C \uD558\uACE0\uC2F6\uC9C0 \uC54A\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC29\uAE08 \uD55C \uB9D0\uC774 \uBD80\uB2F4\uC2A4\uB7EC\uC6B8 \uC218\uB3C4
      \uC788\uB2E4\uB294 \uAC74 \uC54C\uACE0 \uC788\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC54C\uC544\uC694. \uADF8\uB798\uB3C4 \uC88B\uC740 \uB73B\uC774\uB77C\uACE0
      \uB9D0\uC500\uB4DC\uB9AC\uACE0 \uC2F6\uC5C8\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC88B\uC740 \uB73B\uC774\uB77C.."
  _nemoLine: "\uC624\uB298\uC740 \uD6C4\uC791\uAC00\uC758 \uB73B\uC744 \uB9C8\uC9C0\uB9C9\uC73C\uB85C
    \uC804\uD558\uB7EC \uC654\uC5B4\uC694."
