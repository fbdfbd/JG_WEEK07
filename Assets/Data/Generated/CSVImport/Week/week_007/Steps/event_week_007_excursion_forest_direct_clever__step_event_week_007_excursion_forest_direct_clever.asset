--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_excursion_forest_direct_clever__step_event_week_007_excursion_forest_direct_clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC624\uB450\uB9C9 \uAD74\uB69D\uC5D0\uC11C \uAE34 \uC5F0\uAE30\uAC00
      \uC62C\uB77C\uC624\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5F0\uAE30\uAC00 \uD3C9\uC18C\uBCF4\uB2E4 \uAE41\uB2C8\uB2E4. \uC548\uCABD\uC744
      \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uB4E4\uC5B4\uC624\uAC8C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBD88\uC774 \uC798 \uC548 \uC7A1\uD78C \uAC81\uB2C8\uAE4C? \uD639\uC2DC
      \uBAB8\uC774 \uBD88\uD3B8\uD558\uC2E0 \uAC74 \uC544\uB2CC\uC9C0 \uD655\uC778\uD558\uB7EC
      \uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uB098\uBB34\uAC00 \uB35C \uB9D0\uB790\uC5B4. \uB299\uC740 \uAC8C \uBCD1\uC774\uBA74
      \uBCD1\uC774\uACE0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC232\uC5D0 \uC0AC\uB78C\uC774 \uB4DC\uB098\uB4E0 \uD754\uC801\uC774
      \uC788\uC2B5\uB2C8\uB2E4. \uB0AE\uC5D0 \uB2E4\uB140\uAC04 \uC0AC\uB78C\uC740
      \uC544\uB2C8\uACA0\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uBC24\uC5D0 \uC624\uB294 \uC0AC\uB78C\uC774 \uAC00\uB054 \uC788\uC9C0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAD70\uC9C0 \uBCF4\uC168\uB2E4\uBA74 \uB9D0\uC500\uD574 \uC8FC\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uBCF4\uB824\uACE0 \uC548 \uD588\uC5B4. \uBAA8\uB974\uB294 \uAC8C \uC624\uB798
      \uC0AC\uB294 \uBC95\uC77C \uB54C\uB3C4 \uC788\uC73C\uB2C8\uAE4C."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC7A0\uC2DC \uC624\uB450\uB9C9 \uC548\uC744
      \uB458\uB7EC\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4\uC74C\uC5D0 \uB610 \uB204\uAD70\uAC00 \uC624\uBA74 \uC54C\uB824\uC8FC\uC138\uC694.
      \uC7A5\uC791\uACFC \uBB3C\uB3C4 \uBCF4\uB0B4\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uD544\uC694 \uC5C6\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD544\uC694 \uC5C6\uC73C\uC154\uB3C4 \uBCF4\uB0BC \uAC81\uB2C8\uB2E4.
      \uD63C\uC790 \uACC4\uC2E0 \uBD84\uC744 \uADF8\uB0E5 \uB458 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC0AC\uB0E5\uC9C0\uAE30\uB294 \uC9E7\uAC8C \uC6C3\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uBC31\uC791\uAC00 \uC0AC\uB78C \uAC19\uC544\uC84C\uAD70."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uC9C1\uC740 \uC544\uB2D9\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uACE7
      \uADF8\uB807\uAC8C \uD574\uC57C\uACA0\uC9C0\uC694."
  _nemoLine: "\uC624\uB450\uB9C9 \uAD74\uB69D\uC5D0\uC11C \uAE34 \uC5F0\uAE30\uAC00
    \uC62C\uB77C\uC624\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
