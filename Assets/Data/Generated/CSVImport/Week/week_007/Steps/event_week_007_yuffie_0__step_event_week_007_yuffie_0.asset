  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_yuffie_0__step_event_week_007_yuffie_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC548\uB155\uD558\uC138\uC694. \uC720\uD53C \uB85C\uC0AC\uBCA8\uC774\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uB155\uD558\uC138\uC694. \uC544\uBCA8\uB9AC\uC544\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC5B4\uBA38\uB2C8\uAED8\uC11C \uC131\uC778\uC2DD\uC744 \uCD95\uD558\uB4DC\uB9B0\uB2E4\uACE0
      \uC804\uD558\uC168\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD6C4\uC791\uBD80\uC778\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uB9CE\uC740 \uC900\uBE44\uAC00 \uD544\uC694\uD560\uD14C\uB2C8,
      \uD544\uC694\uD55C \uAC83\uC774 \uC788\uC73C\uBA74 \uB9D0\uC500\uD574 \uB2EC\uB77C\uACE0\uB3C4
      \uD558\uC168\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C \uC720\uD53C\uB2D8\uC774 \uC9C1\uC811 \uC624\uC168\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB610\uB798\uB07C\uB9AC \uC778\uC0AC\uB97C \uB098\uB204\uB294 \uAC83\uB3C4
      \uC88B\uACA0\uB2E4\uACE0 \uD558\uC168\uC5B4\uC694. \uC131\uC778\uC2DD \uC900\uBE44\uB294
      \uB9CE\uC774 \uBC14\uC058\uC2E0\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC870\uAE08\uC694."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uADF8\uB7FC \uC624\uB798 \uBD99\uC7A1\uC9C0 \uC54A\uC744\uAC8C\uC694.
      \uC624\uB298\uC740 \uC778\uC0AC\uB9CC \uB4DC\uB9AC\uB7EC \uC654\uC5B4\uC694."
  _nemoLine: "\uC548\uB155\uD558\uC138\uC694. \uC720\uD53C \uB85C\uC0AC\uBCA8\uC774\uC5D0\uC694."
  _useCustomVisualState: 0
  _visualState: 0
