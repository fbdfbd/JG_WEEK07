  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_yuffie_2__step_event_week_007_yuffie_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544 \uB2D8\uC740 \uB108\uBB34 \uD63C\uC790 \uC11C
      \uC788\uB294 \uAC83\uCC98\uB7FC \uBCF4\uC5EC\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uB204\uAC00 \uACC1\uC5D0 \uC788\uC5B4\uB3C4, \uACB0\uC815\uC740
      \uD63C\uC790 \uD574\uC57C \uD558\uB294 \uC0AC\uB78C\uCC98\uB7FC\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C\uAC00 \uD574\uC57C\uD558\uB294 \uC77C\uB4E4\uC774\uB2C8\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uC804\uBD80 \uD63C\uC790 \uD560 \uD544\uC694\uB294
      \uC5C6\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB300\uC2E0 \uC815\uD574\uC8FC\uB294 \uC0AC\uB78C\uC774 \uD544\uC694\uD558\uB2E4\uB294
      \uB73B\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC544\uB2C8\uC694. \uB300\uC2E0 \uBB34\uAC8C\uB97C \uB098\uB220 \uC904
      \uC0AC\uB78C\uC774 \uD544\uC694\uD558\uB2E4\uB294 \uB73B\uC774\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB9D0\uC744 \uC774\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uD6C4\uC791\uAC00\uC758 \uC774\uB984\uC740 \uBB34\uAC70\uC6CC\uC694.
      \uD558\uC9C0\uB9CC \uADF8\uB9CC\uD07C \uB4E0\uB4E0\uD55C \uBC29\uD328\uAC00
      \uB429\uB2C8\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544 \uB2D8\uC740 \uB108\uBB34 \uD63C\uC790 \uC11C
    \uC788\uB294 \uAC83\uCC98\uB7FC \uBCF4\uC5EC\uC694."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
