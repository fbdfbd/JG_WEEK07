--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_yuffie_4__step_event_week_007_yuffie_4
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uC624\uB298\uC740 \uC5B4\uBA38\uB2C8 \uB9D0\uC774 \uC544\uB2C8\uB77C,
      \uC81C \uB9D0\uC744 \uD558\uB7EC \uC654\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC720\uD53C\uC758 \uB9D0\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uD6C4\uC791\uAC00\uC758 \uBCF4\uD638 \uC544\uB798 \uC788\uC73C\uBA74,
      \uC544\uBCA8\uB9AC\uC544 \uB2D8\uC740 \uB35C \uB2E4\uCE60 \uC218 \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC8C \uC720\uD53C \uC0DD\uAC01\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD6C4\uC791\uAC00\uC758 \uC0DD\uAC01\uC774\uAE30\uB3C4 \uD558\uACA0\uC8E0."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4\uAC00 \uB2E4\uC2DC
      \uB4E4\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB9DE\uC544\uC694. \uD558\uC9C0\uB9CC \uC81C\uAC00 \uC544\uBCA8\uB9AC\uC544\uB97C
      \uAC71\uC815\uD558\uB294 \uAC83\uB3C4 \uC9C4\uC9DC\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBCF4\uD638\uBC1B\uC73C\uBA74 \uBB34\uC5C7\uC744 \uC783\uAC8C \uB418\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uC544\uB9C8\uB3C4 \uD63C\uC790 \uC815\uD560 \uC218 \uC788\uB294 \uAC83\uB4E4\uC774\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0\uB370\uB3C4 \uAD8C\uD558\uB294 \uAC74\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uC544\uBCA8\uB9AC\uC544\uAC00 \uB2E4\uCE58\uC9C0 \uC54A\uB294\uAC8C
      \uB354 \uC911\uC694\uD574\uC694."
  _nemoLine: "\uC624\uB298\uC740 \uC5B4\uBA38\uB2C8 \uB9D0\uC774 \uC544\uB2C8\uB77C,
    \uC81C \uB9D0\uC744 \uD558\uB7EC \uC654\uC5B4\uC694."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
