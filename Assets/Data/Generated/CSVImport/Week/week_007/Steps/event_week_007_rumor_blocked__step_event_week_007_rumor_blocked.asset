  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_rumor_blocked__step_event_week_007_rumor_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uACBD\uBE44\uB300\uC7A5\uC774 \uBCF4\uACE0\uC11C\uB97C \uB4E0 \uCC44
      \uBCF5\uB3C4\uB97C \uC9C0\uB098\uAC00\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC74 \uBB50\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC77C\uC0C1\uC801\uC778 \uB3D9\uD5A5 \uBCF4\uACE0\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC1C\uD14C\uB9AC\uC628 \uCABD \uC598\uAE30\uB3C4 \uC788\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uADF8\uCABD\uC740 \uD3C9\uC18C\uB300\uB85C \uD6C8\uB828 \uC911\uC778
      \uAC83\uC73C\uB85C \uC54C\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD3C9\uC18C\uB300\uB85C\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC608. \uBC1C\uD14C\uB9AC\uC628\uC740 \uC6D0\uB798 \uD6C8\uB828\uC744
      \uC790\uC8FC \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB798\uC694?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC608. \uC131\uC778\uC2DD \uC988\uC74C\uC5D4 \uB354 \uADF8\uB807\uC2B5\uB2C8\uB2E4.
      \uCD95\uD558 \uC758\uB840\uC5D0 \uCC38\uC5EC\uD558\uAE30 \uC704\uD55C \uAC83\uC774\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB807\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC608."
  _nemoLine: "\uACBD\uBE44\uB300\uC7A5\uC774 \uBCF4\uACE0\uC11C\uB97C \uB4E0 \uCC44
    \uBCF5\uB3C4\uB97C \uC9C0\uB098\uAC00\uACE0 \uC788\uC5C8\uB2E4."
