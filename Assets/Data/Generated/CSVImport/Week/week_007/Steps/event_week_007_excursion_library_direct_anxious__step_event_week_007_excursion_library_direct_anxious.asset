  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_excursion_library_direct_anxious__step_event_week_007_excursion_library_direct_anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC7A5\uBD80\uB97C \uC77D\uC744\uC218\uB85D
      \uB9D0\uC774 \uC904\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC22B\uC790\uB294 \uC0DD\uAC01\uBCF4\uB2E4 \uC815\uD655\uD558\uAC8C
      \uBB34\uB108\uC9C4 \uACF3\uC744 \uBCF4\uC5EC\uC8FC\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C \uAC83 \uAC19\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC544\uAC00\uC528?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB798\uC11C \uB354 \uBB34\uC11C\uC6CC\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC544\uBC84\uC9C0\uC758 \uC9E7\uC740
      \uBA54\uBAA8\uB97C \uBC1C\uACAC\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC218\uD655\uC774 \uC904\uC5B4\uB4E0 \uD574\uC5D0\uB3C4 \uC18C\uC791\uB18D\uC758
      \uBAAB\uC740 \uC904\uC774\uC9C0 \uB9D0 \uAC83. \uC904\uC5EC\uC57C \uD560 \uB54C\uB294
      \uB0B4 \uBAAB\uBD80\uD130."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBAB0\uB790\uC744 \uB54C\uBCF4\uB2E4, \uC774\uC81C \uB354 \uBCF4\uC5EC\uC694."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC7A5\uBD80\uB97C \uC77D\uC744\uC218\uB85D
    \uB9D0\uC774 \uC904\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
