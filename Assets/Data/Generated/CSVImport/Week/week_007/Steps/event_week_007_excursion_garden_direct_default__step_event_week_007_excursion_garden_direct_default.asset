  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_excursion_garden_direct_default__step_event_week_007_excursion_garden_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC7A5\uBBF8 \uD654\uB2E8\uC5D0 \uD53C\uC9C0\uC54A\uC740 \uAF43\uBD09\uC624\uB9AC\uB4E4\uC774
      \uC904\uC744 \uC9C0\uC5B4 \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACE7 \uAF43\uC774 \uD53C\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 31350c3de27bb9c43a5cd19e30d43ba8, type: 2}
    _text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4, \uC544\uAC00\uC528. \uD55C\uB450 \uC8FC
      \uC548\uC5D0\uB294 \uD544 \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC131\uC778\uC2DD \uC804\uC5D0\uB294 \uD544\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: 31350c3de27bb9c43a5cd19e30d43ba8, type: 2}
    _text: "\uC6B4\uC774 \uC88B\uC73C\uBA74 \uADF8\uB807\uACA0\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBD09\uC624\uB9AC \uD558\uB098 \uC55E\uC5D0
      \uC11C\uC11C \uAF43\uC744 \uC9C0\uCF1C\uBCF4\uC558\uB2E4."
  _nemoLine: "\uC7A5\uBBF8 \uD654\uB2E8\uC5D0 \uD53C\uC9C0\uC54A\uC740 \uAF43\uBD09\uC624\uB9AC\uB4E4\uC774
    \uC904\uC744 \uC9C0\uC5B4 \uC11C \uC788\uC5C8\uB2E4."
