--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_millia_blocked__step_event_week_007_millia_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uBC31\uC791\uAC00 \uC7AC\uC815 \uD604\uD669
      \uC815\uB9AC\uBCF8\uC774 \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC774\uC81C\uB294 \uC774\uB7F0 \uBB38\uC11C\uB4E4\uB3C4 \uC870\uAE08\uC529
      \uC775\uD600\uB450\uC154\uC57C \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC22B\uC790\uAC00 \uB108\uBB34 \uB9CE\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC218\uC785, \uC9C0\uCD9C, \uBD80\uCC44, \uC9C0\uC6D0 \uC870\uAC74\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9C0\uC6D0 \uC870\uAC74\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC5D0\uC11C \uC81C\uC548\uD55C
      \uC870\uD56D\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBB38\uC11C \uC544\uB798\uCABD\uC5D0
      \uC791\uAC8C \uC801\uD78C \uBB38\uC7A5\uC744 \uC190\uB05D\uC73C\uB85C \uC9DA\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774 \uBD80\uBD84\uC740 \uC65C\uC774\uB807\uAC8C \uC791\uAC8C \uC4F0\uC600\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC138\uBD80 \uC870\uAC74\uC774\uAE30 \uB54C\uBB38\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC22B\uC790\uB294 \uBCF4\uC774\uB294\uB370, \uBB34\uC5C7\uC744 \uB73B\uD558\uB294\uC9C0\uB294
      \uC798 \uBAA8\uB974\uACA0\uB124\uC694."
  _nemoLine: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uBC31\uC791\uAC00 \uC7AC\uC815 \uD604\uD669
    \uC815\uB9AC\uBCF8\uC774 \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
