  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_millia_0__step_event_week_007_millia_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uC778\uC7A5\uC774 \uCC0D\uD78C
      \uBB38\uC11C \uBB36\uC74C\uC774 \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC5EC
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC548\uB155\uD558\uC138\uC694. \uBC00\uB9AC\uC544 \uBCA0\uB974\uB514\uC544\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC7AC\uC815 \uBB38\uC11C\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB124. \uBC31\uC791\uAC00 \uC7AC\uC815 \uD604\uD669 \uC815\uB9AC\uBCF8\uC774\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC00\uB9AC\uC544\uAC00 \uAC00\uC838\uC654\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB124. \uC544\uBE60\uAC00 \uAF2D \uC77D\uC5B4\uBCF4\uB77C\uACE0 \uD588\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC88B\uC740 \uB73B\uC73C\uB85C\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uBB38\uC11C \uBB36\uC74C\uC744 \uB0B4\uB824\uB2E4\uBD24\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uADF8\uAC74 \uC77D\uC5B4\uBD10\uC57C \uC54C\uC544\uC694."
  _nemoLine: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uC778\uC7A5\uC774 \uCC0D\uD78C
    \uBB38\uC11C \uBB36\uC74C\uC774 \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC5EC
    \uC788\uC5C8\uB2E4."
