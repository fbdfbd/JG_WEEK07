  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_yuffie_1__step_event_week_007_yuffie_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uD3C9\uC18C\uCC98\uB7FC \uB2E8\uC815\uD558\uAC8C
      \uC549\uC544 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544 \uB2D8."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB124, \uC720\uD53C\uB2D8."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC800\uB294 \uD6C4\uC791\uAC00\uC758 \uB538\uB85C \uC0AC\uB294 \uC77C\uC774
      \uAC00\uB054 \uD3B8\uD558\uB2E4\uACE0 \uC0DD\uAC01\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD3B8\uD558\uB2E4\uACE0\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uC815\uD574\uC9C4 \uC77C\uC774 \uB9CE\uC73C\uB2C8\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD63C\uC790 \uC815\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB418\uC5B4\uC11C\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uBB34\uC5C7\uC744 \uC785\uC744\uC9C0, \uC5B4\uB514\uC5D0 \uC124\uC9C0,
      \uB204\uAD6C\uC5D0\uAC8C \uC778\uC0AC\uD560\uC9C0. \uAC70\uC758 \uB2E4 \uC815\uD574\uC838
      \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2F5\uB2F5\uD558\uC9C0\uB294 \uC54A\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC7A0\uC2DC \uC0DD\uAC01\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB2F5\uB2F5\uD560 \uB54C\uB3C4 \uC788\uC5B4\uC694. \uADF8\uB798\uB3C4
      \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB0A0\uAE4C \uB450\uB835\uC9C0\uB294
      \uC54A\uC544\uC694."
  _nemoLine: "\uC720\uD53C\uB294 \uD3C9\uC18C\uCC98\uB7FC \uB2E8\uC815\uD558\uAC8C
    \uC549\uC544 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
