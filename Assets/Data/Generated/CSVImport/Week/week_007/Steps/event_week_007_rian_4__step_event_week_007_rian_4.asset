MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_rian_4__step_event_week_007_rian_4
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uD669\uC2E4\uC740 \uC800\uB97C \uB2E4\uC2DC \uBD80\uB974\uB824 \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C \uC9C0\uAE08\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uC758 \uC131\uC778\uC2DD \uB54C\uBB38\uC785\uB2C8\uB2E4.
      \uADC0\uC871\uB4E4\uC774 \uBAA8\uB450 \uBCF4\uB294 \uC790\uB9AC\uB2C8\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544 \uB54C\uBB38\uC774\uB77C\uAE30\uBCF4\uB2E4\uB294,
      \uADF8 \uC790\uB9AC\uAC00 \uD544\uC694\uD588\uB358 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uB97C \uB611\uBC14\uB85C
      \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uB798\uC11C \uB9D0\uD558\uB7EC \uC654\uC2B5\uB2C8\uB2E4. \uC544\uBCA8\uB9AC\uC544\uC758
      \uC131\uC778\uC2DD\uC774, \uC544\uBCA8\uB9AC\uC544\uB9CC\uC758 \uC77C\uC774
      \uC544\uB2C8\uAC8C \uB420\uC9C0\uB3C4 \uBAA8\uB974\uB2C8\uAE4C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7EC\uBA74 \uB9AC\uC548\uC740 \uC81C \uCABD\uC5D0 \uC11C\uC788\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "...\uC544\uC9C1\uC740 \uC81C \uB73B\uB300\uB85C \uC6C0\uC9C1\uC77C \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4. \uADF8\uB798\uB3C4 \uC81C\uAC00 \uC5B4\uB5A4 \uC2DD\uC73C\uB85C
      \uC4F0\uC774\uB824\uB294\uC9C0\uB294 \uC555\uB2C8\uB2E4."
  _nemoLine: "\uD669\uC2E4\uC740 \uC800\uB97C \uB2E4\uC2DC \uBD80\uB974\uB824 \uD569\uB2C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
