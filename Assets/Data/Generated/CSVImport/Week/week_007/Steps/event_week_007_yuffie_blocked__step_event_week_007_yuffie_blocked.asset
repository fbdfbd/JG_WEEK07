  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_yuffie_blocked__step_event_week_007_yuffie_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uD6C4\uC791\uAC00\uC5D0\uC11C \uBCF4\uB0B8
      \uC120\uBB3C \uBAA9\uB85D\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uD6C4\uC791\uAC00\uC5D0\uC11C \uACA8\uC6B8 \uC678\uD22C\uC640 \uC7A5\uAC11\uC744
      \uBCF4\uB0B4\uC624\uC168\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB610\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608. \uC544\uAC00\uC528\uAED8 \uD544\uC694\uD560 \uAC83\uC774\uB77C\uBA70
      \uCC59\uACA8\uC8FC\uC2E0 \uB4EF\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098\uB294 \uB2EC\uB77C\uACE0 \uD55C \uC801 \uC5C6\uB294\uB370."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC88B\uC740 \uB73B\uC73C\uB85C \uBCF4\uB0B4\uC2E0 \uBB3C\uAC74\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC88B\uC740 \uB73B\uC774\uBA74 \uB2E4 \uBC1B\uC544\uC57C \uD574\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uAC70\uC808\uD558\uBA74 \uC2E4\uB840\uAC00 \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC120\uBB3C\uC778\uB370, \uC120\uBB3C \uAC19\uC9C0\uAC00 \uC54A\uB124\uC694.."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBB38\uC11C\uB97C \uC811\uC9C0 \uBABB\uD55C
      \uCC44 \uD55C\uCC38 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  _nemoLine: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uD6C4\uC791\uAC00\uC5D0\uC11C \uBCF4\uB0B8
    \uC120\uBB3C \uBAA9\uB85D\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
