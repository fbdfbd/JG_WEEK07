--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_excursion_forest_direct_curious__step_event_week_007_excursion_forest_direct_curious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5F0\uAE30\uAC00 \uB610 \uC62C\uB77C\uC624\uB124\uC694. \uB4E4\uC5B4\uAC00\uB3C4
      \uB420\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uB4E4\uC5B4\uC624\uAC8C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAF64 \uC624\uB798 \uD0C0\uACE0 \uC788\uB358\uB370, \uBD88 \uC870\uC808\uC774
      \uC798 \uC548 \uB41C \uAC74\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uB098\uBB34\uAC00 \uB35C \uB9D0\uB790\uB098 \uBD10."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C\uAC00 \uB3C4\uC640\uB4DC\uB9B4 \uC77C\uC740 \uC5C6\uC744\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uB410\uC5B4. \uC549\uC544."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC694\uC998\uB3C4 \uC5EC\uAE30\uC11C \uC9C0\uB0B4\uC2DC\uB294 \uAC74
      \uB611\uAC19\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uADF8\uB0E5 \uC9C0\uB0B4\uC9C0. \uC624\uB798\uC804\uBD80\uD130 \uD558\uB358
      \uB300\uB85C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD63C\uC790 \uACC4\uC2DC\uBA74 \uC2EC\uC2EC\uD558\uC9C0 \uC54A\uC73C\uC138\uC694?"
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uC790\uB124\uB4E4\uC774 \uAC00\uB054 \uC624\uC796\uC544."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800 \uB9D0\uACE0\uB3C4 \uB204\uAC00 \uC635\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uBC24\uC5D0 \uAC00\uB054 \uB9D0\uBC1C\uAD7D \uC18C\uB9AC\uAC00 \uB4E4\uB824."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAD70\uC9C0\uB294 \uBAA8\uB974\uC2DC\uACE0\uC694?"
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uC5B4\uB450\uC6B0\uB2C8\uAE4C \uBAA8\uB974\uC9C0. \uB098\uB294 \uB0B4\uB2E4\uBCF4\uC9C0
      \uC54A\uC544."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uBB34\uC12D\uC9C0\uB294 \uC54A\uC73C\uC138\uC694?"
  - _speaker: {fileID: 11400000, guid: ee324d7a600a7754290ae04a00012f5b, type: 2}
    _text: "\uB299\uC73C\uBA74 \uBB34\uC11C\uC6B4 \uAC8C \uC904\uC5B4\uB4E4\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0 \uAC74\uAC00\uC694."
  _nemoLine: "\uC5F0\uAE30\uAC00 \uB610 \uC62C\uB77C\uC624\uB124\uC694. \uB4E4\uC5B4\uAC00\uB3C4
    \uB420\uAE4C\uC694?"
  _useCustomVisualState: 0
  _visualState: 0
