  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_rian_0__step_event_week_007_rian_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uCC98\uC74C\uBD59\uACA0\uC2B5\uB2C8\uB2E4, \uC544\uBCA8\uB9AC\uC544."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uD3B8\uC9C0\uC5D0 \uCC0D\uD78C \uBB38\uC7A5, \uBCF4\uC168\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBD24\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uAC8C \uB2F5\uC774\uC5D0\uC694. \uB2E4\uB978 \uC124\uBA85\uC740...
      \uAE38\uC5B4\uC11C \uC624\uB298\uC740 \uBABB \uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD669\uC2E4\uC5D0\uC11C \uC628\uAC70\uBA74 \uB2F9\uC2E0\uC740.."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uAC74 \uB2E4\uC74C\uC5D0. \uC624\uB298\uC740 \uC778\uC0AC\uB9CC
      \uD558\uB7EC \uC654\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC7A0\uC2DC \uCE68\uBB35\uD588\uB2E4. \uADF8\uB7EC\uB2E4
      \uC9E7\uAC8C \uB367\uBD99\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uCCAB \uC778\uC0AC\uAC00 \uB108\uBB34 \uB2A6\uC5C8\uB124\uC694. \uBBF8\uC548\uD574\uC694."
  _nemoLine: "\uCC98\uC74C\uBD59\uACA0\uC2B5\uB2C8\uB2E4, \uC544\uBCA8\uB9AC\uC544."
  _useCustomVisualState: 0
  _visualState: 0
