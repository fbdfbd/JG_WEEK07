--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_night_untold_story__step_event_week_007_night_untold_story_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC544\uBB34\uB3C4 \uB9D0\uD574\uC8FC\uC9C0 \uC54A\uC740 \uAC83"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC11C\uC7AC \uCC45\uC0C1 \uC704\uC5D0 \uC624\uB798\uB41C \uC601\uC9C0
      \uACB0\uC7AC \uBB38\uC11C\uB4E4\uC774 \uD3BC\uCCD0\uC838 \uC788\uB2E4. \uB4F1\uBD88\uC774
      \uD558\uB098\uB9CC \uCF1C\uC838 \uC788\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
      \uBB38\uC11C\uAC00 \uC544\uB2C8\uB77C \uC790\uAE30 \uC190\uC744 \uBCF4\uACE0
      \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB838\uC744 \uB54C\uBD80\uD130 \uAD81\uAE08\uD55C \uAC8C \uC788\uC5C8\uB294\uB370\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uBE60\uAC00 \uC5B4\uB5BB\uAC8C \uB3CC\uC544\uAC00\uC2E0 \uAC74\uC9C0,
      \uC544\uBB34\uB3C4 \uC800\uD55C\uD14C \uC81C\uB300\uB85C \uB9D0\uD574\uC900
      \uC801\uC774 \uC5C6\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uC81C\uB294 \uB4E4\uC5B4\uB3C4 \uB418\uB294 \uB098\uC774\uC796\uC544\uC694."
  _nemoLine: "\uC11C\uC7AC \uCC45\uC0C1 \uC704\uC5D0 \uC624\uB798\uB41C \uC601\uC9C0
    \uACB0\uC7AC \uBB38\uC11C\uB4E4\uC774 \uD3BC\uCCD0\uC838 \uC788\uB2E4. \uB4F1\uBD88\uC774
    \uD558\uB098\uB9CC \uCF1C\uC838 \uC788\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
    \uBB38\uC11C\uAC00 \uC544\uB2C8\uB77C \uC790\uAE30 \uC190\uC744 \uBCF4\uACE0
    \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\u2026\uC2EC\uC7A5\uC774 \uC548 \uC88B\uC558\uC5B4. \uB124 \uC544\uBE60\uB3C4
      \uC54C\uACE0 \uC788\uC5C8\uACE0. \uB9C8\uC74C\uC774 \uB108\uBB34 \uD798\uB4E4\uC5C8\uB358\uAC8C\uC9C0."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uB9C8\uC74C\uC774 \uD798\uB4E4\uC5C8\uB2E4\uAD6C\uC694?"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB0AE\uC544\uC84C\uB2E4."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC544\uBE60\uC5D0\uAC8C \uC5C4\uB9C8\uB294 \uB108\uBB34\uB098 \uD070
        \uC874\uC7AC\uC600\uAD70\uC694.."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uB4F1\uBD88\uC758 \uC2EC\uC9C0\uAC00 \uD55C \uBC88 \uD754\uB4E4\uB838\uB2E4.
        \uC544\uBCA8\uB9AC\uC544\uB294 \uB9D0\uC744 \uC787\uC9C0 \uBABB\uD588\uB2E4."
    _responseLine: "\uB9C8\uC74C\uC774 \uD798\uB4E4\uC5C8\uB2E4\uAD6C\uC694?"
    _interactions:
    - {fileID: 11400000, guid: 07a82ea2eb4e69d47b46715d83afdd61, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: 3326efebbe0162843bc6d7f028b2179b, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uADF8\uAC74 \uC9C0\uAE08 \uAEBC\uB0BC \uC598\uAE30\uAC00 \uC544\uB2CC
      \uAC83 \uAC19\uAD6C\uB098. \uC131\uC778\uC2DD \uB05D\uB098\uBA74 \uCC9C\uCC9C\uD788
      \uC598\uAE30\uD558\uC790."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC774\uBBF8 \uC624\uB798 \uAE30\uB2E4\uB838\uC5B4."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBB38\uC11C\uB97C \uCC9C\uCC9C\uD788
        \uB36E\uC5C8\uB2E4. \uB36E\uC740 \uC190\uC740 \uD55C\uCC38 \uB3D9\uC548 \uADF8
        \uC704\uC5D0 \uBA38\uBB3C\uB800\uB2E4."
    _responseLine: "\u2026"
    _interactions:
    - {fileID: 11400000, guid: 1dd13bdd8eaf9ce4592aeb8a484f9fba, type: 2}
    - {fileID: 11400000, guid: 5567f538fa6f95541b83bef514683358, type: 2}
    _nextStep: {fileID: 11400000, guid: 3326efebbe0162843bc6d7f028b2179b, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uC5B4\uB978\uB4E4\uC774 \uB108\uD55C\uD14C \uB9D0 \uC548 \uD55C \uAC74,
      \uB108\uB97C \uC9C0\uD0A4\uB824\uACE0 \uD55C \uAC70\uB780\uB2E4. \uC88B\uC740
      \uBC29\uC2DD\uC774\uC5C8\uB294\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC9C0\uD0A4\uB824\uACE0\uC694."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC9C0\uD0A8\uB2E4\uB294 \uAC8C \uADF8\uB807\uAC8C \uBAA8\uB974\uAC8C
        \uB450\uB294 \uAC70\uC600\uAD6C\uB098."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uADF8\uAC83\uB3C4 \uC77C\uC885\uC758 \uB2F5\uC774\uAE34 \uD558\uB124\uC694."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB4F1\uBD88 \uAC00\uAE4C\uC774 \uC790\uB9AC\uB97C
        \uC62E\uACA8 \uC549\uC558\uB2E4."
    _responseLine: "\u2026\uC9C0\uD0A4\uB824\uACE0\uC694."
    _interactions:
    - {fileID: 11400000, guid: 156a3b33297a73c469970f297857e022, type: 2}
    _nextStep: {fileID: 11400000, guid: 3326efebbe0162843bc6d7f028b2179b, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
