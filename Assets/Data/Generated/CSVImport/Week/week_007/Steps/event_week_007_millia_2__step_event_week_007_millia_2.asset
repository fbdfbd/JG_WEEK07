  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_millia_2__step_event_week_007_millia_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC774 \uBB38\uC11C\uB294 \uC22B\uC790\uB9CC \uBCF4\uBA74 \uC548 \uB3FC\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC22B\uC790 \uBB38\uC11C\uC778\uB370\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC22B\uC790\uB294 \uB9DE\uC744 \uC218 \uC788\uC5B4\uC694. \uADF8\uB7F0\uB370
      \uC65C \uC774 \uC22B\uC790\uB97C \uBCF4\uC5EC\uC8FC\uB294\uC9C0\uAC00 \uB354
      \uC911\uC694\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uC2A8 \uB73B\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uBB38\uC11C\uC758 \uD55C \uC904\uC744 \uC190\uB05D\uC73C\uB85C
      \uC9DA\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC5EC\uAE30\uC694. \uC9C0\uC6D0\uAE08\uC740 \uD06C\uAC8C \uC801\uD600
      \uC788\uB294\uB370, \uC870\uAC74\uC740 \uB4A4\uC5D0 \uC788\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC870\uAC74\uC774 \uB354 \uC911\uC694\uD55C\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB124. \uB3C8\uC740 \uD55C \uBC88 \uB4E4\uC5B4\uC624\uC9C0\uB9CC, \uC870\uAC74\uC740
      \uACC4\uC18D \uB0A8\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0C1\uB2E8\uC740 \uADF8\uAC78 \uC54C\uACE0 \uC788\uACA0\uC8E0?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB2F9\uC5F0\uD788\uC694. \uBAA8\uB974\uBA74 \uC0C1\uB2E8\uC774 \uC544\uB2C8\uC5D0\uC694."
  _nemoLine: "\uC774 \uBB38\uC11C\uB294 \uC22B\uC790\uB9CC \uBCF4\uBA74 \uC548 \uB3FC\uC694."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
