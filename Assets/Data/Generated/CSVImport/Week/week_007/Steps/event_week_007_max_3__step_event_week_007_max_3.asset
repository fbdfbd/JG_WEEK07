--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_max_3__step_event_week_007_max_3
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uC791\uC740 \uC751\uC811\uC2E4. \uC624\uD6C4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uD3C9\uC18C\uBCF4\uB2E4 \uB354 \uB2E8\uC815\uD55C
      \uBCF5\uC7A5\uC73C\uB85C \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC131\uC778\uC2DD \uC774\uD6C4, \uC81C\uAC00 \uACF5\uC2DD \uD638\uC704\uB85C
      \uC9C0\uBA85\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38 \uB300\uD45C\uAC00 \uC544\uB2C8\uB77C\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB458 \uB2E4\uC785\uB2C8\uB2E4. \uB300\uD45C\uB85C \uC624\uC9C0\uB9CC,
      \uD544\uC694\uD558\uBA74 \uD638\uC704\uB85C\uB3C4 \uC124 \uC218 \uC788\uAC8C
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C9\uC2A4\uAC00 \uC6D0\uD55C \uAC74\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC608."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC00\uBB38\uB3C4 \uC6D0\uD588\uACE0\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uADF8\uAC83\uB3C4 \uB9DE\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC7A0\uC2DC \uC2DC\uC120\uC744 \uB0B4\uB838\uB2E4\uAC00
      \uB2E4\uC2DC \uB9D0\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uD558\uC9C0\uB9CC \uC81C\uAC00 \uC6D0\uD558\uC9C0 \uC54A\uC558\uB2E4\uBA74,
      \uC774\uB807\uAC8C \uB9D0\uD558\uB7EC \uC624\uC9C0\uB294 \uC54A\uC558\uC744
      \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C \uB9D0\uD558\uB7EC \uC654\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uD5C8\uB77D\uBC1B\uACE0 \uC2F6\uC5C8\uC2B5\uB2C8\uB2E4. \uC81C \uC790\uB9AC\uAC00
      \uC544\uBCA8\uB9AC\uC544 \uACC1\uC774\uC5B4\uB3C4 \uB418\uB294\uC9C0."
  _nemoLine: "\uBC31\uC791\uC800 \uC791\uC740 \uC751\uC811\uC2E4. \uC624\uD6C4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
