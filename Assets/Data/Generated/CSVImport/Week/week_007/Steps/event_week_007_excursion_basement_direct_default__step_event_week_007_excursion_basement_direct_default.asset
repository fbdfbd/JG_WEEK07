  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_excursion_basement_direct_default__step_event_week_007_excursion_basement_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBCBD \uC55E\uC5D0\uC11C \uAC78\uC74C\uC744
      \uBA48\uCD94\uACE0 \uAC00\uB9CC\uD788 \uC18C\uB9AC\uB97C \uB4E3\uB294\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC18C\uB9AC\uAC00 \uB108\uBB34 \uC77C\uC815\uD574\uC694. \uADF8\uB0E5
      \uBB3C\uC774 \uC0C8\uB294 \uAC83 \uAC19\uC9C0\uB294 \uC54A\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uBC30\uC218\uAD00\uC774 \uB0A1\uC544\uC11C \uADF8\uB7F4 \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774 \uC704\uCE58\uC5D0\uC11C \uC774\uB7F0 \uC18C\uB9AC\uAC00 \uB09C
      \uC801\uC774 \uC788\uC5C8\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608\uC804\uBD80\uD130 \uADF8\uB7AC\uC744 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "...\uBCBD \uB108\uBA38\uC5D0 \uB2E4\uB978 \uACF5\uAC04\uC774 \uC788\uB294
      \uAC74 \uC544\uB2C8\uACA0\uC8E0."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC18C\uB9AC\uAC00 \uB098\uB294 \uBCBD\uBA74\uC744
      \uD55C \uBC88 \uC9DA\uC5B4\uBCF4\uACE0\uB294 \uCC9C\uCC9C\uD788 \uC190\uC744
      \uB5D0\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBCBD \uC55E\uC5D0\uC11C \uAC78\uC74C\uC744
    \uBA48\uCD94\uACE0 \uAC00\uB9CC\uD788 \uC18C\uB9AC\uB97C \uB4E3\uB294\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
