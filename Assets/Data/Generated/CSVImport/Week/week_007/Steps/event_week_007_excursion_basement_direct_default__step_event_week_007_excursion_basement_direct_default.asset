  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_excursion_basement_direct_default__step_event_week_007_excursion_basement_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBB3C\uBC29\uC6B8\uC740 \uC77C\uC815\uD55C \uAC04\uACA9\uC73C\uB85C
      \uB5A8\uC5B4\uC9C0\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB3C\uC18C\uB9AC \uAC19\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uBCBD \uC548\uCABD \uBC30\uC218\uAD00\uC77C \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9D1 \uC548\uC5D0\uC11C \uB098\uB294 \uC18C\uB9AC\uB294 \uC885\uB958\uAC00
      \uB2E4\uB974\uAD70\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC624\uB798\uB41C \uACF3\uC77C\uC218\uB85D \uADF8\uB807\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB0E5 \uB4E3\uAE30\uB9CC \uD574\uB3C4, \uC5B4\uB518\uAC00 \uC798\uBABB\uB410\uB2E4\uB294
      \uAC74 \uC54C\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC18C\uB9AC\uB77C\uB294 \uAC74 \uC774\uC0C1\uD558\uB124\uC694. \uBCF4\uC9C0
      \uC54A\uC544\uB3C4 \uC54C \uC218 \uC788\uB294\uAC8C \uC788\uC5B4\uC694."
  _nemoLine: "\uBB3C\uBC29\uC6B8\uC740 \uC77C\uC815\uD55C \uAC04\uACA9\uC73C\uB85C
    \uB5A8\uC5B4\uC9C0\uACE0 \uC788\uC5C8\uB2E4."
