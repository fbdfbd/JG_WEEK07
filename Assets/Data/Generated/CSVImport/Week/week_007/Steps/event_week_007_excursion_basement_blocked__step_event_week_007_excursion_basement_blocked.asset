  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_excursion_basement_blocked__step_event_week_007_excursion_basement_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBB38 \uB108\uBA38\uC5D0\uC11C\uB294 \uC5EC\uC804\uD788 \uD76C\uBBF8\uD55C
      \uBB3C\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uC5D0\uC11C \uC544\uC9C1\uB3C4 \uC18C\uB9AC\uAC00 \uB098\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC0C8\uB294 \uACF3\uC774 \uC788\uC5B4 \uCD9C\uC785\uC744 \uB9C9\uC544\uB450\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9CE\uC774 \uC2EC\uD55C\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uD655\uC778 \uC911\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9C1\uC811 \uBCF4\uBA74 \uB35C \uB2F5\uB2F5\uD560 \uAC83 \uAC19\uC740\uB370,
      \uBABB \uBCF4\uAC8C \uD558\uB2C8\uAE4C \uB354 \uC2E0\uACBD\uC774 \uC4F0\uC5EC\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBB38 \uC758 \uBB3C\uD1B5\uC744 \uBC14\uB77C\uBCF4\uB2E4
      \uCC9C\uCC9C\uD788 \uB3CC\uC544\uC130\uB2E4."
  _nemoLine: "\uBB38 \uB108\uBA38\uC5D0\uC11C\uB294 \uC5EC\uC804\uD788 \uD76C\uBBF8\uD55C
    \uBB3C\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
