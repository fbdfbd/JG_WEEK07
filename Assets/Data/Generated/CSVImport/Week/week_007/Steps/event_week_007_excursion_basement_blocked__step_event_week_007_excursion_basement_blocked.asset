  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_excursion_basement_blocked__step_event_week_007_excursion_basement_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB2EB\uD78C \uBB38 \uB108\uBA38\uB85C \uADDC\uCE59\uC801\uC778 \uBB3C\uC18C\uB9AC\uAC00
      \uB4E4\uB824\uC628\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBB38 \uC55E\uC5D0\uB294 \uCD9C\uC785\uC744 \uB9C9\uB294 \uBB3C\uD1B5\uACFC
      \uD5DD\uAC8A\uC774 \uC5B4\uC9C0\uB7FD\uAC8C \uB193\uC5EC \uC788\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC18C\uB9AC\uAC00 \uACC4\uC18D \uB098\uB294\uB370, \uC815\uB9D0 \uADF8\uB0E5
      \uAD6C\uACBD\uB9CC \uD558\uB77C\uACE0\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC218\uB9AC \uC911\uC774\uB77C \uC704\uD5D8\uD569\uB2C8\uB2E4. \uB4E4\uC5B4\uAC00\uC2DC\uBA74
      \uC548 \uB3FC\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC218\uB9AC\uAC00 \uC544\uB2C8\uB77C \uB2E4\uB978 \uAC78 \uC228\uAE30\uACE0
      \uC788\uB294 \uAC70\uBA74\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "...\uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548 \uBCF4\uC5EC\uC8FC\uB2C8\uAE4C \uB354 \uB4E4\uC5B4\uAC00\uACE0
      \uC2F6\uC5B4\uC9C0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB2EB\uD78C \uBB38\uD2C8 \uC0AC\uC774\uB85C
      \uC2DC\uC120\uC744 \uB358\uC84C\uB2E4\uAC00 \uCC9C\uCC9C\uD788 \uC790\uB9AC\uB97C
      \uB72C\uB2E4."
  _nemoLine: "\uB2EB\uD78C \uBB38 \uB108\uBA38\uB85C \uADDC\uCE59\uC801\uC778 \uBB3C\uC18C\uB9AC\uAC00
    \uB4E4\uB824\uC628\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
