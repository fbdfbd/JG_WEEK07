--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_night_unknown_mother__step_event_week_007_night_unknown_mother_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uBAA8\uB974\uB294 \uC5B4\uBA38\uB2C8"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uAC00\uACC4\uBD80 \uD55C \uAD8C\uC744
      \uAEBC\uB0C8\uB2E4. \uD45C\uC9C0\uC5D0 \uC5B4\uBA38\uB2C8 \uC774\uC790\uBCA8\uC758
      \uC774\uB984\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4. \uAE00\uC528\uAC00 \uAC00\uC9C0\uB7F0\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uB294 \uC5C4\uB9C8\uAC00 \uC5B4\uB5A4 \uC0AC\uB78C\uC774\uC5C8\uB294\uC9C0\uB97C
      \uBAB0\uB77C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2EE\uC558\uB2E4\uB294 \uB9D0\uC740 \uD3C9\uC0DD \uB4E4\uC5C8\uB294\uB370,
      \uC815\uC791 \uB2EE\uC740 \uC0AC\uB78C\uC744 \uBAA8\uB974\uB294 \uAC70\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5C4\uB9C8\uB294\u2026 \uC5B4\uB5A4 \uC0AC\uB78C\uC774\uC5C8\uC5B4\uC694?"
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uAC00\uACC4\uBD80 \uD55C \uAD8C\uC744
    \uAEBC\uB0C8\uB2E4. \uD45C\uC9C0\uC5D0 \uC5B4\uBA38\uB2C8 \uC774\uC790\uBCA8\uC758
    \uC774\uB984\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4. \uAE00\uC528\uAC00 \uAC00\uC9C0\uB7F0\uD588\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uC88B\uC740 \uC0AC\uB78C\uC774\uC5C8\uC9C0. \uD615\uC774 \uC2DC\uB044\uB7FD\uAC8C
      \uAD74\uBA74, \uADF8 \uC606\uC5D0\uC11C \uADF8\uB0E5 \uC6C3\uC5B4\uC8FC\uB294
      \uADF8\uB7F0 \uC0AC\uB78C."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uADF8\uB7AC\uAD6C\uB098."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8 \uC606\uC5D0\uC11C \uC6C3\uC5C8\uB2E4\uB294 \uAC70."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8\uAC8C \uC880 \uC88B\uB124\uC694."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC00\uACC4\uBD80\uB97C \uAC00\uC2B4\uC5D0
        \uC548\uC558\uB2E4. \uD55C\uCC38 \uADF8\uB807\uAC8C \uC549\uC544 \uC788\uC5C8\uB2E4."
    _responseLine: "\u2026\uADF8\uB7AC\uAD6C\uB098."
    _interactions:
    - {fileID: 11400000, guid: d6a5e766052d89c428f1743b91d1f5ed, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: 041d6aadbf6688944803726d7890c73c, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uB124 \uC5C4\uB9C8\uB294 \uAC00\uACC4\uBD80 \uC22B\uC790\uB97C \uD55C
      \uBC88\uB3C4 \uD2C0\uB9B0 \uC801\uC774 \uC5C6\uC5C8\uC5B4. \uADF8\uAC74 \uB108\uB791
      \uC548 \uB2EE\uC558\uAD6C\uB098."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uADF8\uAC74 \uC880 \uB108\uBB34\uD558\uC2DC\uB124\uC694."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC9C4\uC9DC\uB85C \uD55C \uBC88\uB3C4 \uC548 \uD2C0\uB838\uC5B4\uC694?"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC9C4\uC9C0\uD558\uAC8C \uAC00\uACC4\uBD80\uC758
        \uC22B\uC790\uB4E4\uC744 \uD655\uC778\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
    _responseLine: "\u2026\uADF8\uAC74 \uC880 \uB108\uBB34\uD558\uC2DC\uB124\uC694."
    _interactions:
    - {fileID: 11400000, guid: d090616150871a540b234c9482e2e144, type: 2}
    _nextStep: {fileID: 11400000, guid: 041d6aadbf6688944803726d7890c73c, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uB9C8\uB9AC\uB098 \uC9D1\uC0AC\uC7A5\uC5D0\uAC8C \uBB3C\uC5B4\uBCF4\uB834.
      \uADF8 \uC0AC\uB78C\uB4E4\uC774 \uB354 \uC798 \uC54C \uAC70\uC57C."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uB124."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC0BC\uCD0C\uC740 \uB9D0\uD574\uC8FC\uAE30 \uC2EB\uC740 \uAC70\uC608\uC694?"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC00\uACC4\uBD80\uB97C \uCC45\uC0C1
        \uC704\uC5D0 \uB2E4\uC2DC \uC62C\uB824\uB193\uC558\uB2E4. \uC190\uC740 \uD45C\uC9C0
        \uC704\uC5D0\uC11C \uD55C\uCC38 \uB3D9\uC548 \uB5A8\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    _responseLine: "\u2026\uB124."
    _interactions:
    - {fileID: 11400000, guid: b0acdf54f7c36774fbadc86a7ef5a9d2, type: 2}
    - {fileID: 11400000, guid: 5567f538fa6f95541b83bef514683358, type: 2}
    _nextStep: {fileID: 11400000, guid: 041d6aadbf6688944803726d7890c73c, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
