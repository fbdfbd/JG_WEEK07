--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_rian_blocked__step_event_week_007_rian_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uD669\uC2E4 \uBB38\uC7A5\uC774 \uCC0D\uD78C
      \uACF5\uC2DD \uD1B5\uBCF4\uC11C\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC131\uC778\uC2DD \uB2F9\uC77C, \uD669\uC2E4\uC5D0\uC11C \uB300\uD45C\uB97C
      \uBCF4\uB0B4\uACA0\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB300\uD45C\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC608. \uD669\uC2E4\uC758 \uC77C\uACF1 \uBC88\uC9F8 \uD669\uC790 \uC804\uD558\uAED8\uC11C
      \uCC38\uC11D\uD558\uC2E4 \uC608\uC815\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC77C\uACF1 \uBC88\uC9F8 \uD669\uC790..."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD1B5\uBCF4\uC11C \uC544\uB798\uCABD\uC5D0
      \uC801\uD78C \uC774\uB984\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uB984\uC740 \uC801\uD600 \uC788\uB294\uB370, \uC5B4\uB5A4 \uC0AC\uB78C\uC778\uC9C0\uB294
      \uD558\uB098\uB3C4 \uC5C6\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uACF5\uC2DD \uBB38\uC11C\uC5D0\uB294 \uC911\uC694\uD55C \uB0B4\uC6A9\uB9CC
      \uC801\uD788\uB294 \uBC95\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC911\uC694\uD55C \uB0B4\uC6A9\uC774 \uC774\uB984\uBFD0\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uCC38\uC11D \uC5EC\uBD80\uC640 \uC9C0\uC704\uAC00 \uC911\uC694\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uB294 \uD669\uC790\uAC00 \uC5B4\uB5A4 \uC0AC\uB78C\uC778\uC9C0\uAC00
      \uB354 \uAD81\uAE08\uD55C\uB370\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD1B5\uBCF4\uC11C\uB97C \uB2E4\uC2DC
      \uC811\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uB807\uAC8C \uC54C\uAC8C \uB418\uB294 \uAC74 \uBCC4\uB85C\uC608\uC694."
  _nemoLine: "\uD0C1\uC790 \uC704\uC5D0\uB294 \uD669\uC2E4 \uBB38\uC7A5\uC774 \uCC0D\uD78C
    \uACF5\uC2DD \uD1B5\uBCF4\uC11C\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
