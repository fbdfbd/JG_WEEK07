  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_excursion_basement_direct_anxious__step_event_week_007_excursion_basement_direct_anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBCBD \uB108\uBA38 \uC5B4\uB460 \uC18D\uC5D0\uC11C \uCD95\uCD95\uD55C
      \uBB3C\uC18C\uB9AC\uAC00 \uB04A\uC774\uC9C0 \uC54A\uACE0 \uB4E4\uB9B0\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBCBD\uBA74\uC5D0 \uADC0\uB97C \uAE30\uC6B8\uC774\uB2E4\uAC00
      \uBAB8\uC744 \uC6C0\uCE20\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBCBD \uC548\uC5D0\uC11C \uB098\uB294 \uC18C\uB9AC\uCE58\uACE0\uB294
      \uB108\uBB34 \uAC00\uAE4C\uC6B4 \uAC83 \uAC19\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC544\uAC00\uC528, \uC5EC\uAE30\uB294 \uB108\uBB34 \uC2B5\uD558\uB124\uC694.
      \uADF8\uB9CC \uC62C\uB77C\uAC00\uC2DC\uB294 \uAC8C \uC88B\uACA0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "...\uADF8\uB7F4\uAE4C\uC694? \uB9C8\uB9AC \uB9D0\uC774 \uB9DE\uB294 \uAC83
      \uAC19\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9C8\uB9AC\uC758 \uB4A4\uB97C \uB530\uB77C
      \uC11C\uB458\uB7EC \uACC4\uB2E8 \uCABD\uC73C\uB85C \uBC1C\uAC78\uC74C\uC744
      \uC62E\uACBC\uB2E4."
  _nemoLine: "\uBCBD \uB108\uBA38 \uC5B4\uB460 \uC18D\uC5D0\uC11C \uCD95\uCD95\uD55C
    \uBB3C\uC18C\uB9AC\uAC00 \uB04A\uC774\uC9C0 \uC54A\uACE0 \uB4E4\uB9B0\uB2E4."
