  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_007_excursion_garden_blocked__step_event_week_007_excursion_garden_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC131\uC778\uC2DD \uAD00\uB828 \uC5C5\uBB34\uAC00
      \uBC00\uB824 \uC815\uC6D0\uC5D0 \uB098\uAC08 \uC218 \uC5C6\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBA70\uCE60 \uB4A4 \uC544\uBCA8\uB9AC\uC544\uB294 \uCC3D\uAC00\uC5D0\uC11C
      \uC815\uC6D0 \uCABD\uC744 \uBD24\uB2E4. \uC7A5\uBBF8 \uD654\uB2E8\uC774 \uBA40\uB9AC
      \uBCF4\uC600\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD53C\uC5C8\uB294\uC9C0, \uC548\uD53C\uC5C8\uB294\uC9C0 \uC774 \uAC70\uB9AC\uC5D0\uC120
      \uC54C \uC218 \uC5C6\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5D8\uB9B0, \uC7A5\uBBF8\uAC00 \uD3C8\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: fa0a52ca28fa9e14780e4a40b6bca1a5, type: 2}
    _text: "\uC544\uC9C1\uC778 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBCF4\uC168\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: fa0a52ca28fa9e14780e4a40b6bca1a5, type: 2}
    _text: "\uB124, \uC544\uCE68\uC5D0 \uC9C0\uB098\uAC00\uBA74\uC11C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB5A4 \uC0C9\uC774\uB358\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: fa0a52ca28fa9e14780e4a40b6bca1a5, type: 2}
    _text: "\uB178\uB780\uC0C9\uC774\uC5C8\uB358 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uD770 \uC7A5\uBBF8\uB294 \uC5C6\uC5C8\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: fa0a52ca28fa9e14780e4a40b6bca1a5, type: 2}
    _text: "\uD770 \uC7A5\uBBF8\uC694?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uB2C8\uC5D0\uC694. \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC131\uC778\uC2DD \uAD00\uB828 \uC5C5\uBB34\uAC00
    \uBC00\uB824 \uC815\uC6D0\uC5D0 \uB098\uAC08 \uC218 \uC5C6\uC5C8\uB2E4."
