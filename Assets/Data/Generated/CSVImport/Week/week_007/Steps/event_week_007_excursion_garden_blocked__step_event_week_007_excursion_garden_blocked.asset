  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC7A5\uBBF8 \uD654\uB2E8\uC5D0 \uAC00\uACE0
      \uC2F6\uC5C8\uC9C0\uB9CC \uC870\uC6A9\uD788 \uBB3C\uB7EC\uB0AC\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uC758 \uC21C\uC751\uACFC \uC2E0\uC911\uC774
      \uB192\uC544\uC9D1\uB2C8\uB2E4."
  _nemoLine: "\uC544\uC9C1 \uAF43\uB4E4\uC774 \uD53C\uC9C0\uC54A\uC544 \uCD9C\uC785\uC744
