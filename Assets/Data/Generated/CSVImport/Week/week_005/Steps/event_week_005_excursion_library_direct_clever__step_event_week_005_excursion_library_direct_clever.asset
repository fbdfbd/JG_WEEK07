MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_excursion_library_direct_clever__step_event_week_005_excursion_library_direct_clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC778\uBA85\uB85D\uC744 \uD3BC\uCCD0\uB193\uACE0
      \uC608\uBC95\uC11C\uB97C \uC606\uC5D0 \uB450\uC5C8\uB2E4. \uB450 \uAD8C\uC744
      \uBC88\uAC08\uC544 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC54C\uBA74 \uC54C \uC218\uB85D \uBB34\uC11C\uC6B4 \uAC83 \uAC19\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uBB34\uC5C7\uC774 \uB9D0\uC785\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC608\uBC95\uC744 \uAC16\uCD94\uC9C0 \uC54A\uB294\uB2E4\uACE0 \uBC8C\uD558\uACE0,
      \uD30C\uBC8C\uC774 \uB2E4\uB974\uB2E4\uACE0 \uC2F8\uC6B0\uACE0."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "...\uADF8\uB807\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC6B0\uB9AC \uAC00\uBB38\uC740 \uC5B4\uB290 \uD3B8\uC5D0 \uC11C\uC57C\uD574?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB5BB\uAC8C \uD589\uB3D9\uD574\uC57C \uC0B4\uC544\uB0A8\uC744
      \uC218 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uB108\uBB34 \uAE4A\uAC8C \uAC71\uC815\uD558\uC2E4 \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4,
      \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC11D\uC5F0\uCE58 \uC54A\uC740 \uB208\uBE5B\uC73C\uB85C
      \uC778\uBA85\uB85D\uC744 \uBC14\uB77C\uBCF8\uB2E4."
  _nemoLine: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC778\uBA85\uB85D\uC744 \uD3BC\uCCD0\uB193\uACE0
    \uC608\uBC95\uC11C\uB97C \uC606\uC5D0 \uB450\uC5C8\uB2E4. \uB450 \uAD8C\uC744
    \uBC88\uAC08\uC544 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
