  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_max_1__step_event_week_005_max_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uC815\uC6D0. \uC624\uD6C4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uD0A4\uAC00 \uB9CE\uC774 \uD06C\uC168\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C9\uC2A4\uB3C4\uC694."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC608\uC804\uC5D4 \uBAA9\uAC80\uC774 \uB354 \uCEE4 \uBCF4\uC600\uB294\uB370,
      \uC774\uC820 \uC880 \uB35C\uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uAC80 \uC5F0\uC2B5\uC744 \uC9C0\uAE08\uB3C4 \uD558\uC2DC\uB098 \uBCF4\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB124. \uACC4\uC18D\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC7A0\uAE50 \uBA38\uBB47\uAC70\uB9AC\uB2E4\uAC00
      \uB9D0\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uD30C\uD2B8\uB108 \uC774\uC57C\uAE30\uB294 \uC6B0\uB9AC \uAC00\uBB38\uC5D0\uC11C
      \uBA3C\uC800 \uAEBC\uB0B8 \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C9\uC2A4\uB3C4 \uC6D0\uD574\uC11C \uC628 \uAC74 \uC544\uB2CC\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uBD88\uD3B8\uD558\uC9C0 \uC54A\uC558\uC73C\uBA74
      \uC88B\uACA0\uC5B4\uC694. \uADF8\uAC8C \uBA3C\uC800\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uBCF8\uC778 \uB9C8\uC74C\uC740\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\u2026\uAC19\uC774 \uC11C\uACE0 \uC2F6\uAE30\uB294 \uD569\uB2C8\uB2E4."
  _nemoLine: "\uBC31\uC791\uC800 \uC815\uC6D0. \uC624\uD6C4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
