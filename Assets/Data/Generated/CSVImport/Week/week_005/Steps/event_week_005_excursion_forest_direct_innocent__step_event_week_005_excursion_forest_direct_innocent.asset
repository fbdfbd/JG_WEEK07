  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5EC\uAE30 \uD480\uC774 \uC5C4\uCCAD \uB9CE\uB0B4\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC6D0\uB798 \uC5EC\uAE30\uB9CC \uC774\uB7F0\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\u2026\uC774\uCABD\uC774 \uC880 \uBB34\uC131\uD55C \uD3B8\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADFC\uB370 \uC608\uC058\uAE30\uB3C4 \uD558\uB124\uC694. \uC5EC\uAE30
      \uC549\uC544 \uC788\uC5B4\uB3C4 \uB418\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC544\uAC00\uC528\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC7A0\uAE50\uB9CC. \uBC14\uB78C\uC774 \uC5EC\uAE30\uAC00 \uC81C\uC77C
      \uC88B\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\u2026\uC608."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uBC84\uC9C0\uB3C4 \uC774\uCABD\uAE4C\uC9C0 \uC654\uC744\uAE4C\uC694?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\u2026\uC544\uB9C8\uB3C4\uC694.."
  _nemoLine: "\uC5EC\uAE30 \uD480\uC774 \uC5C4\uCCAD \uB9CE\uB0B4\uC694."
