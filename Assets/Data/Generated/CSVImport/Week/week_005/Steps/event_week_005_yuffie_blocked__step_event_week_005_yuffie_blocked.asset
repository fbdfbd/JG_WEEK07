--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_yuffie_blocked__step_event_week_005_yuffie_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uAC70\uC6B8 \uC55E\uC5D0 \uC120 \uC544\uBCA8\uB9AC\uC544\uB294 \uC785\uAF2C\uB9AC\uB97C
      \uC870\uAE08 \uC62C\uB824 \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC870\uAE08\uB9CC \uB354 \uBD80\uB4DC\uB7FD\uAC8C \uC6C3\uC73C\uC2DC\uBA74
      \uC88B\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uB807\uAC8C\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uB108\uBB34 \uC5B4\uC0C9\uD569\uB2C8\uB2E4. \uB2E4\uC2DC \uD574\uBCF4\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC6C3\uB294 \uAC83\uB3C4 \uC815\uD574\uC9C4\uAC8C \uC788\uC5B4\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC0AC\uAD50 \uC790\uB9AC\uC5D0\uC11C\uB294 \uD45C\uC815\uB3C4 \uC608\uBC95\uC758
      \uC77C\uBD80\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB2E4\uC2DC \uC6C3\uC5B4 \uBCF4\uC600\uC9C0\uB9CC,
      \uACE7 \uC785\uC220\uC744 \uB2E4\uBB3C\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC774\uBC88\uC5D0\uB294 \uB108\uBB34 \uCC28\uAC00\uC6CC \uBCF4\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uC5B4\uB5BB\uAC8C \uC6C3\uC5B4\uC57C \uD574\uC694?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uAE30\uC058\uC9C0 \uC54A\uC544\uB3C4 \uAE30\uC05C \uAC83\uCC98\uB7FC
      \uBCF4\uC774\uC154\uC57C \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC70\uC6B8 \uC18D \uC790\uC2E0\uC758
      \uC5BC\uAD74\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB0B4\uAC00 \uBD88\uD3B8\uD560 \uB54C\uB294 \uB204\uAC00 \uC2E0\uACBD\uC368\uC8FC\uC8E0?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uAC70\uC6B8 \uC18D \uC544\uBCA8\uB9AC\uC544\uC758 \uC785\uAF2C\uB9AC\uB294
      \uCC9C\uCC9C\uD788 \uB0B4\uB824\uAC14\uB2E4."
  _nemoLine: "\uAC70\uC6B8 \uC55E\uC5D0 \uC120 \uC544\uBCA8\uB9AC\uC544\uB294 \uC785\uAF2C\uB9AC\uB97C
    \uC870\uAE08 \uC62C\uB824 \uBCF4\uC558\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
