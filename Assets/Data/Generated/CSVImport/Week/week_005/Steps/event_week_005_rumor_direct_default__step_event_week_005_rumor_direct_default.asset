MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_rumor_direct_default__step_event_week_005_rumor_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC18C\uBB38 \uD5C8\uAC00"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC9D1\uC0AC\uC7A5\uC774 \uC11C\uB958 \uD55C \uBB36\uC74C\uC744 \uB4E4\uACE0
      \uC11C\uC7AC \uCABD\uC5D0\uC11C \uB098\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9D1\uC0AC\uC7A5\uB2D8."
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC608, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC74 \uBB50\uC608\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC624\uB798\uB41C \uAC70\uB798 \uAE30\uB85D\uB4E4\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C \uB4E4\uACE0 \uACC4\uC138\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC694\uC998 \uBC31\uC791\uAC00\uC758 \uBE5A \uBB38\uC11C\uB4E4\uC744
      \uCC3E\uB294 \uC190\uC774 \uB298\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBE5A \uBB38\uC11C\uC694? \uB204\uAC00 \uCC3E\uC544\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8 \uCABD \uC0AC\uB78C\uB4E4\uC778
      \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC74 \uC6B0\uB9AC\uD55C\uD14C \uC88B\uC740 \uC77C\uC774\uC5D0\uC694,
      \uB098\uC05C \uC77C\uC774\uC5D0\uC694?"
  - _speaker: {fileID: 11400000, guid: 84ffa10995c48764388074048cfd595e, type: 2}
    _text: "\uC544\uC9C1 \uBAA8\uB985\uB2C8\uB2E4, \uC544\uAC00\uC528."
  _nemoLine: "\uC9D1\uC0AC\uC7A5\uC774 \uC11C\uB958 \uD55C \uBB36\uC74C\uC744 \uB4E4\uACE0
    \uC11C\uC7AC \uCABD\uC5D0\uC11C \uB098\uC654\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
