  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_yuffie_0__step_event_week_005_yuffie_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uAC70\uC6B8 \uC55E\uC5D0 \uC870\uC2EC\uC2A4\uB7FD\uAC8C
      \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC548\uB155\uD558\uC138\uC694. \uC720\uD53C \uB85C\uC0AC\uBCA8\uC774\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC544\uBCA8\uB9AC\uC544\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC624\uB298\uC740 \uC6C3\uB294 \uC5F0\uC2B5\uC744 \uAC19\uC774 \uD558\uC790\uACE0
      \uD574\uC11C \uC654\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC6C3\uB294 \uAC83\uB3C4 \uC5F0\uC2B5\uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uB124. \uB108\uBB34 \uD06C\uAC8C \uC6C3\uC73C\uBA74 \uAC00\uBCBC\uC6CC
      \uBCF4\uC774\uACE0, \uB108\uBB34 \uC548 \uC6C3\uC73C\uBA74 \uCC28\uAC00\uC6CC
      \uBCF4\uC778\uB300\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uADF8\uB807\uAC8C \uBCF4\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC5B4\uB978\uB4E4\uC774\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uAC70\uC6B8\uC744 \uBCF4\uBA70 \uC791\uAC8C \uC6C3\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uC800\uB294 \uC774 \uC815\uB3C4\uAC00 \uC88B\uB2E4\uACE0 \uBC30\uC6E0\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC6C3\uB294 \uAC83 \uAC19\uC9C0 \uC54A\uC740\uB370\uC694."
  - _speaker: {fileID: 11400000, guid: 275c8535516efb949adc193602035b9c, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uC608\uC758 \uC788\uC5B4 \uBCF4\uC778\uB300\uC694."
  _nemoLine: "\uC720\uD53C\uB294 \uAC70\uC6B8 \uC55E\uC5D0 \uC870\uC2EC\uC2A4\uB7FD\uAC8C
    \uC11C \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
