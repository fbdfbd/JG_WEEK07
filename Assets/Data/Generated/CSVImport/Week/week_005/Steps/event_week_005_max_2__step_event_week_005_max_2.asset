MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_max_2__step_event_week_005_max_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uC815\uC6D0. \uD574\uC9C8 \uBB34\uB835."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC774\uBC88\uC5D4 \uAC00\uBB38 \uB9D0\uB9CC \uD558\uB7EC \uC628 \uAC8C
      \uC544\uB2C8\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC81C\uAC00 \uC9C1\uC811 \uB9D0\uD558\uACE0 \uC2F6\uC5C8\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC190\uC744 \uAF49 \uC950\uC5C8\uB2E4\uAC00 \uD3C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uC758 \uD30C\uD2B8\uB108\uAC00 \uB418\uACE0
      \uC2F6\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "..\uAC00\uBB38\uC5D0\uC11C \uC6D0\uD574\uC11C\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uADF8\uAC83\uB3C4 \uB9DE\uC544\uC694. \uADF8\uB7F0\uB370 \uC800\uB3C4
      \uC6D0\uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uD63C\uC790 \uC11C \uC788\uC73C\uBA74,
      \uC0AC\uB78C\uB4E4\uC774 \uB354 \uC27D\uAC8C \uB2E4\uAC00\uC62C \uAC83 \uAC19\uC544\uC11C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C9\uC2A4\uAC00 \uC606\uC5D0 \uC788\uC73C\uBA74 \uB2EC\uB77C\uC9C0\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC801\uC5B4\uB3C4 \uC800\uB294 \uC606\uC5D0 \uC788\uC744 \uC218 \uC788\uC796\uC544\uC694."
  _nemoLine: "\uBC31\uC791\uC800 \uC815\uC6D0. \uD574\uC9C8 \uBB34\uB835."
  _useCustomVisualState: 0
  _visualState: 0
