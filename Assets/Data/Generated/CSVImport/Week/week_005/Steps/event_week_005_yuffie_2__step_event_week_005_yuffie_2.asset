  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_yuffie_2__step_event_week_005_yuffie_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uC6C3\uACE0 \uC2F6\uC9C0 \uC54A\uC544\uB3C4 \uC6C3\uC5B4\uC57C \uD560
      \uB54C\uAC00 \uC788\uB300\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uADF8\uB7EC\uBA74 \uC0AC\uB78C\uB4E4\uC774 \uB35C \uB0A0\uCE74\uB85C\uC6CC\uC9C4\uB300\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC81C\uAC00 \uC6C3\uC73C\uBA74\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uC0C1\uB300\uAC00 \uBA3C\uC800 \uD654\uB0B4\uAE30 \uC5B4\uB824\uC6CC\uC9C4\uB300\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uC0C1\uD558\uB124\uC694. \uC81C\uAC00 \uC6C3\uB294\uB370 \uC65C
      \uB2E4\uB978 \uC0AC\uB78C\uC774 \uB2EC\uB77C\uC9C0\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uC800\uB3C4 \uCC98\uC74C\uC5D4 \uC774\uC0C1\uD588\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC190\uAC00\uB77D\uC73C\uB85C \uC790\uAE30 \uC785\uAF2C\uB9AC\uB97C
      \uC0B4\uC9DD \uC62C\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uADF8\uB7F0\uB370 \uC5B4\uB978\uB4E4\uC740 \uD45C\uC815\uC744 \uBA3C\uC800
      \uBD10\uC694. \uB9D0\uBCF4\uB2E4 \uBA3C\uC800\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7FC \uC6C3\uB294 \uAC74 \uBC29\uD328\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uC870\uAE08\uC740\uC694."
  _nemoLine: "\uC6C3\uACE0 \uC2F6\uC9C0 \uC54A\uC544\uB3C4 \uC6C3\uC5B4\uC57C \uD560
    \uB54C\uAC00 \uC788\uB300\uC694."
