  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_max_0__step_event_week_005_max_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC31\uC791\uC800 \uC751\uC811\uC2E4. \uB0AE."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uAE30\uC0AC\uAC00\uBB38 \uC0AC\uB78C\uB4E4\uC774 \uBC31\uC791\uC800\uB97C
      \uBC29\uBB38\uD588\uB2E4. \uB9C9\uC2A4\uB294 \uADF8 \uB4A4\uC5D0\uC11C \uC870\uAE08
      \uAD73\uC740 \uC5BC\uAD74\uB85C \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC548\uB155\uD558\uC138\uC694. \uB9C9\uC2A4 \uBC1C\uD14C\uB9AC\uC628\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC544\uBCA8\uB9AC\uC544\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC624\uB298\uC740 \uBB34\uB3C4\uD68C \uD30C\uD2B8\uB108 \uD6C4\uBCF4\uB85C
      \uC778\uC0AC\uB4DC\uB9AC\uB7EC \uC654\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2F9\uC2E0\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uB124. \uAC00\uBB38\uC5D0\uC11C \uADF8\uB807\uAC8C \uB9D0\uD588\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C9\uC2A4\uB294 \uC7A0\uAE50 \uB208\uC744 \uB0B4\uB838\uB2E4\uAC00
      \uB2E4\uC2DC \uC544\uBCA8\uB9AC\uC544\uB97C \uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: c5f12395c55e0f04286ad56919148193, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC2EB\uC73C\uBA74 \uAC70\uC808\uD574\uB3C4
      \uB3FC\uC694. \uADF8 \uB9D0\uC740 \uAF2D \uD558\uB824\uACE0 \uD588\uC5B4\uC694."
  _nemoLine: "\uBC31\uC791\uC800 \uC751\uC811\uC2E4. \uB0AE."
  _useCustomVisualState: 0
  _visualState: 0
