  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_millia_0__step_event_week_005_millia_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uC791\uC740 \uACAC\uBCF8 \uC0C1\uC790\uB97C
      \uB4E4\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC548\uB155\uD558\uC138\uC694. \uBC00\uB9AC\uC544 \uBCA0\uB974\uB514\uC544\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC544\uBCA8\uB9AC\uC544\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uBB34\uB3C4\uD68C\uC6A9 \uB4DC\uB808\uC2A4\uB791 \uC7A5\uC2E0\uAD6C
      \uACAC\uBCF8\uC744 \uAC00\uC838\uC654\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC00\uB9AC\uC544\uAC00 \uC815\uD558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC544\uB2C8\uC694. \uC5B4\uB978\uB4E4\uC774 \uC815\uD574\uC694. \uC800\uB294
      \uBCF4\uC5EC\uC8FC\uB7EC \uC628 \uAC70\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uC0C1\uC790\uB97C \uC5F4\uC5B4 \uC791\uC740
      \uCC9C \uC870\uAC01\uACFC \uC7A5\uC2DD \uC0D8\uD50C\uC744 \uBCF4\uC5EC\uC92C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC774\uAC74 \uBE44\uC2FC \uCABD. \uC774\uAC74 \uBE44\uC2F8 \uBCF4\uC774\uB294\uB370
      \uB35C \uBE44\uC2FC \uCABD."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB7F0 \uAC83\uB3C4 \uC788\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB2F9\uC5F0\uD558\uC8E0. \uBCF4\uC774\uB294 \uAC8C \uC804\uBD80\uB294
      \uC544\uB2C8\uB2C8\uAE4C\uC694."
  _nemoLine: "\uBC00\uB9AC\uC544\uB294 \uC791\uC740 \uACAC\uBCF8 \uC0C1\uC790\uB97C
    \uB4E4\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
