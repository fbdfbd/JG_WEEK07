  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_excursion_basement_direct_curious__step_event_week_005_excursion_basement_direct_curious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uAC70\uBBF8\uC904 \uAC00\uC6B4\uB370 \uC791\uC740 \uAC70\uBBF8 \uD55C
      \uB9C8\uB9AC\uAC00 \uAC00\uB9CC\uD788 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC800\uAE30 \uC788\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uAC00\uAE4C\uC774 \uAC00\uC9C0 \uC54A\uC73C\uC2DC\uB294 \uAC8C \uC88B\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9CC\uC9C0\uC9C4 \uC54A\uC744 \uAC70\uC608\uC694. \uADF8\uB0E5 \uBCF4\uAE30\uB9CC
      \uD560\uAC8C\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uB108\uBB34 \uAC00\uAE4C\uC774 \uAC00\uC2DC\uBA74 \uC637\uC774 \uB354\uB7EC\uC6CC\uC9D1\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB354\uB7EC\uC6CC\uC9C0\uBA74 \uC5B4\uB54C\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC70\uBBF8\uC904\uC744 \uAC00\uAE4C\uC774
      \uBCF4\uAE30 \uC704\uD574 \uBAB8\uC744 \uB0AE\uCDC4\uB2E4."
  _nemoLine: "\uAC70\uBBF8\uC904 \uAC00\uC6B4\uB370 \uC791\uC740 \uAC70\uBBF8 \uD55C
    \uB9C8\uB9AC\uAC00 \uAC00\uB9CC\uD788 \uC788\uC5C8\uB2E4."
