  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_excursion_basement_direct_default__step_event_week_005_excursion_basement_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uAC70\uBBF8\uC904\uC740 \uC9C0\uB098\uAC00\uB294 \uC0AC\uB78C\uC758
      \uC5BC\uAD74 \uB192\uC774\uC5D0 \uAC78\uB824 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC77C\uBD80\uB7EC \uB9C9\uC544\uB193\uC740 \uAC83 \uAC19\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC624\uB798 \uC190\uB300\uC9C0 \uC54A\uC73C\uBA74 \uC774\uB807\uAC8C
      \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uBB34\uB3C4 \uC9C0\uB098\uAC00\uC9C0 \uC54A\uC558\uB2E4\uB294
      \uB73B\uC774\uAE30\uB3C4 \uD558\uACE0\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC9C0\uD558\uC2E4\uC740 \uC774\uC0C1\uD574\uC694. \uC9D1 \uC548\uC778\uB370,
      \uC9D1\uC774 \uC544\uB2CC \uACF3 \uAC19\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC790\uC8FC \uC4F0\uC9C0 \uC54A\uB294 \uACF3\uC774\uB77C \uADF8\uB807\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uB798\uC11C \uB354 \uC870\uC2EC\uD574\uC57C\uACA0\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uACE0\uAC1C\uB97C \uB0AE\uCD94\uACE0
      \uAC70\uBBF8\uC904 \uC544\uB798\uB97C \uC0B4\uD3C8\uB2E4."
  _nemoLine: "\uAC70\uBBF8\uC904\uC740 \uC9C0\uB098\uAC00\uB294 \uC0AC\uB78C\uC758
    \uC5BC\uAD74 \uB192\uC774\uC5D0 \uAC78\uB824 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
