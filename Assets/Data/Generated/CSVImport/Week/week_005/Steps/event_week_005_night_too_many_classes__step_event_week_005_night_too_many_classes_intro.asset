MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_night_too_many_classes__step_event_week_005_night_too_many_classes_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uB298\uC5B4\uB09C \uC218\uC5C5"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uCC3B\uC794\uC5D0\uC11C \uAE40\uC774 \uC624\uB978\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
      \uD55C \uBAA8\uAE08 \uB9C8\uC2DC\uACE0 \uC794\uC744 \uB0B4\uB824\uB193\uC558\uB2E4.
      \uC190\uAC00\uB77D\uC774 \uC794\uC758 \uC190\uC7A1\uC774\uC5D0\uC11C \uC7A0\uC2DC
      \uBA48\uCDC4\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC694\uC998 \uC218\uC5C5\uC774 \uB108\uBB34 \uB9CE\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC608\uBC95, \uC5B4\uD559, \uBB38\uC7A5\uD559, \uAC00\uBB34\u2026 \uD558\uB8E8\uC5D0
      \uB2E4\uC12F \uAC1C\uC529 \uB4E4\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC194\uC9C1\uD788 \uC870\uAE08 \uC9C0\uCCD0\uC694."
  _nemoLine: "\uCC3B\uC794\uC5D0\uC11C \uAE40\uC774 \uC624\uB978\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
    \uD55C \uBAA8\uAE08 \uB9C8\uC2DC\uACE0 \uC794\uC744 \uB0B4\uB824\uB193\uC558\uB2E4.
    \uC190\uAC00\uB77D\uC774 \uC794\uC758 \uC190\uC7A1\uC774\uC5D0\uC11C \uC7A0\uC2DC
    \uBA48\uCDC4\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uB0B4\uC77C \uC218\uC5C5 \uD558\uB098 \uC815\uB3C4\uB294 \uC0BC\uCD0C\uC774
      \uC120\uC0DD\uB2D8\uD55C\uD14C \uAC11\uC790\uAE30 \uC77C\uC774 \uC0DD\uACBC\uB2E4\uACE0
      \uB458\uB7EC\uB300\uC904\uAE4C?"
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uADF8\uB798\uB3C4 \uB3FC\uC694?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8\uB7FC \uC5B4\uB5A4 \uC77C\uB85C \uB458\uB7EC\uB300\uC694? \uADF8\uB7F4\uB4EF\uD558\uAC8C
        \uD574\uC57C \uD558\uB294\uB370."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC9C4\uC9C0\uD558\uAC8C \uC5B4\uB5A4
        \uD551\uACC4\uAC00 \uAC00\uC7A5 \uC790\uC5F0\uC2A4\uB7EC\uC6B8\uC9C0 \uACE0\uBBFC\uD558\uAE30
        \uC2DC\uC791\uD588\uB2E4. \uD45C\uC815\uC774 \uC870\uAE08 \uD480\uC5B4\uC84C\uB2E4."
    _responseLine: "\u2026\uADF8\uB798\uB3C4 \uB3FC\uC694?"
    _interactions:
    - {fileID: 11400000, guid: d090616150871a540b234c9482e2e144, type: 2}
    _nextStep: {fileID: 11400000, guid: 7223bf46282e7ce41b45cc394d589d67, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uADF8\uB798. \uC9C0\uCE60 \uB9CC \uD574. \uC194\uC9C1\uD788 \uB9D0\uD574\uC918\uC11C
      \uACE0\uB9D9\uAD6C\uB098. \uD568\uAED8 \uC870\uC728\uD574\uBCF4\uC790."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC798 \uB4E4\uC5B4\uC918\uC11C \uACE0\uB9C8\uC6CC\uC694."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8\uB807\uAC8C \uB9D0\uD574\uC8FC\uB2C8\uAE4C, \uC880 \uAC00\uBCBC\uC6CC\uC84C\uC5B4\uC694."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC28\uB97C \uB2E4\uC2DC \uD55C \uBAA8\uAE08
        \uB9C8\uC168\uB2E4. \uC794\uC744 \uB0B4\uB824\uB193\uC744 \uB54C \uC190\uC5D0\uC11C
        \uD55C \uB2E8\uC758 \uD798\uC774 \uBE60\uC84C\uB2E4."
    _responseLine: "\uC798 \uB4E4\uC5B4\uC918\uC11C \uACE0\uB9C8\uC6CC\uC694."
    _interactions:
    - {fileID: 11400000, guid: d6a5e766052d89c428f1743b91d1f5ed, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: 7223bf46282e7ce41b45cc394d589d67, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uBC31\uC791\uAC00 \uC601\uC560\uB85C\uC11C \uB9C8\uB545\uD788 \uAC70\uCCD0\uC57C
      \uD560 \uACFC\uC815\uC774\uC57C. \uC870\uAE08\uB9CC \uB354 \uACAC\uB514\uC790."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uB124."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uACAC\uB38C\uC57C \uD55C\uB2E4\uB294 \uAC74 \uC54C\uC544\uC694."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC9E7\uAC8C \uB300\uB2F5\uD588\uB2E4.
        \uCC28\uB97C \uB9C8\uC2DC\uC9C0 \uC54A\uACE0, \uC794\uB9CC \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4."
    _responseLine: "\u2026\uB124."
    _interactions:
    - {fileID: 11400000, guid: 49d60b6de82ff6d499a3921eb28eb77f, type: 2}
    - {fileID: 11400000, guid: 5567f538fa6f95541b83bef514683358, type: 2}
    _nextStep: {fileID: 11400000, guid: 7223bf46282e7ce41b45cc394d589d67, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
  _cinematicCues:
    _enterCue: {fileID: 0}
    _exitCue: {fileID: 0}
