  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_rian_0__step_event_week_005_rian_0
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB0AF\uC120 \uC18C\uB144\uC774 \uC815\uC6D0 \uC785\uAD6C\uC5D0\uC11C
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4. \uACC1\uC5D0\uB294 \uB9AC\uC548\uC744
      \uB370\uB824\uC628 \uD558\uC778\uC774 \uC11C \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC548\uB155\uD558\uC138\uC694. \uB9AC\uC548\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC544\uBCA8\uB9AC\uC544\uC608\uC694."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC624\uB298\uC740 \uC624\uB798 \uBABB \uC788\uC5B4\uC694. \uACE7 \uB5A0\uB098\uC57C
      \uD574\uC11C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB124?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB2E4\uB978 \uC694\uC591\uC9C0\uC694. \uC5B4\uB978\uB4E4\uC774 \uADF8\uB807\uAC8C
      \uC815\uD588\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9AC\uC548\uC774 \uC815\uD55C \uAC74 \uC544\uB2C8\uACE0\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB124. \uC800\uB294 \uBCF4\uD1B5 \uB2E4 \uC815\uD574\uC9C4 \uB2E4\uC74C\uC5D0
      \uB4E4\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC870\uAE08 \uC6C3\uC5C8\uC9C0\uB9CC, \uB208\uC740
      \uC6C3\uC9C0 \uC54A\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uAC00\uAE30 \uC804\uC5D0 \uB9CC\uB098\uBCF4\uACE0
      \uC2F6\uC5C8\uC5B4\uC694."
  _nemoLine: "\uB0AF\uC120 \uC18C\uB144\uC774 \uC815\uC6D0 \uC785\uAD6C\uC5D0\uC11C
    \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4. \uACC1\uC5D0\uB294 \uB9AC\uC548\uC744
    \uB370\uB824\uC628 \uD558\uC778\uC774 \uC11C \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
