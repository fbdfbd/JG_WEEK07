--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_yuffie_3__step_event_week_005_yuffie_3
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uD3C9\uC18C\uBCF4\uB2E4 \uBE60\uB978 \uAC78\uC74C\uC73C\uB85C
      \uC544\uBCA8\uB9AC\uC544\uB97C \uCC3E\uC544\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544 \uB2D8."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uC2A8 \uC77C\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uC5B4\uBA38\uB2C8\uAED8\uC11C \uC544\uBCA8\uB9AC\uC544 \uB2D8 \uC774\uC57C\uAE30\uB97C
      \uD558\uC168\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD6C4\uC791\uBD80\uC778\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB124. \uAC71\uC815\uD558\uACE0 \uACC4\uC138\uC694. \uD63C\uC790 \uC0AC\uAD50\uACC4\uC5D0
      \uB098\uAC00\uBA74 \uB2E4\uCE60 \uC218 \uC788\uB2E4\uACE0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2E4\uCE5C\uB2E4\uB294 \uAC8C \uBB34\uC2A8 \uB73B\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uB9D0\uB85C\uC694. \uC2DC\uC120\uC73C\uB85C\uC694. \uADF8\uB7F0 \uAC83\uB4E4\uC774\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC720\uD53C\uB294 \uC190\uC744 \uAF2D \uBAA8\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\uADF8\uB798\uC11C \uC544\uBCA8\uB9AC\uC544 \uB2D8\uC744 \uADF8\uB0E5
      \uB450\uACE0 \uC2F6\uC9C0 \uC54A\uC73C\uC2E0 \uAC83 \uAC19\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC74 \uAC71\uC815\uC778\uAC00\uC694, \uC544\uB2C8\uBA74 \uACB0\uC815\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 746862c98c186d24d80b54442fdd7344, type: 2}
    _text: "\u2026\uC800\uB3C4 \uC544\uC9C1 \uC798 \uBAA8\uB974\uACA0\uC5B4\uC694."
  _nemoLine: "\uC720\uD53C\uB294 \uD3C9\uC18C\uBCF4\uB2E4 \uBE60\uB978 \uAC78\uC74C\uC73C\uB85C
    \uC544\uBCA8\uB9AC\uC544\uB97C \uCC3E\uC544\uC654\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
