  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_excursion_garden_direct_anxious__step_event_week_005_excursion_garden_direct_anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC815\uC6D0 \uD5C8\uAC00-\uBD88\uC548"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC14\uB78C\uC774 \uD55C \uBC88 \uC9C0\uB098\uAC00\uC790, \uB2F4\uC7C1\uC774
      \uC78E\uC774 \uC804\uBD80 \uD55C \uBC29\uD5A5\uC73C\uB85C \uB4A4\uC9D1\uD614\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026 \uB2E8\uD14C."
  - _speaker: {fileID: 11400000, guid: 31350c3de27bb9c43a5cd19e30d43ba8, type: 2}
    _text: "\uB124, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC78E\uC774 \uC800\uB807\uAC8C \uD55C \uBC88\uC5D0 \uB4A4\uC9D1\uD788\uB294
      \uAC70, \uC774\uC0C1\uD558\uC9C0 \uC54A\uC544\uC694?"
  - _speaker: {fileID: 11400000, guid: 31350c3de27bb9c43a5cd19e30d43ba8, type: 2}
    _text: "\uBC14\uB78C\uC774 \uC13C \uB0A0\uC5D0\uB294 \uADF8\uB807\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC544\uAE4C\uAE4C\uC9C0 \uC548 \uADF8\uB7AC\uB294\uB370."
  - _speaker: {fileID: 11400000, guid: 31350c3de27bb9c43a5cd19e30d43ba8, type: 2}
    _text: "\uBC14\uB78C\uC774 \uBC29\uAE08 \uBC14\uB00C\uC5C8\uB098 \uBCF4\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD55C\uCC38\uC744 \uC790\uB9AC\uC5D0
      \uC11C\uC11C, \uC78E\uC774 \uB2E4\uC2DC \uB4A4\uC9D1\uD788\uAE30\uB97C \uAE30\uB2E4\uB838\uB2E4."
  _nemoLine: "\uBC14\uB78C\uC774 \uD55C \uBC88 \uC9C0\uB098\uAC00\uC790, \uB2F4\uC7C1\uC774
    \uC78E\uC774 \uC804\uBD80 \uD55C \uBC29\uD5A5\uC73C\uB85C \uB4A4\uC9D1\uD614\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
