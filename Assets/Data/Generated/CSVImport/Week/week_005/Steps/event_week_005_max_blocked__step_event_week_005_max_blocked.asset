--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_max_blocked__step_event_week_005_max_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC14\uB2E5\uC5D0\uB294 \uBB34\uB3C4\uD68C \uB3D9\uC120\uC774 \uD770
      \uC120\uC73C\uB85C \uD45C\uC2DC\uB418\uC5B4 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: e4d7e54a5ce433a498734ab4f137b35a, type: 2}
    _text: "\uC544\uAC00\uC528\uAED8\uC11C\uB294 \uC774 \uC120\uC744 \uB530\uB77C
      \uAC78\uC73C\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD63C\uC790\uC694?"
  - _speaker: {fileID: 11400000, guid: e4d7e54a5ce433a498734ab4f137b35a, type: 2}
    _text: "\uC6B0\uC120\uC740 \uD63C\uC790 \uC5F0\uC2B5\uD558\uC154\uC57C \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBB34\uB3C4\uD68C\uC5D0\uC11C\uB294 \uD63C\uC790 \uAC77\uC9C0 \uC54A\uC796\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: e4d7e54a5ce433a498734ab4f137b35a, type: 2}
    _text: "\uD30C\uD2B8\uB108\uAC00 \uC788\uC5B4\uB3C4 \uAE30\uBCF8 \uBCF4\uD3ED\uC740
      \uC2A4\uC2A4\uB85C \uB9DE\uCD94\uC154\uC57C \uD569\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD45C\uC2DC\uB41C \uC120 \uC704\uB85C
      \uCC9C\uCC9C\uD788 \uAC78\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: e4d7e54a5ce433a498734ab4f137b35a, type: 2}
    _text: "\uC870\uAE08 \uB354 \uCC9C\uCC9C\uD788. \uC2DC\uC120\uC740 \uC815\uBA74\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC2A4\uD15D\uC774 \uC790\uAFB8 \uAF2C\uC5EC\uC694."
  - _speaker: {fileID: 11400000, guid: e4d7e54a5ce433a498734ab4f137b35a, type: 2}
    _text: "\uB2E4\uC2DC \uCC98\uC74C\uBD80\uD130 \uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC11C\uB2E4
      \uD45C\uC2DC\uB41C \uC120 \uBC16\uC73C\uB85C \uBC1C\uC744 \uB514\uB3A0\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB204\uAC00 \uAC19\uC774 \uAC78\uC73C\uBA74 \uB35C \uD2C0\uB9B4 \uAC83
      \uAC19\uC740\uB370."
  _nemoLine: "\uBC14\uB2E5\uC5D0\uB294 \uBB34\uB3C4\uD68C \uB3D9\uC120\uC774 \uD770
    \uC120\uC73C\uB85C \uD45C\uC2DC\uB418\uC5B4 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
