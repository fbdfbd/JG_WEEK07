--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_millia_3__step_event_week_005_millia_3
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uC8FC\uBCC0\uC744 \uBCF4\uACE0 \uC544\uBCA8\uB9AC\uC544\uB97C
      \uBCF5\uB3C4 \uAD6C\uC11D\uC73C\uB85C \uB370\uB824\uAC14\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC6B0\uB9AC \uC0C1\uB2E8\uC744 \uB108\uBB34 \uBBFF\uC9C0\uB294 \uB9C8\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC00\uB9AC\uC544\uC758 \uC0C1\uB2E8\uC778\uB370\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uADF8\uB798\uC11C \uB9D0\uD558\uB294 \uAC70\uC608\uC694. \uB4DC\uB808\uC2A4
      \uB0A9\uD488\uC740 \uADF8\uB0E5 \uC637 \uD30C\uB294 \uC77C\uC774 \uC544\uB2C8\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC8C \uC911\uC694\uD55C\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB204\uAC00 \uC900\uBE44\uD588\uB294\uC9C0 \uC0AC\uB78C\uB4E4\uC774
      \uBCF4\uB2C8\uAE4C\uC694. \uC544\uBE60\uAC00 \uC694\uC998 \uBC31\uC791\uAC00
      \uC774\uC57C\uAE30\uB97C \uC790\uC8FC \uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC88B\uC740 \uB73B\uC73C\uB85C\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uBC14\uB85C \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uBAA8\uB974\uACA0\uC5B4\uC694. \uADF8\uB798\uC11C \uB9D0\uD574 \uC8FC\uB294
      \uAC70\uC608\uC694. \uC544\uBCA8\uB9AC\uC544\uAC00 \uBAA8\uB974\uACE0 \uBC1B\uC73C\uBA74
      \uC2EB\uC744 \uAC83 \uAC19\uC544\uC11C."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uB9D0\uC744 \uBA48\uCDC4\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\u2026\uC2EB\uC744 \uAC83 \uAC19\uC544\uC11C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uD3B8\uD558\uAC8C \uB9D0\uD574\uB3C4 \uAD1C\uCC2E\uC544\uC694."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uC548 \uB3FC\uC694. \uC774\uC81C\uB294 \uC870\uC2EC\uD574\uC57C \uD55C\uB300\uC694.
      \uBB3C\uAC74\uB3C4, \uC0AC\uB78C\uB3C4\uC694."
  _nemoLine: "\uBC00\uB9AC\uC544\uB294 \uC8FC\uBCC0\uC744 \uBCF4\uACE0 \uC544\uBCA8\uB9AC\uC544\uB97C
    \uBCF5\uB3C4 \uAD6C\uC11D\uC73C\uB85C \uB370\uB824\uAC14\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
