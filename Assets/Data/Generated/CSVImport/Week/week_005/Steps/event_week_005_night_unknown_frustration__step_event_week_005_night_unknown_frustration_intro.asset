  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_night_unknown_frustration__step_event_week_005_night_unknown_frustration_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC774\uB984 \uBAA8\uB97C \uB2F5\uB2F5\uD568"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB450 \uBC88\uC9F8 \uC794\uC774 \uC2DD\uC5B4\uAC00\uB294 \uB3D9\uC548,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uCC3D\uBC16\uC744 \uBD24\uB2E4. \uC815\uC6D0\uC758
      \uB098\uBB47\uAC00\uC9C0\uAC00 \uC544\uC9C1 \uD5D0\uBC97\uC5B4 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC694\uC998 \uAC00\uB054\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uC720 \uC5C6\uC774 \uB2F5\uB2F5\uD560 \uB54C\uAC00 \uC788\uC5B4\uC694.
      \uBB50\uAC00 \uBB38\uC81C\uC778\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB294\uB370."
  _nemoLine: "\uB450 \uBC88\uC9F8 \uC794\uC774 \uC2DD\uC5B4\uAC00\uB294 \uB3D9\uC548,
    \uC544\uBCA8\uB9AC\uC544\uB294 \uCC3D\uBC16\uC744 \uBD24\uB2E4. \uC815\uC6D0\uC758
    \uB098\uBB47\uAC00\uC9C0\uAC00 \uC544\uC9C1 \uD5D0\uBC97\uC5B4 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uADF8\uB7FC \uC77C\uB2E8 \uB2E8 \uAC70 \uBA39\uC790. \uB2E8 \uAC70
      \uBA39\uC73C\uBA74 \uD480\uB824."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uB2E8 \uAC70\uC694..?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uD6A8\uACFC\uAC00 \uC788\uC744\uAE4C\uC694?"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC9C4\uC9C0\uD558\uAC8C \uC751\uC811\uC2E4\uC758
        \uACFC\uC790 \uC811\uC2DC\uB97C \uB4E4\uC5EC\uB2E4\uBD24\uB2E4."
    _responseLine: "\uB2E8 \uAC70\uC694..?"
    _interactions:
    - {fileID: 11400000, guid: 1dd13bdd8eaf9ce4592aeb8a484f9fba, type: 2}
    _nextStep: {fileID: 11400000, guid: 4b675fdd5b5804b41b59f465dc1ecd16, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uB2E4\uB4E4 \uADF8\uB798. \uB108\uB9CC \uADF8\uB7F0 \uAC8C \uC544\uB2C8\uB780\uB2E4."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8\uB798\uC694?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uB2E4\uB4E4 \uADF8\uB807\uB2E4\uB294 \uAC8C \uB354 \uB2F5\uB2F5\uD55C\uB370."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC791\uAC8C \uD55C\uC228\uC744 \uC26C\uC5C8\uB2E4.
        \uC790\uAE30\uAC00 \uD55C\uC228\uC744 \uC26C\uC5C8\uB2E4\uB294 \uAC78 \uB4E4\uD0A4\uACE0
        \uC2F6\uC9C0 \uC54A\uC740 \uB4EF, \uACE7\uBC14\uB85C \uCC28\uB97C \uB4E4\uC5C8\uB2E4."
    _responseLine: "\uADF8\uB798\uC694?"
    _interactions:
    - {fileID: 11400000, guid: deb0ce5818482394cbd8341c67eafeb7, type: 2}
    - {fileID: 11400000, guid: 5567f538fa6f95541b83bef514683358, type: 2}
    _nextStep: {fileID: 11400000, guid: 4b675fdd5b5804b41b59f465dc1ecd16, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uCC9C\uCC9C\uD788 \uCC3E\uC544\uB3C4 \uB3FC. \uB108\uBB34 \uC131\uAE09\uD574
      \uD558\uC9C0 \uC54A\uC544\uB3C4 \uAD1C\uCC2E\uB2E8\uB2E4."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uCC9C\uCC9C\uD788\uC694?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uBE68\uB9AC \uCC3E\uC9C0 \uC54A\uC544\uB3C4 \uB3FC\uC694?"
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC2DD\uC740 \uCC28\uB97C \uB2E4\uC2DC
        \uD55C \uBAA8\uAE08 \uB9C8\uC168\uB2E4. \uCC28\uAC00 \uC2DD\uC5C8\uB2E4\uB294
        \uAC78 \uADF8\uC81C\uC57C \uC54C\uC544\uCC48 \uD45C\uC815\uC774\uC5C8\uB2E4."
    _responseLine: "\u2026\uCC9C\uCC9C\uD788\uC694?"
    _interactions:
    - {fileID: 11400000, guid: 1dd13bdd8eaf9ce4592aeb8a484f9fba, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: 4b675fdd5b5804b41b59f465dc1ecd16, type: 2}
