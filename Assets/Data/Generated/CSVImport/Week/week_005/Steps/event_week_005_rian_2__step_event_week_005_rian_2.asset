--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_rian_2__step_event_week_005_rian_2
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB098\uC911\uC5D0 \uC81C\uAC00 \uC870\uAE08 \uB2EC\uB77C \uBCF4\uC5EC\uB3C4
      \uB180\uB77C\uC9C0 \uB9D0\uC544 \uC8FC\uC138\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB2EC\uB77C \uBCF4\uC778\uB2E4\uB294 \uAC8C \uBB34\uC2A8 \uB73B\uC778\uAC00\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC637\uB3C4 \uB2EC\uB77C\uC9C0\uACE0, \uB9D0\uD22C\uB3C4 \uB2EC\uB77C\uC9C8
      \uC218 \uC788\uB300\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9AC\uC548\uC774 \uC6D0\uD574\uC11C\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC544\uB2C8\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC18C\uB9E4 \uB05D\uC744 \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uBCF4\uD638\uC790\uAC00 \uC778\uC0AC\uBC95\uC744 \uB2E4\uC2DC \uBC30\uC6B0\uB77C\uACE0
      \uD588\uC5B4\uC694. \uACE0\uAC1C \uC219\uC774\uB294 \uAC83\uB3C4 \uC21C\uC11C\uAC00
      \uC788\uB300\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9AC\uC548\uB3C4 \uC0AC\uAD50\uACC4 \uC900\uBE44\uB97C \uD560 \uC904\uC740
      \uBAB0\uB790\uC5B4\uC694."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uADF8\uB7F0 \uAC83 \uAC19\uC544\uC694. \uADF8\uB7F0\uB370 \uC900\uBE44\uD55C\uB2E4\uAE30\uBCF4\uB2E4\uB294\u2026"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBCF4\uB2E4\uB294?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC815\uD574\uC9C4 \uC790\uB9AC\uC5D0 \uB9DE\uCDB0\uC9C0\uB294 \uB290\uB08C\uC774\uC5D0\uC694."
  _nemoLine: "\uB098\uC911\uC5D0 \uC81C\uAC00 \uC870\uAE08 \uB2EC\uB77C \uBCF4\uC5EC\uB3C4
    \uB180\uB77C\uC9C0 \uB9D0\uC544 \uC8FC\uC138\uC694."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
    _nextStep: {fileID: 0}
    _fallbackStep: {fileID: 0}
    _statRequirements: []
  _nextStep: {fileID: 0}
