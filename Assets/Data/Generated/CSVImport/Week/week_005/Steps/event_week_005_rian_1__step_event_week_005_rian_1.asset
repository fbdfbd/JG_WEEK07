MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_005_rian_1__step_event_week_005_rian_1
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC624\uB79C\uB9CC\uC774\uC5D0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC815\uB9D0 \uC624\uB79C\uB9CC\uC774\uB124\uC694."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uBA87 \uAD70\uB370\uB97C \uB2E4\uB140\uC654\uC5B4\uC694. \uBC14\uB2E4
      \uAC00\uAE4C\uC6B4 \uACF3\uB3C4 \uC788\uC5C8\uACE0, \uC0B0 \uCABD\uB3C4 \uC788\uC5C8\uACE0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBC14\uB2E4? \uC800\uB3C4 \uAC00\uACE0\uC2F6\uC5C8\uC5B4\uC694. \uC88B\uC558\uB098\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC798 \uBAA8\uB974\uACA0\uC5B4\uC694. \uAC00\uB294 \uACF3\uB9C8\uB2E4
      \uC870\uC6A9\uD788 \uC788\uC73C\uB77C\uACE0\uB9CC \uD574\uC11C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uBAB8 \uB54C\uBB38\uC774\uB77C\uACE0\uB3C4 \uD558\uACE0, \uC774\uB984
      \uB54C\uBB38\uC774\uB77C\uACE0\uB3C4 \uD574\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uB984\uC774\uC694?"
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC7A0\uAE50 \uB9D0\uC744 \uBA48\uCDC4\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uBBF8\uC548\uD574\uC694. \uADF8\uAC74 \uB9D0\uD558\uBA74 \uC548 \uB41C\uB300\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uCE5C\uAD6C\uC0AC\uC774\uC5D0 \uBE44\uBC00\uC740 \uC5C6\uB294\uAC70
      \uC544\uB2C8\uC5D0\uC694?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "...\uC694\uC998\uC740 \uB9D0\uD558\uBA74 \uC548 \uB418\uB294 \uAC8C \uC790\uAFB8
      \uB298\uC5B4\uB098\uC694."
  _nemoLine: "\uC624\uB79C\uB9CC\uC774\uC5D0\uC694."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices: []
  _conditionalNext:
