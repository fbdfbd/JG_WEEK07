  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_001_millia__step_event_week_001_millia
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uD3EC\uC7A5\uC774 \uC870\uAE08 \uC090\uB6A4\uC5B4\uC9C4
      \uC791\uC740 \uC0C1\uC790\uB97C \uB4E4\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB098 \uBC00\uB9AC\uC544\uC57C. \uC774\uAC70, \uC544\uBE60\uAC00 \uAC16\uB2E4
      \uC8FC\uB798. \uD3EC\uC7A5\uC740 \uB0B4\uAC00 \uD588\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uACE0\uB9C8\uC6CC."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uB108\uD76C \uC544\uBE60 \uC8FD\uC5C8\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4.
      \uC2AC\uD37C?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBAA8\uB974\uACA0\uC5B4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uBAA8\uB97C \uC218\uB3C4 \uC788\uAD6C\uB098."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC751."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC00\uB9AC\uC544\uB294 \uB354 \uBB3B\uC9C0 \uC54A\uACE0 \uC0C1\uC790\uB97C
      \uB0B4\uB824\uB2E4\uBD24\uB2E4."
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uADF8\uB798\uB3C4 \uBC25\uC740 \uBA39\uC5B4\uC57C \uB3FC."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C?"
  - _speaker: {fileID: 11400000, guid: 5ab55b540ea181042902e62a49fb7578, type: 2}
    _text: "\uBC30\uACE0\uD504\uBA74 \uD798\uB4E4\uC796\uC544."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uCC98\uC74C\uC73C\uB85C \uC0C1\uC790\uB97C
      \uB0B4\uB824\uB2E4\uBD24\uB2E4."
  _nemoLine: "\uBC00\uB9AC\uC544\uB294 \uD3EC\uC7A5\uC774 \uC870\uAE08 \uC090\uB6A4\uC5B4\uC9C4
    \uC791\uC740 \uC0C1\uC790\uB97C \uB4E4\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
