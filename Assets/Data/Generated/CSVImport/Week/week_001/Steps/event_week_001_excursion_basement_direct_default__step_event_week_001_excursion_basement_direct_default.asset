  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5EC\uAE30\uB294 \uC65C \uC774\uB807\uAC8C \uB354\uB7EC\uC6CC?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC624\uB798 \uC4F0\uC9C0 \uC54A\uC740 \uACF3\uC774\uB77C \uADF8\uB807\uC2B5\uB2C8\uB2E4,
      \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC548\uC5D0 \uBB50 \uC788\uC5B4?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC624\uB798\uB41C \uBB3C\uAC74\uB4E4\uC774 \uC870\uAE08 \uC788\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC870\uAE08?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC5B4\uB978\uB4E4\uC774 \uADF8\uB807\uAC8C \uB9D0\uD560 \uB54C\uB294,
      \uBCF4\uD1B5 \uAF64 \uB9CE\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB824\uC6CC"
  _nemoLine: "\uC5EC\uAE30\uB294 \uC65C \uC774\uB807\uAC8C \uB354\uB7EC\uC6CC?"
