--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_001_excursion_forest_direct_default__step_event_week_001_excursion_forest_direct_default
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC9C4\uD759 \uC704\uC5D0 \uBC1C\uC790\uAD6D\uC774 \uCC0D\uD600 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC8C \uBB50\uC57C?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC0AC\uC2B4 \uBC1C\uC790\uAD6D\uC785\uB2C8\uB2E4, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0AC\uC2B4?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uBC24 \uC0AC\uC774\uC5D0 \uB0B4\uB824\uC628 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB514\uB85C \uAC14\uC5B4?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uC548\uCABD\uC73C\uB85C \uB4E4\uC5B4\uAC04 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB530\uB77C\uAC00 \uBCF4\uBA74 \uC548 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\u2026\uC544\uAC00\uC528\uB9CC \uC870\uC2EC\uD558\uC2E0\uB2E4\uBA74."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uBC1C\uC790\uAD6D\uC740 \uB098\uBB34\uAC00 \uBE7D\uBE7D\uD574\uC9C0\uB294
      \uACF3\uC5D0\uC11C \uD750\uB9BF\uD574\uC84C\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5EC\uAE30\uC11C \uC5C6\uC5B4\uC84C\uB124."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uB099\uC5FD\uC774 \uC313\uC5EC\uC11C \uADF8\uB807\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0AC\uC2B4\uC740 \uC5B4\uB514 \uC788\uC744\uAE4C."
  - _speaker: {fileID: 11400000, guid: ea8bb1cd384c18f4c83d6f267d5433b5, type: 2}
    _text: "\uB354 \uAE4A\uC774 \uB4E4\uC5B4\uAC14\uC744 \uAC81\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBCF4\uACE0 \uC2F6\uC5C8\uB294\uB370..."
  _nemoLine: "\uC9C4\uD759 \uC704\uC5D0 \uBC1C\uC790\uAD6D\uC774 \uCC0D\uD600 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
