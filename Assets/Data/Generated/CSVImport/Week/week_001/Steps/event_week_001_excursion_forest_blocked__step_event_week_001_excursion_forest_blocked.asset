  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_001_excursion_forest_blocked__step_event_week_001_excursion_forest_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC8C4\uC1A1\uD569\uB2C8\uB2E4, \uC544\uAC00\uC528. \uC624\uB298\uC740
      \uC232\uAE38\uC774 \uC88B\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C?"
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC5B4\uC82F\uBC24 \uBE44\uAC00 \uC640\uC11C \uC9C4\uD759\uC774 \uB9CE\uC774
      \uD328\uC600\uC2B5\uB2C8\uB2E4. \uBC1C\uBAA9\uC744 \uB2E4\uCE58\uC2E4 \uC218
      \uC788\uC5B4\uC11C\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADFC\uB370 \uC800\uAC70\uBD10. \uC0AC\uC2B4 \uBC1C\uC790\uAD6D\uB3C4
      \uC788\uB294\uB370."
  - _speaker: {fileID: 11400000, guid: 0c996a4b6053a604a8453b8d2e8e4626, type: 2}
    _text: "\uC0AC\uC2B4\uC740 \uB124 \uBC1C\uC774\uB77C \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4,
      \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "...\uC54C\uACA0\uC5B4."
  _nemoLine: "\uC8C4\uC1A1\uD569\uB2C8\uB2E4, \uC544\uAC00\uC528. \uC624\uB298\uC740
    \uC232\uAE38\uC774 \uC88B\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
