  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB2EB\uD78C \uBB38 \uC548\uCABD\uC5D0\uC11C \uCC45\uC7A5\uC744 \uC62E\uAE30\uB294
      \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC544\uC9C1 \uC815\uB9AC\uAC00 \uB05D\uB098\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBABB \uB4E4\uC5B4\uAC00?"
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC608. \uC624\uB298\uC740 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB098 \uB3D9\uD654\uCC45 \uBCF4\uACE0 \uC2F6\uB2E8 \uB9D0\uC774\uC57C!"
  - _speaker: {fileID: 11400000, guid: f8e7ba4054caf9048a0b07e84278c8e6, type: 2}
    _text: "\uC8C4\uC1A1\uD569\uB2C8\uB2E4. \uC870\uAE08 \uB098\uC911\uC5D0 \uC640\uC8FC\uC138\uC694,
      \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uCE58...\uC54C\uACA0\uC5B4."
  _nemoLine: "\uB2EB\uD78C \uBB38 \uC548\uCABD\uC5D0\uC11C \uCC45\uC7A5\uC744 \uC62E\uAE30\uB294
    \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
