--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_001_rian_blocked__step_event_week_001_rian_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uD558\uC778\uC774 \uC791\uC740 \uC885\uC774\uBC30 \uD558\uB098\uB97C
      \uB4E4\uACE0 \uBCF5\uB3C4\uB97C \uC9C0\uB098\uAC14\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uADF8\uAC70 \uBB50\uC57C?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uB9AC\uC548 \uB2D8\uAED8\uC11C \uB450\uACE0 \uAC00\uC2E0 \uAC83\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9AC\uC548?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uC774\uC6C3 \uC601\uC9C0\uC5D0\uC11C \uC694\uC591 \uC911\uC778 \uB3C4\uB828\uB2D8\uC774\uB77C\uACE0
      \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uC624\uB298\uC740 \uC544\uAC00\uC528\uB97C \uBD59\uC9C0 \uC54A\uACE0
      \uB3CC\uC544\uAC00\uC168\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uC7A5\uB840\uAC00 \uB05D\uB09C \uC9C0 \uC5BC\uB9C8 \uB418\uC9C0 \uC54A\uC544
      \uC624\uB298\uC740 \uBC29\uBB38\uAC1D\uC744 \uC624\uB798 \uB4E4\uC774\uC9C0
      \uC54A\uAE30\uB85C \uD588\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC885\uC774\uBC30\uB97C \uD55C\uCC38
      \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC774\uAC70\u2026 \uB0B4\uAC70\uC57C?"
  - _speaker: {fileID: 11400000, guid: 382a01f86413cfc439d75f63e427a411, type: 2}
    _text: "\uC544\uB9C8\uB3C4\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC885\uC774\uBC30\uB97C \uC190\uC5D0
      \uC954 \uCC44, \uBCF5\uB3C4 \uB05D\uC744 \uBC14\uB77C\uBCF4\uC558\uB2E4."
  _nemoLine: "\uD558\uC778\uC774 \uC791\uC740 \uC885\uC774\uBC30 \uD558\uB098\uB97C
    \uB4E4\uACE0 \uBCF5\uB3C4\uB97C \uC9C0\uB098\uAC14\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
