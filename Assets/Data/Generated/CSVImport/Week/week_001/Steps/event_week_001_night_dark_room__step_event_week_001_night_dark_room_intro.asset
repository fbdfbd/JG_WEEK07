MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_001_night_dark_room__step_event_week_001_night_dark_room_intro
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: "\uC5B4\uB450\uC6B4 \uBC29"
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C8\uB9AC\uAC00 \uCD1B\uBD88 \uD558\uB098\uB9CC \uB0A8\uAE30\uACE0
      \uBC29\uC744 \uB098\uAC14\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uBD88
      \uB05D\uC744 \uB450 \uC190\uC73C\uB85C \uAF2D \uC950\uACE0 \uC788\uC5C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC0BC\uCD0C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBD88 \uB354 \uD0A4\uC6B0\uBA74 \uC548 \uB3FC?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC5B4\uB450\uC6B0\uBA74 \uBB34\uC11C\uC6CC."
  _nemoLine: "\uB9C8\uB9AC\uAC00 \uCD1B\uBD88 \uD558\uB098\uB9CC \uB0A8\uAE30\uACE0
    \uBC29\uC744 \uB098\uAC14\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uBD88
    \uB05D\uC744 \uB450 \uC190\uC73C\uB85C \uAF2D \uC950\uACE0 \uC788\uC5C8\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
  _onEnterInteractions: []
  _choices:
  - _label: "\uADF8\uB798, \uB354 \uBC1D\uAC8C \uD574\uC904\uAC8C. \uBB34\uC11C\uC6B0\uBA74
      \uC5B8\uC81C\uB4E0 \uB9D0\uD558\uB834."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC751. \uACE0\uB9C8\uC6CC, \uC0BC\uCD0C."
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC0BC\uCD0C\uC774 \uC606\uC5D0 \uC788\uC73C\uBA74 \uB35C \uBB34\uC11C\uC6CC."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uBD88 \uC7A1\uC740 \uC190\uC744
        \uCC9C\uCC9C\uD788 \uD3C8\uB2E4."
    _responseLine: "\uC751. \uACE0\uB9C8\uC6CC, \uC0BC\uCD0C."
    _interactions:
    - {fileID: 11400000, guid: d6a5e766052d89c428f1743b91d1f5ed, type: 2}
    - {fileID: 11400000, guid: 4e2d4519c1faa224990410a373c41ac7, type: 2}
    _nextStep: {fileID: 11400000, guid: 0f9a9dd20cc76c94eb0808f3dc4fa3b0, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uC5B4\uB460\uC740 \uBB34\uC11C\uC6B4 \uAC8C \uC544\uB2C8\uC57C. \uACE7
      \uC775\uC219\uD574\uC9C4\uB2E8\uB2E4."
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADF8\uB798?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uADFC\uB370 \uB098\uB294 \uC544\uC9C1 \uC548 \uC775\uC219\uD574."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB300\uB2F5\uC744 \uB354 \uD558\uC9C0
        \uC54A\uC558\uB2E4. \uC774\uBD88\uC744 \uCF54 \uB05D\uAE4C\uC9C0 \uB04C\uC5B4
        \uC62C\uB838\uB2E4."
    _responseLine: "\uADF8\uB798?"
    _interactions:
    - {fileID: 11400000, guid: 07a82ea2eb4e69d47b46715d83afdd61, type: 2}
    - {fileID: 11400000, guid: 5567f538fa6f95541b83bef514683358, type: 2}
    _nextStep: {fileID: 11400000, guid: 0f9a9dd20cc76c94eb0808f3dc4fa3b0, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  - _label: "\uADF8\uB7FC \uC591 \uD55C \uB9C8\uB9AC, \uB450 \uB9C8\uB9AC \uAC19\uC774
      \uC138\uC5B4\uBCFC\uAE4C?"
    _responseDialogueLines:
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\u2026\uC591?"
    - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
      _text: "\uC6B0\uB9AC \uC9D1\uC5D0 \uC591 \uC5C6\uB294\uB370."
    - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
      _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC7A0\uAE50 \uC9C4\uC9C0\uD558\uAC8C
        \uCC9C\uC7A5\uC744 \uC62C\uB824\uB2E4\uBD24\uB2E4."
    _responseLine: "\u2026\uC591?"
    _interactions:
    - {fileID: 11400000, guid: 1dd13bdd8eaf9ce4592aeb8a484f9fba, type: 2}
    _nextStep: {fileID: 11400000, guid: 0f9a9dd20cc76c94eb0808f3dc4fa3b0, type: 2}
    _resultCinematicCues:
      _enterCue: {fileID: 0}
      _exitCue: {fileID: 0}
  _conditionalNext:
