  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_001_rian__step_event_week_001_rian
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC548\uB155. \uB098\uB294 \uB9AC\uC548\uC774\uC57C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC548\uB155."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB108\uB3C4 \uCE5C\uAD6C \uC5C6\uC5B4?"
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uC751."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uB098\uB3C4 \uC5C6\uC5B4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC544\uD30C\uC11C \uC5EC\uAE30\uC800\uAE30 \uB2E4\uB140. \uADF8\uB798\uC11C
      \uCE5C\uAD6C\uAC00 \uC798 \uC548 \uC0DD\uACA8."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9AC\uC548\uC740 \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC811\uD78C \uC885\uC774\uBC30\uB97C
      \uAEBC\uB0C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC774\uAC70 \uC904\uAC8C."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC65C?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uCE5C\uAD6C \uD558\uB824\uACE0."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC885\uC774\uBC30\uAC00 \uC788\uC73C\uBA74 \uCE5C\uAD6C\uC57C?"
  - _speaker: {fileID: 11400000, guid: d39a31eaba59e544f81d15fd71eb37aa, type: 2}
    _text: "\uC544\uB2C8. \uADF8\uB0E5, \uC8FC\uACE0 \uC2F6\uC5B4\uC11C."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC885\uC774\uBC30\uB97C \uBC1B\uC558\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uACE0\uB9C8\uC6CC."
  _nemoLine: "\uC548\uB155. \uB098\uB294 \uB9AC\uC548\uC774\uC57C."
