--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae0b7e66326e1946bca6ce9fa70ec4c, type: 3}
  m_Name: event_week_001_rumor_blocked__step_event_week_001_rumor_blocked
  m_EditorClassIdentifier: Assembly-CSharp::SO_InteractiveEventStepDefinition
  _titleOverride: 
  _bodyText: 
  _dialogueLines:
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C8\uB9AC\uAC00 \uCC28 \uC7C1\uBC18\uC744 \uB4E4\uACE0 \uB4E4\uC5B4\uC654\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C8\uB9AC, \uC624\uB298\uC740 \uC815\uC6D0\uC5D0 \uC548 \uB098\uAC00\uB3C4
      \uB3FC?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC624\uB298\uC740 \uCC28\uBD80\uD130 \uD55C \uC794 \uB4DC\uC2DC\uC9C0\uC694."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC751? \uAC11\uC790\uAE30?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uBA70\uCE60 \uC0C8 \uD587\uBE5B\uC774 \uAC15\uD588\uC2B5\uB2C8\uB2E4.
      \uC7A0\uAE50 \uC548\uC5D0\uC11C \uC26C\uC2DC\uB294 \uAC8C \uC88B\uC2B5\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uBCC4\uB85C \uC548 \uB354\uC6B4\uB370."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\u2026\uADF8\uB798\uB3C4 \uD55C \uC794 \uB4DC\uC2DC\uACE0\uC694."
  - _speaker: {fileID: 11400000, guid: 847f079bcbea6a646a71c4510ac11245, type: 2}
    _text: "\uB9C8\uB9AC\uB294 \uCC3B\uC794\uC744 \uCC9C\uCC9C\uD788 \uB0B4\uB824\uB193\uC558\uB2E4.
      \uC190\uC774 \uD3C9\uC18C\uBCF4\uB2E4 \uC2E0\uC911\uD588\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uB9C8\uB9AC."
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608, \uC544\uAC00\uC528."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\uC624\uB298 \uBB34\uC2A8 \uB0A0\uC774\uC57C?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC544\uB2D9\uB2C8\uB2E4. \uADF8\uB0E5 \uD3C9\uBC94\uD55C \uC624\uD6C4\uC785\uB2C8\uB2E4."
  - _speaker: {fileID: 11400000, guid: 30d9fee260dbe2f40bbd2e941f19c4b0, type: 2}
    _text: "\u2026\uADF8\uB798?"
  - _speaker: {fileID: 11400000, guid: 5bb39217ef6e2284f84306acd528c0b3, type: 2}
    _text: "\uC608. \uCC28\uAC00 \uC2DD\uAE30 \uC804\uC5D0 \uB4DC\uC2DC\uC9C0\uC694."
  _nemoLine: "\uB9C8\uB9AC\uAC00 \uCC28 \uC7C1\uBC18\uC744 \uB4E4\uACE0 \uB4E4\uC5B4\uC654\uB2E4."
  _useCustomVisualState: 0
  _visualState: 0
