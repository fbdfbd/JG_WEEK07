  _options:
  - _semantic: 0
    _label: "\uD5C8\uAC00"
    _presentedText: "\uB3C4\uC11C\uAD00\uC5D0 \uC544\uCE68 \uD587\uC0B4\uC774 \uB4E4\uC5B4\uC628\uB2E4.\n\uC544\uBC84\uC9C0\uAC00
      \uB0A8\uAE34 \uC790\uB9AC\uC758 \uC758\uBBF8\uB97C \uACC4\uC0B0\uD558\uB4EF
      \uC9DA\uC5B4\uBCFC \uC218 \uC788\uB2E4."
    _interactions: []
  - _semantic: 2
    _label: "\uD1B5\uC81C"
    _presentedText: "\uC131\uC778\uC2DD \uC900\uBE44\uB85C \uB3C4\uC11C\uAD00 \uBB38\uC774
      \uB2EB\uD600 \uC788\uB2E4.\n\uC815\uD574\uC9C4 \uC808\uCC28\uB97C \uB530\uB974\uC9C0\uB9CC,
      \uD655\uC778\uD558\uC9C0 \uBABB\uD55C \uAE30\uB85D\uC5D0 \uC870\uAE08 \uB354
      \uBBFC\uAC10\uD574\uC9C8 \uC218 \uC788\uB2E4."
    _interactions: []
