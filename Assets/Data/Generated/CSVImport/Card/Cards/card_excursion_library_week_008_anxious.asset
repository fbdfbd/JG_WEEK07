  _options:
  - _semantic: 0
    _label: "\uD5C8\uAC00"
    _presentedText: "\uBD09\uC778\uB41C \uB9C8\uC9C0\uB9C9 \uD3B8\uC9C0\uAC00 \uB3C4\uC11C\uAD00
      \uCC45\uC0C1 \uC704\uC5D0 \uB193\uC5EC \uC788\uB2E4.\r\n\uD568\uBD80\uB85C
      \uC5F4\uC9C0 \uC54A\uC73C\uB824\uB294 \uC870\uC2EC\uC2A4\uB7EC\uC6C0\uACFC,
      \uD3B8\uC9C0\uC758 \uB0B4\uC6A9\uC5D0 \uC608\uBBFC\uD574\uC9C0\uB294 \uB9C8\uC74C\uC774
      \uC0DD\uAE38 \uC218 \uC788\uB2E4."
    _interactions: []
  - _semantic: 2
    _label: "\uD1B5\uC81C"
    _presentedText: "\uC544\uBC84\uC9C0\uC758 \uB9C8\uC9C0\uB9C9 \uD3B8\uC9C0\uAC00
      \uC788\uB294 \uB3C4\uC11C\uAD00 \uBB38\uC774 \uB2EB\uD600 \uC788\uB2E4.\r\n\uC815\uD574\uC9C4
      \uAE30\uB2E4\uB9BC\uC744 \uB530\uB974\uBA70, \uD655\uC778\uD558\uC9C0 \uBABB\uD55C
      \uB0B4\uC6A9\uC5D0 \uBBFC\uAC10\uD574\uC9C8 \uC218 \uC788\uB2E4."
    _interactions: []
