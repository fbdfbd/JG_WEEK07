  _options:
  - _semantic: 0
    _label: "\uD5C8\uAC00"
    _presentedText: "\uB3C4\uC11C\uAD00 \uCC45\uC0C1\uC5D0 \uD3BC\uCCD0\uB193\uC740
      \uC608\uBC95\uC11C\uAC00 \uADF8\uB300\uB85C \uB193\uC5EC \uC788\uB2E4.\r\n\uC21C\uC11C\uC640
      \uC2DC\uC120\uC744 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uC0B4\uD53C\uBA70 \uB9C8\uC74C\uC744
      \uCC28\uBD84\uD788 \uAC00\uB2E4\uB4EC\uC744 \uC218 \uC788\uB2E4."
    _interactions: []
  - _semantic: 2
    _label: "\uD1B5\uC81C"
    _presentedText: "\uB3C4\uC11C\uAD00 \uBB38\uC740 \uBB34\uB3C4\uD68C \uC900\uBE44\uB85C
      \uB2EB\uD600 \uC788\uB2E4.\r\n\uC815\uD574\uC9C4 \uC77C\uC815\uC744 \uB530\uB974\uBA70,
      \uAE09\uD55C \uC900\uBE44 \uACFC\uC815\uC5D0 \uC870\uAE08 \uB354 \uBBFC\uAC10\uD574\uC9C8
      \uC218 \uC788\uB2E4."
