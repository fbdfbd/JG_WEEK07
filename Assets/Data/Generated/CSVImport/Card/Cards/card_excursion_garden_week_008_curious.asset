  - _semantic: 0
    _label: "\uD5C8\uAC00"
    _presentedText: "\uBE44\uC5B4 \uC788\uB294 \uC0C8\uC7A5 \uC548\uC5D0 \uC791\uC740
      \uAE43\uD138 \uD558\uB098\uAC00 \uB0A8\uC544 \uC788\uB2E4.\n\uB0A8\uACA8\uC9C4
      \uAE43\uD138\uC5D0 \uC21C\uC218\uD55C \uB9C8\uC74C\uC744 \uB450\uBA70, \uB9C8\uC74C\uC744
      \uCC28\uBD84\uD788 \uAC00\uB2E4\uB4EC\uC744 \uC218 \uC788\uB2E4."
    _interactions: []
  - _semantic: 2
    _label: "\uD1B5\uC81C"
    _presentedText: "\uCC3D\uBC16\uC5D0\uC11C \uB0A1\uC740 \uC0C8\uC7A5 \uBB38\uC18C\uB9AC\uAC00
      \uACC4\uC18D \uB4E4\uB824\uC628\uB2E4.\n\uBCF4\uC9C0 \uBABB\uD55C \uCC44 \uC774\uC5B4\uC9C0\uB294
      \uC18C\uB9AC\uC5D0 \uC870\uAE08 \uB354 \uBBFC\uAC10\uD574\uC9C8 \uC218 \uC788\uB2E4."
