  _options:
  - _semantic: 0
    _label: "\uD5C8\uAC00"
    _presentedText: "\uBB34\uB3C4\uD68C \uC608\uBC95\uC11C\uC758 \uADF8\uB9BC\uC774
      \uD3BC\uCCD0\uC838 \uC788\uB2E4.\r\n\uBCF5\uC7A1\uD55C \uC0AC\uAD50\uC758 \uB73B\uBCF4\uB2E4\uB294
      \uB208\uC55E\uC758 \uB3D9\uC791\uC744 \uC21C\uBC15\uD558\uAC8C \uB530\uB77C
      \uD558\uBA70 \uB9C8\uC74C\uC744 \uCC28\uBD84\uD788 \uAC00\uB2E4\uB4EC\uC744
      \uC218 \uC788\uB2E4."
    _interactions: []
  - _semantic: 2
    _label: "\uD1B5\uC81C"
    _presentedText: "\uB3C4\uC11C\uAD00\uC740 \uC608\uBC95 \uC218\uC5C5 \uC900\uBE44\uB85C
      \uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uB2E4.\r\n\uC815\uD574\uC9C4 \uC808\uCC28\uB97C
      \uB530\uB974\uBA70, \uB2EB\uD78C \uC815\uBCF4\uC5D0 \uC870\uAE08 \uB354 \uC608\uBBFC\uD574\uC9C8
      \uC218 \uC788\uB2E4."
