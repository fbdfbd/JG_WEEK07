    _interactions: []
  - _semantic: 2
    _label: "\uD1B5\uC81C"
    _presentedText: "\uC815\uC6D0\uC740 \uC815\uB9AC \uC911\uC774\uB77C \uB4E4\uC5B4\uAC08
      \uC218 \uC5C6\uB2E4.\n\uBCF5\uC7A1\uD55C \uC774\uC720\uB97C \uB530\uC9C0\uAE30\uBCF4\uB2E4,
      \uAFB8\uBC08\uC5C6\uB294 \uB9C8\uC74C\uC73C\uB85C \uAE30\uB2E4\uB9AC\uB294
      \uBC95\uC744 \uBC30\uC6B8 \uC218 \uC788\uB2E4."
