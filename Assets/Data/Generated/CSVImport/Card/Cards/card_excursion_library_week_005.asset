  - _semantic: 0
    _label: "\uD5C8\uAC00"
    _presentedText: "\uB3C4\uC11C\uAD00 \uCC45\uC0C1\uC5D0 \uBB34\uB3C4\uD68C \uC608\uBC95\uC11C\uC640
