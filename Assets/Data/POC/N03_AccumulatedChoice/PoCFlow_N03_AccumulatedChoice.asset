  m_Script: {fileID: 11500000, guid: fac263f3beb935544aa88e3bb087fafe, type: 3}
  m_Name: PoCFlow_N03_AccumulatedChoice
  m_EditorClassIdentifier: Assembly-CSharp::SO_PoCFlowDefinition
  _introPages:
  - _title: "\uC120\uD0DD \uB204\uC801\uD615 \uC721\uC131 PoC"
    _body: "\uC774 PoC\uB294 \uAC04\uC811\uD1B5\uC81C \uC790\uCCB4\uC758 \uC7AC\uBBF8\uAC00
      \uC544\uB2C8\uB77C, \uC120\uD0DD\uC774 \uB204\uC801\uB418\uC5B4 \uC721\uC131
      \uB300\uC0C1\uC758 \uD589\uB3D9 \uBC29\uC2DD\uC774 \uD615\uC131\uB418\uB294
      \uC7AC\uBBF8\uB97C \uAC80\uC99D\uD55C\uB2E4.\n\n\uB0B4\uAC00 \uC9C1\uC811 \uC2DC\uD0A8
      \uAC83\uC740 \uC544\uB2C8\uC9C0\uB9CC, \uB0B4 \uC120\uD0DD\uB4E4\uC774 \uB204\uC801\uB418\uC5B4
      \uB300\uC0C1\uC774 \uC774\uB7F0 \uBC29\uC2DD\uC73C\uB85C \uC790\uB77C\uB0AC\uB2E4\uACE0
      \uB290\uB07C\uB294 \uC7AC\uBBF8\uB97C \uD655\uC778\uD55C\uB2E4."
  _days:
  - _id: day1_place_policy
    _label: "DAY 1 - \uCCAB \uBC88\uC9F8 \uC120\uD0DD: \uC7A5\uC18C\uC5D0 \uB300\uD55C
      \uBC29\uCE68"
    _report:
      _fallbackPage:
        _title: "DAY 1 \uB0AE \uBCF4\uACE0\uC11C"
        _body: "\uB300\uC0C1\uC740 \uC624\uB298\uB3C4 \uAC19\uC740 \uC7A5\uC18C\uC5D0
          \uC624\uB798 \uBA38\uBB3C\uB800\uB2E4.\n\uD574\uB2F9 \uC7A5\uC18C\uC5D0\uC11C\uB294
          \uC548\uC815\uC801\uC778 \uD589\uB3D9\uC744 \uBCF4\uC600\uC9C0\uB9CC, \uB2E4\uB978
          \uC790\uADF9\uC5D0\uB294 \uBC18\uC751\uC774 \uC904\uC5C8\uB2E4.\n\uD604\uC7AC
          \uD589\uB3D9\uC744 \uC720\uC9C0\uD560\uC9C0, \uC81C\uD55C\uD560\uC9C0,
          \uC870\uAC74\uC744 \uC870\uC815\uD560\uC9C0 \uACB0\uC815\uC774 \uD544\uC694\uD558\uB2E4."
      _rules: []
    _choiceTitle: "\uB300\uC0C1\uC774 \uD2B9\uC815 \uC7A5\uC18C\uC5D0 \uBC18\uBCF5\uC801\uC73C\uB85C
      \uBA38\uBB34\uB294 \uD589\uB3D9"
    _choiceBody: "\uC7A5\uC18C \uC811\uADFC\uC5D0 \uB300\uD55C \uD658\uACBD \uBC29\uCE68\uC744
      \uC120\uD0DD\uD55C\uB2E4."
    _mainChoices:
    - _id: day1_allow
      _label: "\uD5C8\uAC00"
      _description: "\uC7A5\uC18C \uC811\uADFC\uC744 \uADF8\uB300\uB85C \uD5C8\uC6A9\uD55C\uB2E4."
      _setFlags:
      - place_accepted
      _statChanges:
      - _statType: 0
        _delta: 1
      - _statType: 1
        _delta: 1
      - _statType: 2
        _delta: 1
    - _id: day1_block
      _label: "\uCC28\uB2E8"
      _description: "\uC7A5\uC18C \uC811\uADFC\uC744 \uC81C\uD55C\uD55C\uB2E4."
      _setFlags:
      - place_denied
      _statChanges:
      - _statType: 0
        _delta: 1
      - _statType: 1
        _delta: -1
      - _statType: 2
        _delta: -1
    - _id: day1_modify
      _label: "\uC218\uC815"
      _description: "\uC7A5\uC18C \uAD6C\uC870\uB098 \uC790\uADF9\uC744 \uC77C\uBD80
        \uBCC0\uACBD\uD55C\uB2E4."
      _setFlags:
      - place_altered
      _statChanges:
      - _statType: 0
        _delta: 1
      - _statType: 1
        _delta: -1
      - _statType: 3
        _delta: 1
    _dayEvent:
      _title: "DAY 1 \uB0AE \uD53C\uB4DC\uBC31"
      _body: "\uC120\uD0DD\uC5D0 \uB530\uB978 \uB0AE \uD53C\uB4DC\uBC31\uC774 \uD45C\uC2DC\uB41C\uB2E4."
      _statChanges: []
      _rules:
      - _priority: 3
        _requiredChoiceId: 
        _requiredFlags:
        - place_accepted
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 1 \uB0AE \uD53C\uB4DC\uBC31 - \uD5C8\uAC00"
          _body: "\uC7A5\uC18C \uC811\uADFC\uC774 \uC720\uC9C0\uB418\uC5C8\uB2E4.\n\uB300\uC0C1\uC740
            \uD3C9\uC18C\uCC98\uB7FC \uADF8\uACF3\uC5D0 \uBA38\uBB3C\uB800\uACE0,
            \uBA38\uBB34\uB294 \uC2DC\uAC04\uC774 \uC870\uAE08 \uC99D\uAC00\uD588\uB2E4.\n\uAC15\uC81C\uB85C
            \uD589\uB3D9\uC744 \uBC14\uAFB8\uB824\uB294 \uBC18\uC751\uC740 \uBCF4\uC774\uC9C0
            \uC54A\uC558\uB2E4.\n\n\uD53C\uB4DC\uBC31 \uC758\uB3C4\n\uB300\uC0C1\uC740
            \uC790\uAE30 \uB9AC\uB4EC\uC744 \uC720\uC9C0\uD55C\uB2E4."
          _statChanges: []
      - _priority: 2
        _requiredChoiceId: 
        _requiredFlags:
        - place_denied
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 1 \uB0AE \uD53C\uB4DC\uBC31 - \uCC28\uB2E8"
          _body: "\uC7A5\uC18C \uC811\uADFC\uC774 \uC81C\uD55C\uB418\uC5C8\uB2E4.\n\uB300\uC0C1\uC740
            \uD55C\uB3D9\uC548 \uC785\uAD6C \uADFC\uCC98\uC5D0 \uBA38\uBB3C\uB800\uC9C0\uB9CC,
            \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC9C0\uB294 \uBABB\uD588\uB2E4.\n\uC774\uD6C4
            \uD65C\uB3D9\uB7C9\uC774 \uC904\uACE0 \uB300\uAE30 \uC2DC\uAC04\uC774
            \uB298\uC5C8\uB2E4.\n\n\uD53C\uB4DC\uBC31 \uC758\uB3C4\n\uD589\uB3D9\uC740
            \uB9C9\uD614\uC9C0\uB9CC, \uC695\uAD6C\uB294 \uC0AC\uB77C\uC9C0\uC9C0
            \uC54A\uC558\uB2E4."
          _statChanges: []
      - _priority: 1
        _requiredChoiceId: 
        _requiredFlags:
        - place_altered
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 1 \uB0AE \uD53C\uB4DC\uBC31 - \uC218\uC815"
          _body: "\uC7A5\uC18C\uC758 \uAD6C\uC870\uAC00 \uC77C\uBD80 \uBCC0\uACBD\uB418\uC5C8\uB2E4.\n\uB300\uC0C1\uC740
            \uCC98\uC74C\uC5D0\uB294 \uBA48\uCE6B\uD588\uC9C0\uB9CC, \uACE7 \uBCC0\uACBD\uB41C
            \uC7A5\uC18C \uC548\uC5D0 \uBA38\uBB3C\uB800\uB2E4.\n\uC548\uC815 \uBC18\uC751\uC740
            \uC720\uC9C0\uB418\uC5C8\uC73C\uB098, \uC774\uC804\uC5D0 \uBCF4\uC774\uB358
            \uC790\uBC1C\uC801 \uC6C0\uC9C1\uC784\uC740 \uC904\uC5C8\uB2E4.\n\n\uD53C\uB4DC\uBC31
            \uC758\uB3C4\n\uC548\uC815\uC740 \uC720\uC9C0\uB410\uC9C0\uB9CC, \uC6D0\uB798
            \uBC29\uC2DD\uC740 \uD750\uB824\uC84C\uB2E4."
          _statChanges: []
    _nightDialogueRules:
    - _dialogue: {fileID: 11400000, guid: 3050bd3768b1b0243ba3ef17fbae5dca, type: 2}
      _priority: 3
      _requiredChoiceId: 
      _requiredFlags:
      - place_accepted
      _forbiddenFlags: []
      _statRequirements: []
    - _dialogue: {fileID: 11400000, guid: 4eb698945cf4e59439e2a43f7772cf5f, type: 2}
      _priority: 2
      _requiredChoiceId: 
      _requiredFlags:
      - place_denied
      _forbiddenFlags: []
      _statRequirements: []
    - _dialogue: {fileID: 11400000, guid: 3ebedc7b45e3df34b8e7e6c13ab3b587, type: 2}
      _priority: 1
      _requiredChoiceId: 
      _requiredFlags:
      - place_altered
      _forbiddenFlags: []
      _statRequirements: []
  - _id: day2_stimulus_policy
    _label: "DAY 2 - \uB450 \uBC88\uC9F8 \uC120\uD0DD: \uC0C8 \uC790\uADF9\uC5D0
      \uB300\uD55C \uBC29\uCE68"
    _report:
      _fallbackPage:
        _title: "DAY 2 \uACF5\uD1B5 \uC0C1\uD669"
        _body: "\uB300\uC0C1\uC774 \uBA38\uBB34\uB294 \uC7A5\uC18C \uADFC\uCC98\uC5D0
          \uB0AF\uC120 \uBB3C\uCCB4\uAC00 \uB193\uC600\uB2E4.\n\uB300\uC0C1\uC740
          \uBB3C\uCCB4\uB97C \uBC1C\uACAC\uD55C \uB4A4, \uC7A0\uC2DC \uBA48\uCDB0\uC11C
          \uBC14\uB77C\uBCF8\uB2E4.\n\uC811\uADFC\uC744 \uD5C8\uC6A9\uD560\uC9C0,
          \uCC28\uB2E8\uD560\uC9C0, \uC870\uAC74\uC744 \uC218\uC815\uD560\uC9C0 \uACB0\uC815\uC774
          \uD544\uC694\uD558\uB2E4."
      _rules:
      - _priority: 3
        _requiredChoiceId: 
        _requiredFlags:
        - place_accepted
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 2 \uC2DC\uC791 \uBCF4\uACE0\uC11C - PlaceMemory Accepted"
          _body: "\uB300\uC0C1\uC740 \uAC19\uC740 \uC7A5\uC18C\uB97C \uB2E4\uC2DC
            \uCC3E\uC558\uB2E4.\n\uC5B4\uC81C\uBCF4\uB2E4 \uAE34\uC7A5 \uBC18\uC751\uC774
            \uC904\uC5C8\uACE0, \uC7A5\uC18C \uC8FC\uBCC0\uC744 \uCC9C\uCC9C\uD788
            \uC0B4\uD53C\uB294 \uD589\uB3D9\uC774 \uCD94\uAC00\uB418\uC5C8\uB2E4.\n\uD574\uB2F9
            \uC7A5\uC18C\uB97C \uC548\uC815\uB41C \uAE30\uC900\uC810\uCC98\uB7FC
            \uC0AC\uC6A9\uD558\uB294 \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4."
      - _priority: 2
        _requiredChoiceId: 
        _requiredFlags:
        - place_denied
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 2 \uC2DC\uC791 \uBCF4\uACE0\uC11C - PlaceMemory Denied"
          _body: "\uB300\uC0C1\uC740 \uC81C\uD55C\uB41C \uC7A5\uC18C\uC5D0 \uC811\uADFC\uD558\uC9C0
            \uC54A\uC558\uB2E4.\n\uB300\uC2E0 \uBE44\uC2B7\uD55C \uAD6C\uC870\uC758
            \uB2E4\uB978 \uAD6C\uC11D\uC5D0 \uC624\uB798 \uBA38\uBB3C\uB800\uB2E4.\n\uAE30\uC874
            \uD589\uB3D9\uC740 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uACE0 \uB2E4\uB978
            \uD615\uD0DC\uB85C \uC62E\uACA8\uAC04 \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4."
      - _priority: 1
        _requiredChoiceId: 
        _requiredFlags:
        - place_altered
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 2 \uC2DC\uC791 \uBCF4\uACE0\uC11C - PlaceMemory Altered"
          _body: "\uB300\uC0C1\uC740 \uBCC0\uACBD\uB41C \uC7A5\uC18C\uB97C \uC0AC\uC6A9\uD588\uB2E4.\n\uC548\uC815
            \uBC18\uC751\uC740 \uC720\uC9C0\uB418\uC5C8\uC9C0\uB9CC, \uC6C0\uC9C1\uC784\uC740
            \uC774\uC804\uBCF4\uB2E4 \uC815\uD574\uC9C4 \uACBD\uB85C\uB97C \uB530\uB790\uB2E4.\n\uC790\uBC1C\uC801\uC778
            \uD0D0\uC0C9 \uD589\uB3D9\uC740 \uAC10\uC18C\uD588\uB2E4."
    _choiceTitle: "\uB0AF\uC120 \uBB3C\uCCB4\uC5D0 \uB300\uD55C \uBC29\uCE68"
    _choiceBody: "DAY 1 \uC120\uD0DD\uC758 \uACB0\uACFC\uAC00 \uBC18\uC601\uB41C
      \uC0C1\uD0DC\uC5D0\uC11C \uC0C8 \uC790\uADF9\uC5D0 \uB300\uD55C \uD658\uACBD
      \uBC29\uCE68\uC744 \uC120\uD0DD\uD55C\uB2E4."
    _mainChoices:
    - _id: day2_allow
      _label: "\uD5C8\uAC00"
      _description: "\uB0AF\uC120 \uBB3C\uCCB4\uC5D0 \uC790\uC720\uB86D\uAC8C \uC811\uADFC\uD558\uB3C4\uB85D
        \uB454\uB2E4."
      _setFlags:
      - stimulus_allowed
      _statChanges:
      - _statType: 1
        _delta: 1
      - _statType: 2
        _delta: 1
    - _id: day2_block
      _label: "\uCC28\uB2E8"
      _description: "\uB0AF\uC120 \uBB3C\uCCB4 \uC811\uADFC\uC744 \uC81C\uD55C\uD55C\uB2E4."
      _setFlags:
      - stimulus_blocked
      _statChanges:
      - _statType: 0
        _delta: 1
      - _statType: 1
        _delta: -1
    - _id: day2_modify
      _label: "\uC218\uC815"
      _description: "\uBB3C\uCCB4 \uC704\uCE58\uB098 \uC811\uADFC \uACBD\uB85C\uB97C
        \uC870\uC815\uD55C\uB2E4."
      _setFlags:
      - stimulus_guided
      _statChanges:
      - _statType: 0
        _delta: 1
      - _statType: 3
        _delta: 1
    _dayEvent:
      _title: "DAY 2 \uB0AE \uD53C\uB4DC\uBC31"
      _body: "\uC120\uD0DD\uC5D0 \uB530\uB978 \uB0AE \uD53C\uB4DC\uBC31\uC774 \uD45C\uC2DC\uB41C\uB2E4."
      _statChanges: []
      _rules:
      - _priority: 3
        _requiredChoiceId: 
        _requiredFlags:
        - stimulus_allowed
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 2 \uB0AE \uD53C\uB4DC\uBC31 - \uD5C8\uAC00"
          _body: "\uB300\uC0C1\uC740 \uB0AF\uC120 \uBB3C\uCCB4\uC5D0 \uBC14\uB85C
            \uB2FF\uC9C0 \uC54A\uC558\uB2E4.\n\uC775\uC219\uD55C \uC7A5\uC18C\uC640
            \uBB3C\uCCB4 \uC0AC\uC774\uB97C \uC624\uAC00\uBA70, \uC811\uADFC\uACFC
            \uD6C4\uD1F4\uB97C \uBC18\uBCF5\uD588\uB2E4.\n\uC2DC\uAC04\uC774 \uC9C0\uB098\uC790
            \uC2A4\uC2A4\uB85C \uAC70\uB9AC\uB97C \uC881\uD788\uB294 \uD589\uB3D9\uC774
            \uAD00\uCC30\uB418\uC5C8\uB2E4.\n\n\uD53C\uB4DC\uBC31 \uC758\uB3C4\n\uB300\uC0C1\uC740
            \uC2A4\uC2A4\uB85C \uC2DC\uB3C4\uD558\uACE0 \uC870\uC808\uD55C\uB2E4."
          _statChanges: []
      - _priority: 2
        _requiredChoiceId: 
        _requiredFlags:
        - stimulus_blocked
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 2 \uB0AE \uD53C\uB4DC\uBC31 - \uCC28\uB2E8"
          _body: "\uB300\uC0C1\uC740 \uBB3C\uCCB4 \uCABD\uC73C\uB85C \uC774\uB3D9\uD558\uB824\uB2E4
            \uBA48\uCDC4\uB2E4.\n\uC774\uD6C4 \uBB3C\uCCB4\uB97C \uBC14\uB77C\uBCF4\uB294
            \uC2DC\uAC04\uC740 \uB298\uC5C8\uC9C0\uB9CC, \uC811\uADFC \uD589\uB3D9\uC740
            \uBC1C\uC0DD\uD558\uC9C0 \uC54A\uC558\uB2E4.\n\uB300\uAE30 \uC2DC\uAC04\uC774
            \uC99D\uAC00\uD588\uB2E4.\n\n\uD53C\uB4DC\uBC31 \uC758\uB3C4\n\uC704\uD5D8\uC740
            \uC904\uC5C8\uC9C0\uB9CC, \uC2DC\uB3C4\uB3C4 \uD568\uAED8 \uBA48\uCDC4\uB2E4."
          _statChanges: []
      - _priority: 1
        _requiredChoiceId: 
        _requiredFlags:
        - stimulus_guided
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 2 \uB0AE \uD53C\uB4DC\uBC31 - \uC218\uC815"
          _body: "\uBB3C\uCCB4\uC758 \uC704\uCE58\uC640 \uC811\uADFC \uACBD\uB85C\uAC00
            \uC870\uC815\uB418\uC5C8\uB2E4.\n\uB300\uC0C1\uC740 \uBCC0\uACBD\uB41C
            \uACBD\uB85C\uB97C \uB530\uB77C \uBB3C\uCCB4 \uADFC\uCC98\uAE4C\uC9C0
            \uC774\uB3D9\uD588\uB2E4.\n\uD589\uB3D9\uC740 \uC548\uC815\uC801\uC774\uC5C8\uC9C0\uB9CC,
            \uACBD\uB85C \uBC16\uC73C\uB85C \uBC97\uC5B4\uB098\uB824\uB294 \uC2DC\uB3C4\uB294
            \uC801\uC5C8\uB2E4.\n\n\uD53C\uB4DC\uBC31 \uC758\uB3C4\n\uD589\uB3D9\uC740
            \uC720\uB3C4\uB410\uC9C0\uB9CC, \uC790\uBC1C\uC801\uC778 \uD0D0\uC0C9\uC740
            \uC904\uC5C8\uB2E4."
          _statChanges: []
