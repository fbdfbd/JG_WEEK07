        _statRequirements: []
        _page:
          _title: "DAY 3 \uACB0\uACFC - \uAD00\uB9AC\uB41C \uC21C\uC751\uD615"
          _body: "\uB300\uC0C1\uC740 \uC870\uC815\uB41C \uACBD\uB85C \uC548\uC5D0\uC11C\uB9CC
            \uC6C0\uC9C1\uC600\uB2E4.\n\uC81C\uD55C\uB41C \uC7A5\uC18C\uB97C \uB300\uC2E0\uD560
            \uD589\uB3D9\uC740 \uC0DD\uACBC\uC9C0\uB9CC, \uC790\uBC1C\uC801\uC778
            \uD655\uC7A5\uC740 \uC801\uC5C8\uB2E4.\n\uD589\uB3D9\uC740 \uC548\uC815\uC801\uC774\uC9C0\uB9CC
            \uC218\uB3D9\uC801\uC774\uB2E4.\n\n\uD615\uC131\uB41C \uD589\uB3D9 \uBC29\uC2DD\n\uAD00\uB9AC\uB41C
            \uC21C\uC751\uD615"
