  - _id: day3_accumulated_result
    _label: "DAY 3 - \uB204\uC801 \uACB0\uACFC \uD655\uC778"
    _report:
      _fallbackPage:
        _title: "DAY 3 \uACB0\uACFC \uD655\uC778"
        _body: "DAY 1 \uC120\uD0DD\uACFC DAY 2 \uC120\uD0DD\uC774 \uD569\uCCD0\uC838
          \uB300\uC0C1\uC758 \uD589\uB3D9 \uBC29\uC2DD\uC774 \uC5B4\uB5BB\uAC8C \uD615\uC131\uB418\uC5C8\uB294\uC9C0
          \uD655\uC778\uD55C\uB2E4."
      _rules:
      - _priority: 9
        _requiredChoiceId: 
        _requiredFlags:
        - place_accepted
        - stimulus_allowed
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 3 \uACB0\uACFC - \uC790\uC728 \uD0D0\uC0C9\uD615"
          _body: "\uB300\uC0C1\uC740 \uC775\uC219\uD55C \uC7A5\uC18C\uB97C \uAE30\uC900\uC810\uC73C\uB85C
            \uC0BC\uC544 \uB0AF\uC120 \uBB3C\uCCB4 \uADFC\uCC98\uAE4C\uC9C0 \uC774\uB3D9\uD588\uB2E4.\n\uC811\uADFC\uACFC
            \uD6C4\uD1F4\uB97C \uC2A4\uC2A4\uB85C \uBC18\uBCF5\uD558\uBA70 \uAC70\uB9AC\uB97C
            \uC870\uC808\uD588\uB2E4.\n\uC0C8\uB85C\uC6B4 \uC790\uADF9\uC5D0 \uB300\uD55C
            \uC790\uBC1C\uC801 \uC2DC\uB3C4\uAC00 \uC99D\uAC00\uD588\uB2E4.\n\n\uD615\uC131\uB41C
            \uD589\uB3D9 \uBC29\uC2DD\n\uC790\uC728 \uD0D0\uC0C9\uD615"
      - _priority: 8
        _requiredChoiceId: 
        _requiredFlags:
        - place_accepted
        - stimulus_blocked
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 3 \uACB0\uACFC - \uC5F4\uB9B0 \uB4A4 \uBA48\uCDA4\uD615"
          _body: "\uB300\uC0C1\uC740 \uC775\uC219\uD55C \uC7A5\uC18C\uC5D0 \uBA38\uBB3C\uB800\uC9C0\uB9CC,
            \uC0C8\uB85C\uC6B4 \uC790\uADF9\uC774 \uC0DD\uAE30\uC790 \uC811\uADFC\uD558\uC9C0
            \uC54A\uC558\uB2E4.\n\uC6C0\uC9C1\uC774\uB824\uB2E4 \uBA48\uCD94\uB294
            \uD589\uB3D9\uC774 \uC99D\uAC00\uD588\uB2E4.\n\uC548\uC815\uB41C \uAE30\uC900\uC810\uC740
            \uB0A8\uC544 \uC788\uC9C0\uB9CC, \uC0C8\uB85C\uC6B4 \uC2DC\uB3C4 \uC55E\uC5D0\uC11C\uB294
            \uB9DD\uC124\uC784\uC774 \uC0DD\uACBC\uB2E4.\n\n\uD615\uC131\uB41C \uD589\uB3D9
            \uBC29\uC2DD\n\uC5F4\uB9B0 \uB4A4 \uBA48\uCDA4\uD615"
      - _priority: 7
        _requiredChoiceId: 
        _requiredFlags:
        - place_accepted
        - stimulus_guided
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 3 \uACB0\uACFC - \uC548\uC815 \uAE30\uBC18 \uC720\uB3C4\uD615"
          _body: "\uB300\uC0C1\uC740 \uC775\uC219\uD55C \uC7A5\uC18C\uC5D0\uC11C
            \uCD9C\uBC1C\uD574 \uC870\uC815\uB41C \uACBD\uB85C\uB97C \uB530\uB77C
            \uC6C0\uC9C1\uC600\uB2E4.\n\uC0C8\uB85C\uC6B4 \uC790\uADF9\uC5D0 \uC811\uADFC\uD558\uAE34
            \uD588\uC9C0\uB9CC, \uACBD\uB85C \uBC16\uC73C\uB85C \uBC97\uC5B4\uB098\uB294
            \uC2DC\uB3C4\uB294 \uC801\uC5C8\uB2E4.\n\uC790\uBC1C\uC131\uACFC \uC720\uB3C4\uB41C
            \uD589\uB3D9\uC774 \uD568\uAED8 \uB098\uD0C0\uB0AC\uB2E4.\n\n\uD615\uC131\uB41C
            \uD589\uB3D9 \uBC29\uC2DD\n\uC548\uC815 \uAE30\uBC18 \uC720\uB3C4\uD615"
      - _priority: 6
        _requiredChoiceId: 
        _requiredFlags:
        - place_denied
        - stimulus_allowed
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 3 \uACB0\uACFC - \uC870\uC2EC\uC2A4\uB7EC\uC6B4 \uC7AC\uC2DC\uB3C4\uD615"
          _body: "\uB300\uC0C1\uC740 \uCC98\uC74C\uC5D0\uB294 \uB0AF\uC120 \uC790\uADF9\uC5D0
            \uC811\uADFC\uD558\uC9C0 \uC54A\uC558\uB2E4.\n\uC2DC\uAC04\uC774 \uC9C0\uB09C
            \uB4A4 \uC9E7\uAC8C \uC811\uADFC\uD558\uACE0 \uACE7\uBC14\uB85C \uBB3C\uB7EC\uB0AC\uB2E4.\n\uC774\uC804
            \uC81C\uD55C\uC758 \uC601\uD5A5\uC73C\uB85C \uC870\uC2EC\uC2A4\uB7FD\uC9C0\uB9CC,
            \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uB824\uB294 \uBC18\uC751\uC774 \uB098\uD0C0\uB0AC\uB2E4.\n\n\uD615\uC131\uB41C
            \uD589\uB3D9 \uBC29\uC2DD\n\uC870\uC2EC\uC2A4\uB7EC\uC6B4 \uC7AC\uC2DC\uB3C4\uD615"
      - _priority: 5
        _requiredChoiceId: 
