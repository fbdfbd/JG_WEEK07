        _event:
          _title: "DAY 3 \uACB0\uACFC - \uAD00\uB9AC\uB41C \uC21C\uC751\uD615"
          _body: "\uB300\uC0C1\uC740 \uC870\uC815\uB41C \uACBD\uB85C \uC548\uC5D0\uC11C\uB9CC
            \uC6C0\uC9C1\uC600\uB2E4.\n\uC81C\uD55C\uB41C \uC7A5\uC18C\uB97C \uB300\uC2E0\uD560
            \uD589\uB3D9\uC740 \uC0DD\uACBC\uC9C0\uB9CC, \uC790\uBC1C\uC801\uC778
            \uD655\uC7A5\uC740 \uC801\uC5C8\uB2E4.\n\uD589\uB3D9\uC740 \uC548\uC815\uC801\uC774\uC9C0\uB9CC
            \uC218\uB3D9\uC801\uC774\uB2E4.\n\n\uCD5C\uC885 \uAC10\uAC01\n\uB300\uC0C1\uC740
            \uAD00\uB9AC \uAC00\uB2A5\uD55C \uBC29\uC2DD\uC73C\uB85C \uC548\uC815\uB418\uC5C8\uC9C0\uB9CC,
            \uC2A4\uC2A4\uB85C \uC120\uD0DD\uD558\uB294 \uB290\uB08C\uC740 \uC57D\uD558\uB2E4."
          _statChanges: []
      - _priority: 3
        _requiredChoiceId: 
        _requiredFlags:
        - place_altered
        - stimulus_allowed
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 3 \uACB0\uACFC - \uC720\uB3C4\uC5D0\uC11C \uBC97\uC5B4\uB098\uB294
            \uC2E4\uD5D8\uD615"
          _body: "\uB300\uC0C1\uC740 \uCC98\uC74C\uC5D0\uB294 \uC870\uC815\uB41C
            \uACBD\uB85C\uB97C \uB530\uB790\uB2E4.\n\uC774\uD6C4 \uC2A4\uC2A4\uB85C
            \uACBD\uB85C \uBC16\uC73C\uB85C \uC9E7\uAC8C \uBC97\uC5B4\uB098 \uB0AF\uC120
            \uC790\uADF9\uC744 \uD655\uC778\uD588\uB2E4.\n\uC720\uB3C4\uB41C \uD589\uB3D9\uC5D0\uC11C
            \uBC97\uC5B4\uB098\uB824\uB294 \uC791\uC740 \uC2DC\uB3C4\uAC00 \uAD00\uCC30\uB418\uC5C8\uB2E4.\n\n\uCD5C\uC885
            \uAC10\uAC01\n\uB300\uC0C1\uC740 \uC720\uB3C4\uB41C \uD658\uACBD\uC5D0
            \uC775\uC219\uD558\uC9C0\uB9CC, \uB2E4\uC2DC \uC790\uAE30 \uBC29\uC2DD\uC73C\uB85C
            \uC2DC\uB3C4\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
          _statChanges: []
      - _priority: 2
        _requiredChoiceId: 
        _requiredFlags:
        - place_altered
        - stimulus_blocked
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 3 \uACB0\uACFC - \uAD50\uC815 \uD6C4 \uC704\uCD95\uD615"
          _body: "\uB300\uC0C1\uC740 \uBCC0\uACBD\uB41C \uD658\uACBD\uC5D0 \uB9DE\uCDB0
            \uC6C0\uC9C1\uC774\uB824 \uD588\uC9C0\uB9CC, \uC0C8 \uC790\uADF9 \uC55E\uC5D0\uC11C
            \uBA48\uCDC4\uB2E4.\n\uC774\uD6C4 \uC8FC\uBCC0\uC744 \uD655\uC778\uD558\uB294
            \uD589\uB3D9\uC774 \uB298\uC5C8\uB2E4.\n\uD589\uB3D9 \uBC94\uC704\uAC00
            \uC774\uC804\uBCF4\uB2E4 \uC881\uC544\uC84C\uB2E4.\n\n\uCD5C\uC885 \uAC10\uAC01\n\uB300\uC0C1\uC740
            \uC548\uC815\uC801\uC774\uC9C0\uB9CC, \uBCC0\uD654 \uC55E\uC5D0\uC11C
            \uC704\uCD95\uB418\uB294 \uBC29\uC2DD\uC774 \uC0DD\uACBC\uB2E4."
          _statChanges: []
      - _priority: 1
        _requiredChoiceId: 
        _requiredFlags:
        - place_altered
        - stimulus_guided
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 3 \uACB0\uACFC - \uC548\uC815\uC801 \uB8E8\uD2F4\uD615"
          _body: "\uB300\uC0C1\uC740 \uC870\uC815\uB41C \uD658\uACBD\uACFC \uACBD\uB85C\uC5D0
            \uC548\uC815\uC801\uC73C\uB85C \uC801\uC751\uD588\uB2E4.\n\uD589\uB3D9\uC740
            \uC608\uCE21 \uAC00\uB2A5\uD558\uACE0 \uC548\uC815\uC801\uC774\uB2E4.\n\uD558\uC9C0\uB9CC
            \uC0C8\uB85C\uC6B4 \uC2DC\uB3C4\uB294 \uC815\uD574\uC9C4 \uBC94\uC704
            \uC548\uC5D0\uC11C\uB9CC \uB098\uD0C0\uB0AC\uB2E4.\n\n\uCD5C\uC885 \uAC10\uAC01\n\uB300\uC0C1\uC740
            \uC548\uC815\uC801\uC778 \uB8E8\uD2F4\uC744 \uD615\uC131\uD588\uC9C0\uB9CC,
            \uC790\uBC1C\uC801\uC778 \uD655\uC7A5\uC740 \uC57D\uD558\uB2E4."
          _statChanges: []
