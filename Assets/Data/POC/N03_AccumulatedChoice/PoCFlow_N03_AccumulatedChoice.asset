        _statRequirements: []
        _page:
          _title: "DAY 3 \uACB0\uACFC - \uC218\uB3D9 \uB300\uAE30\uD615"
          _body: "\uB300\uC0C1\uC740 \uC0C8\uB85C\uC6B4 \uC790\uADF9\uC744 \uBC1C\uACAC\uD588\uC9C0\uB9CC
            \uC811\uADFC\uD558\uC9C0 \uC54A\uC558\uB2E4.\n\uC6C0\uC9C1\uC774\uAE30
            \uC804 \uBA48\uCD94\uB294 \uC2DC\uAC04\uC774 \uAE38\uC5B4\uC84C\uB2E4.\n\uD65C\uB3D9\uB7C9\uC740
            \uB0AE\uACE0, \uB300\uAE30 \uD589\uB3D9\uC774 \uBC18\uBCF5\uB418\uC5C8\uB2E4.\n\n\uD615\uC131\uB41C
            \uD589\uB3D9 \uBC29\uC2DD\n\uC218\uB3D9 \uB300\uAE30\uD615"
      - _priority: 4
        _requiredChoiceId: 
