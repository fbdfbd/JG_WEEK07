    \uD655\uC778\uD55C\uB2E4."
  _dialogueLines: []
  _nemoLine: "\uB300\uC0C1\uC740 \uC6C0\uC9C1\uC774\uAE30 \uC804\uC5D0 \uC7A0\uC2DC
    \uBA48\uCD98\uB2E4.\n\uBB3C\uCCB4\uAC00 \uC788\uB358 \uBC29\uD5A5\uC744 \uBC14\uB77C\uBCF4\uC9C0\uB9CC,
    \uADF8\uCABD\uC73C\uB85C \uC774\uB3D9\uD558\uC9C0 \uC54A\uB294\uB2E4.\n\uD50C\uB808\uC774\uC5B4
    \uCABD\uB3C4 \uD55C \uBC88 \uBC14\uB77C\uBCF8\uB2E4."
