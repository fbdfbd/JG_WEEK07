  m_Script: {fileID: 11500000, guid: fac263f3beb935544aa88e3bb087fafe, type: 3}
  m_Name: PoCFlow_N03_IndirectGrowth
  m_EditorClassIdentifier: Assembly-CSharp::SO_PoCFlowDefinition
  _introPages:
  - _title: "\uAC04\uC811 \uC721\uC131 \uCCB4\uAC10 PoC"
    _body: "\uAC80\uC99D \uBAA9\uD45C\uB294 \uD558\uB098\uB2E4.\n\uD50C\uB808\uC774\uC5B4\uAC00
      \uB300\uC0C1\uC5D0\uAC8C \uC9C1\uC811 \uBA85\uB839\uD558\uC9C0 \uC54A\uC558\uB294\uB370\uB3C4,
      \uC790\uC2E0\uC774 \uC870\uC815\uD55C \uD658\uACBD \uB54C\uBB38\uC5D0 \uB300\uC0C1\uC758
      \uD589\uB3D9\uACFC \uD0DC\uB3C4\uAC00 \uB2EC\uB77C\uC84C\uB2E4\uACE0 \uB290\uB07C\uB294\uAC00?"
  _days:
  - _id: day1_first_intervention
    _label: "DAY 1 - \uBC1C\uACAC\uACFC \uCCAB \uAC1C\uC785"
    _report:
      _fallbackPage:
        _title: "DAY 1 \uB0AE \uBCF4\uACE0\uC11C"
        _body: "\uB300\uC0C1\uC740 \uC624\uB298\uB3C4 \uAC19\uC740 \uC7A5\uC18C\uC5D0
          \uC624\uB798 \uBA38\uBB3C\uB800\uB2E4.\n\uD574\uB2F9 \uC7A5\uC18C\uC5D0\uC11C\uB294
          \uC548\uC815\uC801\uC778 \uD589\uB3D9\uC744 \uBCF4\uC600\uC9C0\uB9CC, \uB2E4\uB978
          \uC790\uADF9\uC5D0\uB294 \uBC18\uC751\uC774 \uC904\uC5C8\uB2E4.\n\uD604\uC7AC
          \uD589\uB3D9\uC744 \uC720\uC9C0\uD560\uC9C0, \uC81C\uD55C\uD560\uC9C0,
          \uC870\uAC74\uC744 \uC870\uC815\uD560\uC9C0 \uACB0\uC815\uC774 \uD544\uC694\uD558\uB2E4."
      _rules: []
    _choiceTitle: "\uD2B9\uC815 \uC7A5\uC18C\uC5D0 \uBC18\uBCF5\uC801\uC73C\uB85C
      \uBA38\uBB34\uB294 \uD589\uB3D9"
    _choiceBody: "\uB300\uC0C1\uC5D0\uAC8C \uC9C1\uC811 \uBA85\uB839\uD558\uC9C0
      \uC54A\uB294\uB2E4.\n\uB300\uC0C1\uC774 \uBA38\uBB34\uB294 \uD658\uACBD\uC758
      \uC870\uAC74\uC744 \uD5C8\uAC00 / \uCC28\uB2E8 / \uC218\uC815 \uC911 \uD558\uB098\uB85C
      \uC870\uC815\uD55C\uB2E4."
    _mainChoices:
    - _id: day1_place_allow
      _label: "\uD5C8\uAC00"
      _description: "\uB300\uC0C1\uC758 \uD604\uC7AC \uC7A5\uC18C \uC811\uADFC\uC744
        \uADF8\uB300\uB85C \uD5C8\uC6A9\uD55C\uB2E4."
      _setFlags:
      - place_allowed
      _statChanges:
      - _statType: 0
        _delta: 1
      - _statType: 1
        _delta: 1
      - _statType: 2
        _delta: 1
    - _id: day1_place_block
      _label: "\uCC28\uB2E8"
      _description: "\uB300\uC0C1\uC774 \uD574\uB2F9 \uC7A5\uC18C\uC5D0 \uC811\uADFC\uD558\uC9C0
        \uBABB\uD558\uB3C4\uB85D \uC81C\uD55C\uD55C\uB2E4."
      _setFlags:
      - place_blocked
      _statChanges:
      - _statType: 0
        _delta: 1
      - _statType: 1
        _delta: -1
      - _statType: 2
        _delta: -1
    - _id: day1_place_modify
      _label: "\uC218\uC815"
      _description: "\uC7A5\uC18C\uB294 \uC720\uC9C0\uD558\uB418, \uAD6C\uC870\uB098
        \uC790\uADF9\uC744 \uC77C\uBD80 \uBCC0\uACBD\uD55C\uB2E4."
      _setFlags:
      - place_modified
      _statChanges:
      - _statType: 0
        _delta: 1
      - _statType: 1
        _delta: -1
      - _statType: 3
        _delta: 1
    _dayEvent:
      _title: "DAY 1 \uB0AE \uD53C\uB4DC\uBC31"
      _body: "DAY 1 \uC120\uD0DD\uC5D0 \uB530\uB978 \uB0AE \uD53C\uB4DC\uBC31\uC774
        \uD45C\uC2DC\uB41C\uB2E4."
      _statChanges: []
      _rules:
      - _priority: 3
        _requiredChoiceId: 
        _requiredFlags:
        - place_allowed
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 1 \uB0AE \uD53C\uB4DC\uBC31 - \uD5C8\uAC00"
          _body: "\uC7A5\uC18C \uC811\uADFC\uC774 \uC720\uC9C0\uB418\uC5C8\uB2E4.\n\uB300\uC0C1\uC740
            \uD3C9\uC18C\uCC98\uB7FC \uADF8\uACF3\uC5D0 \uBA38\uBB3C\uB800\uACE0,
            \uBA38\uBB34\uB294 \uC2DC\uAC04\uC774 \uC870\uAE08 \uC99D\uAC00\uD588\uB2E4.\n\uAC15\uC81C\uB85C
            \uD589\uB3D9\uC744 \uBC14\uAFB8\uB824\uB294 \uBC18\uC751\uC740 \uBCF4\uC774\uC9C0
            \uC54A\uC558\uB2E4.\n\uB300\uC0C1\uC740 \uC790\uC2E0\uC758 \uB9AC\uB4EC\uC744
            \uC720\uC9C0\uD558\uB294 \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4."
          _statChanges: []
      - _priority: 2
        _requiredChoiceId: 
        _requiredFlags:
        - place_blocked
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 1 \uB0AE \uD53C\uB4DC\uBC31 - \uCC28\uB2E8"
          _body: "\uC7A5\uC18C \uC811\uADFC\uC774 \uC81C\uD55C\uB418\uC5C8\uB2E4.\n\uB300\uC0C1\uC740
            \uD55C\uB3D9\uC548 \uC785\uAD6C \uADFC\uCC98\uC5D0 \uBA38\uBB3C\uB800\uC73C\uB098,
            \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC9C0\uB294 \uBABB\uD588\uB2E4.\n\uC774\uD6C4
            \uD65C\uB3D9\uB7C9\uC774 \uC904\uACE0 \uB300\uAE30 \uC2DC\uAC04\uC774
            \uB298\uC5C8\uB2E4.\n\uD589\uB3D9\uC740 \uBA48\uCDC4\uC9C0\uB9CC, \uAD00\uC2EC
            \uC790\uCCB4\uAC00 \uC0AC\uB77C\uC9C4 \uAC83\uC740 \uC544\uB2CC \uAC83\uC73C\uB85C
            \uBCF4\uC778\uB2E4."
          _statChanges: []
      - _priority: 1
        _requiredChoiceId: 
        _requiredFlags:
        - place_modified
        _forbiddenFlags: []
        _statRequirements: []
        _event:
          _title: "DAY 1 \uB0AE \uD53C\uB4DC\uBC31 - \uC218\uC815"
          _body: "\uC7A5\uC18C\uC758 \uAD6C\uC870\uAC00 \uC77C\uBD80 \uBCC0\uACBD\uB418\uC5C8\uB2E4.\n\uB300\uC0C1\uC740
            \uCC98\uC74C\uC5D0\uB294 \uBA48\uCE6B\uD588\uC9C0\uB9CC, \uACE7 \uBCC0\uACBD\uB41C
            \uC7A5\uC18C \uC548\uC5D0 \uBA38\uBB3C\uB800\uB2E4.\n\uC548\uC815 \uBC18\uC751\uC740
            \uC720\uC9C0\uB418\uC5C8\uC73C\uB098, \uC774\uC804\uC5D0 \uBC18\uBCF5\uD558\uB358
            \uC790\uBC1C\uC801 \uC6C0\uC9C1\uC784\uC740 \uC904\uC5C8\uB2E4.\n\uB300\uC0C1\uC740
            \uBC14\uB010 \uD658\uACBD\uC5D0 \uB9DE\uCDB0 \uD589\uB3D9\uC744 \uC870\uC815\uD558\uB294
            \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4."
          _statChanges: []
    _nightDialogueRules:
    - _dialogue: {fileID: 11400000, guid: 5d4f7f53a5b13aa4dab49419742e70df, type: 2}
