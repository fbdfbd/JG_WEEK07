  - _id: day2_change_check
    _label: "DAY 2 - \uBCC0\uD654 \uD655\uC778"
    _report:
      _fallbackPage:
        _title: "DAY 2 \uACF5\uD1B5 \uBCF4\uACE0\uC11C"
        _body: "DAY 2\uC5D0\uC11C\uB294 \uC0C8\uB85C\uC6B4 \uC120\uD0DD\uC744 \uC8FC\uC9C0
          \uC54A\uB294\uB2E4.\nDAY 1\uC758 \uC120\uD0DD\uC774 \uB300\uC0C1\uC758
          \uD589\uB3D9 \uD328\uD134\uC5D0 \uC5B4\uB5BB\uAC8C \uB0A8\uC558\uB294\uC9C0
          \uD655\uC778\uD55C\uB2E4."
      _rules:
      - _priority: 3
        _requiredChoiceId: 
        _requiredFlags:
        - place_allowed
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 2 \uBCF4\uACE0\uC11C - \uD5C8\uAC00 \uB8E8\uD2B8"
          _body: "\uB300\uC0C1\uC740 \uAC19\uC740 \uC7A5\uC18C\uC5D0 \uB2E4\uC2DC
            \uBA38\uBB3C\uB800\uB2E4.\n\uC5B4\uC81C\uBCF4\uB2E4 \uAE34\uC7A5 \uBC18\uC751\uC774
            \uC904\uC5C8\uACE0, \uC7A5\uC18C \uC8FC\uBCC0\uC744 \uCC9C\uCC9C\uD788
            \uD0D0\uC0C9\uD558\uB294 \uD589\uB3D9\uC774 \uCD94\uAC00\uB418\uC5C8\uB2E4.\n\uD574\uB2F9
            \uC7A5\uC18C\uB97C \uB2E8\uC21C\uD788 \uBC18\uBCF5 \uBC29\uBB38\uD558\uB294
            \uAC83\uC774 \uC544\uB2C8\uB77C, \uC548\uC815\uB41C \uAE30\uC900\uC810\uCC98\uB7FC
            \uC0AC\uC6A9\uD558\uB294 \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4."
      - _priority: 2
        _requiredChoiceId: 
        _requiredFlags:
        - place_blocked
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 2 \uBCF4\uACE0\uC11C - \uCC28\uB2E8 \uB8E8\uD2B8"
          _body: "\uB300\uC0C1\uC740 \uC81C\uD55C\uB41C \uC7A5\uC18C\uC5D0 \uC811\uADFC\uD558\uC9C0
            \uC54A\uC558\uB2E4.\n\uB300\uC2E0 \uBE44\uC2B7\uD55C \uAD6C\uC870\uC758
            \uB2E4\uB978 \uAD6C\uC11D\uC5D0 \uC624\uB798 \uBA38\uBB3C\uB800\uB2E4.\n\uAE30\uC874
            \uD589\uB3D9\uC740 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC558\uACE0, \uB2E4\uB978
            \uB300\uC0C1\uC73C\uB85C \uC62E\uACA8\uAC04 \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4.\n\uC0C8\uB85C\uC6B4
            \uC7A5\uC18C\uC5D0\uC11C\uB3C4 \uD65C\uB3D9\uB7C9\uC740 \uB0AE\uAC8C
            \uC720\uC9C0\uB418\uC5C8\uB2E4."
      - _priority: 1
        _requiredChoiceId: 
        _requiredFlags:
        - place_modified
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 2 \uBCF4\uACE0\uC11C - \uC218\uC815 \uB8E8\uD2B8"
          _body: "\uB300\uC0C1\uC740 \uBCC0\uACBD\uB41C \uC7A5\uC18C\uB97C \uC0AC\uC6A9\uD588\uB2E4.\n\uC548\uC815
            \uBC18\uC751\uC740 \uC720\uC9C0\uB418\uC5C8\uC9C0\uB9CC, \uC6C0\uC9C1\uC784\uC740
            \uC774\uC804\uBCF4\uB2E4 \uC815\uD574\uC9C4 \uACBD\uB85C\uB97C \uB530\uB790\uB2E4.\n\uC790\uBC1C\uC801\uC778
            \uD0D0\uC0C9 \uD589\uB3D9\uC740 \uAC10\uC18C\uD588\uB2E4.\n\uB300\uC0C1\uC740
            \uD658\uACBD\uC5D0 \uC801\uC751\uD588\uC9C0\uB9CC, \uC2A4\uC2A4\uB85C
            \uD589\uB3D9\uC744 \uD655\uC7A5\uD558\uB294 \uBAA8\uC2B5\uC740 \uC904\uC5B4\uB4E4\uC5C8\uB2E4."
    _choiceTitle: 
    _choiceBody: 
    _mainChoices: []
