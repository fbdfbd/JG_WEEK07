  - _id: day3_pattern_check
    _label: "DAY 3 - \uD589\uB3D9 \uBC29\uC2DD \uD615\uC131 \uD655\uC778"
    _report:
      _fallbackPage:
        _title: "DAY 3 \uACF5\uD1B5 \uBCF4\uACE0\uC11C"
        _body: "\uB300\uC0C1\uC774 \uBA38\uBB34\uB294 \uC7A5\uC18C \uADFC\uCC98\uC5D0
          \uB0AF\uC120 \uBB3C\uCCB4\uAC00 \uB193\uC600\uB2E4.\n\uC774 \uC790\uADF9\uC5D0
          \uB300\uD55C \uBC18\uC751\uC744 \uD1B5\uD574 DAY 1\uC758 \uC120\uD0DD\uC774
          \uB300\uC0C1\uC758 \uD589\uB3D9 \uBC29\uC2DD\uC5D0 \uC5B4\uB5BB\uAC8C \uB0A8\uC558\uB294\uC9C0
          \uD655\uC778\uD55C\uB2E4."
      _rules:
      - _priority: 3
        _requiredChoiceId: 
        _requiredFlags:
        - place_allowed
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 3 \uBCF4\uACE0\uC11C - \uD5C8\uAC00 \uB8E8\uD2B8"
          _body: "\uB300\uC0C1\uC740 \uB0AF\uC120 \uBB3C\uCCB4\uB97C \uBC14\uB85C
            \uD53C\uD558\uC9C0 \uC54A\uC558\uB2E4.\n\uBA3C\uC800 \uC775\uC219\uD55C
            \uC7A5\uC18C\uC5D0 \uBA38\uBB38 \uB4A4, \uCC9C\uCC9C\uD788 \uBB3C\uCCB4
            \uADFC\uCC98\uAE4C\uC9C0 \uC774\uB3D9\uD588\uB2E4.\n\uC811\uADFC\uACFC
            \uBA48\uCDA4\uC744 \uBC18\uBCF5\uD558\uBA70 \uC2A4\uC2A4\uB85C \uAC70\uB9AC\uB97C
            \uC870\uC808\uD588\uB2E4.\n\uB300\uC0C1\uC740 \uC548\uC815\uB41C \uC7A5\uC18C\uB97C
            \uAE30\uC900\uC810\uC73C\uB85C \uC0BC\uC544 \uC0C8\uB85C\uC6B4 \uD589\uB3D9\uC744
            \uC2DC\uB3C4\uD55C \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4."
      - _priority: 2
        _requiredChoiceId: 
        _requiredFlags:
        - place_blocked
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 3 \uBCF4\uACE0\uC11C - \uCC28\uB2E8 \uB8E8\uD2B8"
          _body: "\uB300\uC0C1\uC740 \uB0AF\uC120 \uBB3C\uCCB4\uB97C \uBC1C\uACAC\uD588\uC9C0\uB9CC
            \uC811\uADFC\uD558\uC9C0 \uC54A\uC558\uB2E4.\n\uD55C\uB3D9\uC548 \uBA48\uCDB0
            \uC788\uC5C8\uACE0, \uC774\uD6C4 \uC81C\uD55C\uB41C \uC7A5\uC18C \uBC29\uD5A5\uACFC
            \uD50C\uB808\uC774\uC5B4 \uCABD\uC744 \uBC88\uAC08\uC544 \uBCF4\uC558\uB2E4.\n\uC0C8\uB85C\uC6B4
            \uD589\uB3D9\uC744 \uC2DC\uC791\uD558\uAE30 \uC804 \uB300\uAE30 \uC2DC\uAC04\uC774
            \uAE38\uC5B4\uC84C\uB2E4.\n\uC704\uD5D8\uD55C \uD589\uB3D9\uC740 \uC904\uC5C8\uC9C0\uB9CC,
            \uC790\uBC1C\uC801\uC778 \uC2DC\uB3C4\uB3C4 \uD568\uAED8 \uAC10\uC18C\uD55C
            \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4."
      - _priority: 1
        _requiredChoiceId: 
        _requiredFlags:
        - place_modified
        _forbiddenFlags: []
        _statRequirements: []
        _page:
          _title: "DAY 3 \uBCF4\uACE0\uC11C - \uC218\uC815 \uB8E8\uD2B8"
          _body: "\uB300\uC0C1\uC740 \uB0AF\uC120 \uBB3C\uCCB4\uC5D0 \uC811\uADFC\uD588\uB2E4.\n\uD558\uC9C0\uB9CC
            \uC9C1\uC811 \uD0D0\uC0C9\uD558\uAE30\uBCF4\uB2E4, \uBCC0\uACBD\uB41C
            \uACBD\uB85C\uB97C \uB530\uB77C \uC6B0\uD68C\uD588\uB2E4.\n\uD589\uB3D9\uC740
            \uC548\uC815\uC801\uC774\uACE0 \uC608\uCE21 \uAC00\uB2A5\uD588\uC9C0\uB9CC,
            \uC0C8\uB85C\uC6B4 \uC2DC\uB3C4\uB294 \uC815\uD574\uC9C4 \uBC94\uC704
            \uC548\uC5D0\uC11C\uB9CC \uB098\uD0C0\uB0AC\uB2E4.\n\uB300\uC0C1\uC740
            \uC870\uC815\uB41C \uD658\uACBD\uC5D0 \uC798 \uC801\uC751\uD588\uC73C\uB098,
            \uC790\uBC1C\uC801\uC778 \uD655\uC7A5\uC740 \uC57D\uD574\uC9C4 \uAC83\uC73C\uB85C
            \uBCF4\uC778\uB2E4."
    _choiceTitle: 
    _choiceBody: 
    _mainChoices: []
    _dayEvent:
      _title: "DAY 3 - \uD589\uB3D9 \uBC29\uC2DD \uD615\uC131 \uD655\uC778 \uB0AE
        \uD53C\uB4DC\uBC31"
      _body: "DAY 1 \uC120\uD0DD\uC5D0 \uB530\uB978 \uB0AE \uD53C\uB4DC\uBC31\uC774
        \uD45C\uC2DC\uB41C\uB2E4."
      _statChanges: []
      _rules:
