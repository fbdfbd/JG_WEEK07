  _titleOverride: "DAY 3 \uBC24 \uC811\uCD09 - \uC218\uC815"
  _bodyText: "\uB0AE\uC758 \uD658\uACBD \uC870\uC815 \uACB0\uACFC\uAC00 \uB300\uC0C1\uC758
    \uC815\uC11C\uC640 \uD0DC\uB3C4\uB85C \uC5B4\uB5BB\uAC8C \uB098\uD0C0\uB0AC\uB294\uC9C0
    \uD655\uC778\uD55C\uB2E4."
  _dialogueLines: []
  _nemoLine: "\uB300\uC0C1\uC740 \uD50C\uB808\uC774\uC5B4\uAC00 \uBCFC \uC218 \uC788\uB294
    \uC704\uCE58\uC5D0\uC11C\uB9CC \uD589\uB3D9\uD55C\uB2E4.\n\uD589\uB3D9\uC740
    \uC548\uC815\uC801\uC774\uC9C0\uB9CC, \uC911\uAC04\uC911\uAC04 \uC8FC\uBCC0\uC744
    \uD655\uC778\uD55C\uB2E4.\n\uD50C\uB808\uC774\uC5B4\uB97C \uC758\uC2EC\uD558\uB294
    \uAC83\uC740 \uC544\uB2C8\uC9C0\uB9CC, \uD658\uACBD \uBCC0\uD654\uC5D0 \uBBFC\uAC10\uD574\uC9C4
    \uB4EF\uD558\uB2E4."
