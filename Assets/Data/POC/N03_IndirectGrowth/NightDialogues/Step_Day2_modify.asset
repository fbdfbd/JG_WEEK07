  _titleOverride: "DAY 2 \uBC24 \uC811\uCD09 - \uC218\uC815"
  _bodyText: "\uB0AE\uC758 \uD658\uACBD \uC870\uC815 \uACB0\uACFC\uAC00 \uB300\uC0C1\uC758
    \uC815\uC11C\uC640 \uD0DC\uB3C4\uB85C \uC5B4\uB5BB\uAC8C \uB098\uD0C0\uB0AC\uB294\uC9C0
    \uD655\uC778\uD55C\uB2E4."
  _dialogueLines: []
  _nemoLine: "\uB300\uC0C1\uC740 \uD589\uB3D9\uD558\uAE30 \uC804\uC5D0 \uC8FC\uBCC0\uC744
    \uD655\uC778\uD55C\uB2E4.\n\uC774\uD6C4 \uBC14\uB010 \uC7A5\uC18C \uC548\uC5D0\uC11C\uB9CC
    \uC870\uC6A9\uD788 \uC6C0\uC9C1\uC778\uB2E4.\n\uD50C\uB808\uC774\uC5B4\uB97C
    \uC758\uC2EC\uD558\uB294 \uAC83\uC740 \uC544\uB2C8\uC9C0\uB9CC, \uD589\uB3D9\uC774
    \uC870\uC2EC\uC2A4\uB7EC\uC6CC\uC84C\uB2E4."
