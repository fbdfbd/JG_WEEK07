  _titleOverride: "DAY 2 \uBC24 \uC811\uCD09 - \uD5C8\uAC00"
  _bodyText: "\uB0AE\uC758 \uD658\uACBD \uC870\uC815 \uACB0\uACFC\uAC00 \uB300\uC0C1\uC758
