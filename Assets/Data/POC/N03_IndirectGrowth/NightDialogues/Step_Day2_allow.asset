    \uD655\uC778\uD55C\uB2E4."
  _dialogueLines: []
  _nemoLine: "\uB300\uC0C1\uC740 \uC7A5\uC18C \uADFC\uCC98\uC5D0 \uC788\uB2E4\uAC00
    \uD50C\uB808\uC774\uC5B4 \uCABD\uC744 \uC7A0\uC2DC \uBC14\uB77C\uBCF8\uB2E4.\n\uB3C4\uB9DD\uCE58\uC9C0
    \uC54A\uB294\uB2E4.\n\uD5C8\uB77D\uC744 \uAD6C\uD55C\uB2E4\uAE30\uBCF4\uB2E4\uB294,
    \uC790\uC2E0\uC774 \uC788\uB294 \uACF3\uC744 \uBCF4\uC5EC\uC8FC\uB294 \uB4EF\uD558\uB2E4."
