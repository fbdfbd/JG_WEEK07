  m_Name: CharacterEnding_Rian_05_06_Stability
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_rian_05_06_stability
  _characterType: 0
  _minMeetCount: 5
  _maxMeetCount: 6
  _moodType: 1
  _text:
    _title: "\uB9AC\uC548 \uB9CC\uB0A8 5~6 - \uC548\uC815"
    _body: "\uC131\uC778\uC2DD \uC804\uC57C, \uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uB97C
      \uCC3E\uC544\uC654\uB2E4. \uD669\uC2E4 \uB0B4\uBD80\uC5D0\uC11C \uBC18\uB300\uAC00
      \uC788\uC5C8\uC9C0\uB9CC, \uADF8\uB294 \uC774\uBBF8 \uACB0\uC2EC\uD55C \uB4A4\uC600\uB2E4.\n\"\uB0B4\uAC00
      \uACF5\uC2DD\uC801\uC73C\uB85C \uC9C0\uC9C0 \uC131\uBA85\uC744 \uB0BC \uAC70\uC57C.
      \uBD09\uC2E0\uAC00\uBB38\uC774 \uBB50\uB77C \uD558\uB4E0, \uD6C4\uC791\uAC00\uAC00
      \uBB50\uB77C \uD558\uB4E0.\"\n\uC544\uBCA8\uB9AC\uC544\uB294 \uACE0\uAC1C\uB97C
      \uC800\uC5C8\uB2E4. \"\uACE0\uB9C8\uC6CC. \uD558\uC9C0\uB9CC \uADF8\uAC74 \uB0B4\uAC00
      \uD574\uC57C \uD560 \uC77C\uC774\uC57C.\"\n\uC131\uC778\uC2DD\uC7A5\uC5D0\uC11C
      \uC544\uBCA8\uB9AC\uC544\uB294 \uBD09\uC2E0\uAC00\uBB38\uC758 \uC774\uC758\uC81C\uAE30\uC5D0
      \uC9C1\uC811 \uB2F5\uD588\uB2E4. \uBAA9\uC18C\uB9AC\uB294 \uC870\uC6A9\uD588\uC9C0\uB9CC
      \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uB9AC\uC548\uC758 \uACF5\uC2DD
      \uC9C0\uC9C0\uB294 \uADF8 \uB4A4\uC5D0 \uBC1C\uD45C\uB418\uC5C8\uACE0, \uADF8\uAC83\uC740
      \uD655\uC778\uC774\uC5C8\uC9C0 \uAD6C\uC6D0\uC774 \uC544\uB2C8\uC5C8\uB2E4.\n\uBC31\uC791\uB839\uC740
      \uC544\uBCA8\uB9AC\uC544\uC758 \uAC83\uC774 \uB418\uC5C8\uB2E4. \uC644\uC804\uD788,
      \uC628\uC804\uD788. \uB9AC\uC548\uC740 \uB5A0\uB098\uAE30 \uC804 \uC815\uC6D0\uC5D0\uC11C
      \uADF8\uB140\uB97C \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBCF4\uC558\uB2E4. \uB450
      \uC0AC\uB78C \uC0AC\uC774\uC5D0 \uB0A8\uC740 \uAC83\uC740 \uC57D\uC18D\uC774
      \uC544\uB2C8\uB77C, \uC11C\uB85C\uAC00 \uC81C \uC790\uB9AC\uC5D0 \uC11C \uC788\uB2E4\uB294
      \uBBFF\uC74C\uC774\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 3
