  _noCharacterMetEndingId: ending_no_character_met
  _noCharacterMetEnding:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB204\uAD6C\uC640\uB3C4 \uB9CC\uB098\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uC758 \uACC1\uC5D0\uB294 \uC544\uBB34\uB3C4
      \uB0A8\uC544\uC788\uC9C0 \uC54A\uC558\uAE30\uC5D0...\n\uC131\uC778\uC2DD \uB0A0,
      \uC5F0\uD68C\uC7A5\uC758 \uBB38\uC740 \uB2E8 \uD55C \uBC88\uB3C4 \uC5F4\uB9AC\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4.\n\uB9AC\uC548\uB3C4, \uC720\uD53C\uB3C4, \uADF8
      \uD754\uD55C \uC7A5\uC0AC\uAFBC\uC870\uCC28 \uC774 \uAC00\uB09C\uD558\uACE0
      \uACE0\uC9D1\uC2A4\uB7EC\uC6B4 \uC601\uC9C0\uB97C \uCC3E\uC9C0 \uC54A\uC558\uAC70\uB4E0\uC694.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uB204\uAD6C\uC5D0\uAC8C\uB3C4 \uBE5A\uC9C0\uC9C0 \uC54A\uC558\uACE0 \uADF8
      \uB204\uAD6C\uC758 \uC74C\uBAA8\uC5D0\uB3C4 \uD718\uB9D0\uB9AC\uC9C0 \uC54A\uC558\uC9C0\uB9CC,
      \uB300\uAC00\uB85C \uC81C\uAD6D \uC804\uCCB4\uB85C\uBD80\uD130 \uC644\uBCBD\uD558\uAC8C
      \uC78A\uD788\uB294 \uAE38\uC744 \uD0DD\uD588\uC2B5\uB2C8\uB2E4.\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uC601\uC9C0\uB294 \uC774\uC81C \uC9C0\uB3C4 \uC704\uC5D0\uC11C \uC810\uCC28
      \uD750\uB9BF\uD574\uC9C0\uB2E4 \uB05D\uB0B4 \uD22C\uBA85\uD574\uC9C4 \uC720\uB839\uC758
      \uB545\uC774 \uB418\uC5B4\uBC84\uB838\uB2F5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uD640\uB85C \uC131\uBCBD \uC704\uB97C \uAC70\uB2D0\uBA70 \uC544\uBB34\uB3C4
      \uC624\uC9C0 \uC54A\uB294 \uC218\uD3C9\uC120\uC744 \uBC14\uB77C\uBCF4\uB294
      \uC77C\uB85C \uD558\uB8E8\uB97C \uBCF4\uB0B4\uAC8C \uB418\uC5C8\uC9C0\uC694.\n\uC8FC\uAD8C\uC740
      \uC9C0\uCF30\uC73C\uB098 \uC18C\uD1B5\uD560 \uC778\uAC04\uC744 \uC783\uC5B4\uBC84\uB9B0
      \uADF8\uB140\uB294, \uC774\uC81C \uC0B4\uC544\uC788\uB294 \uC0AC\uB78C\uC774\uB77C\uAE30\uBCF4\uB2E4
      \uC131\uC744 \uC9C0\uD0A4\uB294 \uC815\uBB3C\uC5D0 \uAC00\uAE4C\uC6CC\uC84C\uC2B5\uB2C8\uB2E4.\n\uB204\uAD6C\uB3C4
      \uADF8\uB140\uB97C \uC704\uD611\uD558\uC9C0 \uC54A\uC9C0\uB9CC, \uADF8 \uB204\uAD6C\uB3C4
      \uADF8\uB140\uC758 \uC774\uB984\uC744 \uBD80\uB974\uC9C0 \uC54A\uB294 \uC644\uBCBD\uD558\uACE0\uB3C4
      \uC11C\uB298\uD55C \uACE0\uB3C5\uC774 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C
      \uC601\uC6D0\uD788 \uC0BC\uCF1C\uBC84\uB838\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
