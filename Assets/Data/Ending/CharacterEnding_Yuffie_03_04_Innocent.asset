  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_03_04_Innocent
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_03_04_caution
  _characterType: 3
  _minMeetCount: 3
  _maxMeetCount: 4
  _moodType: 4
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uC758 \uC6B0\uC815\uC744
      \uC9C4\uC2EC\uC73C\uB85C \uBBFF\uC5C8\uACE0, \uACB0\uAD6D \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB77C\uB294
      \uC774\uB984\uBCF4\uB2E4 \uB85C\uC0AC\uBCA8\uC774\uB77C\uB294 \uADF8\uB298\uC744
      \uB354 \uD3B8\uC548\uD558\uAC8C \uC5EC\uAE30\uAC8C \uB418\uC5C8\uC5B4\uC694.\n\uC131\uC778\uC2DD
      \uC774\uD6C4 \uADF8\uB140\uB294 \uBC31\uC791\uC800\uC5D0\uC11C \uC9C0\uB0B4\uB294
      \uC2DC\uAC04\uBCF4\uB2E4 \uC720\uD53C\uC640 \uD568\uAED8 \uD6C4\uC791\uAC00\uC758
      \uC815\uC6D0\uC5D0\uC11C \uD2F0\uD0C0\uC784\uC744 \uAC16\uB294 \uC2DC\uAC04\uC774
      \uB354 \uB9CE\uC544\uC84C\uB2F5\uB2C8\uB2E4.\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758
      \uC601\uBBFC\uB4E4\uC740 \uC774\uC81C \uBC31\uC791\uC758 \uC5BC\uAD74\uC744
      \uBCF4\uB824\uBA74 \uB85C\uC0AC\uBCA8 \uD6C4\uC791\uC800\uC758 \uBB38\uD131\uC744
      \uB118\uC5B4\uC57C \uD588\uACE0,\n\uBAA8\uB4E0 \uD589\uC815 \uC11C\uB958\uB294
      \uD6C4\uC791 \uBD80\uC778\uC758 \uACB0\uC7AC\uAC00 \uB5A8\uC5B4\uC9C4 \uB4A4\uC5D0\uC57C
      \uC544\uBCA8\uB9AC\uC544\uC758 \uC778\uC7A5\uC774 \uCC0D\uD614\uC9C0\uC694.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uD53C\uC640 \uC790\uB9E4\uCC98\uB7FC \uC9C0\uB0B4\uB294 \uAC83\uC5D0
      \uB9CC\uC871\uD558\uBA70 \uC601\uC9C0\uC758 \uC8FC\uAD8C\uC774 \uB179\uC544\uB0B4\uB9AC\uB294
      \uAC83\uC744 \uBCF4\uC9C0 \uBABB\uD588\uC5B4\uC694.\n\uADF8\uB140\uB294 \uBC31\uC791\uC758
      \uAD00\uC744 \uC37C\uC9C0\uB9CC, \uC0AC\uC2E4\uC0C1 \uC131\uC528\uB9CC \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC77C
      \uBFD0 \uB85C\uC0AC\uBCA8 \uAC00\uBB38\uC758 \uCDA9\uC2E4\uD55C \uC77C\uC6D0\uC73C\uB85C
      \uBC15\uC81C\uB418\uACE0 \uB9D0\uC558\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
