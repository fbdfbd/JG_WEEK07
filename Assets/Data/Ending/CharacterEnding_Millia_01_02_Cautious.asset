  _maxMeetCount: 2
  _moodType: 8
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uAC00 12\uB144 \uB3D9\uC548 \uAC00\uC7A5 \uAC00\uAE4C\uC774
      \uB454 \uC0AC\uB78C\uC740 \uBC00\uB9AC\uC544\uC600\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uC2E0\uC911\uD55C \uC544\uC774\uB85C \uC790\uB790\uAE30\uC5D0...\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uBC00\uB9AC\uC544\uAC00 \uAC00\uC838\uC628 \uD654\uB824\uD55C \uACAC\uBCF8
      \uC0C1\uC790\uBCF4\uB2E4, \uADF8 \uC544\uB798 \uAE54\uB9B0 \uB0A1\uC740 \uC7A5\uBD80\uC758
      \uC22B\uC790\uC5D0 \uB354 \uC9D1\uC911\uD588\uC2B5\uB2C8\uB2E4.\n\uC131\uC778\uC2DD
      \uB0A0 \uC81C\uC548\uB41C \uC0C1\uB2E8\uC758 \uD6C4\uC6D0\uC744 \uAC70\uC808\uD558\uACE0,
      \uADF8\uB140\uB294 \uC2A4\uC2A4\uB85C \uC601\uC9C0\uC758 \uCC3D\uACE0 \uC5F4\uC1E0\uB97C
      \uC6C0\uCF1C\uC950\uB294 \uACE0\uB3C5\uD55C \uAE38\uC744 \uD0DD\uD588\uC9C0\uC694.\n\uBE44\uB85D
      \uC5F0\uD68C\uB294 \uAC80\uC18C\uD558\uACE0 \uC601\uC9C0\uB294 \uC5EC\uC804\uD788
      \uAC00\uB09C\uD588\uC9C0\uB9CC, \uC544\uBCA8\uB9AC\uC544\uC758 \uCC45\uC0C1
      \uC704\uC5D0\uB294 \uC624\uC9C1 \uADF8\uB140 \uC790\uC2E0\uC758 \uC778\uC7A5\uB9CC\uC774
      \uC120\uBA85\uD558\uAC8C \uB0A8\uC558\uB2F5\uB2C8\uB2E4.\n\uBCA0\uB974\uB514\uC544
      \uC0C1\uB2E8\uC740 \uB2F9\uB3CC\uD55C \uC5B4\uB9B0 \uBC31\uC791\uC5D0\uAC8C\uC11C
      \uB2E8 \uD55C \uBF18\uC758 \uD1A0\uC9C0\uB3C4 \uC5BB\uC5B4\uB0B4\uC9C0 \uBABB\uD55C
      \uCC44 \uB3CC\uC544\uAC00\uC57C \uD588\uC5B4\uC694\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC791\uACE0 \uD22C\uBC15\uD588\uC73C\uB098, \uB204\uAD6C\uC5D0\uAC8C\uB3C4
      \uBE5A\uC9C0\uC9C0 \uC54A\uC740 \uCC44 \uAC00\uC7A5 \uB2E8\uB2E8\uD55C \uC790\uB9BD\uC744
      \uC774\uB8E8\uC5B4\uB0C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 1
