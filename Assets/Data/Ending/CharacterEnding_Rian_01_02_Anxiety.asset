  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Rian_01_02_Anxiety
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_rian_01_02_anxiety
  _characterType: 0
  _minMeetCount: 1
  _maxMeetCount: 2
  _moodType: 0
  _text:
    _title: "\uB9AC\uC548 \uB9CC\uB0A8 1~2 - \uBD88\uC548"
    _body: "\uC131\uC778\uC2DD\uC7A5\uC758 \uD669\uC2E4 \uC0AC\uC808\uB2E8 \uC18D\uC5D0\uC11C,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC758 \uC5BC\uAD74\uC744 \uC54C\uC544\uBCF4\uC9C0
      \uBABB\uD588\uB2E4. \uC544\uB2C8, \uC54C\uC544\uBCF4\uC558\uC744\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4. \uB2E4\uB9CC \uADF8\uAC00 \uD669\uC2E4 \uC0AC\uB78C\uC774\uB77C\uB294
      \uC0AC\uC2E4\uC774 \uBAA8\uB4E0 \uAE30\uC5B5 \uC704\uC5D0 \uADF8\uB9BC\uC790\uB97C
      \uB4DC\uB9AC\uC6E0\uB2E4.\n\uB9AC\uC548\uC740 \uC758\uB840\uC801\uC778 \uCD95\uC0AC\uB9CC
      \uB0A8\uAE30\uACE0 \uB3CC\uC544\uAC14\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8 \uC790\uB9AC\uC5D0\uC11C \uBD09\uC2E0\uAC00\uBB38\uC758 \uC774\uC758\uC81C\uAE30\uC5D0
      \uC9C1\uC811 \uB9DE\uC11C\uC57C \uD588\uACE0, \uBAA9\uC18C\uB9AC\uB294 \uB5A8\uB838\uC9C0\uB9CC
      \uB05D\uAE4C\uC9C0 \uC790\uB9AC\uB97C \uC9C0\uCF30\uB2E4.\n\uBC31\uC791\uC704\uB294
      \uACC4\uC2B9\uB418\uC5C8\uB2E4. \uADF8\uB7EC\uB098 \uBD09\uC2E0\uAC00\uBB38\uC740
      \uC644\uC804\uD788 \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uC558\uACE0, \uD6C4\uC791\uAC00\uB294
      '\uD6C4\uACAC'\uC774\uB77C\uB294 \uC774\uB984\uC73C\uB85C \uC601\uC9C0 \uC6B4\uC601\uC5D0
      \uC870\uC5B8\uC744 \uBCF4\uB0B4\uAE30 \uC2DC\uC791\uD588\uB2E4. \uC544\uBCA8\uB9AC\uC544\uC758
      \uC11C\uC7AC\uC5D0\uB294 \uB2F5\uC7A5\uD558\uC9C0 \uBABB\uD55C \uD3B8\uC9C0\uB4E4\uC774
      \uC313\uC5EC \uAC14\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 2
