  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_NoCharacter_Clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_no_character_clever
  _priority: 100
  _isNoCharacterEnding: 1
  _characterType: 1
  _minMeetCount: 0
  _maxMeetCount: 0
  _directionType: 0
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC10\uC815\uBCF4\uB2E4 \uB17C\uB9AC\uB97C,
      \uC0AC\uB78C\uBCF4\uB2E4 \uC22B\uC790\uB97C \uC2E0\uB8B0\uD558\uB294 \uC81C\uAD6D
      \uBD81\uBD80\uC758 \u2018\uC644\uBCBD\uD55C \uD1B5\uCE58\uC790\u2019\uAC00
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uC758 \uC9D1\uBB34\uC2E4\uC740
      \uC81C\uAD6D \uBD81\uBD80\uC758 \uBAA8\uB4E0 \uC815\uBCF4\uC640 \uAE08\uC804\uC774
      \uC624\uAC00\uB294 \uAC70\uB300\uD55C \uACC4\uC0B0\uB300\uAC00 \uB418\uC5C8\uC73C\uBA70,
      \uB2E8 \uD55C \uBF18\uC758 \uD1A0\uC9C0\uB098 \uD55C \uB2E2\uC758 \uB3D9\uC804\uB3C4
      \uADF8\uB140\uC758 \uCE58\uBC00\uD55C \uD5C8\uB77D \uC5C6\uC774\uB294 \uC6C0\uC9C1\uC77C
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \n\uBE44\uD6A8\uC728\uC801\uC778 \uC804\uD1B5\uC744
      \uACE0\uC218\uD558\uB358 \uAC00\uC2E0\uB4E4\uC744 \uB0C9\uC815\uD558\uAC8C
      \uC815\uB9AC\uD55C \uB355\uBD84\uC5D0 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC720\uB840\uC5C6\uB294 \uACBD\uC81C\uC801 \uBC88\uC601\uC744 \uB9DE\uC774\uD588\uC9C0\uB9CC,
      \uC601\uBBFC\uB4E4\uC740 \uBC31\uC791\uC758 \uCC28\uAC00\uC6B4 \uB208\uBE5B\uB9CC
      \uBCF4\uC544\uB3C4 \uC228\uC744 \uC8FD\uC774\uBA70 \uC5BC\uC5B4\uBD99\uC2B5\uB2C8\uB2E4.\r\n\uC131\uC7A5
      \uACFC\uC815\uC5D0\uC11C \uADF8 \uB204\uAD6C\uC640\uB3C4 \uB530\uB73B\uD55C
      \uC720\uB300\uAC10\uC744 \uB098\uB204\uC9C0 \uC54A\uC558\uB358 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C,
      \uC0AC\uB78C\uC740 \uC624\uC9C1 \uC774\uC6A9 \uAC00\uCE58\uAC00 \uC788\uB294
      \uBD80\uD488 \uD639\uC740 \uAD00\uB9AC\uD574\uC57C \uD560 \uBCC0\uC218\uC5D0
      \uBD88\uACFC\uD588\uC2B5\uB2C8\uB2E4.\r\n\uADF8\uB140\uC758 \uACC1\uC5D0\uB294
      \uC9C4\uC2EC \uC5B4\uB9B0 \uCDA9\uC131\uC744 \uBC14\uCE58\uB294 \uAE30\uC0AC\uB098
      \uACE0\uBBFC\uC744 \uB098\uB20C \uCE5C\uAD6C\uAC00 \uC874\uC7AC\uD558\uC9C0
      \uC54A\uC73C\uBA70, \uC624\uC9C1 \uBA85\uB839\uC744 \uC218\uD589\uD558\uB294
      \uAE30\uACC4\uC801\uC778 \uD558\uC778\uB4E4\uB9CC\uC774 \uCE68\uBB35 \uC18D\uC5D0
      \uBA38\uBB3C \uBFD0\uC785\uB2C8\uB2E4. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uC81C
      \uC778\uAC04\uC758 \uB9C8\uC74C\uC774 \uAC00\uC9C4 \uAC00\uBCC0\uC131\uC744
      \uC2E0\uB8B0\uD558\uC9C0 \uC54A\uC73C\uBA70, \uC601\uC9C0\uB97C \uB2E8 \uD55C
      \uCE58\uC758 \uC624\uCC28\uB3C4 \uD5C8\uC6A9\uD558\uC9C0 \uC54A\uB294 \uC815\uAD50\uD55C
      \uAE30\uACC4 \uC7A5\uCE58\uCC98\uB7FC \uB3CC\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \n\uBC24\uB9C8\uB2E4 \uD640\uB85C \uCD1B\uBD88 \uC544\uB798\uC5D0\uC11C \uC7A5\uBD80\uB97C
      \uAC80\uD1A0\uD558\uB294 \uADF8\uB140\uC758 \uBAA8\uC2B5\uC740 \uBB34\uCC99\uC774\uB098
      \uC720\uB2A5\uD574 \uBCF4\uC774\uC9C0\uB9CC, \uADF8\uB140\uB294 \uC790\uC2E0\uC774
      \uB9CC\uB4E0 \uC644\uBCBD\uD55C \uC2DC\uC2A4\uD15C \uC18D\uC5D0 \uC2A4\uC2A4\uB85C\uB97C
      \uAC00\uB454 \uCC44 \uAC00\uC7A5 \uD6A8\uC728\uC801\uC774\uACE0\uB3C4 \uC678\uB85C\uC6B4
      \uC9C0\uBC30\uC790\uB85C \uC0B4\uC544\uAC00\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
