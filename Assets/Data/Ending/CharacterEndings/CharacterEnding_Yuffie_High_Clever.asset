  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_High_Clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_high_clever
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 3
  _minMeetCount: 7
  _maxMeetCount: -1
  _directionType: 0
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uC758 \uCE58\uBC00\uD55C
      \uC870\uC885\uACFC \uAC00\uC2A4\uB77C\uC774\uD305\uC744 \uC644\uBCBD\uD788
      \uC774\uD574\uD558\uBA74\uC11C\uB3C4, \uAC70\uB300\uD55C \uD6C4\uC791\uAC00\uC758
      \uAD8C\uB825\uC744 \uC774\uAE38 \uC218 \uC5C6\uB2E4\uB294 \uB0C9\uD639\uD55C
      \uD604\uC2E4\uC5D0 \uAD74\uBCF5\uD558\uAE30\uB85C \uACB0\uC815\uD588\uC2B5\uB2C8\uB2E4.
      \n\uADF8\uB140\uB294 \uC720\uD53C\uC758 '\uC0AC\uB0E5\uAC1C'\uAC00 \uB418\uC5B4
      \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C \uC9C0\uD0A4\uB294 \uB300\uAC00\uB85C
      \uB85C\uC0AC\uBCA8\uC758 \uC774\uC775\uC744 \uC704\uD574 \uC790\uC2E0\uC758
      \uC601\uBBFC\uD568\uC744 \uD718\uB450\uB974\uB294 \uAE38\uC744 \uD0DD\uD588\uC9C0\uC694.
      \n\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uC601\uB9AC\uD568\uC744
      \uB192\uC774 \uD3C9\uAC00\uD558\uBA70 \"\uC5ED\uC2DC \uC6B0\uB9AC\uB294 \uB108\uBB34
      \uB2EE\uC558\uC5B4\"\uB77C\uACE0 \uCE6D\uCC2C\uD558\uC9C0\uB9CC, \uADF8 \uCE6D\uCC2C\uC740
      \uC544\uBCA8\uB9AC\uC544\uB97C \uB85C\uC0AC\uBCA8\uC758 \uCCB4\uC81C \uC548\uC5D0
      \uBB36\uC5B4\uB450\uB294 \uAC00\uC7A5 \uACAC\uACE0\uD55C \uC0AC\uC2AC\uC774
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \n\uC774\uC81C \uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uD53C\uC758 \uC9C0\uC2DC\uC5D0 \uB530\uB77C \uC81C\uAD6D \uBD81\uBD80\uC758
      \uACBD\uC81C\uB97C \uB4A4\uD754\uB4E4\uBA70 \uCC28\uAC00\uC6B4 \uD1B5\uCE58\uB97C
      \uC774\uC5B4\uAC00\uACE0 \uC788\uC9C0\uB9CC, \uADF8\uB140\uAC00 \uBC8C\uC5B4\uB4E4\uC774\uB294
      \uBAA8\uB4E0 \uAE08\uC804\uC740 \uACB0\uAD6D \uB85C\uC0AC\uBCA8\uC758 \uCC3D\uACE0\uB85C
      \uD758\uB7EC \uB4E4\uC5B4\uAC11\uB2C8\uB2E4. \n\uC601\uBBFC\uD55C \uBC31\uC791\uC740
      \uC790\uC2E0\uC774 \uB85C\uC0AC\uBCA8\uC758 \uAC00\uC7A5 \uC720\uB2A5\uD55C
      \uB300\uB9AC\uC778\uC73C\uB85C \uC804\uB77D\uD588\uC74C\uC744 \uB204\uAD6C\uBCF4\uB2E4
      \uC798 \uC54C\uAE30\uC5D0, \uB9E4\uC77C \uBC24 \uC7A5\uBD80\uB97C \uB36E\uC73C\uBA70
      \uC11C\uB298\uD55C \uC790\uAD34\uAC10\uC5D0 \uC816\uC5B4\uB4ED\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
