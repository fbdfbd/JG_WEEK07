  _maxMeetCount: -1
  _directionType: 4
  _text:
    _title: 
    _body: "\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C \uB85C\uC0AC\uBCA8
      \uAC00\uBB38\uC758 \uC77C\uC6D0\uC774 \uB418\uB294 \uAC83\uC774 \uAC00\uC7A5
      \uC644\uBCBD\uD55C \uD3C9\uD654\uB77C\uACE0 \uC720\uD639\uD558\uBA70, \uADF8\uB140\uB97C
      \uAC00\uBB38\uC758 \uB0B4\uBD80\uC790\uB85C \uB04C\uC5B4\uB4E4\uC774\uB824
      \uD588\uC5B4\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uC758 \uAC00\uC2A4\uB77C\uC774\uD305\uC870\uCC28
      \uD558\uB098\uC758 \uC815\uCE58\uC801 \uC218\uB2E8\uC73C\uB85C \uC774\uD574\uD558\uACE0,
      \uC5ED\uC73C\uB85C \uB85C\uC0AC\uBCA8 \uAC00\uBB38\uC758 \uBA85\uC131\uACFC
      \uC790\uC6D0\uC744 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758 \uBC88\uC601\uC744
      \uC704\uD574 \uC601\uB9AC\uD558\uAC8C \uC774\uC6A9\uD558\uAE30 \uC2DC\uC791\uD588\uB2F5\uB2C8\uB2E4.
      \n\uC720\uD53C\uB294 \uC790\uC2E0\uC774 \uC544\uBCA8\uB9AC\uC544\uB97C \uC870\uC885\uD558\uACE0
      \uC788\uB2E4\uACE0 \uBBFF\uC5C8\uC9C0\uB9CC, \uC2E4\uC0C1\uC740 \uC544\uBCA8\uB9AC\uC544\uAC00
      \uC81C\uACF5\uD558\uB294 \uAC00\uC9DC \uD3C9\uC548\uC5D0 \uCDE8\uD574 \uB85C\uC0AC\uBCA8
      \uAC00\uBB38\uC758 \uC790\uAE08\uC744 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC5D0
      \uC3DF\uC544\uBD93\uACE0 \uC788\uC5C8\uB358 \uAC83\uC774\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uD53C\uC758 \uB2E4\uC815\uD55C \uAC04\uC12D\uC744 \uAE30\uAEBC\uC774
      \uD5C8\uC6A9\uD558\uB294 \uCC99\uD558\uBA74\uC11C\uB3C4, \uC601\uC9C0\uC758
      \uD575\uC2EC \uAD8C\uD55C\uB9CC\uD07C\uC740 \uB2E8 \uD55C \uBF18\uB3C4 \uB0B4\uC8FC\uC9C0
      \uC54A\uB294 \uCCA0\uC800\uD55C \uC774\uC911 \uC804\uB7B5\uC744 \uD3BC\uCCE4\uC5B4\uC694.
      \n\uB450 \uAC00\uBB38\uC740 \uAC89\uC73C\uB85C\uB294 \uC81C\uAD6D\uC5D0\uC11C
      \uAC00\uC7A5 \uB3C8\uB3C5\uD55C \uD608\uB9F9\uCC98\uB7FC \uBCF4\uC774\uC9C0\uB9CC,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uAD00\uACC4\uC758 \uC8FC\uB3C4\uAD8C\uC744
      \uC774\uBBF8 \uC790\uC2E0\uC758 \uC190\uC5D0 \uAF49 \uC950\uACE0 \uC788\uC5C8\uB2F5\uB2C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uD53C\uB77C\uB294 \uBC29\uD328\uB97C \uC55E\uC138\uC6CC \uC601\uC9C0\uC758
      \uC548\uC815\uC744 \uC644\uBCBD\uD788 \uAD6C\uCD95\uD588\uACE0, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uADF8 \uC5B4\uB290 \uB54C\uBCF4\uB2E4 \uB2E8\uB2E8\uD558\uACE0 \uD3C9\uC628\uD55C
      \uC804\uC131\uAE30\uB97C \uB204\uB9AC\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
