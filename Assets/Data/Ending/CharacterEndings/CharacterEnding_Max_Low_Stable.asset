  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Max_Low_Stable
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_low_stable
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 1
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 4
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uB2E8\uB2E8\uD55C \uB300\uC9C0 \uAC19\uC740
      \uD3C9\uC628\uD55C \uC9C0\uBC30\uC790\uAC00 \uB418\uC5C8\uC744 \uB54C, \uB9C9\uC2A4\uB294
      \uADF8 \uACE0\uC694\uD55C \uD3C9\uD654\uB97C \uAE68\uB728\uB9AC\uC9C0 \uC54A\uB294
      \uC120\uC5D0\uC11C \uAC00\uBB38\uC758 \uC790\uB9AC\uB97C \uC9C0\uD0A4\uB294
      \uC870\uC6A9\uD55C \uBD09\uC2E0\uC73C\uB85C \uB0A8\uC558\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uBC31\uC791\uC774 \uC601\uBBFC\uB4E4\uC758 \uB07C\uB2C8\uB97C
      \uCC59\uAE30\uACE0 \uC601\uC9C0\uC758 \uBFCC\uB9AC\uB97C \uB0B4\uC2E4 \uC788\uAC8C
      \uB2E4\uC9C0\uB294 \uB3D9\uC548, \uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC774
      \uC601\uC9C0 \uC678\uBD80\uC758 \uBB34\uC5ED\uB85C\uC640 \uC774\uAD8C\uC744
      \uC870\uAE08\uC529 \uD655\uBCF4\uD560 \uC218 \uC788\uB3C4\uB85D \uC2E0\uC911\uD558\uAC8C
      \uC6C0\uC9C1\uC600\uC9C0\uC694. \n\uB9C9\uC2A4\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uC628\uD654\uD55C \uD1B5\uCE58\uAC00 \uC601\uC9C0\uC5D0 \uC548\uC815\uC744
      \uAC00\uC838\uC624\uB294 \uAC83\uC744 \uBCF4\uBA70 \uADF8\uB140\uC758 \uC778\uD488\uC5D0
      \uC9C4\uC2EC \uC5B4\uB9B0 \uC874\uACBD\uC744 \uD45C\uD588\uC9C0\uB9CC, \uAC00\uBB38\uC758
      \uC9C0\uC2DC\uC5D0 \uB530\uB77C \uADF8\uB140\uAC00 \uC2E0\uACBD \uC4F0\uC9C0
      \uBABB\uD558\uB294 \uC138\uC138\uD55C \uC774\uAD8C\uB4E4\uC744 \uCC28\uADFC\uCC28\uADFC
      \uCC59\uAE30\uB294 \uC77C\uC744 \uC78A\uC9C0 \uC54A\uC558\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uD06C\uB808\uC774\uD504 \uBA38\uD2C0
      \uC544\uB798\uC5D0\uC11C \uCC28\uB97C \uB9C8\uC2DC\uBA70 \uC6C3\uC744 \uB54C\uB9C8\uB2E4
      \uADF8 \uD3C9\uD654\uAC00 \uC601\uC6D0\uD558\uAE30\uB97C \uBC14\uB780\uB2E4\uACE0
      \uC18D\uC0AD\uC774\uBA74\uC11C\uB3C4, \uC601\uC9C0 \uB0B4\uBD80\uC758 \uC2E4\uBB34\uC801
      \uC601\uD5A5\uB825\uC744 \uBC1C\uD14C\uB9AC\uC628\uC758 \uAC83\uC73C\uB85C
      \uCC44\uC6CC \uB123\uC5C8\uC5B4\uC694. \n\uB9C9\uC2A4\uB294 \uD48D\uC694\uB85C\uC6B4
      \uC218\uD655\uC744 \uAC70\uB450\uB294 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758
      \uB4E4\uD310\uC744 \uBC14\uB77C\uBCF4\uBA70 \uC544\uBCA8\uB9AC\uC544\uAC00
      \uB9CC\uB4E0 \uC774 \uB530\uC2A4\uD55C \uD48D\uACBD \uC18D\uC5D0 \uC790\uC2E0\uC758
      \uC790\uB9AC\uB294 \uACB0\uAD6D \uC774\uBC29\uC778\uC77C \uBFD0\uC774\uB77C\uB294
      \uC0AC\uC2E4\uC744 \uBB38\uB4DD \uAE68\uB2EB\uACE0 \uC4F8\uC4F8\uD574\uD558\uACE4
      \uD588\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
