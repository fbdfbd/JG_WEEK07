  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Max_Low_Curious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_low_curious
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 1
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 3
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC601\uC9C0 \uACBD\uC601\uC744 \uB0B4\uD33D\uAC1C\uCE58\uACE0
      \uAE30\uAD34\uD55C \uAE08\uAE30\uB97C \uD0D0\uB2C9\uD558\uB294 \uB3D9\uC548,
      \uB9C9\uC2A4\uB294 \uADF8\uB140\uAC00 \uB9CC\uB4E0 \uACF5\uD3EC\uC758 \uBC15\uBB3C\uAD00
      \uC548\uC73C\uB85C \uAE4A\uC774 \uBC1C\uC744 \uB4E4\uC774\uC9C0 \uC54A\uC740
      \uCC44 \uBB38\uBC16\uC5D0\uC11C \uC870\uC6A9\uD788 \uC790\uB9AC\uB97C \uC9C0\uCF30\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uAC00\uBB38\uC758 \uC774\uAD8C\uC744 \uCC59\uAE30\uB824\uB2E4
      \uC790\uCE6B \uADF8\uB140\uC758 \uAD11\uAE30\uC5D0 \uD718\uB9D0\uB9B4 \uAC83\uC744
      \uACBD\uACC4\uD558\uBA70, \uC608\uC758 \uBC14\uB978 \uAD00\uCC30\uC790\uC758
      \uD0DC\uB3C4\uB85C \uADF8\uB140\uAC00 \uBB34\uB108\uB728\uB9B0 \uC601\uC9C0\uC758
      \uD589\uC815 \uC77C\uBD80\uB97C \uCC9C\uCC9C\uD788 \uC7A0\uC2DD\uD574 \uB098\uAC14\uC5B4\uC694.
      \n\uC544\uBCA8\uB9AC\uC544\uAC00 \uC704\uD5D8\uD55C \uC720\uBB3C\uB4E4\uC744
      \uBAA8\uC73C\uBA70 \uAC00\uBB38\uC758 \uC774\uB984\uC744 \uC9C0\uC6CC\uAC08
      \uB54C, \uB9C9\uC2A4\uB294 \uADF8\uB140\uC5D0\uAC8C \uC0C8\uB85C\uC6B4 \uBBF8\uC2A4\uD130\uB9AC\uB97C
      \uB358\uC838\uC8FC\uBA70 \uADF8\uB140\uC758 \uC2DC\uC120\uC774 \uC601\uC9C0\uC758
      \uD604\uC2E4\uB85C \uB3CC\uC544\uC624\uC9C0 \uBABB\uD558\uB3C4\uB85D \uC720\uB3C4\uD588\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uBC31\uC791\uC774 \uC131\uC548\uC5D0\uC11C \uAE30\uAD34\uD55C
      \uC18C\uB9AC\uC640 \uD568\uAED8 \uC790\uBA78\uD574\uAC00\uB294 \uACFC\uC815\uC744
      \uB2E4\uC815\uD55C \uBBF8\uC18C\uB85C \uC9C0\uCF1C\uBCF4\uBA70, \uBC1C\uD14C\uB9AC\uC628\uC774
      \uADF8 \uD3D0\uD5C8\uB97C \uBB3C\uB824\uBC1B\uC744 \uC900\uBE44\uB97C \uCC28\uADFC\uCC28\uADFC
      \uC9C4\uD589\uD588\uC5B4\uC694. \n\uD558\uC9C0\uB9CC \uAC00\uB054 \uADF8\uB140\uC758
      \uB208\uC5D0 \uC11C\uB9B0 \uAE30\uC774\uD55C \uAD11\uAE30\uAC00 \uC790\uC2E0\uC744
      \uD5A5\uD560 \uB54C\uBA74, \uB9C9\uC2A4\uB294 \uADF8\uB140\uAC00 \uCC3E\uC73C\uB824\uB358
      \uC9C4\uC2E4\uC774 \uC0AC\uC2E4\uC740 \uC790\uC2E0\uC758 \uAC70\uC9D3\uB41C
      \uCE5C\uC808\uC774 \uC544\uB2C8\uC5C8\uC744\uAE4C \uD558\uB294 \uC12C\uB729\uD55C
      \uC608\uAC10\uC5D0 \uBAB8\uC744 \uB5A8\uAE30\uB3C4 \uD588\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
