  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Max_High_Anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_high_anxious
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 1
  _minMeetCount: 11
  _maxMeetCount: -1
  _directionType: 5
  _text:
    _title: 
    _body: "\uACF5\uD3EC\uC640 \uC758\uC2EC\uC73C\uB85C \uBB34\uB108\uC838 \uB0B4\uB9B0
      \uC544\uBCA8\uB9AC\uC544\uC758 \uC9D1\uBB34\uC2E4\uC5D0\uC11C, \uB9C9\uC2A4\uB294
      \uADF8\uB140\uAC00 \uC720\uC77C\uD558\uAC8C \uC2E0\uB8B0\uD558\uACE0 \uAE30\uB308
      \uC218 \uC788\uB294 \uC808\uB300\uC801\uC778 \uC218\uD638\uC790\uC774\uC790
      \uB3C5\uC810\uC801\uC778 \uC870\uC5B8\uC790\uAC00 \uB418\uC5C8\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uBC31\uC791\uC758 \uC2E0\uACBD \uC1E0\uC57D\uC744 \uC774\uC6A9\uD574
      \uADF8\uB140\uC758 \uBAA8\uB4E0 \uD310\uB2E8\uB825\uC744 \uD750\uB9AC\uAC8C
      \uB9CC\uB4E4\uC5C8\uACE0, \uADF8\uB140\uAC00 \uB0B4\uB9AC\uB294 \uBAA8\uB4E0
      \uBA85\uB839\uC774 \uC624\uC9C1 \uC790\uC2E0\uC758 \uC785\uC744 \uD1B5\uD574\uC11C\uB9CC
      \uC601\uC9C0\uC5D0 \uC804\uB2EC\uB418\uB3C4\uB85D \uCCB4\uACC4\uB97C \uC644\uC804\uD788
      \uC7A5\uC545\uD574\uBC84\uB838\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uAC00
      \uBCF4\uC774\uC9C0 \uC54A\uB294 \uC801\uB4E4\uB85C\uBD80\uD130 \uC790\uC2E0\uC744
      \uC9C0\uCF1C\uB2EC\uB77C\uBA70 \uB9C9\uC2A4\uC5D0\uAC8C \uB9E4\uB2EC\uB9B4\uC218\uB85D
      \uB9C9\uC2A4\uB294 \uADF8\uB140\uB97C \uC704\uD55C \uC644\uBCBD\uD55C \uAC10\uC625\uC744
      \uB9CC\uB4E4\uC5B4 \uADF8 \uC548\uC5D0\uC11C \uADF8\uB140\uB97C \uC9C0\uBC30\uD558\uACE0
      \uC601\uC9C0\uC758 \uBAA8\uB4E0 \uC2E4\uAD8C\uC744 \uBC1C\uD14C\uB9AC\uC628\uC758
      \uAC83\uC73C\uB85C \uB3CC\uB838\uB2F5\uB2C8\uB2E4.\n\uADF8\uB294 \uADF8\uB140\uC758
      \uACF5\uD3EC\uB97C \uBA39\uC774 \uC0BC\uC544 \uC790\uC2E0\uC758 \uC601\uD5A5\uB825\uC744
      \uD0A4\uC6B0\uBA74\uC11C\uB3C4 \uC544\uBCA8\uB9AC\uC544 \uC55E\uC5D0\uC11C\uB294
      \uAC00\uC7A5 \uD5CC\uC2E0\uC801\uC774\uACE0 \uB530\uB73B\uD55C \uBAA9\uC18C\uB9AC\uB85C
      \"\uB0B4\uAC00 \uC788\uB294 \uD55C \uB2F9\uC2E0\uC740 \uC548\uC804\uD558\uB2E4\"\uBA70
      \uB04A\uC784\uC5C6\uC774 \uADF8\uB140\uB97C \uC138\uB1CC\uD558\uACE0 \uBB34\uB825\uD654\uC2DC\uCF30\uC5B4\uC694.
      \n\uB9C9\uC2A4\uB294 \uAE30\uBBF8 \uC5C6\uC774\uB294 \uC2DD\uC0AC\uC870\uCC28
      \uD558\uC9C0 \uBABB\uD560 \uC815\uB3C4\uB85C \uD53C\uD3D0\uD574\uC9C4 \uC544\uBCA8\uB9AC\uC544\uB97C
      \uD488\uC5D0 \uC548\uACE0\uC11C, \uC790\uC2E0\uC774 \uB9DD\uAC00\uB728\uB9B0
      \uADF8\uB140\uC758 \uC601\uD63C\uC744 \uC560\uC368 \uBABB \uBCF8 \uCC99\uD558\uBA70
      \uC774 \uBE44\uADF9\uC801\uC778 \uACB0\uB9D0\uC774 \uAC00\uBB38\uC744 \uC704\uD55C
      \uCD5C\uC120\uC758 \uC120\uD0DD\uC774\uC5C8\uB2E4\uACE0 \uC2A4\uC2A4\uB85C\uB97C
      \uAE30\uB9CC\uD588\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
