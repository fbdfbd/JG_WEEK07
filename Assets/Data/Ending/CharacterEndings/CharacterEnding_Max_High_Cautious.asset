  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Max_High_Cautious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_high_cautious
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 1
  _minMeetCount: 11
  _maxMeetCount: -1
  _directionType: 2
  _text:
    _title: 
    _body: "\uC644\uBCBD\uD55C \uBCF4\uC548\uACFC \uC548\uC804\uC5D0 \uC9D1\uCC29\uD558\uB294
      \uC544\uBCA8\uB9AC\uC544\uC758 \uACC1\uC5D0\uC11C, \uB9C9\uC2A4\uB294 \uADF8\uB140\uAC00
      \uB9CC\uB4E0 \uC694\uC0C8\uC758 \uC720\uC77C\uD55C \uC5F4\uC1E0\uB97C \uC954
      \uD638\uC704\uC774\uC790 \uC870\uC5B8\uC790\uB85C \uC790\uB9AC \uC7A1\uC558\uB2F5\uB2C8\uB2E4.\n\uADF8\uB294
      \uBC31\uC791\uC774 \uC544\uBB34\uB3C4 \uBBFF\uC9C0 \uBABB\uD558\uACE0 \uACE0\uB3C5
      \uC18D\uC5D0\uC11C \uB5A8 \uB54C\uB9C8\uB2E4 \uADF8\uB140\uC758 \uBD88\uC548\uC744
      \uAC00\uC7A5 \uC815\uAD50\uD558\uAC8C \uC790\uADF9\uD558\uC5EC, \uADF8\uB140
      \uC2A4\uC2A4\uB85C \uAC00\uBB38\uC744 \uC601\uC6D0\uD55C \uAC10\uC625\uC73C\uB85C
      \uB9CC\uB4E4\uACE0 \uC790\uC2E0\uC5D0\uAC8C\uB9CC \uC758\uC9C0\uD558\uB3C4\uB85D
      \uC124\uACC4\uD588\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uAC00 \uC131\uC758
      \uBAA8\uB4E0 \uBB38\uACE0\uB9AC\uB97C \uD655\uC778\uD558\uBA70 \uC2E0\uACBD
      \uC1E0\uC57D\uC5D0 \uBE60\uC838\uAC08\uC218\uB85D \uB9C9\uC2A4\uB294 \uADF8\uB140\uB97C
      \uB300\uC2E0\uD574 \uC601\uC9C0\uC758 \uBAA8\uB4E0 \uD589\uC815\uACFC \uBA85\uB839\uAD8C\uC744
      \uC7A5\uC545\uD558\uBA70 \uC2E4\uC9C8\uC801\uC778 \uC9C0\uBC30\uC790\uB85C
      \uAD70\uB9BC\uD588\uB2F5\uB2C8\uB2E4. \n\uADF8\uB294 \uADF8\uB140\uB97C \uC548\uC804\uD558\uAC8C
      \uC9C0\uD0A8\uB2E4\uB294 \uBBF8\uBA85 \uD558\uC5D0 \uC678\uBD80\uC640\uC758
      \uBAA8\uB4E0 \uC811\uCD09\uC744 \uCC28\uB2E8\uD558\uACE0, \uADF8\uB140\uC758
      \uC655\uC88C\uB97C \uAC00\uC7A5 \uD654\uB824\uD558\uACE0 \uACAC\uACE0\uD55C
      \uBB34\uB364\uC73C\uB85C \uBCC0\uBAA8\uC2DC\uCF1C \uB098\uAC14\uC5B4\uC694.
      \n\uB9C9\uC2A4\uB294 \uD145 \uBE48 \uC131\uC758 \uD68C\uB791\uC744 \uAC78\uC73C\uBA70
      \uC544\uBCA8\uB9AC\uC544\uAC00 \uC783\uC5B4\uBC84\uB9B0 \uC790\uC720\uC640
      \uC0DD\uAE30\uB97C \uADF8\uB9AC\uC6CC\uD588\uC9C0\uB9CC, \uC790\uC2E0\uC774
      \uADF8\uB140\uB97C \uC0C8\uC7A5 \uC18D\uC5D0 \uAC00\uB450\uACE0 \uB0A0\uAC1C\uB97C
      \uAEBE\uC740 \uD3EC\uD68D\uC790\uB77C\uB294 \uC0AC\uC2E4\uB9CC\uD07C\uC740
      \uB05D\uB0B4 \uC778\uC815\uD558\uC9C0 \uC54A\uC740 \uCC44 \uB2E4\uC815\uD558\uAC8C
      \uADF8\uB140\uC758 \uACC1\uC744 \uC9C0\uCF30\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
