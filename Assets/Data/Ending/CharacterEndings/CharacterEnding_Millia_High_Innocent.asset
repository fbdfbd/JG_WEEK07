  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_High_Innocent
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_high_innocent
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 2
  _minMeetCount: 7
  _maxMeetCount: -1
  _directionType: 1
  _text:
    _title: 
    _body: "\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uC131\uC778\uC2DD
      \uB0A0, \uC0C1\uB2E8\uC5D0\uC11C \uACF5\uC218\uD55C \uAC00\uC7A5 \uADC0\uD55C
      \uBCF4\uC11D\uB4E4\uC744 \uC544\uBCA8\uB9AC\uC544\uC758 \uBA38\uB9AC \uC704\uC5D0
      \uC9C1\uC811 \uC7A5\uC2DD\uD574 \uC8FC\uC5C8\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294
      \uB2E4\uC815\uD558\uAC8C \uC18D\uC0AD\uC774\uBA70 \uBC14\uAE65\uC138\uC0C1\uC740
      \uB108\uBB34 \uC2DC\uB044\uB7FD\uACE0 \uBCF5\uC7A1\uD558\uB2C8 \uC790\uC2E0\uC774
      \uC2DC\uD0A4\uB294 \uB300\uB85C\uB9CC \uD558\uBA74 \uB41C\uB2E4\uACE0 \uC77C\uB7EC\uB450\uC5C8\uC9C0\uC694.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC870\uC6A9\uD788 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uBA70
      \uADF8\uB140\uC758 \uC190\uC744 \uAF2D \uC7A1\uC558\uACE0, \uC601\uC9C0\uC758
      \uBAA8\uB4E0 \uACBD\uC81C\uAD8C\uC744 \uBC00\uB9AC\uC544\uC5D0\uAC8C \uC704\uC784\uD55C\uB2E4\uB294
      \uBB38\uC11C\uC5D0 \uB9DD\uC124\uC784 \uC5C6\uC774 \uC11C\uBA85\uD588\uC2B5\uB2C8\uB2E4.
      \n\uC7A5\uBD80\uC0C1\uC758 \uC22B\uC790\uAC00 \uC904\uC5B4\uB4DC\uB294 \uAC83\uC5D0
      \uB300\uD574\uC11C\uB3C4 \uB2E8 \uD55C \uBC88\uB3C4 \uC758\uBB38\uC744 \uC81C\uAE30\uD558\uC9C0
      \uC54A\uC558\uB2F5\uB2C8\uB2E4. \n\uBC00\uB9AC\uC544\uB294 \uC678\uBD80 \uADC0\uC871\uB4E4\uC758
      \uBAA8\uB4E0 \uC811\uACAC\uC744 \uCC28\uB2E8\uD55C \uCC44 \uC544\uBCA8\uB9AC\uC544\uAC00
      \uC624\uC9C1 \uC544\uB984\uB2E4\uC6B4 \uAC83\uB4E4\uB9CC \uBCF4\uACE0 \uB4E3\uB3C4\uB85D
      \uCCA0\uC800\uD788 \uAD00\uB9AC\uD558\uAE30 \uC2DC\uC791\uD588\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uBC00\uB9AC\uC544\uAC00 \uAC00\uC838\uB2E4\uC8FC\uB294 \uB2EC\uCF64\uD55C
      \uACFC\uC790\uC640 \uB3D9\uD654\uCC45\uC5D0 \uB9CC\uC871\uD558\uBA70 \uC131
      \uC548\uC5D0\uC11C \uAC00\uC7A5 \uD589\uBCF5\uD55C \uAD70\uC8FC\uB85C \uC0B4\uC544\uAC00\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. \n\uC601\uC9C0\uB294 \uC5B4\uB290\uC0C8 \uBC31\uC791\uC758
      \uD1B5\uCE58\uC9C0\uAC00 \uC544\uB2CC, \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758
      \uAC00\uC7A5 \uAC70\uB300\uD558\uACE0 \uC548\uC804\uD55C \uC0AC\uC720\uC9C0\uAC00
      \uB418\uC5B4\uBC84\uB838\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
