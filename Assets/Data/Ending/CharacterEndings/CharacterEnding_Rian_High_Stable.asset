  _maxMeetCount: -1
  _directionType: 4
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC774 \uAC00\uC9C4 \uD669\uC790\uB85C\uC11C\uC758
      \uACE0\uB1CC\uC640 \uC678\uB85C\uC6C0\uC744 \uB530\uB73B\uD558\uAC8C \uD488\uC5B4\uC8FC\uBA70,
      \uADF8\uB97C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB77C\uB294 \uAC70\uB300\uD55C
      \uC548\uC815\uC758 \uD2C0 \uC548\uC5D0 \uC815\uCC29\uC2DC\uCF30\uC2B5\uB2C8\uB2E4.
      \n\uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544 \uACC1\uC5D0\uC11C \uD669\uC2E4\uC758
      \uD53C\uACE4\uD55C \uC815\uC7C1\uC744 \uC78A\uACE0 \uD3C9\uBC94\uD55C \uC778\uAC04\uC73C\uB85C\uC11C\uC758
      \uC0B6\uC744 \uAFC8\uAFB8\uAC8C \uB418\uC5C8\uC73C\uBA70, \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8\uB7F0 \uB9AC\uC548\uC744 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758 \uBA85\uC608
      \uACE0\uBB38\uC73C\uB85C \uC549\uD600 \uD669\uC2E4\uC758 \uBE44\uD638\uC640
      \uC601\uC9C0\uC758 \uC548\uC815\uC744 \uB3D9\uC2DC\uC5D0 \uD655\uBCF4\uD588\uC9C0\uC694.\n\uB450
      \uC0AC\uB78C\uC740 \uC0AC\uB791\uC740 \uC544\uB2C8\uC9C0\uB9CC \uAE4A\uC740
      \uC2E0\uB8B0\uB97C \uBC14\uD0D5\uC73C\uB85C \uC601\uC9C0\uB97C \uD568\uAED8
      \uB3CC\uBCF4\uBA70, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C \uC81C\uAD6D\uC5D0\uC11C
      \uAC00\uC7A5 \uD48D\uC694\uB86D\uACE0 \uD3C9\uD654\uB85C\uC6B4 \uB545\uC73C\uB85C
      \uB9CC\uB4E4\uC5C8\uB2F5\uB2C8\uB2E4. \n\uB9AC\uC548\uC740 \uC774\uC81C \uD669\uC2E4\uC758
      \uD669\uC790\uB77C\uAE30\uBCF4\uB2E4 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758 \uC0AC\uB78C\uCC98\uB7FC
      \uBCF4\uC774\uBA70, \uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC774\uB77C\uB294
      \uBC29\uD328 \uB4A4\uC5D0\uC11C \uB204\uAD6C\uB3C4 \uBC94\uC811\uD560 \uC218
      \uC5C6\uB294 \uB2E8\uB2E8\uD55C \uC9C0\uBC30\uB825\uC744 \uD589\uC0AC\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. \n\uD669\uC2E4\uC870\uCC28 \uC774 \uD3C9\uC628\uD55C
      \uC694\uC0C8\uC5D0 \uB4E4\uC5B4\uC549\uC740 7\uD669\uC790\uB97C \uAC15\uC81C\uB85C
      \uB04C\uC5B4\uB0B4\uC9C0 \uBABB\uD560 \uC815\uB3C4\uB85C, \uC544\uBCA8\uB9AC\uC544\uAC00
      \uAD6C\uCD95\uD55C \uD3C9\uD654\uB294 \uACAC\uACE0\uD558\uACE0\uB3C4 \uC555\uB3C4\uC801\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
