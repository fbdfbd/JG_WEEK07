  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Max_High_Defiant
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_high_defiant
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 1
  _minMeetCount: 7
  _maxMeetCount: -1
  _directionType: 6
  _text:
    _title: 
    _body: "\uAD00\uC2B5\uC744 \uAE68\uACE0 \uB3C5\uB9BD\uC744 \uC120\uD3EC\uD55C
      \uC544\uBCA8\uB9AC\uC544\uC758 \uACC1\uC5D0\uC11C, \uB9C9\uC2A4\uB294 \uADF8\uB140\uC758
      \uAC00\uC7A5 \uC704\uD5D8\uD55C \uACC4\uD68D\uC744 \uC2E4\uD589\uC5D0 \uC62E\uAE30\uB294
      \uCDA9\uC2E4\uD55C \uD638\uC704\uC774\uC790 \uCD5C\uCE21\uADFC\uC774 \uB418\uC5C8\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uBC31\uC791\uC774 \uC81C\uAD6D\uACFC \uB300\uB9BD\uD558\uBA70
      \uACE0\uB9BD\uB418\uB294 \uACFC\uC815\uC744 \uAC00\uC7A5 \uAC00\uAE4C\uC774\uC11C
      \uB3C4\uC6B0\uBA70, \uD754\uB4E4\uB9AC\uB294 \uAD70\uC0AC\uC640 \uD589\uC815\uC744
      \uC544\uBCA8\uB9AC\uC544\uC758 \uC774\uB984 \uC544\uB798 \uB2E4\uC2DC \uBB36\uC5B4
      \uC138\uC6E0\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uAC00 \uC81C\uAD6D\uC758
      \uC555\uBC15\uC5D0 \uB9DE\uC11C \uAC70\uCE60\uAC8C \uC601\uC9C0\uB97C \uC774\uB04C
      \uB54C\uB9C8\uB2E4 \uB9C9\uC2A4\uB294 \uADF8\uB140\uC758 \uACFC\uACA9\uD55C
      \uACB0\uB2E8\uB4E4\uC774 \uBB34\uBAA8\uD55C \uD3ED\uC8FC\uB85C \uD750\uB974\uC9C0
      \uC54A\uB3C4\uB85D \uACC1\uC5D0\uC11C \uCE7C\uB0A0\uC758 \uBC29\uD5A5\uC744
      \uC7A1\uC544\uC8FC\uC5C8\uACE0, \uADF8\uB140\uC758 \uC801\uB4E4\uC744 \uB300\uC2E0
      \uB9C9\uC544\uC130\uB2F5\uB2C8\uB2E4. \n\uADF8\uB294 \uADF8\uB140\uAC00 \uC790\uC720\uB97C
      \uC5BB\uB294 \uB300\uAC00\uB85C \uC804 \uAC00\uBB38\uC758 \uC6B4\uBA85\uC744
      \uBCBC\uB791 \uB05D\uC5D0 \uC62C\uB824\uB193\uACE0 \uC788\uB2E4\uB294 \uAC78
      \uC54C\uBA74\uC11C\uB3C4, \uADF8 \uD30C\uAD34\uC801\uC778 \uC5D0\uB108\uC9C0\uAC00
      \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C \uC9C0\uD0A4\uB294 \uD798\uC774 \uB418\uB3C4\uB85D
      \uB05D\uAE4C\uC9C0 \uBC84\uD168\uB0C8\uC5B4\uC694. \n\uB9C9\uC2A4\uB294 \uB9E4\uC77C
      \uBC24 \uC804\uC7C1\uD130 \uAC19\uC740 \uC77C\uC0C1\uC744 \uBCF4\uB0B4\uBA70
      \uD53C\uB85C\uC5D0 \uCC0C\uB4E0 \uC544\uBCA8\uB9AC\uC544\uC758 \uB4B7\uBAA8\uC2B5\uC744
      \uBCF4\uC558\uACE0, \uC790\uC2E0\uC774 \uC9C0\uD0A8 \uAC83\uC774 \uADF8\uB140\uC758
      \uC2E0\uB150\uC778\uC9C0 \uADF8\uB140 \uC790\uC2E0\uC778\uC9C0 \uBB3B\uACE0
      \uC2F6\uC5C8\uC9C0\uB9CC, \uADF8 \uC9C8\uBB38\uC870\uCC28 \uB2E4\uC815\uD55C
      \uCE68\uBB35\uC73C\uB85C \uB36E\uC5B4\uBC84\uB838\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
