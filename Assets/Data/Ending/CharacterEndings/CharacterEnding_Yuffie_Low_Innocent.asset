  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_Low_Innocent
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_low_innocent
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 3
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 1
  _text:
    _title: 
    _body: "\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uD640\uB85C \uAC10\uB2F9\uD558\uAE30
      \uD798\uB4E0 \uC0AC\uAD50\uACC4\uC758 \uB0A0 \uC120 \uC2DC\uC120\uB4E4\uC744
      \uCC28\uB2E8\uD574 \uC8FC\uBA70, \uAC00\uC7A5 \uB2E4\uC815\uD55C \uBAA9\uC18C\uB9AC\uB85C
      '\uBCF4\uD638'\uB97C \uC81C\uC548\uD588\uC2B5\uB2C8\uB2E4. \n\uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uD53C\uC758 \uC81C\uC548 \uC774\uBA74\uC5D0 \uC228\uACA8\uC9C4 \uD6C4\uC791\uAC00\uC758
      \uC57C\uC695\uC744 \uC804\uD600 \uB208\uCE58\uCC44\uC9C0 \uBABB\uD55C \uCC44,
      \uADF8\uB140\uB97C \uC720\uC77C\uD55C \uC548\uC2DD\uCC98\uB85C \uC5EC\uAE30\uAC8C
      \uB418\uC5C8\uB2F5\uB2C8\uB2E4. \n\uBC31\uC791\uC774 \uB41C \uC544\uBCA8\uB9AC\uC544\uB294
      \uC911\uC694\uD55C \uACB0\uC815\uC774 \uC788\uC744 \uB54C\uB9C8\uB2E4 \uC720\uD53C\uB97C
      \uCC3E\uC73C\uBA70, \uADF8\uB140\uC758 \uC870\uC5B8\uC774 \uACE7 \uC790\uC2E0\uC758
      \uC758\uC9C0\uB77C\uACE0 \uAD73\uAC8C \uBBFF\uACE0 \uC788\uC5B4\uC694. \n\uC720\uD53C\uB294
      \uC544\uBCA8\uB9AC\uC544\uC758 \uC190\uC744 \uAF2D \uC7A1\uACE0 \"\uB2F9\uC2E0\uC740
      \uC544\uBB34\uAC83\uB3C4 \uAC71\uC815\uD558\uC9C0 \uB9C8\uC138\uC694\"\uB77C\uACE0
      \uC18D\uC0AD\uC774\uC9C0\uB9CC, \uC0AC\uC2E4 \uC544\uBCA8\uB9AC\uC544\uB294
      \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB77C\uB294 \uC774\uB984\uC744 \uB85C\uC0AC\uBCA8\uC5D0
      \uD5CC\uB0A9\uD558\uB294 \uBB38\uC11C\uC5D0 \uAE30\uC058\uAC8C \uC11C\uBA85\uD558\uACE0
      \uC788\uC744 \uBFD0\uC785\uB2C8\uB2E4. \n\uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5
      \uC21C\uC218\uD55C \uBC31\uC791\uC740 \uADF8\uB807\uAC8C \uC720\uD53C\uAC00
      \uC815\uD574\uC900 \uB3D9\uD654 \uC18D \uC138\uC0C1\uC5D0\uC11C \uB208\uC774
      \uAC00\uB824\uC9C4 \uCC44 \uC0B4\uC544\uAC00\uAC8C \uB418\uC5C8\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
