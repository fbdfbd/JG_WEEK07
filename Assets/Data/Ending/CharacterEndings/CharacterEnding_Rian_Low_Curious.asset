  _maxMeetCount: 6
  _directionType: 3
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC774 \uAC00\uC838\uB2E4\uC8FC\uB294
      \uD669\uC2E4 \uBE44\uC804\uC758 \uACE0\uC11C\uB4E4\uACFC \uAE30\uC774\uD55C
      \uBCF4\uBB3C\uB4E4\uC5D0\uB9CC \uAD00\uC2EC\uC744 \uBCF4\uC77C \uBFD0, \uB9AC\uC548
      \uBCF8\uC778\uC5D0\uAC8C\uB294 \uD070 \uD765\uBBF8\uB97C \uB290\uB07C\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4.\n\uB9AC\uC548\uC740 \uADF8\uB140\uC758 \uAD00\uC2EC\uC744
      \uB04C\uAE30 \uC704\uD574 \uB354 \uC704\uD5D8\uD558\uACE0 \uB354 \uAE08\uAE30\uC2DC\uB41C
      \uBB3C\uAC74\uB4E4\uC744 \uD669\uC2E4 \uCC3D\uACE0\uC5D0\uC11C \uBE7C\uB3CC\uB824
      \uB0A0\uB790\uACE0, \uC774\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uAD11\uAE30\uC5D0
      \uBE60\uC838\uB4DC\uB294 \uC18D\uB3C4\uB97C \uB2A6\uCD94\uAE30\uB294\uCEE4\uB155
      \uC624\uD788\uB824 \uAC00\uC18D\uD654\uD558\uB294 \uACB0\uACFC\uAC00 \uB418\uC5C8\uB2F5\uB2C8\uB2E4.
      \n\uB9AC\uC548\uC740 \uADF8\uB140\uAC00 \uBCF4\uBB3C\uC5D0 \uCDE8\uD574 \uC6C3\uB294
      \uBAA8\uC2B5\uC744 \uBCF4\uBA70 \uB9CC\uC871\uD588\uC9C0\uB9CC, \uC815\uC791
      \uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC774 \uB204\uAD6C\uC778\uC9C0\uC870\uCC28
      \uC78A\uC5B4\uBC84\uB9B0 \uCC44 \uADF8\uAC00 \uAC00\uC838\uC628 '\uBBF8\uC2A4\uD130\uB9AC'\uC5D0\uB9CC
      \uC9D1\uCC29\uD558\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \n\uACB0\uAD6D \uC601\uC9C0\uB294
      \uC8FC\uC778\uC744 \uC783\uACE0 \uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uC758
      \uC218\uC9D1\uC695\uC744 \uCC44\uC6CC\uC8FC\uB294 \uC774\uB984 \uC5C6\uB294
      \uBCF4\uAE09\uAD00\uC73C\uB85C \uC804\uB77D\uD558\uC5EC, \uADF8\uB140\uAC00
      \uD30C\uBA78\uB85C \uAC00\uB294 \uAE38\uC5D0 \uAE30\uAEBC\uC774 \uAE08\uAE08\uC744
      \uAE54\uC544\uC8FC\uC5C8\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
