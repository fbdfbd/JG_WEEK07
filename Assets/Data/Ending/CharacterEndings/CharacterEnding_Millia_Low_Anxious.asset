  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_Low_Anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_low_anxious
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 2
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 5
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC00\uB9AC\uC544\uAC00 \uAC00\uC838\uC624\uB294
      \uBAA8\uB4E0 \uC815\uBCF4\uC640 \uBB3C\uAC74\uB4E4\uC774 \uC790\uC2E0\uC744
      \uD30C\uBA78\uC2DC\uD0A4\uB824\uB294 \uC74C\uBAA8\uB77C\uACE0 \uBBFF\uC73C\uBA70
      \uADF9\uC2EC\uD55C \uC758\uC2EC\uACFC \uBD88\uC548 \uC99D\uC138\uB97C \uBCF4\uC600\uC2B5\uB2C8\uB2E4.\n\uBC00\uB9AC\uC544\uB294
      \uCC98\uC74C\uC5D0\uB294 \uC544\uBCA8\uB9AC\uC544\uB97C \uB2EC\uB798\uB824
      \uD588\uC73C\uB098, \uC0AC\uC18C\uD55C \uC22B\uC790 \uC624\uCC28\uC5D0\uB3C4
      \uBC1C\uC791\uD558\uBA70 \uC790\uC2E0\uC744 \uBC30\uC2E0\uC790\uB85C \uBAA8\uB294
      \uC544\uBCA8\uB9AC\uC544\uC758 \uBAA8\uC2B5\uC5D0 \uC815\uC774 \uB5A8\uC5B4\uC838
      \uADF8\uB140\uB97C \uCCA0\uC800\uD788 \uC774\uC6A9\uD574\uBA39\uAE30\uB85C
      \uB9C8\uC74C\uBA39\uC5C8\uC9C0\uC694. \n\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uBD88\uC548\uC744 \uAD50\uBB18\uD558\uAC8C \uC790\uADF9\uD558\uC5EC \uC774
      \uC57D\uC744 \uBA39\uC9C0 \uC54A\uC73C\uBA74 \uBC24\uC5D0 \uC554\uC0B4\uC790\uAC00
      \uC62C \uAC70\uB77C\uAC70\uB098, \uC774 \uACC4\uC57D\uC11C\uC5D0 \uC11C\uBA85\uD558\uC9C0
      \uC54A\uC73C\uBA74 \uAC00\uBB38\uC774 \uB9DD\uD560 \uAC70\uB77C\uB294 \uAC00\uC9DC
      \uACF5\uD3EC\uB97C \uC2EC\uC5B4 \uC601\uC9C0\uC758 \uBAA8\uB4E0 \uC7AC\uC0B0\uC744
      \uAC08\uCDE8\uD588\uB2F5\uB2C8\uB2E4. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uC81C
      \uBC00\uB9AC\uC544\uAC00 \uB358\uC838\uC8FC\uB294 \uAC00\uC9DC \uC548\uC2EC\uC5D0
      \uB9E4\uB2EC\uB9AC\uB294 \uBE44\uCC38\uD55C \uCC98\uC9C0\uAC00 \uB418\uC5C8\uACE0,
      \uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uACF5\uD3EC\uB97C
      \uB3C8\uC73C\uB85C \uD658\uC0B0\uD558\uBA70 \uADF8\uB140\uC758 \uC601\uD63C\uC744
      \uC870\uAC01\uC870\uAC01 \uBD80\uC218\uC5B4\uBC84\uB838\uC9C0\uC694. \n\uC601\uC9C0\uB294
      \uC774\uC81C \uC8FC\uC778\uC758 \uAD11\uAE30\uC640 \uC0C1\uB2E8\uC758 \uCC29\uCDE8\uB85C
      \uC778\uD574 \uBE44\uBA85\uC774 \uB04A\uC774\uC9C0 \uC54A\uB294 \uC9C0\uC625\uC774
      \uB418\uC5C8\uC73C\uBA70, \uBC00\uB9AC\uC544\uB294 \uCC28\uAC00\uC6B4 \uB208\uC73C\uB85C
      \uBB34\uB108\uC838\uAC00\uB294 \uC544\uBCA8\uB9AC\uC544\uB97C \uAD00\uCC30\uD558\uBA70
      \uB9C8\uC9C0\uB9C9 \uB0A8\uC740 \uAE08\uD654 \uD55C \uB2E2\uAE4C\uC9C0 \uD138\uC5B4\uAC08
      \uC900\uBE44\uB97C \uD569\uB2C8\uB2E4. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC5B4\uB460
      \uC18D\uC5D0\uC11C \uBC00\uB9AC\uC544\uC758 \uD658\uC601\uC744 \uBCF4\uBA70
      \uBE44\uBA85\uC744 \uC9C0\uB974\uACE0, \uBC00\uB9AC\uC544\uB294 \uADF8 \uBE44\uBA85
      \uC18C\uB9AC\uB97C \uBC30\uACBD \uC0BC\uC544 \uAC00\uC7A5 \uD654\uB824\uD55C
      \uB4DC\uB808\uC2A4\uB97C \uC785\uACE0 \uC131\uC744 \uB098\uC12D\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
