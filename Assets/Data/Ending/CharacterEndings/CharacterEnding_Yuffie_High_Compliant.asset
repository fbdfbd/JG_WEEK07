  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_High_Compliant
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_high_compliant
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 3
  _minMeetCount: 7
  _maxMeetCount: -1
  _directionType: 7
  _text:
    _title: 
    _body: "\uC720\uD53C\uB294 \uC624\uB79C \uC2DC\uAC04 \uACF5\uC744 \uB4E4\uC5EC
      \uC544\uBCA8\uB9AC\uC544\uC758 \uC815\uC2E0\uC801\uC778 \uC9C0\uC8FC\uB97C
      \uC790\uCC98\uD558\uBA70, \uB85C\uC0AC\uBCA8 \uD6C4\uC791\uAC00\uC758 \uADF8\uB298\uB9CC\uC774
      \uC720\uC77C\uD55C \uC548\uC2DD\uCC98\uB77C\uACE0 \uC138\uB1CC\uD588\uC5B4\uC694.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uC81C \uC720\uD53C\uC758 \uBAA9\uC18C\uB9AC\uAC00
      \uC5C6\uC73C\uBA74 \uC624\uB298\uC758 \uB0A0\uC528\uC870\uCC28 \uC2A4\uC2A4\uB85C
      \uD310\uB2E8\uD558\uC9C0 \uBABB\uD560 \uC815\uB3C4\uB85C \uAE4A\uC740 \uC758\uC874
      \uC0C1\uD0DC\uC5D0 \uBE60\uC84C\uB2F5\uB2C8\uB2E4. \n\uC720\uD53C\uB294 \"\uC6B0\uB9AC\uB294
      \uD558\uB098\uC796\uC544\uC694\"\uB77C\uB294 \uB2EC\uCF64\uD55C \uB9D0\uB85C
      \uC544\uBCA8\uB9AC\uC544\uB97C \uAC10\uC2F8 \uC548\uC73C\uBA74\uC11C\uB3C4,
      \uADF8\uB140\uAC00 \uC678\uBD80\uC778\uACFC \uC811\uCD09\uD558\uB294 \uBAA8\uB4E0
      \uD1B5\uB85C\uB97C \uAD50\uBB18\uD558\uAC8C \uCC28\uB2E8\uD588\uC5B4\uC694.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uAC00\uBB38\uC758 \uC2E4\uAD8C\uC744 \uB118\uAE30\uB294
      \uACC4\uC57D\uC11C\uC5D0 \uC11C\uBA85\uD558\uBA74\uC11C\uB3C4, \uADF8\uAC83\uC774
      \uC790\uC2E0\uC744 \uC704\uD55C \uC720\uD53C\uC758 \uD5CC\uC2E0\uC801\uC778
      \uC0AC\uB791\uC774\uB77C\uACE0 \uAD73\uAC8C \uBBFF\uC73C\uBA70 \uBBF8\uC18C
      \uC9C0\uC5C8\uC9C0\uC694. \n\uC131\uC778\uC774 \uB41C \uC544\uBCA8\uB9AC\uC544\uC758
      \uACC1\uC5D0\uB294 \uB298 \uC720\uD53C\uAC00 \uADF8\uB9BC\uC790\uCC98\uB7FC
      \uBD99\uC5B4 \uC788\uC73C\uBA70, \uADF8\uB140\uC758 \uC785\uC744 \uB300\uC2E0\uD574
      \uC601\uC9C0\uC758 \uBAA8\uB4E0 \uB300\uC18C\uC0AC\uB97C \uACB0\uC815\uD558\uACE0
      \uC788\uB2F5\uB2C8\uB2E4. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC2A4\uC2A4\uB85C
      \uBB38\uC744 \uC7A0\uADFC \uC0C8\uC7A5 \uC548\uC5D0\uC11C \uC720\uD53C\uAC00
      \uC8FC\uB294 \uBA39\uC774\uB9CC\uC744 \uAE30\uB2E4\uB9AC\uB294, \uAC00\uC7A5
      \uC6B0\uC544\uD558\uACE0 \uC2AC\uD508 \uAF2D\uB450\uAC01\uC2DC \uBC31\uC791\uC774
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
