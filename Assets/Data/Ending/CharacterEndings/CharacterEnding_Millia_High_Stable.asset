  _maxMeetCount: -1
  _directionType: 4
  _text:
    _title: 
    _body: "\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uAC00\uC9C4
      \uB2E8\uB2E8\uD558\uACE0 \uD3C9\uC628\uD55C \uAE30\uC6B4\uC5D0 \uB3D9\uD654\uB418\uC5B4,
      \uD3C9\uC0DD\uC744 \uCAD3\uC544\uC654\uB358 \uACC4\uC0B0\uC801\uC778 \uC0B6\uC5D0\uC11C
      \uBC97\uC5B4\uB098 \uC544\uBCA8\uB9AC\uC544\uC758 \uACC1\uC5D0\uC11C \uC9C4\uC815\uD55C
      \uC548\uC2DD\uC744 \uCC3E\uAE30\uB85C \uACB0\uC2EC\uD588\uC2B5\uB2C8\uB2E4.
      \n\uADF8\uB140\uB294 \uC0C1\uB2E8\uC758 \uB9C9\uB300\uD55C \uC774\uC775\uBCF4\uB2E4\uB294
      \uC601\uC9C0\uC758 \uC9C0\uC18D \uAC00\uB2A5\uD55C \uBC88\uC601\uC744 \uC704\uD574
      \uC790\uBCF8\uC744 \uD22C\uC785\uD588\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8\uB7F0 \uBC00\uB9AC\uC544\uC758 \uD5CC\uC2E0\uC5D0 \uC601\uC9C0\uC758
      \uBC95\uC801 \uC9C0\uC704\uC640 \uAC00\uBB38\uC758 \uC774\uB984\uC744 \uC544\uB08C\uC5C6\uC774
      \uB098\uB204\uC5B4\uC8FC\uC5C8\uC9C0\uC694. \n\uC774\uC81C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC81C\uAD6D\uC5D0\uC11C \uAC00\uC7A5 \uD48D\uC694\uB86D\uACE0\uB3C4 \uD3C9\uD654\uB85C\uC6B4
      \uC548\uC2DD\uCC98\uAC00 \uB418\uC5C8\uC73C\uBA70, \uBC00\uB9AC\uC544\uB294
      \uC0C1\uC778\uC73C\uB85C\uC11C\uC758 \uC57C\uC695\uC744 \uB0B4\uB824\uB193\uACE0
      \uC544\uBCA8\uB9AC\uC544\uC758 \uC601\uC9C0\uB97C \uC81C\uAD6D\uC5D0\uC11C
      \uAC00\uC7A5 \uC0B4\uAE30 \uC88B\uC740 \uB545\uC73C\uB85C \uAC00\uAFB8\uB294
      \uB370 \uD3C9\uC0DD\uC744 \uBC14\uCE69\uB2C8\uB2E4.\n\uB450 \uC0AC\uB78C\uC758
      \uC2E0\uB8B0\uB294 \uADF8 \uC5B4\uB5A4 \uACC4\uC57D\uC11C\uBCF4\uB2E4\uB3C4
      \uB2E8\uB2E8\uD558\uAC8C \uBB36\uC5EC \uC788\uC73C\uBA70, \uC544\uBCA8\uB9AC\uC544\uAC00
      \uC81C\uACF5\uD558\uB294 \uC815\uC11C\uC801 \uC548\uC815\uAC10\uC740 \uBC00\uB9AC\uC544\uC758
      \uB0A0\uCE74\uB85C\uC6B4 \uC2E0\uACBD\uC744 \uBD80\uB4DC\uB7FD\uAC8C \uAC10\uC2F8
      \uC548\uC544\uC8FC\uC5C8\uB2F5\uB2C8\uB2E4. \n\uC601\uBBFC\uB4E4\uC740 \uC774\uC81C
      \uC790\uC560\uB85C\uC6B4 \uBC31\uC791\uACFC \uC720\uB2A5\uD55C \uC0C1\uB2E8\uC8FC\uAC00
      \uB9CC\uB4E4\uC5B4\uB0B8 \uCD95\uBCF5\uBC1B\uC740 \uC601\uC9C0\uC5D0\uC11C
      \uAC00\uC7A5 \uC544\uB984\uB2E4\uC6B4 \uC804\uC131\uAE30\uB97C \uB204\uB9AC\uACE0
      \uC788\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uB9E4\uC77C \uC544\uCE68
      \uD06C\uB808\uC774\uD504 \uBA38\uD2C0 \uC544\uB798\uC5D0\uC11C \uBC00\uB9AC\uC544\uAC00
      \uC9C1\uC811 \uC6B0\uB824\uB0B8 \uCC28\uB97C \uB9C8\uC2DC\uBA70, \uB450 \uC0AC\uB78C\uC774
      \uD568\uAED8 \uC77C\uAD88\uB0B8 \uD3C9\uC628\uD55C \uB300\uC9C0\uB97C \uB0B4\uB824\uB2E4\uBCF4\uBA70
      \uBBF8\uC18C \uC9D3\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
