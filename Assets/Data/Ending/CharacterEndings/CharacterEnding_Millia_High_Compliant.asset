  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_High_Compliant
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_high_compliant
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 2
  _minMeetCount: 7
  _maxMeetCount: -1
  _directionType: 7
  _text:
    _title: 
    _body: "\uBC00\uB9AC\uC544\uB294 \uC21C\uC751\uC801\uC778 \uC544\uBCA8\uB9AC\uC544\uB97C
      \uD5A5\uD55C \uAE4A\uC740 \uC560\uC815\uC744 \uBC14\uD0D5\uC73C\uB85C, \uADF8\uB140\uAC00
      \uC138\uC0C1\uC758 \uBE44\uB09C\uC744 \uBC1B\uC9C0 \uC54A\uB3C4\uB85D \uBAA8\uB4E0
      \uB354\uB7EC\uC6B4 \uACB0\uC815\uC744 \uC0C1\uB2E8\uC774 \uB300\uC2E0 \uB0B4\uB9AC\uB294
      \uAD6C\uC870\uB97C \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294
      \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C \uADF8\uC800 \uBE5B\uB098\uB294 \uC790\uB9AC\uC5D0
      \uC549\uC544 \uC788\uAE30\uB9CC \uD558\uBA74 \uB098\uBA38\uC9C0\uB294 \uC790\uC2E0\uC774
      \uB2E4 \uC54C\uC544\uC11C \uD558\uACA0\uB178\uB77C \uBD80\uB4DC\uB7FD\uAC8C
      \uC57D\uC18D\uD588\uC9C0\uC694. \n\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00
      \uC608\uBC95\uACFC \uC804\uD1B5\uC744 \uC9C0\uD0A4\uBA70 \uC6B0\uC544\uD558\uAC8C
      \uC874\uC7AC\uD560 \uC218 \uC788\uB3C4\uB85D \uC601\uC9C0\uC758 \uBAA8\uB4E0
      \uD589\uC815\uC801 \uBD80\uB2F4\uACFC \uBE44\uB09C\uC744 \uC0C1\uB2E8\uC73C\uB85C
      \uB04C\uC5B4\uC654\uC73C\uBA70, \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8\uB7F0
      \uBC00\uB9AC\uC544\uB97C \uC804\uC801\uC73C\uB85C \uC2E0\uB8B0\uD558\uBA70
      \uADF8\uB140\uAC00 \uB0B4\uBBF8\uB294 \uBAA8\uB4E0 \uBB38\uC11C\uC5D0 \uC870\uC6A9\uD788
      \uC11C\uBA85\uD588\uB2F5\uB2C8\uB2E4. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uBC00\uB9AC\uC544\uAC00
      \uB9CC\uB4E4\uC5B4\uC900 \uC644\uBCBD\uD55C \uC628\uC2E4 \uC18D\uC5D0\uC11C
      \uC81C\uAD6D\uC774 \uC0AC\uB791\uD558\uB294 \uBAA8\uBC94\uC801\uC778 \uBC31\uC791\uC73C\uB85C
      \uCE6D\uC1A1\uBC1B\uAC8C \uB418\uC5C8\uC9C0\uB9CC, \uADF8\uB140\uC758 \uBAA9\uC18C\uB9AC\uB294
      \uC0AC\uB77C\uC9C0\uACE0 \uC624\uC9C1 \uBC00\uB9AC\uC544\uC758 \uACC4\uC0B0\uB41C
      \uC758\uC9C0\uB9CC\uC774 \uC601\uC9C0\uB97C \uC9C0\uBC30\uD558\uAC8C \uB418\uC5C8\uC9C0\uC694.
      \n\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uB97C \uD5A5\uD55C \uBCF4\uD638\uBCF8\uB2A5\uC73C\uB85C
      \uADF8\uB140\uC758 \uC8FC\uB3C4\uC131\uC744 \uC644\uC804\uD788 \uAC70\uC138\uD588\uC73C\uBA70,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uC81C \uBC00\uB9AC\uC544\uC758 \uD5C8\uB77D
      \uC5C6\uC774\uB294 \uC790\uC2E0\uC758 \uAC10\uC815\uC870\uCC28 \uC608\uBC95\uC5D0
      \uB9DE\uB294\uC9C0 \uD655\uC778\uD574\uC57C \uD558\uB294 \uC9C0\uB3C5\uD55C
      \uC758\uC874 \uC0C1\uD0DC\uC5D0 \uBE60\uC84C\uC2B5\uB2C8\uB2E4.\n\uC601\uC9C0\uB294
      \uAC89\uBCF4\uAE30\uC5D0 \uD654\uB824\uD558\uACE0 \uC9C8\uC11C \uC815\uC5F0\uD558\uC9C0\uB9CC,
      \uADF8 \uC548\uC758 \uC8FC\uC778\uC740 \uBC00\uB9AC\uC544\uAC00 \uC5F0\uCD9C\uD55C
      \uC5F0\uADF9\uC758 \uC8FC\uC778\uACF5\uC73C\uB85C \uC804\uB77D\uD558\uC5EC
      \uD3C9\uC0DD\uD1A0\uB85D \uBC00\uB9AC\uC544\uC758 \uC190\uAE38\uC744 \uADF8\uB9AC\uC6CC\uD558\uBA70
      \uC0B4\uC544\uAC11\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
