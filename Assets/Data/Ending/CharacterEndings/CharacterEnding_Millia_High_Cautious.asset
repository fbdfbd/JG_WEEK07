  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_High_Cautious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_high_cautious
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 2
  _minMeetCount: 7
  _maxMeetCount: -1
  _directionType: 2
  _text:
    _title: 
    _body: "\uBC00\uB9AC\uC544\uB294 \uC218\uB144\uAC04 \uC544\uBCA8\uB9AC\uC544\uC758
      \uAE4C\uB2E4\uB85C\uC6B4 \uAC80\uC5F4\uC744 \uBAA8\uB450 \uD1B5\uACFC\uD55C
      \uB05D\uC5D0, \uB9C8\uCE68\uB0B4 \uBC31\uC791\uAC00\uC758 \uC720\uC77C\uD558\uACE0
      \uC808\uB300\uC801\uC778 \uACF5\uC2DD \uD30C\uD2B8\uB108 \uC790\uB9AC\uB97C
      \uAFF0\uCC3C\uC2B5\uB2C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294 \uC624\uC9C1
      \uBC00\uB9AC\uC544\uAC00 \uAC80\uC218\uD55C \uC815\uBCF4\uC640 \uBB3C\uAC74\uB9CC\uC744
      \uC2E0\uB8B0\uD588\uC73C\uBA70, \uB2E4\uB978 \uAC00\uBB38\uC774\uB098 \uC0C1\uB2E8\uC758
      \uC811\uADFC\uC740 \uCCA0\uC800\uD788 \uCC28\uB2E8\uD558\uB294 \uD3D0\uC1C4\uC801\uC778
      \uD1B5\uCE58\uB97C \uC774\uC5B4\uAC14\uC9C0\uC694. \n\uBC00\uB9AC\uC544\uAC00
      \uD655\uC778\uD55C \uAC83\uC774\uB77C\uBA74 \uB354 \uC774\uC0C1\uC758 \uBCF4\uACE0\uB294
      \uD544\uC694 \uC5C6\uB2E4\uBA70 \uB2E4\uB978 \uBCF4\uACE0\uAD00\uB4E4\uC744
      \uBB3C\uB7EC\uAC00\uAC8C \uD558\uB294 \uADF8\uB140\uC758 \uB2E8\uD638\uD568\uC740,
      \uACB0\uAD6D \uC601\uC9C0\uC758 \uC7AC\uC815 \uCCB4\uACC4\uB97C \uC0C1\uB2E8\uC5D0
      \uD1B5\uC9F8\uB85C \uB9E1\uAE30\uB294 \uC704\uD5D8\uD55C \uACB0\uACFC\uB97C
      \uCD08\uB798\uD588\uB2F5\uB2C8\uB2E4. \n\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uC2E0\uB8B0\uB97C \uBC29\uD328 \uC0BC\uC544 \uC601\uC9C0\uC758 \uBAA8\uB4E0
      \uC720\uD1B5\uB9DD\uC744 \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC73C\uB85C
      \uB2E8\uC77C\uD654\uD588\uACE0, \uC601\uBBFC\uB4E4\uC740 \uC0C1\uB2E8\uC774
      \uC815\uD55C \uAC00\uACA9\uB300\uB85C\uB9CC \uBB3C\uAC74\uC744 \uC0AC\uC57C
      \uD558\uB294 \uB3C5\uC810 \uC2DC\uC7A5\uC758 \uB178\uC608\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC790\uC2E0\uC774 \uAC00\uBB38\uC744 \uAC00\uC7A5
      \uC548\uC804\uD558\uAC8C \uC9C0\uD0A4\uACE0 \uC788\uB2E4\uACE0 \uBBFF\uACE0
      \uC788\uC9C0\uB9CC, \uC0AC\uC2E4 \uAC00\uBB38\uC740 \uBC00\uB9AC\uC544\uB77C\uB294
      \uAC70\uB300\uD55C \uC0C1\uC778\uC774 \uB9CC\uB4E0 \uC815\uAD50\uD55C \uADF8\uBB3C
      \uC18D\uC5D0 \uAC07\uD600\uBC84\uB9B0 \uC148\uC774\uC9C0\uC694. \n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uC601\uC9C0\uB294 \uAC89\uBCF4\uAE30\uC5D0\uB294 \uD3C9\uC628\uD558\uACE0
      \uC9C8\uC11C \uC815\uC5F0\uD558\uC9C0\uB9CC, \uADF8 \uC548\uC5D0\uC11C\uB294
      \uC624\uC9C1 \uBC00\uB9AC\uC544\uC758 \uC2B9\uC778 \uC5C6\uC774\uB294 \uC228\uC870\uCC28
      \uC274 \uC218 \uC5C6\uB294 \uC815\uC801\uB9CC\uC774 \uD750\uB974\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
