  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Max_High_Clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_high_clever
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 1
  _minMeetCount: 11
  _maxMeetCount: -1
  _directionType: 0
  _text:
    _title: 
    _body: "\uC601\uC9C0\uB97C \uAC70\uB300\uD55C \uAE30\uACC4 \uC7A5\uCE58\uCC98\uB7FC
      \uB3CC\uB9AC\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4
      \uACF3\uC5D0\uB294, \uADF8\uB140\uC758 \uBAA8\uB4E0 \uC218\uCE58\uB97C \uD568\uAED8
      \uAD00\uB9AC\uD558\uB294 \uB9C9\uC2A4\uAC00 \uC870\uC5B8\uC790\uB85C \uC790\uB9AC
      \uC7A1\uC558\uB2F5\uB2C8\uB2E4. \n\uADF8\uB294 \uBC31\uC791\uC774 \uC22B\uC790\uC5D0\uB9CC
      \uB9E4\uBAB0\uB418\uC5B4 \uC778\uAC04\uC758 \uB9C8\uC74C\uC744 \uC783\uC5B4\uBC84\uB9AC\uB294
      \uACFC\uC815\uC744 \uAC00\uC7A5 \uC801\uADF9\uC801\uC73C\uB85C \uB3C4\uC654\uACE0,
      \uADF8 \uB300\uAC00\uB85C \uC601\uC9C0\uC758 \uD575\uC2EC\uC801\uC778 \uC815\uBCF4\uC640
      \uC2E4\uAD8C\uC744 \uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC758 \uC190\uC544\uADC0\uC5D0
      \uB123\uC5C8\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uAC00 \uC11C\uB298\uD55C
      \uC774\uC131\uC73C\uB85C \uC601\uBBFC\uB4E4\uC744 \uC555\uBC15\uD560 \uB54C\uB9C8\uB2E4
      \uB9C9\uC2A4\uB294 \uADF8\uB140\uC758 \uB4A4\uD3B8\uC5D0\uC11C \uADF8 \uC794\uC778\uD55C
      \uD6A8\uC728\uC131\uC744 \uAC00\uC7A5 \uD569\uB9AC\uC801\uC778 \uC815\uC758\uB77C\uACE0
      \uD3EC\uC7A5\uD558\uBA70 \uADF8\uB140\uB97C \uACE0\uB9BD\uC2DC\uCF30\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uADF8\uB140\uAC00 \uB0B4\uB9AC\uB294 \uBAA8\uB4E0 \uACB0\uB2E8\uC774
      \uC624\uC9C1 \uC790\uC2E0\uB9CC\uC774 \uC774\uD574\uD560 \uC218 \uC788\uB294
      \uC644\uBCBD\uD55C \uD1B5\uCE58\uB77C\uACE0 \uCE6D\uC1A1\uD558\uBA70, \uADF8\uB140\uB97C
      \uC138\uC0C1\uC73C\uB85C\uBD80\uD130 \uB2E8\uC808\uB41C \uCC28\uAC00\uC6B4
      \uC655\uC88C\uC5D0 \uBB36\uC5B4\uB450\uC5C8\uC5B4\uC694. \n\uB9C9\uC2A4\uB294
      \uAC00\uB054 \uD145 \uBE48 \uD68C\uB791\uC744 \uD640\uB85C \uAC78\uC73C\uBA70
      \uC544\uBCA8\uB9AC\uC544\uAC00 \uC783\uC5B4\uBC84\uB9B0 \uC778\uAC04\uB2E4\uC6B4
      \uC628\uAE30\uB97C \uADF8\uB9AC\uC6CC\uD588\uC9C0\uB9CC, \uADF8 \uC0C1\uC2E4\uC774
      \uC790\uC2E0\uC758 \uCE58\uBC00\uD55C \uC720\uB3C4 \uB54C\uBB38\uC774\uB77C\uB294
      \uC0AC\uC2E4\uC744 \uB05D\uB05D\uB0B4 \uC678\uBA74\uD558\uBA70 \uC2A4\uC2A4\uB85C\uB97C
      \uAE30\uB9CC\uD588\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
