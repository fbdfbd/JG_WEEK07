  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_Low_Compliant
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_low_compliant
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 3
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 7
  _text:
    _title: 
    _body: "\uC720\uD53C\uB294 \uC0AC\uAD50\uACC4\uC758 \uBCF5\uC7A1\uD55C \uC608\uBC95\uC744
      \uBE4C\uBBF8\uB85C \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C \uB85C\uC0AC\uBCA8
      \uAC00\uBB38\uC774 \uC815\uD55C '\uBC31\uC791\uC758 \uBAA8\uBC94'\uC744 \uB530\uB97C
      \uAC83\uC744 \uC740\uADFC\uD788 \uAC15\uC694\uD588\uC5B4\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294
      \uC2A4\uC2A4\uB85C \uACB0\uC815\uC744 \uB0B4\uB9AC\uAE30\uBCF4\uB2E4 \uC720\uD53C\uAC00
      \uBBF8\uB9AC \uADF8\uB824\uB454 \uC644\uBCBD\uD55C \uC601\uC560\uC758 \uBAA8\uC2B5\uC5D0
      \uC790\uC2E0\uC744 \uB9DE\uCD94\uB294 \uAC83\uC774 \uAC00\uBB38\uC744 \uC9C0\uD0A4\uB294
      \uAC00\uC7A5 \uC548\uC804\uD55C \uAE38\uC774\uB77C\uACE0 \uBBFF\uAC8C \uB418\uC5C8\uC9C0\uC694.
      \n\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC2E4\uC218\uD560 \uB54C\uB9C8\uB2E4
      \"\uC5ED\uC2DC \uC81C\uAC00 \uC5C6\uC73C\uBA74 \uC548 \uB418\uACA0\uB124\uC694\"\uB77C\uBA70
      \uADF8\uB140\uC758 \uC790\uC874\uAC10\uC744 \uC11C\uC11C\uD788 \uAE4E\uC544\uB0B4\uB838\uACE0,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uCE5C\uC808\uD55C \uB3C5\uC124\uC744
      \uC870\uC5B8\uC774\uB77C \uC5EC\uAE30\uBA70 \uC21C\uC21C\uD788 \uBC1B\uC544\uB4E4\uC600\uB2F5\uB2C8\uB2E4.
      \n\uACB0\uACFC\uC801\uC73C\uB85C \uC544\uBCA8\uB9AC\uC544\uB294 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758
      \uBAA8\uB4E0 \uB300\uC678 \uC815\uCC45\uC744 \uB85C\uC0AC\uBCA8 \uD6C4\uC791\uAC00\uC5D0
      \uC2B9\uC778\uBC1B\uB294 \uC9C0\uACBD\uC5D0 \uC774\uB974\uB800\uC5B4\uC694.
      \n\uADF8\uB140\uB294 \uD654\uB824\uD55C \uB4DC\uB808\uC2A4\uB97C \uC785\uACE0
      \uC720\uD53C\uAC00 \uC368\uC900 \uC6D0\uACE0\uB97C \uC77D\uC73C\uBA70, \uC790\uC2E0\uC774
      \uC8FC\uCCB4\uC801\uC778 \uBC31\uC791\uC774\uB77C\uB294 \uCC29\uAC01 \uC18D\uC5D0
      \uC548\uC8FC\uD558\uAC8C \uB418\uC5C8\uB2F5\uB2C8\uB2E4. \n\uACB0\uAD6D \uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uC601\uC9C0\uB294 \uB85C\uC0AC\uBCA8 \uAC00\uBB38\uC758 \uCDA9\uC2E4\uD55C
      \uBD80\uC18D \uC601\uC9C0\uB85C\uC11C \uADF8 \uB3C5\uC790\uC131\uC744 \uC644\uC804\uD788
      \uC783\uC5B4\uBC84\uB9AC\uACE0 \uB9D0\uC558\uC5B4\uC694."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
