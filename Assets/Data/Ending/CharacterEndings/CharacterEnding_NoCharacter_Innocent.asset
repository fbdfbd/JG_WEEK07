  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_NoCharacter_Innocent
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_no_character_innocent
  _priority: 100
  _isNoCharacterEnding: 1
  _characterType: 1
  _minMeetCount: 0
  _maxMeetCount: 0
  _directionType: 1
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC81C\uAD6D\uC5D0\uC11C \uAC00\uC7A5
      \uC790\uBE44\uB86D\uACE0 \uBE44\uD604\uC2E4\uC801\uC778 \u2018\uB3D9\uD654
      \uC18D \uBC31\uC791\u2019\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \r\n\uADF8\uB140\uB294
      \uC138\uC0C1\uC758 \uBAA8\uB4E0 \uC545\uC758\uB97C \uBD80\uC815\uD558\uBA70
      \uC601\uC9C0\uB97C \uAC70\uB300\uD55C \uC815\uC6D0\uCC98\uB7FC \uC544\uB984\uB2F5\uAC8C
      \uAFB8\uBA84\uACE0, \uBC31\uC131\uB4E4\uC758 \uACE0\uD1B5\uC744 \uCC28\uB9C8
      \uC678\uBA74\uD558\uC9C0 \uBABB\uD574 \uBAA8\uB4E0 \uC138\uAE08\uC744 \uBA74\uC81C\uD558\uB294
      \uD30C\uACA9\uC801\uC778 \uC790\uBE44\uB97C \uBCA0\uD480\uC5C8\uC2B5\uB2C8\uB2E4.
      \r\n\uC601\uBBFC\uB4E4\uC740 \uCC98\uC74C\uC5D4 \uADF8\uB140\uB97C \uC131\uB140\uB77C
      \uCE6D\uC1A1\uD558\uBA70 \uAE30\uBED0\uD588\uC9C0\uB9CC, \uC815\uC791 \uC601\uC9C0\uC758
      \uCC3D\uACE0\uB294 \uC544\uBB34\uB7F0 \uB300\uCC45 \uC5C6\uC774 \uBE44\uC5B4\uB9CC
      \uAC14\uC2B5\uB2C8\uB2E4.\r\n\uC544\uBCA8\uB9AC\uC544\uB294 \uACC1\uC5D0\uC11C
      \uD604\uC2E4\uC801\uC778 \uC870\uC5B8\uC744 \uD574\uC904 \uC778\uC5F0\uC744
      \uB2E8 \uD55C \uBA85\uB3C4 \uB9CC\uB4E4\uC9C0 \uC54A\uC558\uAE30\uC5D0, \uC120\uC758\uAC00
      \uAC00\uC838\uC62C \uD30C\uBA78\uC744 \uC804\uD600 \uC608\uC0C1\uD558\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4.\r\n\uAD50\uD65C\uD55C \uC8FC\uBCC0 \uC601\uC8FC\uB4E4\uC740
      \uADF8\uB140\uC758 \uC21C\uC218\uD55C \uCE5C\uC808\uC744 \u2018\uC57D\uC810\u2019\uC73C\uB85C
      \uD30C\uC545\uD558\uACE0, \uBCF4\uD638\uB77C\uB294 \uBBF8\uBA85 \uD558\uC5D0
      \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758 \uC774\uAD8C\uC744 \uD558\uB098\uB458
      \uAC00\uC838\uAC00\uAE30 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4. \r\n\uADF8\uB140\uB294
      \uD654\uB824\uD55C \uC815\uC6D0 \uC548\uC5D0\uC11C \uC778\uD615\uCC98\uB7FC
      \uC6C3\uACE0 \uC788\uC9C0\uB9CC, \uC815\uC791 \uC131\uBCBD \uBC16\uC758 \uC601\uBBFC\uB4E4\uC740
      \uB2E4\uC74C \uB07C\uB2C8\uB97C \uAC71\uC815\uD558\uBA70 \uADF8\uB140\uC758
      \uB208\uBA3C \uC790\uBE44\uB97C \uC6D0\uB9DD\uD558\uACE0 \uC788\uB2F5\uB2C8\uB2E4.
      \r\n\uC544\uBB34\uB3C4 \uADF8\uB140\uC758 \uB208\uC744 \uAC00\uB9B0 \uAC00\uC9DC
      \uD3C9\uD654\uC758 \uB9C9\uC744 \uAC77\uC5B4\uC8FC\uC9C0 \uC54A\uC558\uAE30\uC5D0,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uC790\uC2E0\uC774 \uC0AC\uB791\uD558\uB294
      \uC601\uC9C0\uAC00 \uBB34\uB108\uC9C0\uB294 \uC21C\uAC04\uAE4C\uC9C0\uB3C4
      \uAC00\uC7A5 \uC544\uB984\uB2E4\uC6B4 \uAFC8\uC18D\uC5D0\uC11C \uD640\uB85C
      \uCDA4\uC744 \uCD94\uB294 \uACE0\uB3C5\uD55C \uAD70\uC8FC\uB85C \uB0A8\uAC8C
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
