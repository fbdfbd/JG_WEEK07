  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_NoCharacter_Stable
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_no_character_stable
  _priority: 100
  _isNoCharacterEnding: 1
  _characterType: 1
  _minMeetCount: 0
  _maxMeetCount: 0
  _directionType: 4
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uC5B4\uB5A4 \uD3ED\uD48D\uC5D0\uB3C4
      \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uBFCC\uB9AC \uAE4A\uC740 \uB098\uBB34
      \uAC19\uC740 \uBC31\uC791\uC774 \uB418\uC5C8\uC9C0\uB9CC, \uB3D9\uC2DC\uC5D0
      \uB204\uAD6C\uC758 \uC811\uADFC\uB3C4 \uD5C8\uC6A9\uD558\uC9C0 \uC54A\uB294
      '\uC815\uC9C0\uB41C \uD3C9\uD654\uC758 \uC218\uD638\uC790'\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \n\uADF8\uB140\uB294 \uACFC\uAC70\uC758 \uC0C1\uCC98\uC640 \uBBF8\uB798\uC758
      \uBD88\uC548\uC744 \uC2A4\uC2A4\uB85C \uC218\uC6A9\uD558\uC5EC \uC601\uC9C0
      \uC804\uCCB4\uC5D0 \uACE0\uC694\uD558\uACE0 \uB2E8\uB2E8\uD55C \uC9C8\uC11C\uB97C
      \uC815\uCC29\uC2DC\uCF30\uACE0, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294 \uC774\uC81C
      \uC81C\uAD6D\uC5D0\uC11C \uAC00\uC7A5 \uC0B4\uAE30 \uC88B\uACE0 \uD3C9\uC628\uD55C
      \uC548\uC2DD\uCC98\uB85C \uC18C\uBB38\uC774 \uB0AC\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294
      \uD654\uB824\uD55C \uC815\uBCF5\uC774\uB098 \uB9C9\uB300\uD55C \uBD80\uB97C
      \uCAD3\uC9C0\uB294 \uC54A\uC9C0\uB9CC, \uC601\uBBFC\uB4E4\uC758 \uB07C\uB2C8\uB97C
      \uCC59\uAE30\uACE0 \uAC00\uBB38\uC758 \uBFCC\uB9AC\uB97C \uC9C0\uD0A4\uB294
      \uC77C\uC5D0 \uD5CC\uC2E0\uD558\uBA70 \uC9C4\uC815\uD55C \uC874\uACBD\uC744
      \uD55C \uBAB8\uC5D0 \uBC1B\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uB204\uAD6C\uC640\uB3C4
      \uAE4A\uC740 \uAC10\uC815\uC744 \uB098\uB204\uC9C0 \uC54A\uACE0 \uC2A4\uC2A4\uB85C\uB97C
      \uB2E4\uC2A4\uB9AC\uB294 \uBC95\uB9CC\uC744 \uC775\uD614\uAE30\uC5D0, \uADF8\uB140\uAC00
      \uB9CC\uB4E0 \uD3C9\uD654\uB294 \uB108\uBB34\uB098 \uACAC\uACE0\uD574\uC11C
      \uC624\uD788\uB824 \uC0C8\uB85C\uC6B4 \uBCC0\uD654\uB098 \uC0DD\uB3D9\uAC10\uC774
      \uB07C\uC5B4\uB4E4 \uD2C8\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uADF8\uB140\uB294
      \uB9E4\uC77C \uC544\uCE68 \uD06C\uB808\uC774\uD504 \uBA38\uD2C0 \uC544\uB798\uC5D0\uC11C
      \uCC28\uB97C \uB9C8\uC2DC\uBA70 \uD3C9\uC628\uD558\uAC8C \uC601\uC9C0\uB97C
      \uB0B4\uB824\uB2E4\uBCF4\uC9C0\uB9CC, \uADF8 \uB208\uB3D9\uC790\uC5D0\uB294
      \uAE30\uC068\uB3C4 \uC2AC\uD514\uB3C4 \uC5C6\uB294 \uBB34\uAC70\uC6B4 \uD3C9\uC628\uB9CC\uC774
      \uAC10\uB3CC \uBFD0\uC785\uB2C8\uB2E4. \n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uADF8\uB140\uC758 \uC628\uD654\uD55C \uD488 \uC548\uC5D0\uC11C \uC804\uC131\uAE30\uB97C
      \uB204\uB9AC\uACE0 \uC788\uC73C\uB098, \uC544\uBCA8\uB9AC\uC544 \uBCF8\uC778\uC740
      \uC815\uC791 \uADF8 \uC5B4\uB5A4 \uC628\uAE30\uB3C4 \uB290\uB07C\uC9C0 \uBABB\uD55C
      \uCC44 \uC2A4\uC2A4\uB85C\uAC00 \uB9CC\uB4E0 \uD3C9\uC628\uC774\uB77C\uB294
      \uC774\uB984\uC758 \uC694\uC0C8 \uC548\uC5D0\uC11C \uCC9C\uCC9C\uD788 \uAD73\uC5B4\uAC00\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. \n\uC601\uC9C0\uB294 \uD3C9\uD654\uB86D\uC9C0\uB9CC,
      \uADF8 \uD3C9\uD654\uAC00 \uB108\uBB34\uB098 \uC644\uBCBD\uD574\uC11C \uB9C8\uCE58
      \uC2DC\uAC04\uC774 \uBA48\uCDB0\uBC84\uB9B0 \uBC15\uC81C\uB41C \uD48D\uACBD\uCC98\uB7FC
      \uB290\uAEF4\uC9C0\uAE30\uB3C4 \uD55C\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
