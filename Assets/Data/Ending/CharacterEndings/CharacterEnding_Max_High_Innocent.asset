  _maxMeetCount: -1
  _directionType: 1
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uD145 \uBE44\uC5B4\uBC84\uB9B0 \uCC3D\uACE0\uB97C
      \uC678\uBA74\uD558\uBA70 \uC778\uD615\uCC98\uB7FC \uC6C3\uACE0 \uC788\uC744
      \uB54C, \uADF8\uB140\uC758 \uACC1\uC744 \uAC00\uC7A5 \uB2E4\uC815\uD558\uAC8C
      \uC9C0\uD0A8 \uAC83\uC740 \uBC14\uB85C \uB9C9\uC2A4\uC600\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uBC31\uC791\uC758 \uAC00\uC7A5 \uC2E0\uB8B0\uBC1B\uB294 \uD638\uC704\uC774\uC790
      \uC870\uC5B8\uC790\uAC00 \uB418\uC5B4, \uADF8\uB140\uAC00 \uC131\uBCBD \uBC16\uC758
      \uBE44\uCC38\uD55C \uD604\uC2E4\uC744 \uC601\uC601 \uBCF4\uC9C0 \uBABB\uD558\uB3C4\uB85D
      \uAC70\uB300\uD55C \uB3D9\uD654 \uC18D \uC131\uC744 \uC644\uBCBD\uD558\uAC8C
      \uC644\uC131\uD574 \uC8FC\uC5C8\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uAC00
      \uC21C\uC218\uD55C \uC790\uBE44\uB97C \uBCA0\uD478\uB290\uB77C \uAC00\uBB38\uC758
      \uBAA8\uB4E0 \uAD8C\uD55C\uC744 \uC0C1\uC2E4\uD558\uB294 \uB3D9\uC548, \uB9C9\uC2A4\uB294
      \uADF8 \uBAA8\uB4E0 \uACB0\uC815\uC774 \uC544\uB984\uB2E4\uC6B4 \uD1B5\uCE58\uB77C\uBA70
      \uADF8\uB140\uB97C \uCC2C\uC591\uD558\uACE0 \uB4A4\uD3B8\uC5D0\uC11C \uC2E4\uAD8C\uC744
      \uCC28\uADFC\uCC28\uADFC \uCC59\uACBC\uB2F5\uB2C8\uB2E4. \n\uADF8\uB294 \uADF8\uB140\uC758
      \uC190\uC744 \uC7A1\uACE0 \uC815\uC6D0\uC744 \uAC70\uB2D0\uBA70 \uC774\uAC83\uC774
      \uADF8\uB140\uB97C \uC704\uD55C \uC720\uC77C\uD55C \uC548\uC2DD\uCC98\uB77C\uACE0
      \uC18D\uC0AD\uC600\uC9C0\uB9CC, \uC0AC\uC2E4\uC740 \uADF8\uB140\uB97C \uAC00\uBB38\uC758
      \uC774\uC775\uC744 \uC704\uD55C \uD654\uB824\uD55C \uC7A5\uC2DD\uD488\uC73C\uB85C
      \uB9CC\uB4E4\uC5B4\uAC00\uACE0 \uC788\uC5C8\uC5B4\uC694. \n\uB9C9\uC2A4\uB294
      \uB9E4\uC77C \uBC24 \uC7A0\uB4E0 \uADF8\uB140\uC758 \uD3C9\uC628\uD55C \uC5BC\uAD74\uC744
      \uBCF4\uBA70 \uC790\uC2E0\uC774 \uC9C0\uD0A8 \uAC83\uC774 \uADF8\uB140\uC758
      \uBBF8\uC18C\uC778\uC9C0, \uC544\uB2C8\uBA74 \uBC1C\uD14C\uB9AC\uC628\uC758
      \uD0D0\uC695\uC778\uC9C0 \uBD84\uAC04\uD558\uC9C0 \uBABB\uD55C \uCC44 \uC790\uC2E0\uC758
      \uC8C4\uCC45\uAC10\uC744 \uB2E4\uC815\uD568\uC73C\uB85C \uB36E\uC5B4\uBC84\uB838\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
