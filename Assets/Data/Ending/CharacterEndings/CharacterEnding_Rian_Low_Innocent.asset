  _maxMeetCount: 6
  _directionType: 1
  _text:
    _title: 
    _body: "\uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uB97C \uC138\uC0C1\uC758
      \uD48D\uD30C\uB85C\uBD80\uD130 \uC9C0\uCF1C\uC8FC\uACE0 \uC2F6\uC5B4 \uD588\uC9C0\uB9CC,
      \uADF8\uC640\uC758 \uB9CC\uB0A8\uC774 \uC801\uC5C8\uB358 \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8\uC800 \uADF8\uB97C '\uAC00\uB054 \uCC3E\uC544\uC624\uB294 \uCE5C\uC808\uD55C
      \uD669\uC790\uB2D8'\uC73C\uB85C\uB9CC \uAE30\uC5B5\uD569\uB2C8\uB2E4. \r\n\uB9AC\uC548\uC740
      \uADF8\uB140\uAC00 \uC601\uC9C0\uC758 \uC2E4\uC9C8\uC801\uC778 \uACE0\uD1B5\uC744
      \uC678\uBA74\uD558\uACE0 \uAF43\uBC2D\uC744 \uAC00\uAFB8\uB294 \uB3D9\uC548,
      \uD669\uC2E4\uC758 \uC774\uB984\uC744 \uBE4C\uB824 \uC8FC\uBCC0 \uC601\uC8FC\uB4E4\uC758
      \uC555\uBC15\uC744 \uB300\uC2E0 \uB9C9\uC544\uC8FC\uB294 \uCD5C\uC18C\uD55C\uC758
      \uBC29\uD328\uAC00 \uB418\uC5B4 \uC8FC\uC5C8\uB2F5\uB2C8\uB2E4. \r\n\uB355\uBD84\uC5D0
      \uC544\uBCA8\uB9AC\uC544\uB294 \uC601\uC9C0\uAC00 \uBB34\uB108\uC838\uAC00\uB294
      \uC904\uB3C4 \uBAA8\uB974\uACE0 \uB9AC\uC548\uC774 \uBCF4\uB0B4\uC900 \uC544\uB984\uB2E4\uC6B4
      \uC120\uBB3C\uB4E4\uC5D0 \uD30C\uBB3B\uD600 \uC601\uC6D0\uD788 \uC544\uC774
      \uAC19\uC740 \uBBF8\uC18C\uB97C \uC9D3\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uACB0\uAD6D \uADF8\uB140\uB294 \uB9AC\uC548\uC774\uB77C\uB294 \uC874\uC7AC
      \uB355\uBD84\uC5D0 \uC138\uC0C1\uC758 \uC545\uC758\uB97C \uC601\uC6D0\uD788
      \uAE68\uB2EB\uC9C0 \uBABB\uD55C \uCC44, \uAC00\uC7A5 \uD589\uBCF5\uD558\uACE0\uB3C4
      \uBB34\uB2A5\uD55C \uAD70\uC8FC\uB85C \uB0A8\uAC8C \uB418\uC5C8\uC9C0\uC694.
      \r\n\uADF8\uB140\uC5D0\uAC8C \uB9AC\uC548\uC740 \uAD6C\uC6D0\uC774\uC5C8\uC744\uAE4C\uC694,
      \uC544\uB2C8\uBA74 \uC9C4\uC2E4\uC744 \uAC00\uB9B0 \uC7A5\uB9C9\uC774\uC5C8\uC744\uAE4C\uC694?"
    _summary: 
    _closingLine: 
