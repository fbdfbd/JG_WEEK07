  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_NoCharacter_Cautious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_no_character_cautious
  _priority: 100
  _isNoCharacterEnding: 1
  _characterType: 1
  _minMeetCount: 0
  _maxMeetCount: 0
  _directionType: 2
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC644\uBCBD\uD55C \uBCF4\uC548\uACFC
      \uC548\uC804\uC5D0 \uC9D1\uCC29\uD558\uB294, \uC81C\uAD6D\uC5D0\uC11C \uAC00\uC7A5
      \uCCA0\uC800\uD55C \u2018\uC694\uC0C8\uC758 \uC9C0\uBC30\uC790\u2019\uAC00
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uC7A0\uC7AC\uC801\uC778
      \uBAA8\uB4E0 \uC704\uD611\uC744 \uC0AC\uC804\uC5D0 \uCC28\uB2E8\uD55C\uB2E4\uB294
      \uC774\uC720\uB85C \uC601\uC9C0\uC758 \uBAA8\uB4E0 \uC131\uBB38\uC744 \uB2EB\uC544\uAC78\uC5C8\uC73C\uBA70,
      \uC678\uBD80\uC778\uC740 \uBB3C\uB860 \uC601\uBBFC\uB4E4\uC870\uCC28 \uBC31\uC791\uC758
      \uC5BC\uAD74\uC744 \uBCF8 \uC9C0\uAC00 \uC218\uB144\uC774 \uC9C0\uB0AC\uC744
      \uC815\uB3C4\uB85C \uCCA0\uC800\uD788 \uC740\uB454 \uC911\uC785\uB2C8\uB2E4.
      \n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294 \uC81C\uAD6D\uC5D0\uC11C \uAC00\uC7A5
      \uBC94\uC8C4 \uC5C6\uB294 \uC548\uC804\uD55C \uC601\uC9C0\uAC00 \uB418\uC5C8\uC9C0\uB9CC,
      \uB3D9\uC2DC\uC5D0 \uB204\uAD6C\uB3C4 \uC0C8\uB85C \uB4E4\uC5B4\uC624\uC9C0
      \uC54A\uB294 \uC815\uCCB4\uB41C \uC8FD\uC74C\uC758 \uB545\uC73C\uB85C \uC11C\uC11C\uD788
      \uBCC0\uD574\uAC00\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uB204\uAD6C\uC640\uB3C4
      \uB9CC\uB0A8\uC744 \uAC16\uC9C0 \uC54A\uACE0 \uC2A4\uC2A4\uB85C\uB97C \uBCF4\uD638\uD558\uB294
      \uBC95\uB9CC\uC744 \uC775\uD614\uAE30\uC5D0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uD0C0\uC778\uC744 \uC2E0\uB8B0\uD558\uB294 \uBC95\uC744 \uC78A\uC5B4\uBC84\uB9B0
      \uCC44 \uC2A4\uC2A4\uB85C\uAC00 \uB9CC\uB4E0 \uAC70\uB300\uD55C \uAC10\uC625
      \uC548\uC5D0 \uAC07\uD600\uBC84\uB838\uC2B5\uB2C8\uB2E4.\r\n\uADF8\uB140\uB294
      \uB9E4\uC77C \uBC24 \uC131\uC758 \uBAA8\uB4E0 \uBB38\uACE0\uB9AC\uB97C \uC9C1\uC811
      \uD655\uC778\uD558\uACE0 \uD558\uC778\uB4E4\uC758 \uC791\uC740 \uC6C0\uC9C1\uC784\uC870\uCC28
      \uC758\uC2EC\uD558\uBA70 \uACE0\uB3C5 \uC18D\uC5D0\uC11C \uB5A8\uACE0 \uC788\uC73C\uBA70,
      \uC790\uC2E0\uC774 \uB0B4\uB9AC\uB294 \uACB0\uC815\uC774 \uAC00\uBB38\uC5D0
      \uD30C\uBA78\uC744 \uAC00\uC838\uC62C\uAE4C \uB450\uB824\uC6CC \uACB0\uB2E8\uC744
      \uBBF8\uB8E8\uAE30\uB9CC \uD569\uB2C8\uB2E4. \n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC774\uC81C \uC8FC\uC778\uC758 \uC9C0\uB098\uCE5C \uC2E0\uC911\uD568\uC5D0
      \uC804\uC5FC\uB418\uC5B4 \uC0DD\uB3D9\uAC10\uC744 \uC783\uACE0 \uC815\uB9C9\uB9CC\uC774
      \uAC10\uB3CC\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \n\uC544\uBCA8\uB9AC\uC544\uB294
      \uAC00\uC7A5 \uC548\uC804\uD55C \uACF3\uC5D0\uC11C \uAC00\uC7A5 \uC644\uBCBD\uD55C
      \uBC29\uC5B4\uB97C \uD574\uB0C8\uC9C0\uB9CC, \uACB0\uAD6D \uC544\uBB34\uB3C4
      \uB2FF\uC9C0 \uBABB\uD558\uB294 \uC131\uBCBD \uAE4A\uC740 \uACF3\uC5D0\uC11C
      \uD640\uB85C \uB299\uC5B4\uAC00\uB294 \uAC00\uC7A5 \uC678\uB86D\uACE0 \uC548\uC804\uD55C
      \uAD70\uC8FC\uAC00 \uB418\uACE0 \uB9D0\uC558\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
