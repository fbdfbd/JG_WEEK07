  _minMeetCount: 1
  _maxMeetCount: 10
  _directionType: 2
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uAC00\uBB38\uC744 \uAC70\uB300\uD55C
      \uAC10\uC625\uC73C\uB85C \uB9CC\uB4E4\uACE0 \uC544\uBB34\uB3C4 \uBBFF\uC9C0
      \uBABB\uD558\uB294 \uACE0\uB3C5 \uC18D\uC5D0 \uC740\uB454\uD560 \uB54C, \uB9C9\uC2A4\uB294
      \uC694\uC0C8\uC758 \uAD73\uAC8C \uB2EB\uD78C \uBB38 \uBC16\uC5D0\uC11C \uAC00\uC7A5
      \uC815\uC911\uD55C \uBD09\uC2E0\uC758 \uC790\uB9AC\uB97C \uC9C0\uD0A4\uBA70
      \uAE30\uB2E4\uB838\uB2F5\uB2C8\uB2E4. \n\uADF8\uB294 \uADF8\uB140\uC758 \uCCA0\uC800\uD55C
      \uBCF4\uC548\uB9DD\uC744 \uB6AB\uACE0 \uAC00\uBB38\uC758 \uBAA9\uC801\uC744
      \uB2EC\uC131\uD558\uC9C0\uB294 \uBABB\uD588\uC9C0\uB9CC, \uBA70\uCE60\uC5D0
      \uD55C \uBC88\uC529 \uBB38\uD2C8\uC73C\uB85C \uC548\uBD80\uB97C \uBB3B\uB294
      \uC720\uC77C\uD558\uAC8C \uD5C8\uB77D\uB41C \uBAA9\uC18C\uB9AC\uB85C \uB0A8\uC558\uC5B4\uC694.
      \n\uC544\uBCA8\uB9AC\uC544\uAC00 \uBAA8\uB4E0 \uC704\uD611\uC744 \uCC28\uB2E8\uD55C\uB2E4\uB294
      \uBA85\uBD84\uC73C\uB85C \uC601\uC9C0\uB97C \uC815\uCCB4\uB41C \uC8FD\uC74C\uC758
      \uB545\uC73C\uB85C \uB9CC\uB4E4 \uB54C, \uB9C9\uC2A4\uB294 \uADF8\uB140\uC758
      \uBD88\uC548\uC744 \uC790\uADF9\uD574 \uB354 \uACAC\uACE0\uD55C \uC7A5\uBCBD\uC744
      \uC313\uAC8C \uD568\uC73C\uB85C\uC368 \uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC774
      \uC601\uC9C0 \uC678\uBD80\uC758 \uAC70\uB798\uB97C \uB3C5\uC810\uD558\uB3C4\uB85D
      \uC720\uB3C4\uD588\uB2F5\uB2C8\uB2E4. \n\uADF8\uB294 \uADF8\uB140\uAC00 \uBBFF\uC744
      \uC218 \uC788\uB294 \uC720\uC77C\uD55C \uC678\uBD80\uC778\uC774 \uB418\uAE30
      \uC704\uD574 \uBD80\uB4DC\uB7EC\uC6B4 \uC870\uC5B8\uC744 \uC544\uB07C\uC9C0
      \uC54A\uC558\uC9C0\uB9CC, \uACB0\uCF54 \uADF8\uB140\uC758 \uC740\uC2E0\uCC98
      \uC548\uC73C\uB85C\uB294 \uCD08\uB300\uBC1B\uC9C0 \uBABB\uD588\uC5B4\uC694.
      \n\uB9C9\uC2A4\uB294 \uBC24\uB9C8\uB2E4 \uAD73\uAC8C \uC7A0\uAE34 \uC131\uBB38\uC744
      \uBC14\uB77C\uBCF4\uBA70 \uADF8\uB140\uAC00 \uC790\uC2E0\uC870\uCC28 \uBBFF\uC9C0
      \uBABB\uD558\uAC8C \uB41C \uAC83\uC774 \uC790\uC2E0\uC758 \uACC4\uC0B0\uB41C
      \uCE5C\uC808 \uB54C\uBB38\uC774\uB77C\uB294 \uAC83\uC744 \uC54C\uACE0 \uC788\uC5C8\uC9C0\uB9CC,
      \uADF8\uAC83\uC774 \uAC00\uBB38\uC744 \uC9C0\uD0A4\uB294 \uBC29\uC2DD\uC774\uB77C\uBA70
      \uC560\uC368 \uC9C4\uC2EC\uC744 \uC678\uBA74\uD588\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
