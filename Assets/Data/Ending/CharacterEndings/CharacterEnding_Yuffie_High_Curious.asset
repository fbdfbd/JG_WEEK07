  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_High_Curious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_high_curious
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 3
  _minMeetCount: 7
  _maxMeetCount: -1
  _directionType: 3
  _text:
    _title: 
    _body: "\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uD0D0\uAD6C\uC695\uC744
      \uC774\uC6A9\uD574 \uADF8\uB140\uB97C \uC601\uC9C0\uC758 \uC2E4\uBB34\uC5D0\uC11C
      \uC644\uC804\uD788 \uBC30\uC81C\uD558\uACE0, \uC624\uC9C1 \uB85C\uC0AC\uBCA8\uC774
      \uD5C8\uB77D\uD55C '\uAE08\uAE30'\uC5D0\uB9CC \uBAB0\uB450\uD558\uAC8C \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uAC00 \uC81C\uACF5\uD558\uB294
      \uACE0\uB300 \uC720\uBB3C\uACFC \uAE30\uAD34\uD55C \uC5F0\uAD6C\uB4E4\uC5D0
      \uC601\uD63C\uC744 \uBE7C\uC557\uACBC\uC73C\uBA70, \uADF8 \uBAA8\uB4E0 \uC9C0\uC6D0\uC744
      \uC544\uB07C\uC9C0 \uC54A\uB294 \uC720\uD53C\uB97C \uC790\uC2E0\uC758 \uC9C4\uC815\uD55C
      \uC601\uD63C\uC758 \uB2E8\uC9DD\uC73C\uB85C \uCD94\uC559\uD558\uAE30 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4.
      \n\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uAE30\uD589\uC774 \uC2EC\uD574\uC9C8\uC218\uB85D
      \uC0AC\uAD50\uACC4\uC5D0 \uADF8\uB140\uC758 '\uBD88\uC548\uC815\uD568'\uC744
      \uD37C\uB728\uB9AC\uBA70, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C \uB85C\uC0AC\uBCA8\uC774
      \uB300\uB9AC \uD1B5\uCE58\uD574\uC57C \uD55C\uB2E4\uB294 \uC815\uB2F9\uC131\uC744
      \uCC28\uADFC\uCC28\uADFC \uC313\uC544\uB098\uAC14\uC9C0\uC694.\n\uC774\uC81C
      \uBC31\uC791\uC774 \uB41C \uC544\uBCA8\uB9AC\uC544\uB294 \uC131\uC548\uC5D0
      \uD2C0\uC5B4\uBC15\uD600 \uC720\uD53C\uAC00 \uB358\uC838\uC900 \uC218\uC218\uAED8\uB07C\uB97C
      \uD478\uB294 \uB370 \uC9D1\uCC29\uD558\uBA70, \uC790\uC2E0\uC774 \uAC00\uBB38\uC744
      \uD314\uC544\uB118\uAE30\uB294 \uACC4\uC57D\uC11C\uC5D0 \uC11C\uBA85\uD558\uACE0
      \uC788\uB2E4\uB294 \uC0AC\uC2E4\uC870\uCC28 \uC78A\uC5B4\uBC84\uB838\uC2B5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uAC00 \uBC1C\uACAC\uD55C \uAC00\uC7A5 \uC704\uB300\uD55C
      \uBE44\uBC00\uC740 \uC0AC\uC2E4 \uC720\uD53C\uAC00 \uADF8\uB140\uB97C \uC5B4\uB5BB\uAC8C
      \uD30C\uBA78\uC2DC\uD0A4\uACE0 \uC788\uB294\uAC00\uC5D0 \uB300\uD55C \uC124\uACC4\uB3C4\uC600\uC73C\uB098,
      \uADF8\uB140\uB294 \uADF8\uB9C8\uC800\uB3C4 \uD558\uB098\uC758 \uD765\uBBF8\uB85C\uC6B4
      \uD604\uC0C1\uC73C\uB85C \uC5EC\uAE30\uBA70 \uC6C3\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
