  _maxMeetCount: 6
  _directionType: 1
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC138\uC0C1\uC758 \uBAA8\uB4E0 \uC545\uC758\uB97C
      \uBD80\uC815\uD558\uBA70 \uD654\uB824\uD55C \uAC00\uC9DC \uD3C9\uD654 \uC18D\uC5D0
      \uBA38\uBB3C \uB54C, \uB9C9\uC2A4\uB294 \uADF8 \uD658\uC0C1\uC744 \uAE68\uB728\uB9AC\uC9C0
      \uC54A\uC744 \uB9CC\uD07C\uC758 \uAC70\uB9AC\uB97C \uC720\uC9C0\uD558\uBA70
      \uBA40\uCC0D\uC774 \uC790\uB9AC\uB97C \uC7A1\uC558\uB2F5\uB2C8\uB2E4. \n\uADF8\uB294
      \uAC00\uBB38\uC758 \uB73B\uC5D0 \uB530\uB77C \uADF8\uB140\uC758 \uB208\uC744
      \uAC00\uB9AC\uACE0 \uC2E4\uAD8C\uC744 \uC557\uC544\uC624\uB824 \uD588\uC9C0\uB9CC,
      \uACB0\uAD6D \uC21C\uC218\uD558\uAC8C \uC6C3\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uBBF8\uC18C \uC55E\uC5D0\uC11C \uBC88\uBC88\uC774 \uC81C\uC548\uC744 \uB9DD\uC124\uC600\uC5B4\uC694.
      \n\uB9C9\uC2A4\uB294 \uAC00\uBB38\uC758 \uC774\uC775\uC744 \uC644\uC804\uD788
      \uD3EC\uAE30\uD558\uC9C0 \uC54A\uC740 \uCC44 \uADF8\uB140\uC758 \uC815\uC6D0\uC744
      \uAD00\uB9AC\uD574 \uC8FC\uB294 \uB2E4\uC815\uD55C \uBD09\uC2E0\uC758 \uAC00\uBA74\uC744
      \uC4F0\uACE0 \uACC4\uC18D \uACC1\uC744 \uB9F4\uB3CC\uC558\uB2F5\uB2C8\uB2E4.
      \n\uBC31\uC791\uAC00\uAC00 \uC8FC\uBCC0 \uC601\uC8FC\uB4E4\uC5D0\uAC8C \uC774\uAD8C\uC744
      \uB72F\uAE30\uB294 \uC640\uC911\uC5D0\uB3C4 \uB9C9\uC2A4\uB294 \uADF8\uB140\uC758
      \uD654\uB2E8\uC5D0 \uBB3C\uC744 \uC8FC\uBA70 \uADF8\uAC83\uC774 \uAC00\uC7A5
      \uC548\uC804\uD55C \uBCF4\uD638\uB77C\uACE0 \uC2A4\uC2A4\uB85C\uB97C \uC18D\uC600\uC5B4\uC694.\n\uD558\uC9C0\uB9CC
      \uAC00\uB054 \uD640\uB85C \uB0A8\uACA8\uC9C4 \uC815\uC6D0\uC5D0\uC11C \uC2DC\uB4E4\uC5B4\uAC00\uB294
      \uAF43\uB4E4\uC744 \uBCF4\uBA70, \uADF8\uB294 \uC790\uC2E0\uC774 \uADF8\uB140\uC5D0\uAC8C
      \uAC74\uB138\uB358 \uC548\uC2EC\uC774\uB77C\uB294 \uB9D0\uB4E4\uC774 \uC0AC\uC2E4\uC740
      \uAC00\uC7A5 \uC794\uC778\uD55C \uC678\uBA74\uC774\uC5C8\uB2E4\uB294 \uC0AC\uC2E4\uC5D0
      \uAC00\uC2B4 \uD55C\uAD6C\uC11D\uC774 \uC11C\uB298\uD574\uC9C0\uACE4 \uD588\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
