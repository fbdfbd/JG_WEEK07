  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_NoCharacter_Compliant
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_no_character_compliant
  _priority: 100
  _isNoCharacterEnding: 1
  _characterType: 1
  _minMeetCount: 0
  _maxMeetCount: 0
  _directionType: 7
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC81C\uAD6D \uADC0\uC871 \uC0AC\uD68C\uC758
      \uC608\uBC95\uACFC \uAD00\uC2B5\uC744 \uC644\uBCBD\uD558\uAC8C \uCCB4\uD654\uD55C,
      \uC5ED\uC0AC\uC0C1 \uAC00\uC7A5 '\uBAA8\uBC94\uC801\uC778 \uAF2D\uB450\uAC01\uC2DC*\uAC00
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uD669\uC2E4\uACFC \uC911\uC559
      \uADC0\uC871\uB4E4\uC774 \uC694\uAD6C\uD558\uB294 \uBAA8\uB4E0 \uC758\uBB34\uB97C
      \uAD70\uB9D0 \uC5C6\uC774 \uC218\uD589\uD558\uBA70 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758
      \uC774\uB984\uC744 \uC0AC\uAD50\uACC4\uC758 \uC815\uC810\uC5D0 \uC62C\uB824\uB193\uC558\uC2B5\uB2C8\uB2E4.
      \n\uD558\uC9C0\uB9CC \uD654\uB824\uD55C \uBA85\uC131\uACFC \uB2EC\uB9AC, \uC601\uC9C0\uC758
      \uC2E4\uAD8C\uC740 \uC774\uBBF8 \uADF8\uB140\uC758 \uC21C\uC751\uC801\uC778
      \uD0DC\uB3C4\uB97C \uC774\uC6A9\uD55C \uC678\uC138\uC758 \uC190\uC5D0 \uB118\uC5B4\uAC04
      \uC9C0 \uC624\uB798\uC785\uB2C8\uB2E4.\r\n\uC131\uC7A5 \uACFC\uC815\uC5D0\uC11C
      \uC790\uC2E0\uC758 \uC758\uC9C0\uB97C \uC9C0\uC9C0\uD574 \uC904 \uADF8 \uB204\uAD6C\uC640\uB3C4
      \uAD50\uB958\uD558\uC9C0 \uC54A\uC558\uAE30\uC5D0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uC815\uD574\uC9C4 \uADDC\uCE59\uC744 \uB530\uB974\uB294 \uAC83\uB9CC\uC774
      \uAC00\uBB38\uC744 \uC9C0\uD0A4\uB294 \uC720\uC77C\uD55C \uBC29\uBC95\uC774\uB77C
      \uBBFF\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uADF8\uB140\uC758 \uBAA9\uC18C\uB9AC\uB294
      \uB204\uAD6C\uBCF4\uB2E4 \uC6B0\uC544\uD558\uC9C0\uB9CC \uADF8 \uC548\uC5D0\uB294
      \uC790\uC2E0\uC758 \uC9C4\uC2EC\uC774 \uB2F4\uACA8 \uC788\uC9C0 \uC54A\uC73C\uBA70,
      \uADF8\uB140\uAC00 \uB0B4\uB9AC\uB294 \uBAA8\uB4E0 \uBA85\uB839\uC740 \uC0AC\uC2E4
      \uB204\uAD70\uAC00 \uBBF8\uB9AC \uC791\uC131\uD574 \uB454 \uC6D0\uACE0\uC5D0
      \uBD88\uACFC\uD569\uB2C8\uB2E4. \n\uC601\uBBFC\uB4E4\uC740 \uC8FC\uC778\uC758
      \uBB34\uC870\uAC74\uC801\uC778 \uBCF5\uC885 \uB54C\uBB38\uC5D0 \uC218\uD0C8\uB2F9\uD558\uBA70
      \uACE0\uD1B5\uBC1B\uACE0 \uC788\uC9C0\uB9CC, \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8\uC800 \uC815\uD574\uC9C4 \uC21C\uC11C\uC5D0 \uB9DE\uCDB0 \uC6B0\uC544\uD558\uAC8C
      \uACE0\uAC1C\uB97C \uC219\uC77C \uBFD0\uC785\uB2C8\uB2E4. \n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uD654\uB824\uD55C \uD3EC\uC7A5\uC9C0\uC5D0 \uC2F8\uC778 \uCC44 \uB0B4\uBD80\uBD80\uD130
      \uC11C\uC11C\uD788 \uC2DD\uC5B4\uAC00\uACE0 \uC788\uC73C\uBA70, \uADF8\uB140\uB294
      \uC790\uC2E0\uC774 \uC120\uD0DD\uD55C '\uC644\uBCBD\uD55C \uC608\uBC95'\uC774\uB77C\uB294
      \uC0AC\uC2AC\uC5D0 \uBB36\uC5EC \uAC00\uC7A5 \uC544\uB984\uB2E4\uC6B4 \uC778\uD615\uC73C\uB85C
      \uB0A8\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
