  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Max_Low_Compliant
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_low_compliant
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 1
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 7
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uAC00 \uC81C\uAD6D\uC758 \uC608\uBC95\uC744
      \uC644\uBCBD\uD558\uAC8C \uB530\uB974\uB294 \uC6B0\uC544\uD55C \uC778\uD615\uC774
      \uB418\uC5C8\uC744 \uB54C, \uB9C9\uC2A4\uB294 \uADF8\uB140\uC758 \uC0AC\uAD50\uACC4
      \uD65C\uB3D9\uC744 \uAC00\uC7A5 \uAC00\uAE4C\uC774\uC11C \uBCF4\uD544\uD558\uB294
      \uBD09\uC2E0\uAC00\uBB38\uC758 \uB300\uD45C\uB85C \uC790\uB9AC \uC7A1\uC558\uB2F5\uB2C8\uB2E4.
      \n\uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC740 \uBC31\uC791\uAC00\uC758 \uB0B4\uBD80\uAE4C\uC9C0
      \uAE4A\uC219\uC774 \uCE68\uD22C\uD558\uC9C0\uB294 \uBABB\uD588\uC9C0\uB9CC,
      \uC544\uBCA8\uB9AC\uC544\uAC00 \uAD00\uC2B5\uC5D0 \uB9DE\uCDB0 \uC6B0\uC544\uD558\uAC8C
      \uACE0\uAC1C\uB97C \uC219\uC77C \uB54C\uB9C8\uB2E4 \uB9C9\uC2A4\uB294 \uADF8
      \uACC1\uC5D0\uC11C \uAC00\uBB38\uC758 \uC774\uC775\uC744 \uC704\uD55C \uBA85\uBD84\uC744
      \uCC29\uC2E4\uD788 \uC313\uC544\uB098\uAC14\uC5B4\uC694. \n\uADF8\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00
      \uC815\uD574\uC9C4 \uAC01\uBCF8\uB300\uB85C \uC6C0\uC9C1\uC774\uB294 \uBAA8\uC2B5\uC744
      \uBCF4\uBA70 \uADF8\uB140\uC758 \uD488\uC704\uAC00 \uAC00\uBB38\uC758 \uC704\uC0C1\uC744
      \uB192\uC5EC\uC900\uB2E4\uACE0 \uCE6D\uC1A1\uD558\uBA74\uC11C\uB3C4, \uC815\uC791
      \uADF8\uB140\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uC0AC\uB77C\uC9C4 \uC790\uB9AC\uC5D0\uB294
      \uBC1C\uD14C\uB9AC\uC628\uC758 \uC758\uC911\uC744 \uCC44\uC6CC \uB123\uC5C8\uB2F5\uB2C8\uB2E4.
      \n\uB9C9\uC2A4\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC790\uC2E0\uC758 \uC758\uC9C0
      \uC5C6\uC774 \uB204\uAD70\uAC00 \uC791\uC131\uD55C \uC6D0\uACE0\uB97C \uC77D\uB294
      \uAE30\uACC4\uAC00 \uB418\uC5B4\uAC00\uB294 \uAC83\uC744 \uC9C0\uCF1C\uBCF4\uBA70
      \uADF8\uAC83\uC774 \uBC31\uC791\uC744 \uC704\uD55C \uAC00\uC7A5 \uC548\uC804\uD55C
      \uAE38\uC774\uB77C \uBBFF\uAE30\uB85C \uD588\uC5B4\uC694. \n\uD558\uC9C0\uB9CC
      \uAC00\uB054 \uADF8\uB140\uC758 \uD750\uD2B8\uB7EC\uC9D0 \uC5C6\uB294 \uC644\uBCBD\uD55C
      \uC778\uC0AC\uBC95\uC744 \uB9C8\uC8FC\uD560 \uB54C\uBA74, \uC608\uC804\uC5D0
      \uC11C\uD234\uAC8C \uAC80\uC744 \uD718\uB450\uB974\uB358 \uC18C\uB144\uC758
      \uC9C4\uC2EC\uC774 \uD55C\uC21C\uAC04 \uAC00\uC2B4\uC744 \uCC0C\uB974\uACE0
      \uC9C0\uB098\uAC00\uB294 \uAC83\uC744 \uB290\uAF08\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
