  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 0
  _text:
    _title: 
    _body: "\uC601\uBBFC\uD574\uC9C4 \uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC774
      \uAC00\uC9C4 '\uD669\uC790'\uB77C\uB294 \uD0C0\uC774\uD2C0\uC758 \uBB34\uAC8C\uB97C
      \uC815\uD655\uD788 \uAFF0\uB6AB\uC5B4 \uBCF4\uC558\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294
      \uB9AC\uC548\uACFC \uAE4A\uC740 \uC815\uC744 \uB098\uB204\uB294 \uB300\uC2E0,
      \uADF8\uB97C \uD669\uC2E4\uC758 \uC815\uBCF4\uB97C \uBE7C\uB0B4\uB294 \uCC3D\uAD6C\uC774\uC790
      \uC8FC\uBCC0 \uC601\uC8FC\uB4E4\uC744 \uACAC\uC81C\uD560 '\uD669\uC2E4\uC758
      \uC778\uC7A5' \uC815\uB3C4\uB85C\uB9CC \uB300\uC6B0\uD558\uBA70 \uCCA0\uC800\uD788
      \uAC70\uB9AC\uB97C \uB450\uC5C8\uB2F5\uB2C8\uB2E4. \n\uB9AC\uC548\uC740 \uADF8\uB140\uC758
      \uCC28\uAC00\uC6B4 \uD0DC\uB3C4\uC5D0 \uB2F9\uD669\uD558\uBA74\uC11C\uB3C4
      \uADF8\uB140\uC758 \uC644\uBCBD\uD55C \uD1B5\uCE58 \uB2A5\uB825\uC5D0 \uC555\uB3C4\uB418\uC5B4,
      \uC694\uAD6C\uD558\uB294 \uC9C0\uC6D0\uC744 \uAD70\uB9D0 \uC5C6\uC774 \uC81C\uACF5\uD558\uB294
      \uCDA9\uC2E4\uD55C \uC870\uB825\uC790\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uB9AC\uC548\uC758 \uD798\uC744 \uBE4C\uB824 \uBD81\uBD80\uC758 \uBD80\uB97C
      \uB3C5\uC810\uD588\uACE0, \uB9AC\uC548\uC740 \uADF8\uB140\uC758 \uC601\uC9C0\uAC00
      \uCEE4\uC9C8\uC218\uB85D \uD669\uC2E4 \uB0B4\uC5D0\uC11C \uC790\uC2E0\uC758
      \uC785\uC9C0\uAC00 \uB2E8\uB2E8\uD574\uC9C0\uB294 \uAE30\uBB18\uD55C \uACF5\uC0DD
      \uAD00\uACC4\uB97C \uC990\uAE30\uAC8C \uB418\uC5C8\uC9C0\uC694. \uC6B0\uC815\uC870\uCC28
      \uC22B\uC790\uB85C \uD658\uC0B0\uD558\uB294 \uADF8\uB140\uC5D0\uAC8C \uB9AC\uC548\uC740
      \uAC00\uC7A5 \uAC00\uC131\uBE44 \uC88B\uC740 \uBB34\uAE30\uC600\uC744 \uBFD0\uC785\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
