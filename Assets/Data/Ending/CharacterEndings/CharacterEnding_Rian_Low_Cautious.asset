  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 2
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uACFC\uC758 \uC7A6\uC740
      \uB9CC\uB0A8\uC744 \uD1B5\uD574 \uADF8\uAC00 \uD669\uC2E4\uC5D0\uC11C \uC5BC\uB9C8\uB098
      \uC57D\uD55C \uC874\uC7AC\uC778\uC9C0\uB97C \uAC04\uD30C\uD558\uACE0, \uADF8\uB97C
      \uC5ED\uC73C\uB85C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uC601\uC9C0 \uC548\uC5D0
      \uBD99\uB4E4\uC5B4\uB450\uB294 \uC120\uD0DD\uC744 \uD588\uC2B5\uB2C8\uB2E4.
      \n\uADF8\uB140\uB294 \uB9AC\uC548\uC744 '\uBCF4\uD638'\uD55C\uB2E4\uB294 \uD551\uACC4\uB85C
      \uADF8\uB97C \uC131\uC548\uC5D0 \uBA38\uBB3C\uAC8C \uD558\uBA70 \uD669\uC2E4\uB85C\uBD80\uD130
      \uC624\uB294 \uBAA8\uB4E0 \uC555\uBC15\uC744 \uCC28\uB2E8\uD588\uC9C0\uB9CC,
      \uC774\uB294 \uC0AC\uC2E4 \uB9AC\uC548\uC744 \uC778\uC9C8 \uC0BC\uC544 \uD669\uC2E4\uACFC\uC758
      \uAC70\uB798\uC5D0\uC11C \uC6B0\uC704\uB97C \uC810\uD558\uB824\uB294 \uACC4\uC0B0\uC774\uC5C8\uC9C0\uC694.
      \n\uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uC758 \uACC1\uC5D0 \uBA38\uBB3C
      \uC218 \uC788\uB2E4\uB294 \uC0AC\uC2E4\uC5D0 \uAE30\uBED0\uD558\uBA70 \uC2A4\uC2A4\uB85C
      \uC0C8\uC7A5 \uC18D\uC758 \uC0C8\uAC00 \uB418\uC5C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8\uB7F0 \uB9AC\uC548\uC744 \uAC10\uC2DC\uD558\uBA70 \uC601\uC9C0\uC758
      \uC644\uBCBD\uD55C \uC548\uC804\uC744 \uD655\uBCF4\uD588\uB2F5\uB2C8\uB2E4.
      \n\uB450 \uC0AC\uB78C\uC740 \uC11C\uB85C\uB97C \uBBFF\uC9C0 \uBABB\uD558\uBA74\uC11C\uB3C4
      \uC11C\uB85C\uC758 \uACC1\uC744 \uB5A0\uB098\uC9C0 \uBABB\uD558\uB294 \uAE30\uBB18\uD55C
      \uAC10\uC625\uC744 \uB9CC\uB4E4\uC5C8\uC73C\uBA70, \uB9AC\uC548\uC740 \uADF8\uB140\uAC00
      \uC313\uC544 \uC62C\uB9B0 \uC758\uC2EC\uC758 \uC131\uBCBD \uC704\uC5D0\uC11C
      \uAC00\uC7A5 \uD654\uB824\uD55C \uC7A5\uC2DD\uD488\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
