  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 0
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uAC00 \uC81C\uACF5\uD558\uB294
      \uC815\uBCF4\uC640 \uC790\uC6D0\uC774 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C
      \uC9C0\uD0F1\uD558\uB294 \uB370 \uD544\uC218\uC801\uC774\uB77C\uB294 \uC0AC\uC2E4\uC744
      \uC601\uB9AC\uD558\uAC8C \uACC4\uC0B0\uD574 \uB0C8\uC2B5\uB2C8\uB2E4. \n\uC720\uD53C\uAC00
      \uAC74\uB124\uB294 '\uD638\uC758'\uAC00 \uB3C5\uC774 \uB4E0 \uC131\uBC30\uC784\uC744
      \uC54C\uBA74\uC11C\uB3C4, \uB2F9\uC7A5\uC758 \uC601\uC9C0 \uBCF4\uC804\uC744
      \uC704\uD574 \uADF8 \uC190\uC744 \uC7A1\uB294 \uAC83\uC774 \uAC00\uC7A5 \uD6A8\uC728\uC801\uC778
      \uC120\uD0DD\uC774\uB77C\uACE0 \uD310\uB2E8\uD55C \uAC83\uC774\uC9C0\uC694.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uC758 \uAC00\uC2A4\uB77C\uC774\uD305\uC744
      \uB208\uCE58\uCC44\uACE0 \uC801\uB2F9\uD55C \uAC70\uB9AC\uB97C \uB450\uB824
      \uC560\uC4F0\uC9C0\uB9CC, \uC720\uD53C\uB294 \uC774\uBBF8 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758
      \uC7AC\uBB34 \uAE30\uB85D \uAE4A\uC219\uC774 \uB85C\uC0AC\uBCA8\uC758 \uC778\uC7A5\uC744
      \uBC15\uC544 \uB123\uC5C8\uC2B5\uB2C8\uB2E4. \n\uBC31\uC791\uC774 \uB41C \uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uD53C\uB97C '\uAC00\uC7A5 \uC704\uD5D8\uD55C \uC870\uB825\uC790'\uB85C
      \uACC1\uC5D0 \uB450\uBA70 \uB04A\uC784\uC5C6\uB294 \uC218 \uC2F8\uC6C0\uC744
      \uBC8C\uC774\uACE0 \uC788\uC9C0\uB9CC, \uC774\uBBF8 \uC601\uC9C0\uC758 \uC774\uAD8C\uC740
      \uC11C\uC11C\uD788 \uB85C\uC0AC\uBCA8 \uCABD\uC73C\uB85C \uAE30\uC6B8\uACE0
      \uC788\uB2F5\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uC790\uC2E0\uC758 \uC601\uBBFC\uD568\uC73C\uB85C
      \uAC00\uBB38\uC744 \uC9C0\uCF30\uB2E4\uACE0 \uBBFF\uACE0 \uC2F6\uC5B4 \uD558\uC9C0\uB9CC,
      \uC0AC\uC2E4\uC740 \uC720\uD53C\uAC00 \uC9DC\uB193\uC740 \uAC70\uB300\uD55C
      \uCCB4\uC2A4\uD310 \uC704\uC758 \uB9D0\uB85C \uC804\uB77D\uD588\uC74C\uC744
      \uBD80\uC815\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
