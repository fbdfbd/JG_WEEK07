  _maxMeetCount: -1
  _directionType: 7
  _text:
    _title: 
    _body: "\uC0AC\uAD50\uACC4\uC758 \uC815\uC810\uC5D0 \uC120 \uC544\uBCA8\uB9AC\uC544\uAC00
      \uD654\uB824\uD55C \uAF2D\uB450\uAC01\uC2DC\uB85C\uC11C\uC758 \uC0B6\uC744
      \uBC1B\uC544\uB4E4\uC600\uC744 \uB54C, \uB9C9\uC2A4\uB294 \uADF8\uB140\uC758
      \uBAA8\uB4E0 \uC77C\uAC70\uC218\uC77C\uD22C\uC871\uC744 \uAD00\uB9AC\uD558\uB294
      \uCE58\uBC00\uD55C \uC870\uC5B8\uC790\uAC00 \uB418\uC5C8\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uBC31\uC791\uC774 \uD669\uC2E4\uC758 \uC694\uAD6C\uC5D0 \uC21C\uC751\uD558\uBA70
      \uC2E4\uAD8C\uC744 \uC783\uC5B4\uAC00\uB294 \uACFC\uC815\uC744 \uAC00\uC7A5
      \uC801\uADF9\uC801\uC73C\uB85C \uB3C4\uC654\uACE0, \uADF8 \uB300\uAC00\uB85C
      \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uC601\uC9C0\uC758 \uC2E4\uC9C8\uC801\uC778
      \uACB0\uC815\uAD8C\uC744 \uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC758 \uC190\uC544\uADC0\uC5D0
      \uB123\uC5C8\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uAC00 \uC815\uD574\uC9C4
      \uC21C\uC11C\uC5D0 \uB9DE\uCDB0 \uBBF8\uC18C \uC9C0\uC744 \uB54C\uB9C8\uB2E4
      \uB9C9\uC2A4\uB294 \uADF8\uB140\uB97C \uC704\uD55C \uC644\uBCBD\uD55C \uBB34\uB300\uB97C
      \uC5F0\uCD9C\uD558\uBA70, \uADF8\uB140\uAC00 \uC2A4\uC2A4\uB85C\uC758 \uC758\uC9C0\uB97C
      \uCC3E\uC73C\uB824 \uD560 \uD2C8\uC870\uCC28 \uC8FC\uC9C0 \uC54A\uACE0 \uB2E4\uC815\uD558\uAC8C
      \uC5B5\uB20C\uB800\uB2F5\uB2C8\uB2E4. \n\uADF8\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00
      \uAC00\uBB38\uC758 \uC774\uAD8C\uC744 \uC0C1\uC2E4\uD558\uB294 \uACB0\uC815\uC744
      \uB0B4\uB9B4 \uB54C\uC870\uCC28 \uADF8\uAC83\uC774 \uBC31\uC791\uAC00\uC758
      \uBA85\uC608\uB97C \uC9C0\uD0A4\uB294 \uC720\uC77C\uD55C \uBC29\uBC95\uC774\uB77C\uBA70
      \uADF8\uB140\uB97C \uC548\uC2EC\uC2DC\uD0A4\uACE0 \uB4A4\uD3B8\uC5D0\uC11C
      \uC774\uB4DD\uC744 \uCC59\uACBC\uC5B4\uC694. \n\uB9C9\uC2A4\uB294 \uB9E4\uC77C
      \uBC24 \uD654\uB824\uD55C \uB4DC\uB808\uC2A4\uB97C \uBC97\uACE0 \uC9C0\uCE5C
      \uD45C\uC815\uC73C\uB85C \uC7A0\uB4E0 \uC544\uBCA8\uB9AC\uC544\uB97C \uBCF4\uBA70
      \uC790\uC2E0\uC774 \uADF8\uB140\uB97C \uC9C0\uD0A8 \uAC83\uC778\uC9C0, \uC544\uB2C8\uBA74
      \uAC00\uC7A5 \uC794\uC778\uD558\uAC8C \uBB34\uB108\uB728\uB9B0 \uAC83\uC778\uC9C0
      \uD63C\uB780\uC2A4\uB7EC\uC6CC\uD558\uBA74\uC11C\uB3C4 \uADF8 \uC704\uC120\uC744
      \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
