  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_Low_Defiant
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_low_defiant
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 3
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 6
  _text:
    _title: 
    _body: "\uC720\uD53C\uB294 \uC608\uBC95\uACFC \uAD00\uC2B5\uC774\uB77C\uB294
      \uC0AC\uC2AC\uB85C \uC544\uBCA8\uB9AC\uC544\uB97C \uBB36\uC73C\uB824 \uD588\uC73C\uB098,
      \uC790\uC720\uB97C \uAC08\uB9DD\uD558\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uAE30\uC9C8\uC740 \uC774\uB97C \uAC70\uCE60\uAC8C \uAC70\uBD80\uD588\uC5B4\uC694.
      \n\uC720\uD53C\uAC00 \"\uD6C4\uC791\uAC00\uC758 \uBCF4\uD638\uAC00 \uD544\uC694\uD560
      \uAC83\"\uC774\uB77C\uACE0 \uC81C\uC548\uD560 \uB54C\uB9C8\uB2E4, \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8\uAC83\uC744 \uAC00\uBB38\uC758 \uB3C5\uB9BD\uC744 \uC704\uD611\uD558\uB294
      \uC624\uB9CC\uD55C \uAC04\uC12D\uC73C\uB85C \uCE58\uBD80\uD558\uBA70 \uB0A0\uC744
      \uC138\uC6E0\uB2F5\uB2C8\uB2E4. \n\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uB97C
      \uB2E4\uB8E8\uAE30 \uD798\uB4E0 \uC544\uC774\uB77C \uC5EC\uAE30\uBA70 \uAC89\uC73C\uB85C\uB294
      \uC6C3\uC73C\uBA74\uC11C\uB3C4 \uC18D\uC73C\uB85C\uB294 \uB85C\uC0AC\uBCA8
      \uAC00\uBB38\uC758 \uD798\uC744 \uB3D9\uC6D0\uD574 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C
      \uC555\uBC15\uD558\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294
      \uC774\uB7EC\uD55C \uC678\uC555\uC5D0 \uAD74\uBCF5\uD558\uAE30\uB294\uCEE4\uB155,
      \uB85C\uC0AC\uBCA8 \uAC00\uBB38\uACFC\uC758 \uBAA8\uB4E0 \uACF5\uC2DD\uC801\uC778
      \uAD50\uB958\uB97C \uC911\uB2E8\uD558\uACE0 \uC790\uAE09\uC790\uC871\uC758
      \uAE38\uC744 \uD0DD\uD558\uB294 \uD30C\uACA9\uC801\uC778 \uD589\uBCF4\uB97C
      \uBCF4\uC600\uC9C0\uC694. \n\uB450 \uAC00\uBB38\uC758 \uAD00\uACC4\uB294 \uB3CC\uC774\uD0AC
      \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C \uC545\uD654\uB418\uC5C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uC0AC\uAD50\uACC4\uC5D0\uC11C '\uBB34\uB840\uD55C \uBC18\uC5ED\uC790'\uB77C\uB294
      \uB099\uC778\uC774 \uCC0D\uD788\uB294 \uAC83\uC744 \uB450\uB824\uC6CC\uD558\uC9C0
      \uC54A\uC558\uB2F5\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uD6C4\uC791\uAC00\uC758
      \uD654\uB824\uD55C \uBE44\uB2E8 \uB300\uC2E0 \uAC70\uCE5C \uAC00\uC8FD \uC637\uC744
      \uC785\uACE0, \uC790\uC2E0\uC758 \uC601\uC9C0\uB97C \uCE68\uBC94\uD558\uB824\uB294
      \uBAA8\uB4E0 \uC190\uAE38\uC744 \uB2E8\uD638\uD558\uAC8C \uCCD0\uB0B4\uBA70
      \uD640\uB85C \uB2F9\uB2F9\uD788 \uC11C \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
