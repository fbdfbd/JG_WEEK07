  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Max_Low_Clever
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_low_clever
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 1
  _minMeetCount: 1
  _maxMeetCount: 10
  _directionType: 0
  _text:
    _title: 
    _body: "\uAC10\uC815\uC774 \uAC70\uC138\uB41C \uCCA0\uD608\uC758 \uD1B5\uCE58\uC790\uAC00
      \uB41C \uC544\uBCA8\uB9AC\uC544\uC758 \uC9D1\uBB34\uC2E4\uC5D0\uC11C, \uB9C9\uC2A4\uB294
      \uC608\uBC95\uC758 \uC815\uC11D\uC744 \uBCF4\uC5EC\uC8FC\uBA70 \uCCA0\uC800\uD558\uAC8C
      \uACF5\uC2DD\uC801\uC778 \uAC70\uB9AC\uB97C \uC720\uC9C0\uD588\uB2F5\uB2C8\uB2E4.\n\uADF8\uB294
      \uAC00\uBB38\uC758 \uC774\uC775\uC744 \uCC59\uAE30\uAE30 \uC704\uD574 \uBA87
      \uBC88\uC774\uB098 \uC815\uAD50\uD55C \uB300\uD654\uC758 \uB36B\uC744 \uB193\uC558\uC9C0\uB9CC,
      \uC544\uBCA8\uB9AC\uC544\uC758 \uC11C\uB298\uD55C \uACC4\uC0B0\uC740 \uADF8
      \uC758\uB3C4\uB97C \uAC00\uCC28 \uC5C6\uC774 \uAC78\uB7EC\uB0B4\uC5B4 \uBC1C\uD14C\uB9AC\uC628\uC758
      \uCE68\uD22C\uB97C \uC808\uBC18\uCBE4\uC5D0\uC11C \uBA48\uCDB0 \uC138\uC6E0\uC5B4\uC694.
      \n\uB9C9\uC2A4\uB294 \uBC31\uC791\uC758 \uAE4A\uC740 \uC2E0\uB8B0\uB97C \uC5BB\uC9C0
      \uBABB\uD588\uC74C\uC5D0\uB3C4 \uBD88\uAD6C\uD558\uACE0, \uADF8\uB140\uC758
      \uD6A8\uC728\uC801\uC778 \uD1B5\uCE58 \uCCB4\uACC4 \uC548\uC5D0\uC11C \uAC00\uC7A5
      \uC720\uB2A5\uD558\uACE0 \uC608\uC758 \uBC14\uB978 \uBD09\uC2E0\uC774\uB77C\uB294
      \uC790\uB9AC\uB97C \uACB0\uCF54 \uC783\uC9C0 \uC54A\uC558\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC7A5\uBD80\uC758 \uC22B\uC790\uB9CC\uC744
      \uC2E0\uB8B0\uD558\uBA70 \uACE0\uB3C5\uD574\uC9C8 \uB54C\uB9C8\uB2E4 \uBD80\uB4DC\uB7EC\uC6B4
      \uBAA9\uC18C\uB9AC\uB85C \uC548\uBD80\uB97C \uBB3C\uC73C\uBA70 \uADF8\uB140\uC758
      \uACBD\uACC4\uC2EC\uC774 \uD750\uD2B8\uB7EC\uC9C0\uB294 \uD2C8\uC744 \uB048\uC9C8\uAE30\uAC8C
      \uAE30\uB2E4\uB838\uC5B4\uC694. \n\uD558\uC9C0\uB9CC \uC790\uC2E0\uC758 \uC644\uBCBD\uD55C
      \uC608\uBC95\uC870\uCC28 \uC544\uBCA8\uB9AC\uC544\uC758 \uCC28\uAC00\uC6B4
      \uC2DC\uC120 \uC55E\uC5D0\uC11C\uB294 \uD55C\uB0B1 \uC11C\uB958 \uD55C \uC7A5\uCC98\uB7FC
      \uCDE8\uAE09\uBC1B\uB294 \uAC83\uC744 \uB290\uB084 \uB54C\uBA74, \uB9C9\uC2A4\uB294
      \uC790\uC2E0\uC774 \uADF8\uB140\uC5D0\uAC8C \uB0A8\uAE30\uB824 \uD588\uB358
      \uD754\uC801\uC774 \uBB34\uC5C7\uC774\uC5C8\uB294\uC9C0 \uACF5\uD5C8\uD558\uAC8C
      \uB418\uBB3B\uACE4 \uD588\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
