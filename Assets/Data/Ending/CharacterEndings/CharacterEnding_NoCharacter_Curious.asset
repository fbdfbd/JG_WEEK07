  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_NoCharacter_Curious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_no_character_curious
  _priority: 100
  _isNoCharacterEnding: 1
  _characterType: 1
  _minMeetCount: 0
  _maxMeetCount: 0
  _directionType: 3
  _text:
    _title: 
    _body: "\uBC31\uC791\uC704\uC5D0 \uC624\uB978 \uC544\uBCA8\uB9AC\uC544\uB294
      \uC601\uC9C0 \uACBD\uC601\uC774\uB77C\uB294 \uC9C0\uB8E8\uD55C \uD604\uC2E4\uBCF4\uB2E4\uB294,
      \uC138\uC0C1\uC5D0 \uC54C\uB824\uC9C0\uC9C0 \uC54A\uC740 \u2018\uC2E0\uBE44\uD55C
      \uC9C4\uC2E4\u2019\uC744 \uCC3E\uB294 \uB370 \uBAA8\uB4E0 \uAD8C\uB825\uC744
      \uC3DF\uC544\uBD93\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uC131\uC758
      \uC9C0\uD558\uC2E4\uC744 \uACE0\uB300\uC758 \uC720\uBB3C\uACFC \uAE30\uC774\uD55C
      \uAE30\uB85D\uB4E4\uB85C \uAC00\uB4DD \uCC44\uC6E0\uC73C\uBA70, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uBC31\uC791\uC800\uB294 \uC774\uC81C \uC81C\uAD6D\uC5D0\uC11C \uAC00\uC7A5
      \uBE44\uBC00\uC2A4\uB7FD\uACE0 \uAE30\uAD34\uD55C \uC18C\uBB38\uC774 \uB5A0\uB3C4\uB294
      \uBC15\uBB3C\uAD00\uC774 \uB418\uC5B4\uBC84\uB838\uC2B5\uB2C8\uB2E4. \n\uC601\uBBFC\uB4E4\uC740
      \uBC31\uC791\uC774 \uCC3E\uC544\uB0B8 \uC720\uBB3C\uC5D0\uC11C \uB098\uC624\uB294
      \uAE30\uBB18\uD55C \uC18C\uB9AC\uC640 \uBE5B\uC5D0 \uBD88\uC548\uD574\uD558\uBA70
      \uBC24\uC7A0\uC744 \uC124\uCE58\uACE0, \uC601\uC9C0\uC758 \uD589\uC815\uC740
      \uC8FC\uC778\uC744 \uC783\uC740 \uCC44 \uD63C\uB780 \uC18D\uC5D0 \uBC29\uCE58\uB418\uC5B4
      \uC788\uC2B5\uB2C8\uB2E4.\r\n\uADF8\uB140\uC758 \uB118\uCE58\uB294 \uD638\uAE30\uC2EC\uC744
      \uD604\uC2E4\uB85C \uB3CC\uB824\uB193\uAC70\uB098 \uD568\uAED8 \uD0D0\uD5D8\uD574
      \uC904 \uC720\uD53C\uB098 \uB9C9\uC2A4 \uAC19\uC740 \uC778\uC5F0\uC774 \uC5C6\uC5C8\uAE30\uC5D0,
      \uC544\uBCA8\uB9AC\uC544\uC758 \uAD00\uC2EC\uC740 \uC9D1\uCC29\uC774 \uB418\uC5B4
      \uC138\uC0C1\uC758 \uACBD\uACC4 \uBC16\uC73C\uB85C \uB118\uC5B4\uAC00 \uBC84\uB838\uC2B5\uB2C8\uB2E4.\r\n\uADF8\uB140\uB294
      \uC790\uC2E0\uC758 \uC774\uB984\uC774 \uC9C0\uB3C4 \uC704\uC5D0\uC11C \uC9C0\uC6CC\uC9C0\uB294
      \uAC83\uBCF4\uB2E4, \uB0B4\uC77C \uB9C8\uC8FC\uD560 \uC0C8\uB85C\uC6B4 \uBBF8\uC2A4\uD130\uB9AC\uC5D0
      \uAC00\uBB38\uC758 \uC6B4\uBA85\uC744 \uD1B5\uC9F8\uB85C \uAC70\uB294 \uC704\uD5D8\uD55C
      \uC120\uD0DD\uC744 \uBC18\uBCF5\uD569\uB2C8\uB2E4. \n\uD145 \uBE48 \uC131 \uC548\uC5D0\uC11C
      \uD640\uB85C \uACE0\uB300\uC758 \uBB38\uC790\uB97C \uD574\uB3C5\uD558\uBA70
      \uC990\uAC70\uC6CC\uD558\uB294 \uADF8\uB140\uC758 \uBAA8\uC2B5\uC740 \uC601\uC9C0\uC758
      \uC8FC\uC778\uC774\uB77C\uAE30\uBCF4\uB2E4, \uC9C0\uC2DD\uC5D0 \uC7A1\uC544\uBA39\uD78C
      \uD0D0\uAD6C\uC790\uC5D0 \uAC00\uAE5D\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294
      \uACB0\uAD6D \uAC00\uBB38\uC758 \uBAA8\uB4E0 \uC5ED\uC0AC\uC640 \uC790\uC2E0\uC758
      \uBBF8\uB798\uB97C \uC0C8\uB85C\uC6B4 \uC9C0\uC2DD\uACFC \uB9DE\uBC14\uAFB8\uB824
      \uD558\uBA70, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB77C\uB294 \uC774\uB984\uC774
      \uC138\uC0C1\uC5D0\uC11C \uC78A\uD788\uB294 \uC21C\uAC04\uAE4C\uC9C0\uB3C4
      \uBA48\uCD94\uC9C0 \uC54A\uB294 \uD638\uAE30\uC2EC\uC758 \uB178\uC608\uB85C
      \uB0A8\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
