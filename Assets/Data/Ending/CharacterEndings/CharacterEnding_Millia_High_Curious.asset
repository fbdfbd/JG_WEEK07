  _maxMeetCount: -1
  _directionType: 3
  _text:
    _title: 
    _body: "\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uB97C \uC704\uD574
      \uC81C\uAD6D \uC804\uC5ED\uC758 \uACE0\uC11C\uC801\uACFC \uAE08\uC9C0\uB41C
      \uC5F0\uAD6C \uC790\uB8CC\uB4E4\uC744 \uB2E5\uCE58\uB294 \uB300\uB85C \uC0AC\uB4E4\uC5EC
      \uBC31\uC791\uC800\uC758 \uC11C\uACE0\uB97C \uCC44\uC6E0\uC2B5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC11C\uACE0\uC5D0 \uBC15\uD600 \uB9E4\uC77C\uAC19\uC774
      \uBC00\uB9AC\uC544\uAC00 \uAC00\uC838\uB2E4\uC900 \uACE0\uB300\uC5B4 \uC0AC\uC804\uC744
      \uB4A4\uC801\uC774\uBA70 \uC138\uC0C1\uC758 \uBE44\uBC00\uC744 \uD30C\uD5E4\uCE58\uB294
      \uB370 \uC9D1\uCC29\uD588\uC9C0\uC694. \n\uADF8\uB140\uAC00 \uC774 \uBE44\uBC00\uC744
      \uC54C\uC544\uB0B4\uBA74 \uC815\uB9D0 \uC138\uC0C1\uC774 \uBC14\uB014\uC9C0
      \uD640\uB9B0 \uB4EF \uC911\uC5BC\uAC70\uB9AC\uBA74 \uBC00\uB9AC\uC544\uB294
      \uC870\uC6A9\uD788 \uACC1\uC5D0\uC11C \uCC28\uB97C \uB530\uB974\uBA70 \uB4E0\uB4E0\uD55C
      \uD6C4\uC6D0\uC790\uB97C \uC790\uCC98\uD560 \uBFD0\uC774\uC5C8\uB2F5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uAC00 \uC6D0\uD558\uB294 \uAC83\uC774\uB77C\uBA74
      \uBB34\uC5C7\uC774\uB4E0 \uAC00\uC838\uB2E4\uC8FC\uACA0\uB2E4\uB294 \uC57D\uC18D\uC758
      \uB300\uAC00\uB85C, \uADF8\uB140\uB294 \uC5F0\uAD6C\uC5D0 \uD544\uC694\uD55C
      \uB9C9\uB300\uD55C \uBE44\uC6A9\uC744 \uC0C1\uB2E8\uC5D0\uC11C \uB300\uCD9C\uBC1B\uC558\uACE0,
      \uADF8 \uB2F4\uBCF4\uB85C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uAC00\uBB38\uC758
      \uC131\uC528\uC640 \uBB38\uC7A5\uC744 \uC0AC\uC6A9\uD558\uB294 \uAD8C\uD55C\uAE4C\uC9C0
      \uBC00\uB9AC\uC544\uC5D0\uAC8C \uB118\uACA8\uC8FC\uC5C8\uC2B5\uB2C8\uB2E4.
      \n\uC774\uC81C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uC601\uC9C0\uB294 \uC0C1\uB2E8\uC758
      \uC2E4\uD5D8\uC7A5\uC774\uC790 \uAC70\uB300\uD55C \uB3C4\uC11C\uAD00\uC73C\uB85C
      \uBCC0\uBAA8\uD588\uC73C\uBA70, \uC601\uBBFC\uB4E4\uC740 \uBC31\uC791\uC774
      \uC5B8\uC81C \uC131 \uC548\uC5D0\uC11C \uC704\uD5D8\uD55C \uC2E4\uD5D8\uC744
      \uD130\uB728\uB9B4\uC9C0 \uBAB0\uB77C \uB9E4\uC77C \uBC24 \uC804\uC804\uAE0D\uAE0D\uD558\uACE0
      \uC788\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC9C4\uC2E4\uC744 \uCC3E\uB294
      \uAD11\uAE30\uC5D0 \uCDE8\uD574 \uC788\uC73C\uBA70, \uBC00\uB9AC\uC544\uB294
      \uADF8 \uAD11\uAE30\uB97C \uAC00\uC7A5 \uBE44\uC2FC \uAC00\uACA9\uC5D0 \uD314\uC544\uCE58\uC6B0\uB294
      \uC704\uB300\uD55C \uC0C1\uC778\uC774 \uB418\uC5C8\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
