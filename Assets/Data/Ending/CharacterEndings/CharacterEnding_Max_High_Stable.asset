  _maxMeetCount: -1
  _directionType: 4
  _text:
    _title: 
    _body: "\uB2E8\uB2E8\uD55C \uD3C9\uD654\uB97C \uC77C\uAD88\uB0B8 \uC544\uBCA8\uB9AC\uC544\uC758
      \uACC1\uC5D0\uC11C, \uB9C9\uC2A4\uB294 \uADF8\uB140\uC758 \uBAA8\uB4E0 \uD589\uC815\uC801
      \uBD80\uB2F4\uC744 \uB098\uB204\uC5B4 \uC9CA\uC5B4\uC9C0\uB294 \uAC00\uC7A5
      \uB4E0\uB4E0\uD55C \uC870\uC5B8\uC790\uC774\uC790 \uBC18\uB824\uC790\uB85C
      \uC790\uB9AC \uC7A1\uC558\uB2F5\uB2C8\uB2E4. \n\uADF8\uB294 \uBC31\uC791\uC774
      \uC601\uBBFC\uB4E4\uC758 \uC2E0\uB9DD\uC744 \uBC1B\uC73C\uBA70 \uC548\uC8FC\uD558\uB294
      \uB3D9\uC548 \uC601\uC9C0\uC758 \uC2E4\uC9C8\uC801\uC778 \uAD00\uB9AC \uCCB4\uACC4\uB97C
      \uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC758 \uBC29\uC2DD\uB300\uB85C \uC7AC\uD3B8\uD588\uACE0,
      \uC544\uBCA8\uB9AC\uC544\uAC00 \uAE68\uB2EB\uC9C0 \uBABB\uD558\uB294 \uC0AC\uC774\uC5D0
      \uC601\uC9C0 \uC804\uCCB4\uAC00 \uB9C9\uC2A4\uC758 \uC190\uAE38 \uC5C6\uC774\uB294
      \uB3CC\uC544\uAC00\uC9C0 \uC54A\uB3C4\uB85D \uB9CC\uB4E4\uC5C8\uC9C0\uC694.
      \n\uC544\uBCA8\uB9AC\uC544\uAC00 \uD3C9\uC628\uD55C \uC77C\uC0C1 \uC18D\uC5D0\uC11C
      \uAC00\uBB38\uC758 \uBFCC\uB9AC\uB97C \uC9C0\uD0A4\uB294 \uC77C\uC5D0 \uBAB0\uB450\uD560
      \uB54C\uB9C8\uB2E4 \uB9C9\uC2A4\uB294 \uADF8\uB140\uC758 \uB178\uACE0\uB97C
      \uCC2C\uC591\uD558\uBA70 \uD798\uB4E0 \uACB0\uC815\uB4E4\uC740 \uBAA8\uB450
      \uC790\uC2E0\uC774 \uB300\uC2E0 \uCC98\uB9AC\uD574\uC8FC\uACA0\uB2E4\uBA70
      \uADF8\uB140\uC758 \uAD8C\uD55C\uC744 \uD558\uB098\uC529 \uAC00\uC838\uC654\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uADF8\uB140\uB97C \uC704\uD574 \uD5CC\uC2E0\uD558\uB294 \uB2E4\uC815\uD55C
      \uCE21\uADFC\uC758 \uBAA8\uC2B5\uC73C\uB85C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758
      \uBAA8\uB4E0 \uC790\uC6D0\uACFC \uC815\uBCF4\uB97C \uB3C5\uC810\uD588\uACE0,
      \uACB0\uAD6D \uC544\uBCA8\uB9AC\uC544\uB97C \uD3C9\uD654\uB77C\uB294 \uC774\uB984\uC758
      \uC548\uB77D\uD55C \uADF8\uB298 \uC18D\uC5D0 \uAC00\uB450\uC5B4 \uB450\uC5C8\uC5B4\uC694.
      \n\uB9C9\uC2A4\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uD3C9\uC628\uD55C \uB208\uC73C\uB85C
      \uC790\uC2E0\uC744 \uBBFF\uACE0 \uC758\uC9C0\uD560 \uB54C\uB9C8\uB2E4 \uB9C8\uC74C
      \uAE4A\uC740 \uACF3\uC5D0\uC11C \uC6B8\uB9AC\uB294 \uC8C4\uCC45\uAC10\uC744
      \uC678\uBA74\uD558\uBA70, \uC774\uAC83\uC774\uC57C\uB9D0\uB85C \uADF8\uB140\uB97C
      \uAC00\uC7A5 \uD589\uBCF5\uD558\uAC8C \uB9CC\uB4DC\uB294 \uBCF4\uD638\uB77C\uACE0
      \uC2A4\uC2A4\uB85C\uB97C \uAE30\uB9CC\uD588\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
