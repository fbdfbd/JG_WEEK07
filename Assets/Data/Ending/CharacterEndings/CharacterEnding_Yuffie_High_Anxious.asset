  _maxMeetCount: -1
  _directionType: 5
  _text:
    _title: 
    _body: "\uC720\uD53C\uB294 \uBD88\uC548\uC5D0 \uB5A0\uB294 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
      \"\uC138\uC0C1\uC740 \uBAA8\uB450 \uC801\uC774\uC9C0\uB9CC, \uB098\uB9CC\uC740
      \uC9C4\uC2E4\uD558\uB2E4\"\uB294 \uAD50\uBB18\uD55C \uAC00\uC2A4\uB77C\uC774\uD305\uC744
      \uC9C0\uC18D\uD558\uC5EC \uADF8\uB140\uC758 \uD310\uB2E8\uB825\uC744 \uC644\uC804\uD788
      \uB9C8\uBE44\uC2DC\uCF30\uC5B4\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uAC00
      \uC5C6\uC73C\uBA74 \uB2F9\uC7A5\uC774\uB77C\uB3C4 \uAC00\uBB38\uC774 \uBB34\uB108\uC9C8
      \uAC83\uC774\uB77C\uB294 \uACF5\uD3EC\uC5D0 \uC9C8\uB824, \uC601\uC9C0\uC758
      \uBAA8\uB4E0 \uC778\uC7A5\uACFC \uAD8C\uD55C\uC744 \uC720\uD53C\uC758 \uBC1C\uCE58\uC5D0
      \uBC14\uCE58\uBA70 \uB9E4\uB2EC\uB838\uB2F5\uB2C8\uB2E4. \n\uC720\uD53C\uB294
      \uC544\uBCA8\uB9AC\uC544\uC758 \uACF5\uD3EC\uB97C \uB354\uC6B1 \uBD80\uCC44\uC9C8\uD558\uAE30
      \uC704\uD574 \uAC00\uC9DC \uC704\uD611\uC744 \uAFB8\uBA70\uB0C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uD53C\uC758 \uD488 \uC548\uC5D0\uC11C\uB9CC \uC228\uC744 \uC274 \uC218
      \uC788\uB294 \uAC00\uB828\uD55C \uC874\uC7AC\uB85C \uC804\uB77D\uD558\uACE0
      \uB9D0\uC558\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uC81C \uC720\uD53C\uC758
      \uB208\uC9D3 \uD558\uB098\uC5D0 \uBE44\uBA85\uC744 \uC9C0\uB974\uAC70\uB098
      \uD750\uB290\uB07C\uBA70, \uADF8\uB140\uAC00 \uC2DC\uD0A4\uB294 \uAC83\uC774\uB77C\uBA74
      \uC790\uC2E0\uC758 \uC601\uBBFC\uB4E4\uC744 \uC0AC\uC9C0\uB85C \uB0B4\uBAA8\uB294
      \uC77C\uC870\uCC28 \uC11C\uC2B4\uC9C0 \uC54A\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uBC31\uC791\uC800\uB294 \uC720\uD53C\uC758
      \uB73B\uC5D0 \uB530\uB77C \uC6C0\uC9C1\uC774\uB294 \uAC70\uB300\uD55C \uC815\uC2E0\uBCD1\uB3D9\uC774
      \uB418\uC5C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8\uACF3\uC5D0\uC11C
      \uC655\uAD00\uC744 \uC4F4 \uCC44 \uC720\uD53C\uC758 \uBC1C\uC744 \uD565\uB294
      \uAD11\uAE30 \uC5B4\uB9B0 \uC778\uD615\uC774 \uB418\uC5B4\uBC84\uB838\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB140\uB294 \uC790\uC2E0\uC774 \uC9C0\uC625\uC5D0 \uC788\uB2E4\uB294
      \uC0AC\uC2E4\uC870\uCC28 \uC778\uC9C0\uD558\uC9C0 \uBABB\uD55C \uCC44, \uC720\uD53C\uAC00
      \uC8FC\uB294 \uAC00\uC9DC \uC548\uC815\uC5D0 \uCDE8\uD574 \uC11C\uC11C\uD788
      \uC790\uC544\uB97C \uC783\uC5B4\uAC14\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
