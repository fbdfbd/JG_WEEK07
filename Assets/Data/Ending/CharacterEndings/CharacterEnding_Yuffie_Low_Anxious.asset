  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_Low_Anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_low_anxious
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 3
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 5
  _text:
    _title: 
    _body: "\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uD754\uB4E4\uB9AC\uB294
      \uC2EC\uB9AC\uB97C \uD30C\uACE0\uB4E4\uC5B4 \"\uB098\uB9CC\uC774 \uB2F9\uC2E0\uC744
      \uC9C0\uD0AC \uC218 \uC788\uB2E4\"\uACE0 \uC18D\uC0AD\uC600\uC73C\uB098, \uADF9\uC2EC\uD55C
      \uBD88\uC548\uC5D0 \uBE60\uC9C4 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C\uB294
      \uADF8 \uBAA9\uC18C\uB9AC\uC870\uCC28 \uAC70\uB300\uD55C \uC74C\uBAA8\uC758
      \uC77C\uBD80\uB85C \uB4E4\uB838\uC5B4\uC694. \n\uC720\uD53C\uAC00 \uB2E4\uAC00\uC62C\uC218\uB85D
      \uC544\uBCA8\uB9AC\uC544\uB294 \uB85C\uC0AC\uBCA8 \uAC00\uBB38\uC774 \uC790\uC2E0\uC758
      \uC601\uC9C0\uB97C \uD1B5\uC9F8\uB85C \uC9D1\uC5B4\uC0BC\uD0A4\uB824 \uD55C\uB2E4\uB294
      \uACF5\uD3EC\uC5D0 \uD729\uC2F8\uC5EC, \uC720\uD53C\uAC00 \uAC74\uB124\uB294
      \uBAA8\uB4E0 \uD638\uC758\uB97C \uAC70\uBD80\uD558\uACE0 \uC131\uBB38\uC744
      \uAD73\uAC8C \uB2EB\uC544\uAC78\uC5C8\uB2F5\uB2C8\uB2E4. \n\uC720\uD53C\uB294
      \uC544\uBCA8\uB9AC\uC544\uC758 \uAC70\uC808\uC744 \uBAA8\uC695\uC73C\uB85C
      \uBC1B\uC544\uB4E4\uC600\uACE0, \uC2E4\uC81C\uB85C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C
      \uACE0\uB9BD\uC2DC\uD0A4\uAE30 \uC704\uD55C \uC678\uAD50\uC801 \uC555\uBC15\uC744
      \uAC00\uD558\uBA70 \uC544\uBCA8\uB9AC\uC544\uC758 \uD658\uC0C1\uC744 \uD604\uC2E4\uB85C
      \uB9CC\uB4E4\uC5B4\uBC84\uB838\uC5B4\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294
      \uB9E4\uC77C \uBC24 \uC720\uD53C\uC758 \uC5BC\uAD74\uC774 \uAD34\uBB3C\uB85C
      \uBCC0\uD558\uB294 \uC545\uBABD\uC744 \uAFB8\uBA70, \uC601\uBBFC\uB4E4\uC870\uCC28
      \uC720\uD53C\uC758 \uCCA9\uC790\uC77C\uC9C0 \uBAA8\uB978\uB2E4\uB294 \uC0DD\uAC01\uC5D0
      \uC0AC\uB85C\uC7A1\uD600 \uAC00\uD639\uD55C \uAC10\uC2DC\uB97C \uC2DC\uC791\uD588\uC9C0\uC694.
      \n\uACB0\uAD6D \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294 \uC8FC\uC778\uC758 \uB05D\uC5C6\uB294
      \uC758\uC2EC\uACFC \uBD88\uC548 \uC18D\uC5D0\uC11C \uC678\uBD80\uC640 \uC644\uC804\uD788
      \uB2E8\uC808\uB41C \uCC44 \uC11C\uC11C\uD788 \uB9D0\uB77C \uC8FD\uC5B4\uAC00\uB294
      \uB545\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \n\uC544\uBCA8\uB9AC\uC544\uB294
      \uD145 \uBE48 \uC131\uC548\uC5D0\uC11C \uBCF4\uC774\uC9C0 \uC54A\uB294 \uC720\uD53C\uC758
      \uADF8\uB9BC\uC790\uC640 \uC2F8\uC6B0\uBA70, \uC2A4\uC2A4\uB85C \uD30C\uBA78\uC744
      \uD5A5\uD574 \uAC78\uC5B4\uAC00\uB294 \uBE44\uADF9\uC801\uC778 \uBC31\uC791\uC774
      \uB418\uACE0 \uB9D0\uC558\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
