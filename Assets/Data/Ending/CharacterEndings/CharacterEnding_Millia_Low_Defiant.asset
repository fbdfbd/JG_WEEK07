  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_Low_Defiant
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_low_defiant
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 2
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 6
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC31\uC791\uAC00\uB97C \uC625\uC8C4\uC5B4\uC628
      \uBAA8\uB4E0 \uAD00\uC2B5\uACFC \uC0C1\uB2E8\uC758 \uC0C1\uC5C5\uC801 \uACC4\uC57D\uC5D0
      \uACA9\uB82C\uD788 \uBC18\uD56D\uD588\uACE0, \uC774\uB294 \uACE7 \uBCA0\uB974\uB514\uC544
      \uC0C1\uB2E8\uACFC\uC758 \uC804\uBA74\uC801\uC778 \uACB0\uBCC4\uB85C \uC774\uC5B4\uC84C\uC2B5\uB2C8\uB2E4.
      \n\uBC00\uB9AC\uC544\uB294 \uC790\uC2E0\uC758 \uACC4\uC0B0\uB41C \uC81C\uC548\uC744
      \uBB34\uB840\uD558\uAC8C \uAC77\uC5B4\uCC28\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uD0DC\uB3C4\uC5D0 \uBD84\uB178\uD588\uACE0, \uD3C9\uBBFC \uC0C1\uC778\uB4E4\uC758
      \uC5F0\uD569\uC744 \uB3D9\uC6D0\uD574 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uC601\uC9C0\uC758
      \uBAA8\uB4E0 \uBCF4\uAE09\uB85C\uC640 \uC720\uD1B5\uB9DD\uC744 \uCCA0\uC800\uD788
      \uBD95\uAD34\uC2DC\uD0A4\uB294 \uBCF4\uBCF5\uC744 \uC2DC\uC791\uD588\uC9C0\uC694.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uAC00\uBB38\uC758 \uC790\uC874\uC2EC\uC744
      \uB418\uCC3E\uACA0\uB2E4\uBA70 \uAC70\uCE60\uAC8C \uC800\uD56D\uD588\uC73C\uB098,
      \uC790\uBCF8\uC758 \uD798\uC744 \uC55E\uC138\uC6B4 \uBC00\uB9AC\uC544\uC758
      \uACF5\uACA9 \uC55E\uC5D0 \uC601\uC9C0\uC758 \uACBD\uC81C\uB294 \uC21C\uC2DD\uAC04\uC5D0
      \uD30C\uD0C4 \uC9C0\uACBD\uC5D0 \uC774\uB974\uB800\uB2F5\uB2C8\uB2E4. \n\uBC00\uB9AC\uC544\uB294
      \uC544\uBCA8\uB9AC\uC544\uAC00 \uACE0\uD1B5\uBC1B\uB294 \uBAA8\uC2B5\uC744
      \uBCF4\uBA70 \uC138\uC0C1\uC740 \uC758\uC9C0\uB9CC\uC73C\uB85C \uB3CC\uC544\uAC00\uB294
      \uAC83\uC774 \uC544\uB2C8\uB77C\uB294 \uAD50\uD6C8\uC744 \uBF08\uC544\uD504\uAC8C
      \uC0C8\uACA8\uC8FC\uC5C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294 \uACB0\uAD6D
      \uC0AC\uB9C9 \uD55C\uAC00\uC6B4\uB370 \uBC84\uB824\uC9C4 \uC0AC\uC790\uCC98\uB7FC
      \uAD76\uC8FC\uB9B0 \uCC44 \uD640\uB85C \uD3EC\uD6A8\uD558\uAC8C \uB418\uC5C8\uC9C0\uC694.
      \n\uC601\uBBFC\uB4E4\uC740 \uBC31\uC791\uC758 \uBB34\uBAA8\uD55C \uBC18\uD56D
      \uB54C\uBB38\uC5D0 \uC0DD\uC874\uAD8C\uC774 \uC704\uD611\uBC1B\uC790 \uB4F1\uC744
      \uB3CC\uB9AC\uAE30 \uC2DC\uC791\uD588\uACE0, \uBC00\uB9AC\uC544\uB294 \uBB34\uB108\uC9C4
      \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758 \uC794\uD574\uB97C \uD5D0\uAC12\uC5D0
      \uC9D1\uC5B4\uC0BC\uD0AC \uC900\uBE44\uB97C \uB9C8\uCCE4\uB2F5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uC81C \uD145 \uBE48 \uC131\uC5D0\uC11C
      \uBC00\uB9AC\uC544\uAC00 \uBCF4\uB0B8 \uB9C8\uC9C0\uB9C9 \uACBD\uACE0\uC7A5\uC744
      \uCC22\uC5B4\uBC1C\uAE30\uBA70, \uBCF5\uC218\uB9CC\uC744 \uAFC8\uAFB8\uB294
      \uACE0\uB3C5\uD55C \uBC18\uC5ED\uC790\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
