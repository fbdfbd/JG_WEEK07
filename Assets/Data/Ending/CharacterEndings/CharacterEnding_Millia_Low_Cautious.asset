  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_Low_Cautious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_low_cautious
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 2
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 2
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC00\uB9AC\uC544\uAC00 \uAC00\uC838\uC628
      \uBAA8\uB4E0 \uC11C\uB958\uB97C \uB3CB\uBCF4\uAE30\uB85C \uD6D1\uC73C\uBA70,
      \uB2E8 \uD558\uB098\uC758 \uC624\uCC28\uB3C4 \uD5C8\uC6A9\uD558\uC9C0 \uC54A\uACA0\uB2E4\uB294
      \uB4EF \uB0A0\uCE74\uB86D\uAC8C \uB300\uCC98\uD588\uC2B5\uB2C8\uB2E4. \n\uAC70\uB798\uCC98\uC758
      \uC2E0\uC6A9\uB3C4\uAC00 \uD655\uC2E4\uD558\uC9C0 \uC54A\uB2E4\uB294 \uC774\uC720\uB85C
      \uACC4\uC57D\uC744 \uC720\uBCF4\uC2DC\uD0A4\uB294 \uC77C\uC774 \uBC18\uBCF5\uB418\uC5C8\uACE0,
      \uC544\uBCA8\uB9AC\uC544\uC758 \uC9C0\uB098\uCE5C \uC2E0\uC911\uD568 \uB54C\uBB38\uC5D0
      \uC0C1\uB2E8\uC758 \uACF5\uACA9\uC801\uC778 \uD22C\uC790 \uACC4\uD68D\uC740
      \uBC88\uBC88\uC774 \uBB34\uC0B0\uB418\uC5C8\uC9C0\uC694. \n\uBC00\uB9AC\uC544\uB294
      \uB2F5\uB2F5\uD55C \uB4EF \uD55C\uC228\uC744 \uB0B4\uC26C\uBA74\uC11C\uB3C4
      \uADF8\uB140\uC758 \uACB0\uC815\uC744 \uAC70\uC2A4\uB974\uC9C0 \uBABB\uD588\uB2F5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC601\uC9C0\uC758 \uBAA8\uB4E0 \uBB38\uC744
      \uB2EB\uC544\uAC78\uACE0 \uC0C1\uB2E8\uACFC\uC758 \uAC70\uB798\uB9C8\uC800\uB3C4
      \uC544\uC8FC \uC81C\uD55C\uC801\uC778 \uBC94\uC704 \uB0B4\uC5D0\uC11C\uB9CC
      \uD5C8\uAC00\uD558\uBA70 \uC548\uC815\uC744 \uAF80\uD588\uC9C0\uB9CC, \uBCC0\uD654\uB97C
      \uAC70\uBD80\uD55C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uC601\uC9C0\uB294 \uC8FC\uBCC0
      \uC601\uC9C0\uB4E4\uC774 \uBC1C\uC804\uD558\uB294 \uB3D9\uC548 \uD640\uB85C
      \uB0A1\uC740 \uACFC\uAC70\uC758 \uC2DC\uAC04\uC5D0 \uBA48\uCDB0 \uC11C\uAC8C
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \n\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uC2E0\uB8B0\uB97C \uC5BB\uAE30 \uC704\uD574 \uC218\uC775\uC131\uBCF4\uB2E4\uB294
      \uC548\uC804\uC131\uC774 \uBCF4\uC7A5\uB41C \uC9C0\uB8E8\uD55C \uBB3C\uD488\uB4E4\uB9CC
      \uB0A9\uD488\uD558\uAE30 \uC2DC\uC791\uD588\uACE0, \uC601\uC9C0\uC758 \uACBD\uC81C\uB294
      \uC11C\uC11C\uD788 \uD65C\uAE30\uB97C \uC783\uC5B4\uAC14\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294
      \uB9E4\uC77C \uBC24 \uC131\uBCBD \uC704\uC5D0\uC11C \uC7A0\uC7AC\uC801\uC778
      \uC801\uB4E4\uC744 \uACBD\uACC4\uD558\uACE0 \uC788\uC9C0\uB9CC, \uC815\uC791
      \uC601\uC9C0\uB294 \uC544\uBB34\uB7F0 \uC704\uD611\uB3C4, \uC544\uBB34\uB7F0
      \uAE30\uD68C\uB3C4 \uC5C6\uB294 \uC8FD\uC5B4\uAC00\uB294 \uB545\uC774 \uB418\uC5B4\uBC84\uB838\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
