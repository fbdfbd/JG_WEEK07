  _maxMeetCount: -1
  _directionType: 2
  _text:
    _title: 
    _body: "\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uC9C0\uB3C5\uD55C
      \uC2E0\uC911\uD568\uC744 \uC774\uC6A9\uD574 \uADF8\uB140\uAC00 \uB85C\uC0AC\uBCA8
      \uC5C6\uC774\uB294 \uD55C \uAC78\uC74C\uB3C4 \uBC16\uC73C\uB85C \uB098\uAC00\uC9C0
      \uBABB\uD558\uAC8C \uB9CC\uB4DC\uB294 \uC2EC\uB9AC\uC801 \uAC70\uC138\uC5D0
      \uC131\uACF5\uD588\uC2B5\uB2C8\uB2E4. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uAC00
      \uC124\uACC4\uD55C '\uC644\uBCBD\uD55C \uBCF4\uD638' \uCCB4\uACC4\uC5D0 \uC555\uB3C4\uB418\uC5B4,
      \uADF8\uB140\uC758 \uAC10\uC2DC\uAC00 \uC5C6\uB294 \uACF3\uC5D0\uC11C\uB294
      \uADF9\uC2EC\uD55C \uACF5\uD3EC\uB97C \uB290\uB07C\uB294 \uC9C0\uACBD\uC5D0
      \uC774\uB974\uB800\uC9C0\uC694. \n\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uBAA8\uB4E0 \uBE44\uC11C\uC640 \uAC00\uC2E0\uC744 \uB85C\uC0AC\uBCA8\uC758
      \uC0AC\uB78C\uB4E4\uB85C \uAD50\uCCB4\uD558\uBA70 \"\uC774\uAC8C \uAC00\uC7A5
      \uC548\uC804\uD55C \uAE38\uC774\uC57C\"\uB77C\uACE0 \uC18D\uC0AD\uC600\uACE0,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uC228 \uB9C9\uD788\uB294 \uD1B5\uC81C\uAC00
      \uC790\uC2E0\uC744 \uC704\uD55C \uD5CC\uC2E0\uC774\uB77C\uACE0 \uAD73\uAC8C
      \uBBFF\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \n\uBC31\uC791 \uC9C0\uC704\uB97C \uBB3C\uB824\uBC1B\uC740
      \uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uC81C \uC720\uD53C\uC758 \uADF8\uB9BC\uC790
      \uB4A4\uC5D0 \uC228\uC5B4 \uADF8\uB140\uAC00 \uC368\uC900 \uC5F0\uC124\uBB38\uB9CC\uC744
      \uC74A\uC870\uB9AC\uB294 \uC720\uB839 \uAC19\uC740 \uC874\uC7AC\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \n\uADF8\uB140\uB294 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uAC00\uBB38\uC758 \uC778\uC7A5\uC744
      \uC720\uD53C\uC5D0\uAC8C \uB9E1\uAE30\uBA70 \"\uC774\uAC8C \uAC00\uC7A5 \uC548\uC804\uD55C
      \uBCF4\uAD00\uBC95\uC774\uC57C\"\uB77C\uACE0 \uC911\uC5BC\uAC70\uB9AC\uC9C0\uB9CC,
      \uC815\uC791 \uADF8\uB140\uAC00 \uC9C0\uD0A8 \uAC83\uC740 \uAC00\uBB38\uC758
      \uC774\uB984\uBFD0\uC778 \uBE48 \uAECD\uB370\uAE30\uBFD0\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
