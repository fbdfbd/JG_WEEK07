  _maxMeetCount: -1
  _directionType: 1
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC744 \uC804\uC801\uC73C\uB85C
      \uC2E0\uB8B0\uD558\uBA70 \uC790\uC2E0\uC758 \uBAA8\uB4E0 \uD310\uB2E8\uC744
      \uADF8\uC5D0\uAC8C \uB9E1\uACA8\uBC84\uB9AC\uB294 \uAE38\uC744 \uD0DD\uD588\uC2B5\uB2C8\uB2E4.
      \n\uB9AC\uC548\uC740 \uADF8\uB140\uB97C \uB3D5\uACA0\uB2E4\uB294 \uC21C\uC218\uD55C
      \uC758\uB3C4\uB85C \uC2DC\uC791\uD588\uC73C\uB098, \uD669\uC2E4\uC758 \uADF8\uB9BC\uC790\uB294
      \uADF8\uB140\uC758 \uBB34\uC9C0\uB97C \uC774\uC6A9\uD574 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uC601\uC9C0\uB97C \uD669\uC2E4\uC758 \uC18C\uC720\uB098 \uB2E4\uB984\uC5C6\uB294
      \uC0C1\uD0DC\uB85C \uADC0\uC18D\uC2DC\uCF1C \uBC84\uB838\uB2F5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uC81C \uB9AC\uC548\uC774 \uC5C6\uC73C\uBA74
      \uACB0\uC7AC \uC11C\uB958 \uD55C \uC7A5 \uB118\uAE30\uC9C0 \uBABB\uD558\uB294
      \uC0C1\uD0DC\uAC00 \uB418\uC5C8\uACE0, \uB9AC\uC548\uC740 \uC8C4\uCC45\uAC10\uC744
      \uB290\uB07C\uBA74\uC11C\uB3C4 \uADF8\uB140\uB97C '\uBCF4\uD638'\uD55C\uB2E4\uB294
      \uBA85\uBAA9\uD558\uC5D0 \uADF8\uB140\uC758 \uAD8C\uB9AC\uB97C \uD558\uB098\uB458\uC529
      \uAC00\uC838\uC635\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uB9E4\uC77C \uBC24 \uB9AC\uC548\uC774
      \uB4E4\uB824\uC8FC\uB294 \uB2EC\uCF64\uD55C \uD669\uC2E4\uC758 \uC774\uC57C\uAE30\uB9CC\uC744
      \uBBFF\uC73C\uBA70, \uC131\uBB38 \uBC16 \uC601\uBBFC\uB4E4\uC758 \uBE44\uBA85\uC740
      \uB9AC\uC548\uC774 \uC5F0\uC8FC\uD574 \uC8FC\uB294 \uC74C\uC545 \uC18C\uB9AC\uC5D0
      \uBB3B\uD600 \uB4E3\uC9C0 \uBABB\uD558\uAC8C \uB418\uC5C8\uC9C0\uC694. \n\uAC00\uC7A5
      \uC21C\uC218\uD55C \uBBFF\uC74C\uC774 \uBD88\uB7EC\uC628, \uC138\uC0C1\uC5D0\uC11C
      \uAC00\uC7A5 \uC6B0\uC544\uD558\uACE0\uB3C4 \uCC98\uCC38\uD55C \uC885\uC18D\uC758
      \uC2DC\uC791\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
