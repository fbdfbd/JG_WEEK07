  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_High_Anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_high_anxious
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 2
  _minMeetCount: 7
  _maxMeetCount: -1
  _directionType: 5
  _text:
    _title: 
    _body: "\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uB05D\uC5C6\uB294
      \uBD88\uC548\uC744 \uBAA9\uACA9\uD558\uBA70, \uADF8\uB140\uB97C \uD5A5\uD55C
      \uB4A4\uD2C0\uB9B0 \uB3C5\uC810\uC695\uACFC \uC5F0\uBBFC\uC774 \uACB0\uD569\uD55C
      \uAE30\uAD34\uD55C \uBCF4\uD638 \uAD00\uACC4\uB97C \uD615\uC131\uD588\uC2B5\uB2C8\uB2E4.
      \n\uADF8\uB140\uB294 \uBC14\uAE65\uC138\uC0C1\uC740 \uB108\uBB34 \uC704\uD5D8\uD558\uB2C8
      \uC790\uC2E0\uB9CC\uC774 \uC544\uBCA8\uB9AC\uC544\uB97C \uC9C0\uD0AC \uC218
      \uC788\uB294 \uC720\uC77C\uD55C \uC0AC\uB78C\uC774\uB77C\uBA70, \uB2E4\uB978
      \uB204\uAD6C\uC758 \uB9D0\uB3C4 \uB4E3\uC9C0 \uB9D0\uB77C\uACE0 \uB04A\uC784\uC5C6\uC774
      \uC18D\uC0AD\uC600\uC9C0\uC694. \n\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uACF5\uD3EC\uB97C \uC7A0\uC7AC\uC6B4\uB2E4\uB294 \uBA85\uBD84\uC73C\uB85C
      \uADF8\uB140\uC758 \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC744 \uBAA8\uB450 \uC219\uCCAD\uD558\uACE0
      \uC624\uC9C1 \uC790\uC2E0\uB9CC\uC774 \uC544\uBCA8\uB9AC\uC544\uC758 \uC720\uC77C\uD55C
      \uAD6C\uC6D0\uC790\uAC00 \uB418\uB3C4\uB85D \uD658\uACBD\uC744 \uC870\uC791\uD588\uB2F5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uC81C \uBC00\uB9AC\uC544\uC758 \uC190\uAE38
      \uC5C6\uC774\uB294 \uC228\uC870\uCC28 \uC81C\uB300\uB85C \uC26C\uC9C0 \uBABB\uD558\uB294
      \uADF9\uC2EC\uD55C \uC758\uC874 \uC0C1\uD0DC\uAC00 \uB418\uC5C8\uC73C\uBA70,
      \uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uBD88\uC548\uC744
      \uC57D\uC810 \uC0BC\uC544 \uADF8\uB140\uB97C \uC790\uC2E0\uC758 \uCE68\uC2E4
      \uC548\uCABD \uAE4A\uC219\uD55C \uACF3\uC5D0 \uAC00\uB450\uC5B4\uBC84\uB838\uC9C0\uC694.
      \n\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uB97C \uD5A5\uD55C \uAD11\uAE30
      \uC5B4\uB9B0 \uC9D1\uCC29\uC73C\uB85C \uC601\uC9C0\uC758 \uBAA8\uB4E0 \uC790\uC6D0\uC744
      \uC624\uC9C1 \uC544\uBCA8\uB9AC\uC544\uB97C \uC548\uC804\uD558\uAC8C \uAC00\uB450\uB294
      \uB370\uB9CC \uC3DF\uC544\uBD80\uC5C8\uACE0, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uBC31\uC791\uC800\uB294 \uC774\uC81C \uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5
      \uD654\uB824\uD558\uACE0 \uC228 \uB9C9\uD788\uB294 \uAC10\uC625\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uB9E4\uC77C \uBC24 \uBC00\uB9AC\uC544\uC758 \uD488 \uC548\uC5D0\uC11C \uB5A8\uBA70
      \uADF8\uB140\uAC00 \uC18D\uC0AD\uC774\uB294 \uBB34\uC11C\uC6B4 \uBBF8\uB798\uC5D0
      \uADC0\uB97C \uAE30\uC6B8\uC774\uACE0, \uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uB208\uBB3C \uC816\uC740 \uC5BC\uAD74\uC744 \uD0D0\uB2C9\uD558\uBA70 \uADF8\uB140\uAC00
      \uC601\uC6D0\uD788 \uBD88\uC548 \uC18D\uC5D0\uC11C \uC790\uC2E0\uB9CC\uC744
      \uAC08\uAD6C\uD558\uAE30\uB97C \uAE30\uB3C4\uD569\uB2C8\uB2E4. \n\uB450 \uC18C\uB140\uB294
      \uC774\uC81C \uACF5\uD3EC\uC640 \uC9D1\uCC29\uC73C\uB85C \uC5EE\uC778 \uC0AC\uC2AC\uC744
      \uBAA9\uC5D0 \uAC74 \uCC44, \uC8FC\uC778\uC744 \uC783\uACE0 \uC790\uBA78\uD574\uAC00\uB294
      \uC601\uC9C0\uC758 \uC911\uC2EC\uC5D0\uC11C \uC11C\uB85C\uB97C \uD30C\uAD34\uC801\uC73C\uB85C
      \uAEF4\uC548\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
