  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_NoCharacter_Anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_no_character_anxious
  _priority: 100
  _isNoCharacterEnding: 1
  _characterType: 1
  _minMeetCount: 0
  _maxMeetCount: 0
  _directionType: 5
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9E4\uC77C \uBC24 \uC790\uC2E0\uC758
      \uC655\uC88C\uAC00 \uBB34\uB108\uC9C0\uB294 \uD658\uCCAD\uC5D0 \uC2DC\uB2EC\uB9AC\uB294,
      \uC81C\uAD6D\uC5D0\uC11C \uAC00\uC7A5 \uC704\uD0DC\uB85C\uC6B4 '\uBE44\uBA85
      \uC9C0\uB974\uB294 \uAD70\uC8FC'\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294
      \uBCF4\uC774\uC9C0 \uC54A\uB294 \uC801\uB4E4\uC758 \uC74C\uBAA8\uB97C \uB9C9\uB294\uB2E4\uB294
      \uBA85\uBD84\uC73C\uB85C \uC601\uBBFC\uB4E4\uC744 \uB04A\uC784\uC5C6\uC774
      \uAC10\uC2DC\uD558\uACE0 \uD639\uB3C5\uD558\uAC8C \uBAB0\uC544\uC138\uC6E0\uC73C\uBA70,
      \uBC31\uC791\uC800\uB294 \uC774\uC81C \uACF5\uD3EC\uC640 \uAE34\uC7A5\uC774
      \uB04A\uC774\uC9C0 \uC54A\uB294 \uC11C\uB298\uD55C \uACF5\uAC04\uC73C\uB85C
      \uBCC0\uD574\uBC84\uB838\uC2B5\uB2C8\uB2E4. \n\uC0AC\uC18C\uD55C \uC2E4\uC218\uC870\uCC28
      \uAC00\uBB38\uC758 \uD30C\uBA78\uB85C \uC774\uC5B4\uC9C8\uAE4C \uB450\uB824\uC6CC
      \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0 \uBABB\uD574 \uD589\uC815\uC740 \uB9C8\uBE44\uB418\uC5C8\uACE0,
      \uADF8\uB140 \uC790\uC2E0\uC740 \uC2DD\uC0AC\uC870\uCC28 \uAE30\uBBF8 \uC5C6\uC774\uB294
      \uD558\uC9C0 \uBABB\uD560 \uC815\uB3C4\uB85C \uC2EC\uAC01\uD55C \uC2E0\uACBD
      \uC1E0\uC57D\uC5D0 \uBE60\uC838 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uBD88\uC548\uD55C
      \uB9C8\uC74C\uC744 \uBD99\uC7A1\uC544\uC904 \uB2E8 \uD55C \uBA85\uC758 \uC774\uD574\uC790\uB3C4
      \uACC1\uC5D0 \uC5C6\uC5C8\uAE30\uC5D0, \uADF8\uB140\uC758 \uC791\uC740 \uB450\uB824\uC6C0\uC740
      \uAC70\uB300\uD55C \uAD34\uBB3C\uC774 \uB418\uC5B4 \uADF8\uB140\uC758 \uC774\uC131\uC744
      \uC7A0\uC2DD\uD574 \uBC84\uB838\uC2B5\uB2C8\uB2E4.\r\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC774\uC81C \uC8FC\uC778\uC758 \uACF5\uD3EC\uC5D0 \uC804\uC5FC\uB418\uC5B4
      \uC0DD\uAE30\uB97C \uC783\uACE0 \uC11C\uC11C\uD788 \uC790\uBA78\uC758 \uAE38\uC744
      \uAC77\uACE0 \uC788\uC73C\uBA70, \uC544\uBCA8\uB9AC\uC544\uB294 \uD145 \uBE48
      \uB208\uC73C\uB85C \uC5B4\uB460 \uC18D\uC5D0\uC11C \uB204\uAD70\uAC00\uC758
      \uADF8\uB9BC\uC790\uB97C \uCC3E\uC73C\uBA70 \uC18C\uB9AC \uC9C0\uB974\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uC131\uC758 \uBAA8\uB4E0 \uCC3D\uBB38\uC744
      \uAC00\uB9B0 \uCC44 \uD640\uB85C \uCD1B\uBD88 \uD558\uB098\uC5D0 \uC758\uC9C0\uD574
      \uBC8C\uBC8C \uB5A8\uBA70, \uC544\uBB34\uB3C4 \uC5C6\uB294 \uBC29 \uC548\uC5D0\uC11C
      \uBCF4\uC774\uC9C0 \uC54A\uB294 \uC801\uB4E4\uACFC \uC2F8\uC6B0\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \n\uADF8\uB140\uC758 \uBE44\uBA85\uC740 \uC131\uBCBD\uC744 \uB118\uC5B4 \uC601\uC9C0
      \uC804\uCCB4\uB97C \uC9D3\uB204\uB974\uB294 \uBB34\uAC70\uC6B4 \uC548\uAC1C\uAC00
      \uB418\uC5C8\uACE0, \uACB0\uAD6D \uC544\uBCA8\uB9AC\uC544\uB294 \uC2A4\uC2A4\uB85C\uB97C
      \uAC00\uC7A5 \uC5B4\uB450\uC6B4 \uBC29\uC548\uC5D0 \uAC00\uB454 \uCC44 \uAC00\uC7A5
      \uBE44\uCC38\uD55C \uC885\uB9D0\uC744 \uAE30\uB2E4\uB9AC\uB294 \uC874\uC7AC\uAC00
      \uB418\uACE0 \uB9D0\uC558\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
