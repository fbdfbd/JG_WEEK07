  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 2
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBAA8\uB4E0 \uC678\uBD80 \uC138\uB825\uC744
      \uACBD\uACC4\uD558\uBA70 \uBE57\uC7A5\uC744 \uAC78\uC5B4 \uC7A0\uAC14\uC9C0\uB9CC,
      \uC720\uD53C\uB9CC\uC740 '\uAC00\uC871 \uAC19\uC740 \uBC30\uB824'\uB77C\uB294
      \uBA85\uBAA9\uC73C\uB85C \uADF8 \uACAC\uACE0\uD55C \uC694\uC0C8 \uC548\uC5D0
      \uBC1C\uC744 \uB4E4\uC774\uB294 \uB370 \uC131\uACF5\uD588\uC2B5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uC758 \uC870\uC5B8\uC774 \uC790\uC2E0\uC758
      \uC601\uC9C0\uB97C \uC9C0\uD0A4\uB294 \uAC00\uC7A5 \uC548\uC804\uD55C \uBC29\uBC95\uC774\uB77C\uACE0
      \uD310\uB2E8\uD588\uACE0, \uC720\uD53C\uB294 \uADF8\uB7F0 \uC544\uBCA8\uB9AC\uC544\uC758
      \uC2E0\uC911\uD568\uC744 '\uACE0\uB9BD'\uC73C\uB85C \uBC14\uAFB8\uC5B4 \uB193\uC558\uC2B5\uB2C8\uB2E4.
      \n\uC720\uD53C\uB294 \"\uB2F9\uC2E0\uC744 \uC704\uD611\uD558\uB294 \uC774\uB4E4\uC774
      \uB108\uBB34 \uB9CE\uC73C\uB2C8, \uC6B0\uB9AC \uAC00\uBB38\uC758 \uBCF4\uD638\uB9C9
      \uB4A4\uB85C \uC228\uC73C\uC138\uC694\"\uB77C\uACE0 \uB04A\uC784\uC5C6\uC774
      \uBD88\uC548\uC744 \uBD80\uCD94\uACBC\uC73C\uBA70, \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8 \uAC10\uC5B8\uC774\uC124\uC5D0 \uC18D\uC544 \uC2A4\uC2A4\uB85C\uB97C
      \uAC00\uB450\uC5C8\uC2B5\uB2C8\uB2E4. \n\uBC31\uC791\uC774 \uB41C \uC544\uBCA8\uB9AC\uC544\uB294
      \uC694\uC0C8 \uC548\uC5D0\uC11C \uC720\uD53C\uAC00 \uD544\uD130\uB9C1\uD574
      \uC8FC\uB294 \uC815\uBCF4\uB9CC\uC744 \uBBFF\uC73C\uBA70 \uC138\uC0C1\uC744
      \uBC14\uB77C\uBCF4\uACE0 \uC788\uC9C0\uB9CC, \uC0AC\uC2E4 \uADF8 \uC694\uC0C8\uC758
      \uC5F4\uC1E0\uB294 \uC774\uBBF8 \uC720\uD53C\uC758 \uC190\uC5D0 \uB118\uC5B4\uAC00
      \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294 \uC790\uC2E0\uC774 \uAC00\uC7A5
      \uC548\uC804\uD55C \uACF3\uC5D0 \uC788\uB2E4\uACE0 \uBBFF\uC73C\uBA70 \uC548\uB3C4\uD558\uACE0
      \uC788\uC9C0\uB9CC, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294 \uC774\uBBF8 \uC678\uBD80\uB85C\uBD80\uD130
      \uACE0\uB9BD\uB418\uC5B4 \uB85C\uC0AC\uBCA8\uC758 \uC601\uD1A0\uB85C \uD761\uC218\uB418\uACE0
      \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
