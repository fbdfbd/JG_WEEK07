  _maxMeetCount: 6
  _directionType: 3
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC00\uB9AC\uC544\uAC00 \uAC00\uC838\uC628
      \uC774\uAD6D\uC801\uC778 \uC720\uBB3C \uC0C1\uC790\uC5D0 \uC2DC\uC120\uC744
      \uBE7C\uC557\uAE34 \uCC44, \uC601\uC9C0 \uBC29\uC5B4 \uC2DC\uC124 \uC608\uC0B0
      \uC804\uC6A9 \uC11C\uB958\uC5D0 \uBB34\uC2EC\uCF54 \uC11C\uBA85\uD588\uC2B5\uB2C8\uB2E4.
      \n\uADF8\uB140\uB294 \uB4E4\uB72C \uBAA9\uC18C\uB9AC\uB85C \uC720\uC801\uC5D0\uC11C
      \uB098\uC628 \uC9C0\uB3C4\uAC00 \uC815\uB9D0 \uBCF4\uBB3C\uB85C \uC774\uC5B4\uC9C0\uB294\uC9C0
      \uAC70\uB4ED \uBB3C\uC5C8\uACE0, \uBC00\uB9AC\uC544\uB294 \uACC4\uC0B0\uC801\uC778
      \uBBF8\uC18C\uB97C \uC9C0\uC73C\uBA70 \uC11C\uBA85\uB9CC \uD558\uBA74 \uC9C0\uB3C4\uB97C
      \uD574\uC11D\uD560 \uC804\uBB38\uAC00\uB4E4\uB3C4 \uC0C1\uB2E8\uC5D0\uC11C
      \uBCF4\uB0B4\uC8FC\uACA0\uB2E4\uACE0 \uBD80\uB4DC\uB7FD\uAC8C \uC18D\uC0AD\uC600\uC9C0\uC694.\n
      \uC544\uBCA8\uB9AC\uC544\uB294 \uC601\uC9C0\uC758 \uD589\uC815\uC740 \uB4B7\uC804\uC73C\uB85C
      \uBBF8\uB904\uB450\uACE0 \uBC00\uB9AC\uC544\uAC00 \uC81C\uACF5\uD558\uB294
      \uAE30\uC774\uD55C \uC815\uBCF4\uC640 \uACE8\uB3D9\uD488\uB4E4\uC744 \uC218\uC9D1\uD558\uB294
      \uB370 \uBAA8\uB4E0 \uC5F4\uC815\uC744 \uC3DF\uC558\uB2F5\uB2C8\uB2E4. \n\uBC00\uB9AC\uC544\uB294
      \uC544\uBCA8\uB9AC\uC544\uC758 \uB05D\uC5C6\uB294 \uD638\uAE30\uC2EC\uC744
      \uC774\uC6A9\uD574 \uC601\uC9C0\uC758 \uC8FC\uC694 \uBD80\uC9C0\uB97C \uD558\uB098\uB458\uC529
      \uC0C1\uB2E8\uC758 \uBA85\uC758\uB85C \uC774\uC804\uC2DC\uCF30\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uC774\uB97C \uC778\uC9C0\uD558\uC9C0 \uBABB\uD55C \uCC44 \uC0C8\uB85C\uC6B4
      \uC720\uBB3C\uC744 \uBC1C\uACAC\uD560 \uB54C\uB9C8\uB2E4 \uC544\uC774\uCC98\uB7FC
      \uAE30\uBED0\uD588\uC2B5\uB2C8\uB2E4. \n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uBC31\uC791\uC800\uB294
      \uC774\uC81C \uAE30\uAD34\uD55C \uC218\uC9D1\uD488\uC73C\uB85C \uAC00\uB4DD
      \uCC2C \uBC15\uBB3C\uAD00\uC774 \uB418\uC5C8\uC9C0\uB9CC, \uC601\uC9C0\uB294
      \uC8FC\uC778\uC744 \uC783\uACE0 \uC0C1\uC778\uB4E4\uC758 \uD0D0\uC695\uC5D0
      \uC758\uD574 \uC870\uAC01\uC870\uAC01 \uCC22\uACA8 \uB098\uAC00\uACE0 \uC788\uC9C0\uC694.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uD145 \uBE48 \uC601\uACE0 \uC704\uC5D0\uC11C
      \uC5EC\uC804\uD788 \uBC00\uB9AC\uC544\uAC00 \uAC00\uC838\uC62C \uB0B4\uC77C\uC758
      \uBBF8\uC2A4\uD130\uB9AC\uB9CC\uC744 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
