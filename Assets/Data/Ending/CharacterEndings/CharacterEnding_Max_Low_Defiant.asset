  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 6
  _text:
    _title: 
    _body: "\uC81C\uAD6D\uC758 \uBAA8\uB4E0 \uC0AC\uC2AC\uC744 \uB04A\uC5B4\uB0B8
      \uC544\uBCA8\uB9AC\uC544\uAC00 \uAD11\uC57C\uC758 \uAC00\uC8FC\uB85C \uC6B0\uB69D
      \uC130\uC744 \uB54C, \uB9C9\uC2A4\uB294 \uADF8\uB140\uC758 \uB300\uB2F4\uD55C
      \uD589\uBCF4\uB97C \uACBD\uACC4\uD558\uBA70 \uAC00\uBB38\uC758 \uC548\uC704\uB97C
      \uC9C0\uD0A4\uB294 \uC2E0\uC911\uD55C \uC911\uC7AC\uC790\uC758 \uC790\uB9AC\uB97C
      \uC9C0\uCF30\uB2F5\uB2C8\uB2E4. \n\uADF8\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00
      \uC81C\uAD6D\uC758 \uBC95\uB839\uC744 \uBD88\uD0DC\uC6B0\uACE0 \uB3C5\uC790\uC801\uC778
      \uC9C8\uC11C\uB97C \uC138\uC6B0\uB294 \uACFC\uC815\uC5D0\uC11C \uBC1C\uD14C\uB9AC\uC628
      \uAC00\uBB38\uC774 \uC785\uC744 \uD0C0\uACA9\uC744 \uCD5C\uC18C\uD654\uD558\uAE30
      \uC704\uD574 \uB04A\uC784\uC5C6\uC774 \uB300\uD654\uC758 \uCC3D\uAD6C\uB97C
      \uC5F4\uC5B4\uB450\uC5C8\uC9C0\uC694. \n\uB9C9\uC2A4\uB294 \uADF8\uB140\uC758
      \uBC18\uC5ED\uC801\uC778 \uAE30\uAC1C\uC5D0 \uAC00\uBB38\uC774 \uD729\uC4F8\uB9AC\uC9C0
      \uC54A\uB3C4\uB85D \uC77C\uC815\uD55C \uAC70\uB9AC\uB97C \uC720\uC9C0\uD558\uBA74\uC11C\uB3C4,
      \uACB0\uC815\uC801\uC778 \uC21C\uAC04\uC5D0\uB294 \uC544\uBCA8\uB9AC\uC544\uC758
      \uD3B8\uC744 \uB4DC\uB294 \uCC99\uD558\uBA70 \uC2E4\uB9AC\uC801\uC778 \uC591\uBCF4\uB97C
      \uC5BB\uC5B4\uB0B4\uC5B4 \uAC00\uBB38\uC758 \uC785\uC9C0\uB97C \uB2E4\uC84C\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC804\uC7C1\uC758 \uC704\uD611
      \uC18D\uC5D0\uC11C\uB3C4 \uAD7D\uD788\uC9C0 \uC54A\uB294 \uBAA8\uC2B5\uC744
      \uBCF4\uBA70 \uADF8\uB140\uC758 \uC6A9\uAE30\uB97C \uB192\uAC8C \uD3C9\uAC00\uD588\uC9C0\uB9CC,
      \uC815\uC791 \uC601\uC9C0\uC758 \uC7AC\uC815\uC801 \uC704\uAE30 \uC55E\uC5D0\uC11C\uB294
      \uB0C9\uC815\uD558\uAC8C \uBC1C\uD14C\uB9AC\uC628\uC758 \uBAAB\uC744 \uBA3C\uC800
      \uCC59\uACBC\uC5B4\uC694. \n\uB9C9\uC2A4\uB294 \uBD88\uAE38\uCC98\uB7FC \uD0C0\uC624\uB974\uB294
      \uC544\uBCA8\uB9AC\uC544\uC758 \uC9D1\uBB34\uC2E4\uC744 \uB098\uC624\uBA70
      \uADF8\uB140\uAC00 \uD63C\uC790 \uC9CA\uC5B4\uC9C4 \uC0AC\uC2AC\uC758 \uBB34\uAC8C\uB97C
      \uC9D0\uC791\uD588\uC9C0\uB9CC, \uC790\uC2E0\uC774 \uAC74\uB12C \uC218 \uC788\uB294
      \uAC83\uC740 \uC624\uC9C1 \uACC4\uC0B0\uB41C \uCE5C\uC808\uBFD0\uC774\uB77C\uB294
      \uC0AC\uC2E4\uC744 \uC501\uC4F8\uD558\uAC8C \uB418\uC0C8\uACBC\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
