  _maxMeetCount: -1
  _directionType: 6
  _text:
    _title: 
    _body: "\uB9AC\uC548\uACFC\uC758 \uB048\uC9C8\uAE34 \uB300\uD654\uB97C \uD1B5\uD574
      \uD669\uC2E4\uC758 \uC57D\uC810\uC744 \uD30C\uC545\uD55C \uC544\uBCA8\uB9AC\uC544\uB294
      \uB9AC\uC548\uC744 \uD3EC\uC12D\uD558\uC5EC \uD669\uC2E4 \uB0B4\uBD80\uB85C\uBD80\uD130\uC758
      \uBD95\uAD34\uB97C \uAF80\uD588\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uB9AC\uC548\uC5D0\uAC8C
      \"\uB2F9\uC2E0\uC774 \uD669\uC2E4\uC5D0\uC11C \uBB34\uC2DC\uB2F9\uD558\uB294
      \uC774\uC720\uB294 \uADF8\uB4E4\uC758 \uB0A1\uC740 \uC9C8\uC11C \uB54C\uBB38\"\uC774\uB77C\uBA70
      \uADF8\uB97C \uC138\uB1CC\uD588\uACE0, \uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uC758
      \uAC15\uB82C\uD55C \uC758\uC9C0\uC5D0 \uB9E4\uB8CC\uB418\uC5B4 \uD669\uC2E4\uC758
      \uBC30\uC2E0\uC790\uAC00 \uB418\uAE30\uB85C \uACB0\uC2EC\uD588\uC9C0\uC694.
      \n\uC774\uC81C \uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC774 \uC81C\uACF5\uD558\uB294
      \uB0B4\uBD80 \uC815\uBCF4\uB97C \uC774\uC6A9\uD574 \uD669\uC2E4\uC758 \uAD8C\uC704\uB97C
      \uD558\uB098\uC529 \uBB34\uB108\uB728\uB9AC\uACE0 \uC788\uC73C\uBA70, \uB9AC\uC548\uC740
      \uC544\uBCA8\uB9AC\uC544\uC758 \uCE7C\uB0A0\uC774 \uB418\uC5B4 \uD669\uC2E4\uC758
      \uC2EC\uC7A5\uC744 \uACA8\uB204\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \n\uB9AC\uC548\uC740
      \uC790\uC2E0\uC774 \uC544\uBCA8\uB9AC\uC544\uB97C \uB3D5\uACE0 \uC788\uB2E4\uACE0
      \uBBFF\uC9C0\uB9CC, \uC0AC\uC2E4 \uADF8\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00
      \uD669\uC2E4\uC744 \uBB34\uB108\uB728\uB9AC\uAE30 \uC704\uD574 \uC0AC\uC6A9\uD558\uB294
      \uAC00\uC7A5 \uB0A0\uCE74\uB86D\uACE0\uB3C4 \uC704\uD5D8\uD55C \uB3C4\uAD6C\uC77C
      \uBFD0\uC785\uB2C8\uB2E4. \n\uC81C\uAD6D\uC740 \uC774\uC81C \uC774 \uB450 \uC0AC\uB78C\uC774
      \uC77C\uC73C\uD0A8 \uBC18\uB780\uC758 \uD3ED\uD48D \uC18D\uC73C\uB85C \uAC00\uB77C\uC549\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
