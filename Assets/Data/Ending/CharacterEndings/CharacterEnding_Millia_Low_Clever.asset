  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 0
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC00\uB9AC\uC544\uAC00 \uAC00\uC838\uC628
      \uC7AC\uC815 \uBCF4\uACE0\uC11C\uC758 \uC5EC\uBC31\uC5D0 \uAE43\uD39C\uC73C\uB85C
      \uC9C1\uC811 \uACC4\uC0B0\uC744 \uACE0\uCCD0 \uC4F0\uBA70 \uCC28\uAC11\uAC8C
      \uC9C8\uBB38\uC744 \uB358\uC84C\uC2B5\uB2C8\uB2E4. \n\uC9C0\uC6D0\uAE08 \uB4A4\uC5D0
      \uC228\uACA8\uC9C4 \uC0C1\uB2E8\uC758 \uB3C5\uC810\uAD8C \uD589\uC0AC \uAE30\uAC04\uC774
      \uC790\uC2E0\uC758 \uACC4\uC0B0\uACFC \uC5B4\uAE0B\uB09C\uB2E4\uB294 \uC9C0\uC801\uC774\uC5C8\uC9C0\uC694.
      \n\uBC00\uB9AC\uC544\uB294 \uB2F9\uD669\uD558\uC9C0 \uC54A\uACE0 \uCC3B\uC794\uC744
      \uB0B4\uB824\uB193\uC73C\uBA70, \uC0C1\uB2E8\uC758 \uC790\uAE08 \uC5C6\uC774\uB294
      \uC774\uBC88 \uBD84\uAE30 \uC601\uC9C0 \uBCF4\uC218\uB3C4 \uBD88\uAC00\uB2A5\uD560
      \uAC70\uB77C \uB9DE\uBC1B\uC544\uCCE4\uC2B5\uB2C8\uB2E4. \n\uB450 \uC0AC\uB78C\uC740
      \uBC24\uC774 \uAE4A\uB3C4\uB85D \uC9D1\uBB34\uC2E4 \uB4F1\uBD88 \uC544\uB798\uC11C
      \uB2E8 \uD55C \uC870\uAC01\uC758 \uC774\uAD8C\uC744 \uB354 \uCC28\uC9C0\uD558\uAE30
      \uC704\uD574 \uC22B\uC790\uB85C \uC2F8\uC6C0\uC744 \uC774\uC5B4\uAC14\uB2F5\uB2C8\uB2E4.
      \n\uACB0\uAD6D \uC544\uBCA8\uB9AC\uC544\uB294 \uC0C1\uB2E8\uC758 \uC9C0\uC6D0\uC744
      \uBC1B\uC544\uB0B4\uB294 \uB300\uC2E0, \uC601\uC9C0\uC758 \uC8FC\uC694 \uAD11\uC0B0
      \uCC44\uAD74\uAD8C\uC744 \uC77C\uC815 \uAE30\uAC04 \uB118\uACA8\uC8FC\uB294
      \uD0C0\uD611\uC548\uC5D0 \uC11C\uBA85\uD588\uC2B5\uB2C8\uB2E4. \n\uC774\uC81C
      \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uC601\uC9C0\uB294 \uC81C\uAD6D \uBD81\uBD80\uC5D0\uC11C
      \uAC00\uC7A5 \uD6A8\uC728\uC801\uC778 \uAE30\uACC4 \uC7A5\uCE58\uCC98\uB7FC
      \uB3CC\uC544\uAC00\uC9C0\uB9CC, \uC544\uBCA8\uB9AC\uC544\uC640 \uBC00\uB9AC\uC544
      \uC0AC\uC774\uC5D0\uB294 \uC6B0\uC815 \uB300\uC2E0 \uC624\uC9C1 \uCCA0\uC800\uD55C
      \uBE44\uC988\uB2C8\uC2A4\uC801 \uAE34\uC7A5\uAC10\uB9CC\uC774 \uB0A8\uAC8C
      \uB418\uC5C8\uC9C0\uC694. \n\uC601\uBBFC\uB4E4\uC740 \uD48D\uC871\uD55C \uC0DD\uD65C\uC744
      \uBCF4\uC7A5\uBC1B\uC558\uC9C0\uB9CC, \uBC31\uC791\uC758 \uC9D1\uBB34\uC2E4\uC5D0\uC11C
      \uC0C8\uC5B4 \uB098\uC624\uB294 \uC11C\uB298\uD55C \uACC4\uC0B0\uC758 \uAE30\uC6B4\uC5D0
      \uC228\uC744 \uC8FD\uC774\uBA70 \uC0B4\uC544\uAC00\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
