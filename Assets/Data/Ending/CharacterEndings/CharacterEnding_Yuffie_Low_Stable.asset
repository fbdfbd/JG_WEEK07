  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_Low_Stable
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_low_stable
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 3
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 4
  _text:
    _title: 
    _body: "\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uD3C9\uC628\uD55C
      \uAE30\uC9C8\uC744 \uC774\uC6A9\uD574 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uC601\uC9C0\uB97C
      \uB85C\uC0AC\uBCA8 \uAC00\uBB38\uC758 \uD734\uC591\uC9C0\uCC98\uB7FC \uD761\uC218\uD558\uB824\uB294
      \uC57C\uC695\uC744 \uBCF4\uC600\uC5B4\uC694. \n\uD558\uC9C0\uB9CC \uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uD53C\uC758 \uC81C\uC548\uC774 \uAC00\uC838\uC62C \uD30C\uAE09\uD6A8\uACFC\uB97C
      \uCC28\uBD84\uD558\uAC8C \uBD84\uC11D\uD588\uACE0, \uAC00\uBB38\uC758 \uBFCC\uB9AC\uB97C
      \uD754\uB4E4\uC9C0 \uC54A\uB294 \uC120\uC5D0\uC11C\uB9CC \uC815\uC911\uD558\uAC8C
      \uB3C4\uC6C0\uC744 \uC218\uC6A9\uD588\uB2F5\uB2C8\uB2E4. \n\uC720\uD53C\uB294
      \uC790\uC2E0\uC758 \uC601\uD5A5\uB825\uC774 \uC544\uBCA8\uB9AC\uC544\uC758
      \uB2E8\uB2E8\uD55C \uB0B4\uBA74\uC744 \uB6AB\uC9C0 \uBABB\uD558\uB294 \uAC83\uC5D0
      \uC870\uBC14\uC2EC\uC744 \uB290\uAF08\uC9C0\uB9CC, \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8\uC800 \uC628\uD654\uD55C \uBBF8\uC18C\uB85C \uB300\uC751\uD558\uBA70
      \uC120\uC744 \uADF8\uC5C8\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uB85C\uC0AC\uBCA8
      \uAC00\uBB38\uC758 \uBCF4\uD638 \uB300\uC2E0 \uC601\uBBFC\uB4E4\uACFC\uC758
      \uC2E0\uB8B0\uB97C \uBC14\uD0D5\uC73C\uB85C \uC601\uC9C0\uC758 \uC548\uC815\uC744
      \uAF80\uD588\uACE0, \uC720\uD53C\uB294 \uACB0\uAD6D \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C
      \uC644\uC804\uD788 \uC7A5\uC545\uD558\uB294 \uAC83\uC744 \uD3EC\uAE30\uD558\uACE0
      \uB300\uB4F1\uD55C \uC774\uC6C3 \uAC00\uBB38\uC73C\uB85C \uB300\uC6B0\uD558\uAC8C
      \uB418\uC5C8\uB2F5\uB2C8\uB2E4. \n\uACB0\uACFC\uC801\uC73C\uB85C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC5B4\uB5A4 \uC138\uB825\uC5D0\uB3C4 \uCE58\uC6B0\uCE58\uC9C0 \uC54A\uB294
      \uC911\uB9BD\uC801\uC778 \uD3C9\uD654\uB97C \uC720\uC9C0\uD558\uAC8C \uB418\uC5C8\uC73C\uBA70,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uC601\uC9C0\uC758 \uC9C4\uC815\uD55C \uC8FC\uC778\uC73C\uB85C\uC11C
      \uC874\uACBD\uBC1B\uAC8C \uB418\uC5C8\uC5B4\uC694. \n\uC720\uD53C\uB294 \uAC00\uB054
      \uC544\uBCA8\uB9AC\uC544\uB97C \uBC29\uBB38\uD560 \uB54C\uB9C8\uB2E4, \uC790\uC2E0\uC774
      \uACB0\uCF54 \uD1B5\uC81C\uD560 \uC218 \uC5C6\uB294 \uAC70\uB300\uD55C \uB300\uC9C0
      \uAC19\uC740 \uADF8\uB140\uC758 \uC874\uC7AC\uAC10\uC5D0 \uBB18\uD55C \uD328\uBC30\uAC10\uC744
      \uB290\uB080\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
