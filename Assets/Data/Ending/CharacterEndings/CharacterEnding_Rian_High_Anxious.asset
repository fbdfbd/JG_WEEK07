  _maxMeetCount: -1
  _directionType: 5
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC774\uB77C\uB294 \uC874\uC7AC\uB97C
      \uC790\uC2E0\uC758 \uBD88\uC548\uC744 \uC7A0\uC7AC\uC6B8 \uC720\uC77C\uD55C
      '\uC57D'\uC73C\uB85C \uC0BC\uC544, \uADF8\uC5D0\uAC8C \uBCD1\uC801\uC73C\uB85C
      \uC758\uC874\uD558\uAE30 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294
      \uB9AC\uC548\uC774 \uACC1\uC5D0 \uC5C6\uC73C\uBA74 \uC601\uC9C0\uAC00 \uB2F9\uC7A5\uC774\uB77C\uB3C4
      \uBB34\uB108\uC9C8 \uAC83 \uAC19\uC740 \uD658\uAC01\uC5D0 \uC2DC\uB2EC\uB838\uACE0,
      \uB9AC\uC548\uC744 \uACC1\uC5D0 \uB450\uAE30 \uC704\uD574 \uC790\uC2E0\uC758
      \uAD8C\uC704\uC640 \uC601\uC9C0\uC758 \uC774\uAD8C\uC744 \uD558\uB098\uC529
      \uD669\uC2E4\uC5D0 \uC0C1\uB0A9\uD558\uBA70 \uADF8\uC758 \uBCF4\uD638\uB97C
      \uAD6C\uAC78\uD588\uB2F5\uB2C8\uB2E4. \n\uB9AC\uC548\uC740 \uCC98\uC74C\uC5D4
      \uB3D9\uC815\uC2EC\uC73C\uB85C \uADF8\uB140\uB97C \uC9C0\uCF30\uC73C\uB098,
      \uC810\uCC28 \uC790\uC2E0 \uC5C6\uC774\uB294 \uC228\uC870\uCC28 \uC26C\uC9C0
      \uBABB\uD558\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uBAA8\uC2B5\uC5D0 \uAE30\uBB18\uD55C
      \uCC45\uC784\uAC10\uACFC \uD53C\uB85C\uB97C \uB3D9\uC2DC\uC5D0 \uB290\uB07C\uAC8C
      \uB418\uC5C8\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uC81C \uB9AC\uC548\uC758
      \uBC1C\uCE58\uC5D0 \uC5CE\uB4DC\uB824 \"\uB098\uB97C \uBC84\uB9AC\uC9C0 \uB9D0\uC544\uB2EC\uB77C\"\uACE0
      \uC560\uC6D0\uD558\uBA70, \uADF8\uAC00 \uC815\uD574\uC8FC\uB294 \uC0AC\uB78C\uB9CC\uC744
      \uB9CC\uB098\uACE0 \uADF8\uAC00 \uC2DC\uD0A4\uB294 \uB300\uB85C\uB9CC \uC601\uC9C0\uB97C
      \uB2E4\uC2A4\uB9AC\uB294 \uC778\uD615\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \n\uD669\uC2E4\uC740 7\uD669\uC790\uB97C \uD1B5\uD574 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C
      \uC644\uBCBD\uD558\uAC8C \uD1B5\uC81C\uD558\uAC8C \uB418\uC5C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uB9AC\uC548\uC774\uB77C\uB294 \uAC10\uC625 \uC548\uC5D0\uC11C \uC548\uB3C4\uD558\uBA70
      \uC11C\uC11C\uD788 \uC790\uBA78\uC758 \uAE38\uC744 \uAC77\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
