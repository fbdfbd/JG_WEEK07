  m_Name: CharacterEnding_Millia_Low_Stable
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_low_stable
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 2
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 4
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC601\uC9C0\uC758 \uC548\uC815\uC744
      \uCD5C\uC6B0\uC120\uC73C\uB85C \uC0BC\uC73C\uBA70 \uBC00\uB9AC\uC544\uAC00
      \uC81C\uC548\uD558\uB294 \uAE09\uC9C4\uC801\uC778 \uC0C1\uC5C5 \uD655\uC7A5\uC774\uB098
      \uBAA8\uD5D8\uC801\uC778 \uD22C\uC790\uB97C \uBAA8\uB450 \uAC70\uC808\uD558\uB294
      \uC2E0\uC911\uD568\uC744 \uBCF4\uC600\uC2B5\uB2C8\uB2E4. \n\uBC00\uB9AC\uC544\uB294
      \uD669\uAE08\uC54C\uC744 \uB0B3\uB294 \uAC70\uC704\uAC00 \uB420 \uC904 \uC54C\uC558\uB358
      \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uAC00 \uB108\uBB34\uB098\uB3C4 \uC815\uC801\uC778
      \uD3C9\uD654 \uC18D\uC5D0 \uBA38\uBB3C\uC790, \uC544\uBCA8\uB9AC\uC544\uB97C
      \uC57C\uB9DD \uC5C6\uB294 \uC9C0\uB8E8\uD55C \uAD70\uC8FC\uB85C \uCE58\uBD80\uD558\uBA70
      \uC0C1\uB2E8\uC758 \uC8FC\uC694 \uAC70\uC810\uC744 \uB2E4\uB978 \uC601\uC9C0\uB85C
      \uC62E\uACA8\uBC84\uB838\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC0C1\uB2E8\uC758
      \uC790\uBCF8\uC774 \uBE60\uC838\uB098\uAC00\uB294 \uAC83\uC744 \uB2F4\uB2F4\uD788
      \uC9C0\uCF1C\uBCF4\uBA70 \uC601\uC9C0\uC758 \uB0B4\uC2E4\uC744 \uB2E4\uC9C0\uB294
      \uB370 \uC9D1\uC911\uD588\uC73C\uB098, \uACB0\uACFC\uC801\uC73C\uB85C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC81C\uAD6D\uC758 \uAE09\uBCC0\uD558\uB294 \uACBD\uC81C \uD750\uB984\uC5D0\uC11C
      \uC644\uC804\uD788 \uC18C\uC678\uB41C \uB099\uD6C4\uB41C \uC601\uC9C0\uAC00
      \uB418\uC5C8\uB2F5\uB2C8\uB2E4.\n\uBC00\uB9AC\uC544\uB294 \uB354 \uC774\uC0C1
      \uC544\uBCA8\uB9AC\uC544\uB97C \uAC00\uCE58 \uC788\uB294 \uD30C\uD2B8\uB108\uB85C
      \uBCF4\uC9C0 \uC54A\uC73C\uBA70, \uAC00\uB054 \uC18C\uC2DD\uC744 \uB4E4\uC744
      \uB54C\uB9C8\uB2E4 \uC5EC\uC804\uD788 \uADF8 \uC791\uC740 \uC232\uC5D0\uC11C
      \uB3C4\uD1A0\uB9AC\uB098 \uC90D\uACE0 \uC788\uB290\uB0D0\uBA70 \uBE44\uC544\uB0E5\uAC70\uB9AC\uB294
      \uD3B8\uC9C0\uB97C \uBCF4\uB0BC \uBFD0\uC774\uC5C8\uC9C0\uC694. \n\uC544\uBCA8\uB9AC\uC544\uB294
      \uBE44\uB85D \uC601\uBBFC\uB4E4\uC5D0\uAC8C \uC874\uACBD\uBC1B\uB294 \uB530\uB73B\uD55C
      \uAC00\uC8FC\uAC00 \uB418\uC5C8\uC9C0\uB9CC, \uC601\uC9C0\uB294 \uC0C1\uB2E8\uC758
      \uD65C\uAE30\uB97C \uC783\uACE0 \uC11C\uC11C\uD788 \uB299\uC5B4\uAC00\uB294
      \uC815\uCCB4\uB41C \uB545\uC774 \uB418\uC5B4\uBC84\uB838\uC2B5\uB2C8\uB2E4.
      \n\uBC00\uB9AC\uC544\uC640\uC758 \uC778\uC5F0\uC740 \uADF8\uB807\uAC8C \uD3C9\uD589\uC120\uCC98\uB7FC
      \uBA40\uC5B4\uC84C\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294 \uC774\uC81C \uBC00\uB9AC\uC544\uAC00
      \uB450\uACE0 \uAC04 \uB0A1\uC740 \uC7A5\uC2DD\uD568 \uD558\uB098\uB9CC\uC744
      \uCD94\uC5B5\uCC98\uB7FC \uAC04\uC9C1\uD558\uBA70 \uACE0\uC694\uD55C \uD3C9\uD654\uB97C
      \uC9C0\uD0B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
