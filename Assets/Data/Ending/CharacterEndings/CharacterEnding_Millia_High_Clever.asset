  _maxMeetCount: -1
  _directionType: 0
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC00\uB9AC\uC544\uAC00 \uC81C\uC548\uD55C
      \uC0C1\uC5C5 \uB3C4\uC2DC \uAC74\uC124 \uACC4\uD68D\uC548\uC744 \uBCF4\uACE0\uB294
      \uC870\uC6A9\uD788 \uC790\uB9AC\uC5D0\uC11C \uC77C\uC5B4\uB098 \uC9C0\uB3C4\uB97C
      \uD3BC\uCCE4\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uD574\uB2F9 \uC9C0\uC810\uC744
      \uC0C1\uB2E8\uC758 \uBB3C\uB958 \uAC70\uC810\uC73C\uB85C \uC0BC\uB294 \uB300\uC2E0
      \uBC31\uC791\uAC00\uAC00 \uD1B5\uD589\uC138\uC758 3\uD560\uC744 \uC9C1\uC811
      \uAD00\uB9AC\uD558\uACA0\uB2E4\uB294 \uC5ED\uC81C\uC548\uC744 \uB358\uC84C\uC9C0\uC694.
      \n\uBC00\uB9AC\uC544\uB294 \uB9CC\uC871\uC2A4\uB7EC\uC6B4 \uB4EF \uD06C\uAC8C
      \uC6C3\uC73C\uBA70 \uC790\uC2E0\uC758 \uC778\uC7A5\uC744 \uAEBC\uB0B4 \uCC0D\uC5C8\uB2F5\uB2C8\uB2E4.
      \n\uB450 \uC0AC\uB78C\uC740 \uC11C\uB85C\uC758 \uC9C0\uC801 \uB2A5\uB825\uC744
      \uC644\uBCBD\uD55C \uD30C\uD2B8\uB108\uB85C\uC11C \uC778\uC815\uD558\uBA70,
      \uBC31\uC791\uAC00\uC758 \uBC95\uC801 \uAD8C\uC704\uC640 \uC0C1\uB2E8\uC758
      \uACBD\uC81C\uB825\uC744 \uACB0\uD569\uD574 \uC81C\uAD6D \uBD81\uBD80\uC758
      \uC0C1\uAD8C\uC744 \uC644\uC804\uD788 \uC7A5\uC545\uD588\uC2B5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uBC00\uB9AC\uC544\uB97C \uAC00\uBB38\uC758
      \uC720\uC77C\uD55C \uC0C1\uC5C5\uC801 \uB300\uBCC0\uC778\uC73C\uB85C \uC784\uBA85\uD588\uACE0,
      \uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uD1B5\uCE58\uC5D0
      \uBC29\uD574\uAC00 \uB418\uB294 \uC815\uC801\uB4E4\uC758 \uC7AC\uC815\uC744
      \uC740\uBC00\uD558\uAC8C \uBB34\uB108\uB728\uB838\uC9C0\uC694. \n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uC601\uC9C0\uB294 \uC774\uC81C \uD669\uC2E4\uC870\uCC28 \uD568\uBD80\uB85C
      \uAC74\uB4DC\uB9AC\uC9C0 \uBABB\uD558\uB294 \uAC70\uB300\uD55C \uBD80\uC758
      \uC694\uC0C8\uAC00 \uB418\uC5B4 \uC81C\uAD6D \uC804\uCCB4\uC758 \uACBD\uC81C
      \uD750\uB984\uC744 \uC950\uACE0 \uD754\uB4ED\uB2C8\uB2E4. \n\uB450 \uCC9C\uC7AC\uC801\uC778
      \uC5EC\uC131\uC758 \uACB0\uD569\uC740 \uC601\uC9C0\uC5D0 \uC720\uB840\uC5C6\uB294
      \uBC88\uC601\uC744 \uAC00\uC838\uC654\uC9C0\uB9CC, \uADF8 \uBC88\uC601\uC740
      \uC624\uC9C1 \uC22B\uC790\uB85C \uC99D\uBA85\uB418\uB294 \uB0C9\uC815\uD55C
      \uACB0\uACFC\uBB3C\uC77C \uBFD0\uC774\uB78D\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
