  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Max_Low_Anxious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_low_anxious
  _priority: 100
  _isNoCharacterEnding: 0
  _characterType: 1
  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 5
  _text:
    _title: 
    _body: "\uB9E4\uC77C \uBC24 \uACF5\uD3EC\uC5D0 \uB5A8\uBA70 \uD658\uCCAD\uC5D0
      \uC2DC\uB2EC\uB9AC\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uC131\uC5D0\uC11C,
      \uB9C9\uC2A4\uB294 \uADF8\uB140\uC758 \uBD88\uC548\uC744 \uC7A0\uC7AC\uC6CC\uC8FC\uB294
      \uC720\uC77C\uD558\uAC8C \uD5C8\uB77D\uB41C \uC678\uBD80\uC778\uC774\uC790
      \uC815\uC911\uD55C \uBD09\uC2E0\uC73C\uB85C \uB0A8\uC558\uB2F5\uB2C8\uB2E4.
      \n\uADF8\uB294 \uBC31\uC791\uC774 \uC601\uBBFC\uB4E4\uC744 \uAC10\uC2DC\uD558\uACE0
      \uC2A4\uC2A4\uB85C\uB97C \uACE0\uB9BD\uC2DC\uD0A4\uBA70 \uC790\uBA78\uD574\uAC00\uB294
      \uACFC\uC815\uC744 \uB2E4\uC815\uD55C \uBBF8\uC18C\uB85C \uC9C0\uCF1C\uBCF4\uBA70,
      \uADF8 \uD63C\uB780\uC744 \uD2C8\uD0C0 \uC601\uC9C0\uC758 \uD575\uC2EC \uC790\uC0B0\uB4E4\uC744
      \uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC758 \uBA85\uC758\uB85C \uC62E\uAE30\uB294
      \uC791\uC5C5\uC744 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uC9C4\uD589\uD588\uC9C0\uC694.
      \n\uB9C9\uC2A4\uB294 \uC544\uBCA8\uB9AC\uC544\uAC00 \uB204\uAD6C\uB3C4 \uBBFF\uC9C0
      \uBABB\uD558\uACE0 \uC2E0\uACBD \uC1E0\uC57D\uC5D0 \uBE60\uC9C8 \uB54C\uB9C8\uB2E4
      \uADF8\uB140\uC758 \uB450\uB824\uC6C0\uC774 \uD569\uB2F9\uD55C \uAC83\uC774\uB77C\uBA70
      \uC704\uB85C\uD558\uACE0, \uADF8\uB140\uAC00 \uB0B4\uB9AC\uB294 \uAC00\uD639\uD55C
      \uACB0\uC815\uB4E4\uC774 \uAC00\uBB38\uC744 \uC9C0\uD0A4\uB294 \uC720\uC77C\uD55C
      \uBC29\uD328\uB77C\uACE0 \uBD80\uCD94\uACA8 \uADF8\uB140\uB97C \uB354\uC6B1
      \uACE0\uB9BD\uC2DC\uCF30\uB2F5\uB2C8\uB2E4. \n\uADF8\uB294 \uADF8\uB140\uC758
      \uBE44\uBA85\uC774 \uC131\uBCBD\uC744 \uB118\uC9C0 \uBABB\uD558\uB3C4\uB85D
      \uB9C9\uC544\uC8FC\uB294 \uCC99\uD558\uBA74\uC11C \uC0AC\uC2E4\uC740 \uADF8\uB140\uC758
      \uAD11\uAE30\uAC00 \uC601\uC9C0\uC758 \uAE30\uBC18\uC744 \uBB34\uB108\uB728\uB824
      \uAC00\uBB38\uC774 \uADF8 \uD130\uB97C \uCC28\uC9C0\uD558\uAE30\uB9CC\uC744
      \uB048\uC9C8\uAE30\uAC8C \uAE30\uB2E4\uB838\uC5B4\uC694. \n\uB9C9\uC2A4\uB294
      \uC5B4\uB460 \uC18D\uC5D0\uC11C \uB5A8\uACE0 \uC788\uB294 \uC544\uBCA8\uB9AC\uC544\uB97C
      \uB0A8\uACA8\uB454 \uCC44 \uC131\uC744 \uB098\uC11C\uBA70 \uADF8\uB140\uC758
      \uC77C\uADF8\uB7EC\uC9C4 \uC5BC\uAD74\uC744 \uB5A0\uC62C\uB838\uACE0, \uADF8
      \uACE0\uD1B5\uC758 \uC2DC\uC791\uC774 \uC790\uC2E0\uC758 \uC0AC\uC18C\uD55C
      \uC870\uC5B8\uB4E4\uC774\uC5C8\uB2E4\uB294 \uC0AC\uC2E4\uC5D0 \uC7A0\uC2DC
      \uBC1C\uAC78\uC74C\uC744 \uBA48\uCD94\uAE30\uB3C4 \uD588\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
