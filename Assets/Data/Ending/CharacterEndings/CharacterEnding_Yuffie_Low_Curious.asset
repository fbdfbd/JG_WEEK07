  _minMeetCount: 1
  _maxMeetCount: 6
  _directionType: 3
  _text:
    _title: 
    _body: "\uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uC655\uC131\uD55C
      \uD638\uAE30\uC2EC\uC744 \uC774\uC6A9\uD574 \uADF8\uB140\uC758 \uC2DC\uC120\uC744
      \uC601\uC9C0 \uACBD\uC601\uC774 \uC544\uB2CC \uC790\uADF9\uC801\uC774\uACE0
      \uAE30\uC774\uD55C \uC815\uBCF4\uB4E4\uB85C \uB3CC\uB824\uB193\uC558\uC2B5\uB2C8\uB2E4.
      \n\uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uAC00 \uC2AC\uCA4D \uD758\uB9AC\uB294
      \uD6C4\uC791\uAC00\uC758 \uBE44\uC0AC\uB098 \uC0AC\uAD50\uACC4\uC758 \uCD94\uC7A1\uD55C
      \uC18C\uBB38\uB4E4\uC5D0 \uB9E4\uB8CC\uB418\uC5B4, \uC815\uC791 \uC790\uC2E0\uC758
      \uC601\uC9C0\uAC00 \uC5B4\uB5BB\uAC8C \uCE68\uD0C8\uB2F9\uD558\uACE0 \uC788\uB294\uC9C0
      \uC0B4\uD544 \uAE30\uD68C\uB97C \uB193\uCCD0\uBC84\uB838\uC9C0\uC694. \n\uC720\uD53C\uB294
      \"\uC544\uBCA8\uB9AC\uC544, \uC774\uB7F0 \uAC74 \uB2F9\uC2E0\uB9CC \uC54C\uACE0
      \uC788\uC5B4\uC57C \uD574\uC694\"\uB77C\uBA70 \uD2B9\uBCC4\uD55C \uC720\uB300\uAC10\uC744
      \uC2EC\uC5B4\uC8FC\uC5C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uC9DC\uB9BF\uD55C
      \uBE44\uBC00 \uACF5\uC720\uC5D0 \uC911\uB3C5\uB418\uC5B4 \uC720\uD53C\uB97C
      \uCD5C\uACE0\uC758 \uCE5C\uAD6C\uB77C \uBBFF\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \n\uBC31\uC791\uC774 \uB41C \uB4A4\uC5D0\uB3C4 \uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uD53C\uAC00 \uAC00\uC838\uC624\uB294 \uC0C8\uB85C\uC6B4 '\uD765\uBBF8
      \uAC70\uB9AC'\uC5D0 \uBAA8\uB4E0 \uC2DC\uAC04\uC744 \uC3DF\uC73C\uBA70, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758
      \uACB0\uC7AC \uC11C\uB958 \uC704\uC5D0\uB294 \uC720\uD53C\uC758 \uC190\uC790\uAD6D\uB9CC
      \uAC00\uB4DD\uD574\uC84C\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uC720\uD53C\uAC00
      \uC5F4\uC5B4\uC900 \uC0C8\uB85C\uC6B4 \uC138\uACC4\uC5D0 \uAC10\uD0C4\uD558\uACE0
      \uC788\uC9C0\uB9CC, \uADF8 \uC138\uACC4\uB294 \uC0AC\uC2E4 \uC544\uBCA8\uB9AC\uC544\uB97C
      \uAC00\uBB38\uC5D0\uC11C \uACA9\uB9AC\uD558\uAE30 \uC704\uD574 \uB9CC\uB4E0
      \uD654\uB824\uD55C \uAC10\uC625\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
