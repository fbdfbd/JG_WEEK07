  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_NoCharacter_Defiant
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_no_character_defiant
  _priority: 100
  _isNoCharacterEnding: 1
  _characterType: 1
  _minMeetCount: 0
  _maxMeetCount: 0
  _directionType: 6
  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC81C\uAD6D\uC758 \uBAA8\uB4E0 \uAD8C\uC704\uC640
      \uAD00\uC2B5\uC5D0 \uC815\uBA74\uC73C\uB85C \uB3C4\uC804\uD558\uB294, \uBD81\uBD80\uC758
      '\uACE0\uB3C5\uD55C \uBC18\uC5ED\uC790'\uB85C \uBD88\uB9AC\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \n\uADF8\uB140\uB294 \uC131\uC778\uC2DD \uB0A0 \uC790\uC2E0\uC744 \uC5B5\uB20C\uB7EC\uC628
      \uBAA8\uB4E0 \uAC00\uBB38\uC758 \uC870\uC57D\uACFC \uC608\uBC95 \uC11C\uB958\uB4E4\uC744
      \uAD11\uC7A5\uC5D0 \uBAA8\uC544 \uBD88\uD0DC\uC6E0\uACE0, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB9CC\uC758
      \uB3C5\uC790\uC801\uC778 \uBC95\uACFC \uC9C8\uC11C\uB97C \uC120\uD3EC\uD558\uC5EC
      \uC81C\uAD6D \uC804\uCCB4\uB97C \uACBD\uC545\uCF00 \uD588\uC2B5\uB2C8\uB2E4.
      \n\uADF8\uB140\uC758 \uC0AC\uC804\uC5D0\uB294 \uB354 \uC774\uC0C1 \uD0C0\uD611\uC774\uB098
      \uC591\uBCF4\uB780 \uC874\uC7AC\uD558\uC9C0 \uC54A\uC73C\uBA70, \uC624\uC9C1
      \uC790\uC2E0\uC758 \uC790\uC720\uB97C \uCE68\uD574\uD558\uB294 \uBAA8\uB4E0
      \uAC83\uC5D0 \uCE7C\uB0A0\uC744 \uD718\uB450\uB974\uB294 \uAC15\uC778\uD55C
      \uD1B5\uCE58\uB97C \uC774\uC5B4\uAC11\uB2C8\uB2E4.\r\n\uADF8\uB140\uC758 \uB0A0
      \uC120 \uB9C8\uC74C\uC744 \uBD80\uB4DC\uB7FD\uAC8C \uB179\uC5EC\uC904 \uCE5C\uAD6C\uB098
      \uC774\uC131\uC801\uC73C\uB85C \uC870\uC5B8\uD574 \uC904 \uD30C\uD2B8\uB108\uAC00
      \uB2E8 \uD55C \uBA85\uB3C4 \uC5C6\uC5C8\uAE30\uC5D0, \uC544\uBCA8\uB9AC\uC544\uC758
      \uBC18\uD56D\uC2EC\uC740 \uC8FC\uBCC0\uC758 \uBAA8\uB4E0 \uAC83\uC744 \uBC00\uC5B4\uB0B4\uB294
      \uB0A0\uCE74\uB85C\uC6B4 \uAC00\uC2DC\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uC911\uC559
      \uC815\uBD80\uC758 \uC138\uAE08 \uC9D5\uC218\uB97C \uAC70\uBD80\uD558\uACE0
      \uB3C5\uC790\uC801\uC778 \uAE38\uC744 \uAC77\uB294 \uADF8\uB140\uC758 \uB300\uB2F4\uD568\uC5D0
      \uC601\uBBFC\uB4E4\uC740 \uC5F4\uAD11\uD558\uC9C0\uB9CC, \uC601\uC9C0\uB294
      \uB9E4\uC77C\uAC19\uC774 \uC81C\uAD6D\uAD70\uC758 \uC555\uBC15\uACFC \uC815\uCE58\uC801\uC778
      \uACE0\uB9BD \uC18D\uC5D0 \uB193\uC5EC \uC788\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294
      \uBD80\uC11C\uC9C8\uC9C0\uC5B8\uC815 \uAD7D\uD788\uC9C0 \uC54A\uB294 \uAE30\uAC1C\uB85C
      \uC655\uC88C\uB97C \uC9C0\uD0A4\uACE0 \uC788\uC73C\uBA70, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C
      \uC81C\uAD6D \uC548\uC758 \uC791\uC740 \uB3C5\uB9BD\uAD6D\uCC98\uB7FC \uAC70\uCE60\uACE0
      \uAC15\uD558\uAC8C \uC774\uB04C\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \n\uD558\uC9C0\uB9CC
      \uC2B9\uB9AC \uC5C6\uB294 \uD22C\uC7C1\uC744 \uACC4\uC18D\uD558\uB294 \uADF8\uB140\uC758
      \uB4B7\uBAA8\uC2B5\uC5D0\uB294 \uB204\uAD6C\uB3C4 \uACC1\uC5D0 \uB450\uC9C0
      \uBABB\uD55C \uC790\uC758 \uC9C0\uB3C5\uD55C \uC4F8\uC4F8\uD568\uC774 \uC9D9\uAC8C
      \uBC30\uC5B4 \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
