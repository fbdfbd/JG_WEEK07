  _text:
    _title: 
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uAC10\uC815\uC774 \uAC70\uC138\uB41C
      \uB4EF\uD55C \uC644\uBCBD\uD55C '\uCCA0\uD608\uC758 \uD1B5\uCE58\uC790'\uB85C
      \uAC70\uB4ED\uB0AC\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uC758 \uC9D1\uBB34\uC2E4\uC740
      \uC81C\uAD6D \uBD81\uBD80\uC758 \uBAA8\uB4E0 \uC815\uBCF4\uC640 \uAE08\uC804\uC774
      \uBAA8\uC774\uB294 \uAC70\uB300\uD55C \uACC4\uC0B0\uB300\uAC00 \uB418\uC5C8\uC73C\uBA70,
      \uB2E8 \uD55C \uBF18\uC758 \uD1A0\uC9C0\uB098 \uD55C \uB2E2\uC758 \uB3D9\uC804\uB3C4
      \uADF8\uB140\uC758 \uD5C8\uB77D \uC5C6\uC774\uB294 \uC6C0\uC9C1\uC77C \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4. \n\uBE44\uD6A8\uC728\uC801\uC778 \uC804\uD1B5\uACFC
      \uC4F8\uBAA8\uC5C6\uB294 \uAC00\uC2E0\uB4E4\uC744 \uAC00\uCC28 \uC5C6\uC774
      \uC219\uCCAD\uD55C \uB355\uBD84\uC5D0 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC720\uB840\uC5C6\uB294 \uD669\uAE08\uAE30\uB97C \uB9DE\uC774\uD588\uC9C0\uB9CC,
      \uC601\uBBFC\uB4E4\uC740 \uBC31\uC791\uC758 \uB208\uBE5B\uB9CC \uBCF4\uC544\uB3C4
      \uC5BC\uC5B4\uBD99\uC5B4 \uC228\uC744 \uC8FD\uC785\uB2C8\uB2E4. \n\uADF8\uB140\uB294
      \uC774\uC81C \uC778\uAC04\uC758 \uB9C8\uC74C\uBCF4\uB2E4 \uC7A5\uBD80\uC758
      \uC22B\uC790\uB97C \uB354 \uC2E0\uB8B0\uD558\uBA70, \uC790\uC2E0\uC758 \uC601\uC9C0\uB97C
      \uAC70\uB300\uD55C \uAE30\uACC4 \uC7A5\uCE58\uCC98\uB7FC \uC815\uAD50\uD558\uACE0
      \uCC28\uAC11\uAC8C \uB3CC\uB9AC\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
