  _text:
    _title: "\uB2E8\uB2E8\uD55C \uB300\uC9C0\uC758 \uD3C9\uC628\uD55C \uC9C0\uBC30\uC790"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uC5B4\uB5A4 \uD3ED\uD48D\uC5D0\uB3C4
      \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uBFCC\uB9AC \uAE4A\uC740 \uB098\uBB34
      \uAC19\uC740 \uBC31\uC791\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294
      \uACFC\uAC70\uC758 \uC0C1\uCC98\uC640 \uBBF8\uB798\uC758 \uBD88\uC548\uC744
      \uBAA8\uB450 \uC218\uC6A9\uD558\uC5EC \uC601\uC9C0 \uC804\uCCB4\uC5D0 \uACE0\uC694\uD558\uACE0
      \uB2E8\uB2E8\uD55C \uD3C9\uD654\uB97C \uC815\uCC29\uC2DC\uCF30\uACE0, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC774\uC81C \uC81C\uAD6D\uC5D0\uC11C \uAC00\uC7A5 \uC0B4\uAE30 \uC88B\uACE0
      \uD3C9\uC628\uD55C \uC548\uC2DD\uCC98\uB85C \uC18C\uBB38\uC774 \uB0AC\uC2B5\uB2C8\uB2E4.
      \n\uD654\uB824\uD55C \uC815\uBCF5\uC774\uB098 \uB9C9\uB300\uD55C \uBD80\uB97C
      \uCAD3\uC9C0\uB294 \uC54A\uC9C0\uB9CC, \uADF8\uB140\uB294 \uC601\uBBFC\uB4E4\uC758
      \uB07C\uB2C8\uB97C \uCC59\uAE30\uACE0 \uAC00\uBB38\uC758 \uBFCC\uB9AC\uB97C
      \uC9C0\uD0A4\uB294 \uC77C\uC5D0 \uD5CC\uC2E0\uD558\uBA70 \uC9C4\uC815\uD55C
      \uC874\uACBD\uC744 \uD55C \uBAB8\uC5D0 \uBC1B\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \n\uADF8\uB140\uB294 \uB9E4\uC77C \uC544\uCE68 \uD06C\uB808\uC774\uD504 \uBA38\uD2C0
      \uC544\uB798\uC5D0\uC11C \uCC28\uB97C \uB9C8\uC2DC\uBA70 \uD3C9\uC628\uD558\uAC8C
      \uC601\uC9C0\uB97C \uB0B4\uB824\uB2E4\uBCF4\uACE0, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uADF8\uB140\uC758 \uC628\uD654\uD55C \uD488 \uC548\uC5D0\uC11C \uAC00\uC7A5
      \uC544\uB984\uB2E4\uC6B4 \uC804\uC131\uAE30\uB97C \uB204\uB9AC\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
