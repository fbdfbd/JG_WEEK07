  _text:
    _title: 
    _body: "\uBC31\uC791\uC704\uC5D0 \uC624\uB978 \uC544\uBCA8\uB9AC\uC544\uB294
      \uC601\uC9C0 \uACBD\uC601\uC5D0\uB294 \uD1B5 \uAD00\uC2EC\uC774 \uC5C6\uACE0,
      \uC624\uC9C1 \uC138\uC0C1\uC5D0 \uC54C\uB824\uC9C0\uC9C0 \uC54A\uC740 '\uAE08\uAE30'\uB97C
      \uCC3E\uB294 \uB370 \uBAA8\uB4E0 \uAD8C\uB825\uC744 \uC3DF\uC544\uBD93\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uACE0\uB300\uC758 \uC720\uC801\uC744
      \uD30C\uD5E4\uCE58\uACE0 \uC704\uD5D8\uD55C \uC720\uBB3C\uB4E4\uC744 \uC131\uC548\uC73C\uB85C
      \uB04C\uC5B4\uB4E4\uC600\uC73C\uBA70, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4 \uBC31\uC791\uC800\uB294
      \uC774\uC81C \uC81C\uAD6D\uC5D0\uC11C \uAC00\uC7A5 \uAE30\uC774\uD558\uACE0
      \uACF5\uD3EC\uC2A4\uB7EC\uC6B4 \uBC15\uBB3C\uAD00\uC774 \uB418\uC5B4\uBC84\uB838\uC2B5\uB2C8\uB2E4.
      \n\uC601\uBBFC\uB4E4\uC740 \uBC31\uC791\uC758 \uAE30\uD589 \uB54C\uBB38\uC5D0
      \uBC24\uB9C8\uB2E4 \uC131\uC5D0\uC11C \uB4E4\uB824\uC624\uB294 \uAE30\uAD34\uD55C
      \uC18C\uB9AC\uC5D0 \uB5A8\uBA70 \uC7A0\uC744 \uC124\uCE58\uACE0, \uC601\uC9C0\uC758
      \uD589\uC815\uC740 \uC8FC\uC778\uC744 \uC783\uC740 \uCC44 \uD63C\uB780 \uC18D\uC5D0
      \uBC29\uCE58\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \n\uADF8\uB140\uB294 \uC790\uC2E0\uC758
      \uC774\uB984\uC774 \uC9C0\uB3C4 \uC704\uC5D0\uC11C \uC9C0\uC6CC\uC9C0\uB294
      \uAC83\uBCF4\uB2E4, \uB0B4\uC77C \uB9C8\uC8FC\uD560 \uC0C8\uB85C\uC6B4 \uBBF8\uC2A4\uD130\uB9AC\uC5D0
      \uC790\uC2E0\uC758 \uC601\uD63C\uACFC \uAC00\uBB38\uC744 \uD1B5\uC9F8\uB85C
      \uAC78 \uC900\uBE44\uAC00 \uB418\uC5B4 \uC788\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 0
