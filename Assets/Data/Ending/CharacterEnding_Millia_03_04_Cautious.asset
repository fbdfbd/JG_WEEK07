  _maxMeetCount: 4
  _moodType: 8
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC00\uB9AC\uC544\uAC00 \uAC00\uB974\uCCD0\uC900
      \u2018\uB3C8\uC758 \uC5B8\uC5B4\u2019\uB97C \uC5ED\uC73C\uB85C \uC774\uC6A9\uD574
      \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC744 \uC601\uC9C0\uC758 \uAC70\uB300\uD55C
      \uBC29\uD328\uB85C \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uC0C1\uB2E8\uC758 \uC790\uAE08\uC744 \uBC1B\uC544 \uC601\uC9C0\uB97C \uC7AC\uAC74\uD558\uBA74\uC11C\uB3C4,
      \uACB0\uC815\uC801\uC778 \uC21C\uAC04\uC5D0 \uC0C1\uB2E8\uC758 \uBC1C\uC744
      \uBB36\uC5B4\uBC84\uB9AC\uB294 \uD2B9\uC218 \uC870\uD56D\uC744 \uACC4\uC57D\uC11C
      \uACF3\uACF3\uC5D0 \uC9C0\uB8B0\uCC98\uB7FC \uC2EC\uC5B4\uB450\uC5C8\uC9C0\uC694.\n\uBCA0\uB974\uB514\uC544
      \uC0C1\uB2E8\uC740 \uC790\uC2E0\uB4E4\uC774 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uAC00\uB97C
      \uD0A4\uC6E0\uB2E4\uACE0 \uBBFF\uC5C8\uC9C0\uB9CC, \uACB0\uACFC\uC801\uC73C\uB85C\uB294
      \uC601\uC9C0\uC758 \uBE5A\uB9CC \uD0D5\uAC10\uD574\uC8FC\uACE0 \uCAD3\uACA8\uB098\uB294
      \uC2E0\uC138\uAC00 \uB418\uC5C8\uB2F5\uB2C8\uB2E4.\n\uBC00\uB9AC\uC544\uB294
      \uC544\uBCA8\uB9AC\uC544\uC758 \uC11C\uB298\uD55C \uBC30\uC2E0\uC5D0 \uC785\uC220\uC744
      \uAE68\uBB3C\uC5C8\uC73C\uB098, \uC544\uBCA8\uB9AC\uC544\uB294 \uCC28\uAC00\uC6CC\uC9C4
      \uC190\uB05D\uC744 \uC2DD\uD788\uBA70 \uC774\uBBF8 \uB2E4\uC74C \uC0C1\uB300\uB97C
      \uACE0\uB974\uACE0 \uC788\uC5C8\uC5B4\uC694.\n\uC0AC\uB78C\uB4E4\uC740 \uADF8\uB140\uB97C
      '\uC0C1\uC778\uC758 \uC2EC\uC7A5\uC744 \uAC00\uC9C4 \uBC31\uC791'\uC774\uB77C
      \uBD80\uB974\uBA70, \uADF8\uB140\uC758 \uBBF8\uC18C \uB4A4\uC5D0 \uC228\uACA8\uC9C4
      \uACC4\uC0B0\uAE30\uB97C \uB450\uB824\uC6CC\uD558\uAC8C \uB418\uC5C8\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 1
