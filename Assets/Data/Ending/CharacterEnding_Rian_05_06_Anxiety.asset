  m_Name: CharacterEnding_Rian_05_06_Anxiety
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_rian_05_06_anxiety
  _characterType: 0
  _minMeetCount: 5
  _maxMeetCount: 6
  _moodType: 0
  _text:
    _title: "|- \uB9AC\uC548 \uB9CC\uB0A8 5~6 - \uBD88\uC548"
    _body: "|- \uB9AC\uC548\uC774 \uACF5\uC2DD \uC9C0\uC9C0\uB97C \uC120\uC5B8\uD588\uC744
      \uB54C, \uC544\uBCA8\uB9AC\uC544\uB294 \uC548\uB3C4\uBCF4\uB2E4 \uBA3C\uC800
      \uBB34\uAC70\uC6C0\uC744 \uB290\uAF08\uB2E4. \uC774 \uBCF4\uD638\uAC00 \uC601\uC6D0\uD558\uC9C0
      \uC54A\uB2E4\uB294 \uAC78 \uC54C\uC558\uAE30 \uB54C\uBB38\uC774\uB2E4.\n\uC131\uC778\uC2DD\uC740
      \uC131\uACF5\uC801\uC774\uC5C8\uB2E4. \uBD09\uC2E0\uAC00\uBB38\uC740 \uBB3C\uB7EC\uC130\uACE0,
      \uD6C4\uC791\uAC00\uB3C4 \uD55C \uBC1C \uB4A4\uB85C \uBB3C\uB7EC\uB0AC\uB2E4.
      \uADF8\uB7EC\uB098 \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uBAA8\uB4E0 \uAC83\uC774
      \uB9AC\uC548\uC758 \uC774\uB984 \uB355\uBD84\uC774\uB77C\uB294 \uC0AC\uC2E4\uC744
      \uC54C\uACE0 \uC788\uC5C8\uACE0, \uADF8 \uC0AC\uC2E4\uC774 \uBC24\uB9C8\uB2E4
      \uC7A0\uC744 \uC124\uCE58\uAC8C \uD588\uB2E4.\n\uB9AC\uC548\uC774 \uD669\uC2E4\uB85C
      \uB3CC\uC544\uAC04 \uB4A4, \uC544\uBCA8\uB9AC\uC544\uB294 \uB9E4\uC8FC \uC11C\uC2E0\uC744
      \uBCF4\uB0C8\uB2E4. \uC815\uBB34 \uBCF4\uACE0\uAC00 \uC544\uB2C8\uB77C, \uC790\uC2E0\uC774
      \uC62C\uBC14\uB978 \uACB0\uC815\uC744 \uB0B4\uB9AC\uACE0 \uC788\uB294\uC9C0
      \uD655\uC778\uBC1B\uACE0 \uC2F6\uC740 \uD3B8\uC9C0\uC600\uB2E4. \uB9AC\uC548\uC740
      \uC5B8\uC81C\uB098 \uB2F5\uC7A5\uD588\uB2E4. \uADF8\uB9AC\uACE0 \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8 \uB2F5\uC7A5 \uC5C6\uC774\uB294 \uB2E4\uC74C \uAC78\uC74C\uC744 \uB5BC\uC9C0
      \uBABB\uD588\uB2E4.\n\uBC31\uC791\uB839\uC740 \uC720\uC9C0\uB418\uC5C8\uB2E4.
      \uADF8\uB7EC\uB098 \uADF8\uAC83\uC740 \uC544\uBCA8\uB9AC\uC544\uC758 \uC601\uC9C0\uB77C\uAE30\uBCF4\uB2E4,
      \uB9AC\uC548\uC774\uB77C\uB294 \uBA3C \uACF3\uC758 \uB2FB\uC5D0 \uB9E4\uC5EC
      \uC788\uB294 \uBC30\uC640 \uAC19\uC558\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 2
