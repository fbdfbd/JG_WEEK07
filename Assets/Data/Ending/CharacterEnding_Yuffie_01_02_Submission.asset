  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_01_02_Submission
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_01_02_submission
  _characterType: 3
  _minMeetCount: 1
  _maxMeetCount: 2
  _moodType: 4
  _text:
    _title: "\uC720\uD53C \uB9CC\uB0A8 1~2 - \uC21C\uC751"
    _body: "\uC131\uC778\uC2DD\uC7A5\uC5D0\uC11C \uC720\uD53C\uB294 \uD6C4\uC791\uAC00
      \uB300\uD45C\uC758 \uBC14\uB85C \uC606\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4.
      \uC544\uBCA8\uB9AC\uC544\uC640 \uB208\uC774 \uB9C8\uC8FC\uCCE4\uC744 \uB54C,
      \uC720\uD53C\uB294 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uBBF8\uC18C \uC9C0\uC5C8\uB2E4.
      \uBC30\uC6B4 \uB300\uB85C\uC758 \uBBF8\uC18C\uC600\uB2E4.\n\uC2DD\uC774 \uB05D\uB09C
      \uB4A4, \uD6C4\uC791\uAC00\uB294 '\uCD95\uD558\uC640 \uC6B0\uB824'\uB97C \uB3D9\uC2DC\uC5D0
      \uB2F4\uC740 \uC11C\uC2E0\uC744 \uBCF4\uB0B4\uC654\uB2E4. \uC5B4\uB9B0 \uBC31\uC791\uC774
      \uD640\uB85C \uC601\uC9C0\uB97C \uC774\uB04C\uAE30\uC5D0\uB294 \uACBD\uD5D8\uC774
      \uBD80\uC871\uD558\uB2C8, \uD544\uC694\uD560 \uB54C \uD6C4\uACAC\uC744 \uC81C\uACF5\uD558\uACA0\uB2E4\uB294
      \uB0B4\uC6A9\uC774\uC5C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uC11C\uC2E0\uC744
      \uC11C\uC7AC\uC5D0 \uB450\uACE0 \uC624\uB798 \uBC14\uB77C\uBCF4\uC558\uB2E4.
      \uAC70\uC808\uC758 \uB9D0\uC774 \uB5A0\uC624\uB974\uC9C0 \uC54A\uC558\uB2E4.
      \uAC70\uC808\uD574\uC57C \uD55C\uB2E4\uB294 \uD655\uC2E0\uB3C4 \uC11C\uC9C0
      \uC54A\uC558\uB2E4.\n\uBC31\uC791\uC704\uB294 \uACC4\uC2B9\uB418\uC5C8\uC9C0\uB9CC,
      \uD6C4\uC791\uAC00\uC758 \uC870\uC5B8\uAD00\uC774 \uD55C \uBA85, \uB450 \uBA85
      \uC601\uC9C0\uC5D0 \uBA38\uBB3C\uAE30 \uC2DC\uC791\uD588\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8\uAC83\uC744 \uB3C4\uC6C0\uC774\uB77C\uACE0 \uBD88\uB800\uB2E4. \uC544\uC9C1\uC740."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 4
