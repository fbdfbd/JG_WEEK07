  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_03_04_Bad
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_03_04_bad
  _characterType: 2
  _minMeetCount: 3
  _maxMeetCount: 4
  _moodType: 6
  _text:
    _title: "|- \uBC00\uB9AC\uC544 \uB9CC\uB0A8 3~4 - bad"
    _body: "|- \uBC00\uB9AC\uC544\uC640 \uB098\uB208 \uB300\uD654\uB4E4 \uC18D\uC5D0\uC11C,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uC138\uC0C1\uC744 \uACC4\uC0B0\uD558\uB294
      \uBC95\uC744 \uBC30\uC6E0\uB2E4. \uAC10\uC815\uC774 \uC544\uB2C8\uB77C \uAD6C\uC870\uB85C,
      \uC778\uC0C1\uC774 \uC544\uB2C8\uB77C \uC870\uAC74\uC73C\uB85C.\n\uC0C1\uB2E8\uC774
      \uB0B4\uBD80 \uD68C\uC720\uB97C \uC2DC\uB3C4\uD558\uBA70 \uC720\uB9AC\uD55C
      \uAC70\uB798\uB97C \uC81C\uC548\uD588\uC744 \uB54C, \uC544\uBCA8\uB9AC\uC544\uB294
      \uBC00\uB9AC\uC544\uB77C\uBA74 \uC774 \uC81C\uC548\uC744 \uC5B4\uB5BB\uAC8C
      \uC77D\uC744\uC9C0 \uC0DD\uAC01\uD588\uB2E4. \uADF8\uB9AC\uACE0 \uBB38\uC11C
      \uC18D\uC5D0\uC11C \uBB34\uD6A8\uD654 \uADFC\uAC70\uB97C \uCC3E\uC544\uB0C8\uB2E4.\n\uC0C1\uB2E8\uC758
      \uB17C\uB9AC\uB97C \uC0C1\uB2E8\uC758 \uBC29\uC2DD\uC73C\uB85C \uB418\uB3CC\uB824\uC8FC\uC790,
      \uBC00\uB9AC\uC544\uC5D0\uAC8C\uC11C \uD3B8\uC9C0\uAC00 \uC654\uB2E4. \uC9E7\uC740
      \uAE00\uC774\uC5C8\uB2E4. \"\uB124\uAC00 \uADF8\uAC78 \uCC3E\uC744 \uC904 \uC54C\uC558\uC5B4.\"\n\uBC31\uC791\uB839\uC740
      \uC0C1\uB2E8\uACFC \uAC70\uB798\uB97C \uC720\uC9C0\uD558\uB418, \uADF8 \uAC70\uB798\uC758
      \uC870\uAC74\uC744 \uC544\uBCA8\uB9AC\uC544\uAC00 \uC815\uD558\uB294 \uAD6C\uC870\uB85C
      \uBC14\uB00C\uC5C8\uB2E4. \uBC00\uB9AC\uC544\uAC00 \uC900 \uAC83\uC740 \uB3C8\uC774
      \uC544\uB2C8\uB77C \uB208\uC774\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 1
