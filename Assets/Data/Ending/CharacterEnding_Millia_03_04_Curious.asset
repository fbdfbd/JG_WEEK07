  _maxMeetCount: 4
  _moodType: 7
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uC0C1\uB2E8\uC774 \uBCF4\uC5EC\uC900
      \uB354 \uB113\uC740 \uC138\uACC4\uC640 \uBB34\uD55C\uD55C \uBD80\uC758 \uAC00\uB2A5\uC131\uC5D0
      \uAE4A\uC774 \uB9E4\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uBC31\uC791\uC774 \uB418\uC790\uB9C8\uC790 \uC601\uC9C0\uC758 \uBE44\uC0C1\uAE08\uAE4C\uC9C0
      \uD138\uC5B4 \uC0C1\uB2E8\uC758 \uC0C8\uB85C\uC6B4 \uBB34\uC5ED \uD56D\uB85C
      \uC0AC\uC5C5\uC5D0 \uACF5\uACA9\uC801\uC73C\uB85C \uD22C\uC790\uD558\uB294
      \uD30C\uACA9\uC744 \uC120\uBCF4\uC600\uC9C0\uC694.\n\uACB0\uACFC\uB294 \uCC38\uB2F4\uD55C
      \uB09C\uD30C\uC600\uACE0, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758 \uC7AC\uC815\uC740
      \uD558\uB8E8\uC544\uCE68\uC5D0 \uB3CC\uC774\uD0AC \uC218 \uC5C6\uB294 \uBD80\uCC44\uC758
      \uB2AA\uC73C\uB85C \uBE60\uC838\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uBC31\uC791\uC758 \uAD00\uC744 \uC37C\uC9C0\uB9CC, \uB9E4\uB2EC \uC0C1\uB2E8
      \uC0AC\uC808\uC774 \uAC00\uC838\uC624\uB294 \uC774\uC790 \uCCAD\uAD6C\uC11C\uC5D0
      \uC190\uC744 \uB5A8\uBA70 \uC778\uC7A5\uC744 \uCC0D\uB294 \uCC98\uC9C0\uAC00
      \uB418\uC5C8\uB2F5\uB2C8\uB2E4.\n\uADF8\uB140\uC758 \uD638\uAE30\uC2EC\uC740
      \uC601\uC9C0\uC758 \uC9C0\uB3C4\uB97C \uD48D\uC694\uB86D\uAC8C \uB9CC\uB4DC\uB294
      \uB300\uC2E0, \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uCC44\uAD8C \uC77C\uB78C\uD45C\uB97C
      \uCC44\uC6B0\uB294 \uBD88\uAF43\uC774 \uB418\uC5B4\uBC84\uB838\uC5B4\uC694."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 3
