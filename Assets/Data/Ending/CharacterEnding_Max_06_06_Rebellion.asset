  _moodType: 2
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9C9\uC2A4\uB97C \uAC00\uC7A5 \uB9CE\uC774
      \uB9CC\uB0AC\uC2B5\uB2C8\uB2E4. \uADF8\uB9AC\uACE0 \uBC18\uD56D\uC801\uC774\uC5C8\uAE30\uC5D0
      \u2014\n\uC544\uBCA8\uB9AC\uC544\uB294 \uB9C9\uC2A4\uC640\uC758 \uC624\uB79C
      \uAD50\uAC10\uC744 \uD1B5\uD574 \uC5BB\uC740 \uC815\uBCF4\uC640 \uC778\uB9E5\uC744
      \uB3D9\uC6D0\uD574, \uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC744 \uC601\uC9C0\uC5D0\uC11C
      \uC644\uC804\uD788 \uCD95\uCD9C\uD558\uB294 \uD30C\uACA9\uC801\uC778 \uC120\uD0DD\uC744
      \uB0B4\uB838\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294 \uC131\uC778\uC2DD \uC5F0\uC124\uC5D0\uC11C
      \uBD09\uC2E0 \uAC00\uBB38\uC758 \uCDA9\uC131\uC2EC\uC744 \uACF5\uAC1C\uC801\uC73C\uB85C
      \uC2DC\uD5D8\uD588\uACE0, \uADF8\uB4E4\uC774 \uBA38\uBB47\uAC70\uB9AC\uB294
      \uD2C8\uC744 \uD0C0 \uBAA8\uB4E0 \uC601\uC9C0\uB97C \uC9C1\uD560\uB839\uC73C\uB85C
      \uD68C\uC218\uD574\uBC84\uB838\uC9C0\uC694.\n\uB9C9\uC2A4\uB294 \uADF8\uB140\uC758
      \uBC30\uC2E0\uC5D0 \uC808\uB9DD\uD558\uBA70 \uC601\uC9C0\uB97C \uB5A0\uB0AC\uACE0,
      \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294 \uC81C\uAD6D \uC5ED\uC0AC\uC0C1 \uC720\uB840\uC5C6\uB294
      '\uBD09\uC2E0 \uC5C6\uB294 \uBC31\uC791\uB839'\uC73C\uB85C \uAC70\uB4ED\uB0AC\uC2B5\uB2C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uB3D9\uB8CC\uB97C \uC783\uC740 \uB300\uAC00\uB85C \uC808\uB300\uC801\uC778
      \uAD8C\uB825\uC744 \uC190\uC5D0 \uB123\uC5C8\uC73C\uBA70, \uBD81\uBD80\uC758
      \uBAA8\uB4E0 \uADC0\uC871\uC740 \uADF8\uB140\uC758 \uC774\uB984\uB9CC \uB4E4\uC5B4\uB3C4
      \uBAB8\uC744 \uB5A8\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uAC83\uC740
      \uD53C\uB85C \uC4F4 \uC2B9\uB9AC\uC600\uC73C\uB098, \uC544\uBCA8\uB9AC\uC544\uC758
      \uC655\uC88C\uB294 \uADF8 \uC5B4\uB290 \uB54C\uBCF4\uB2E4 \uB192\uACE0 \uACAC\uACE0\uD588\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
