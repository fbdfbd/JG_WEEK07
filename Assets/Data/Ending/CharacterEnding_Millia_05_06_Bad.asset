  m_Name: CharacterEnding_Millia_05_06_Bad
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_05_06_bad
  _characterType: 2
  _minMeetCount: 5
  _maxMeetCount: 6
  _moodType: 6
  _text:
    _title: "|- \uBC00\uB9AC\uC544 \uB9CC\uB0A8 5~6 - bad"
    _body: "|- \uBC00\uB9AC\uC544\uC640 \uD568\uAED8 \uBB38\uC11C\uB97C \uBD84\uC11D\uD558\uB358
      \uB0A0\uB4E4\uC774 \uC313\uC774\uBA74\uC11C, \uC544\uBCA8\uB9AC\uC544\uC758
      \uB208\uC740 \uBC00\uB9AC\uC544\uC758 \uAC83\uACFC \uB2EE\uC544 \uAC14\uB2E4.
      \uB2E4\uB9CC \uC544\uBCA8\uB9AC\uC544\uB294 \uC22B\uC790\uB9CC \uC77D\uB294
      \uAC83\uC774 \uC544\uB2C8\uB77C, \uC22B\uC790 \uC0AC\uC774\uC5D0 \uC228\uC740
      \uC0AC\uB78C\uC744 \uC77D\uC5C8\uB2E4.\n\uCE74\uB974\uBCF4 \uC0C1\uB2E8\uC774
      \uBD80\uCC44 \uC870\uD56D\uC744 \uB0B4\uBC00\uC5C8\uC744 \uB54C, \uC544\uBCA8\uB9AC\uC544\uB294
      \uBC00\uB9AC\uC544\uAC00 \uC54C\uB824\uC900 \uBB34\uD6A8\uD654 \uBC29\uBC95\uC744
      \uC790\uAE30 \uC2DD\uC73C\uB85C \uB2E4\uB4EC\uC5B4 \uACF5\uAC1C \uC11D\uC0C1\uC5D0\uC11C
      \uC9C1\uC811 \uAEBC\uB0C8\uB2E4.\n\uC0C1\uB2E8\uC740 \uBA85\uBD84\uC744 \uC783\uACE0
      \uBB3C\uB7EC\uC130\uB2E4. \uBC31\uC791\uAC00\uB294 \uBD80\uCC44\uC5D0\uC11C
      \uC790\uC720\uB85C\uC6CC\uC84C\uB2E4.\n\uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544
      \uC606\uC5D0 \uC11C\uC11C \uC870\uC6A9\uD788 \uC6C3\uACE0 \uC788\uC5C8\uB2E4.
      \"\uB108, \uB098\uBCF4\uB2E4 \uC798\uD558\uB294 \uAC70 \uC544\uB2C8\uC57C?\"\n\uC544\uBCA8\uB9AC\uC544\uB3C4
      \uC6C3\uC5C8\uB2E4. \"\uB124\uAC00 \uAC00\uB974\uCCD0\uC900 \uAC70\uC796\uC544.\"\n\uD6D7\uB0A0
      \uB450 \uC0AC\uB78C\uC740 \uAC00\uC7A5 \uC798 \uB9DE\uB294 \uAC70\uB798 \uC0C1\uB300\uB85C
      \uB0A8\uC558\uB2E4. \uB3D9\uB4F1\uD558\uAC8C \uB9C8\uC8FC \uBCF4\uB294 \uC0AC\uC774.
      \uBC00\uB9AC\uC544\uAC00 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C \uBC14\uB780
      \uAC83\uC740, \uC5B4\uCA4C\uBA74 \uCC98\uC74C\uBD80\uD130 \uADF8\uAC83\uC774\uC5C8\uC744\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 1
