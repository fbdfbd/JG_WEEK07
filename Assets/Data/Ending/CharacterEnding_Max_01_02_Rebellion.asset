  m_Name: CharacterEnding_Max_01_02_Rebellion
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_01_02_rebellion
  _priority: 10
  _characterType: 1
  _minMeetCount: 1
  _maxMeetCount: 2
  _moodType: 2
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9C9\uC2A4\uB97C \uAC00\uC7A5 \uB9CE\uC774
      \uB9CC\uB0AC\uC2B5\uB2C8\uB2E4. \uADF8\uB9AC\uACE0 \uBC18\uD56D\uC801\uC774\uC5C8\uAE30\uC5D0
      \u2014\n\uC131\uC778\uC2DD \uB0A0, \uC544\uBCA8\uB9AC\uC544\uB294 \uBC1C\uD14C\uB9AC\uC628
      \uAC00\uBB38\uC774 \uBCF4\uB0B8 \uCD95\uD558 \uC0AC\uC808\uC744 \uC131\uBB38
      \uBC16\uC5D0\uC11C \uB3CC\uB824\uBCF4\uB0C8\uC2B5\uB2C8\uB2E4.\n\uB9C9\uC2A4\uC640\uC758
      \uC9E7\uC740 \uB9CC\uB0A8\uC740 \uADF8\uB140\uC5D0\uAC8C \uB204\uAD70\uAC00\uC758
      \uD638\uC758\uAC00 \uB54C\uB85C\uB294 \uAC70\uCD94\uC7A5\uC2A4\uB7EC\uC6B4
      \uC9D0\uC774 \uB420 \uC218 \uC788\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uAC00\uB974\uCCD0\uC8FC\uC5C8\uAC70\uB4E0\uC694.\n\uADF8\uB140\uB294
      \uBD09\uC2E0 \uAC00\uBB38\uC758 \uB3C4\uC6C0 \uC5C6\uC774 \uD640\uB85C \uC9D1\uBB34\uC2E4\uC758
      \uCD1B\uBD88\uC744 \uCF30\uACE0, \uC790\uC2E0\uC758 \uC601\uC9C0\uAC00 \uAC00\uB09C\uD560\uC9C0\uC5B8\uC815
      \uB204\uAD6C\uC5D0\uAC8C\uB3C4 \uBE5A\uC9C0\uC9C0 \uC54A\uC558\uC74C\uC744
      \uC120\uD3EC\uD588\uC2B5\uB2C8\uB2E4.\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758
      \uC7A5\uBD80\uC5D0\uB294 \uBC1C\uD14C\uB9AC\uC628\uC758 \uC774\uB984 \uB300\uC2E0
      \uC544\uBCA8\uB9AC\uC544\uC758 \uB2E8\uD638\uD55C \uD544\uC801\uB9CC\uC774
      \uB0A8\uC558\uC2B5\uB2C8\uB2E4.\n\uC0AC\uB78C\uB4E4\uC740 \uADF8\uB140\uB97C
      '\uC778\uC0AC\uC870\uCC28 \uBC1B\uC9C0 \uC54A\uB294 \uC624\uB9CC\uD55C \uBC31\uC791'\uC774\uB77C
      \uBD88\uB800\uC9C0\uB9CC, \uADF8\uB140\uB294 \uADF8 \uACE0\uB3C5\uD55C \uC8FC\uAD8C\uC744
      \uAE30\uAEBC\uC774 \uC990\uACBC\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
