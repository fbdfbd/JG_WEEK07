  m_Name: CharacterEnding_Max_01_02_Rebellion
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_01_02_rebellion
  _characterType: 1
  _minMeetCount: 1
  _maxMeetCount: 2
  _moodType: 2
  _text:
    _title: "|- \uB9C9\uC2A4 \uB9CC\uB0A8 1~2 - \uBC18\uD56D"
    _body: "|- \uC131\uC778\uC2DD\uC7A5\uC5D0\uC11C \uBD09\uC2E0\uAC00\uBB38\uC774
      \uC774\uC758\uB97C \uC81C\uAE30\uD588\uC744 \uB54C, \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8 \uB300\uC5F4 \uC18D\uC5D0\uC11C \uB9C9\uC2A4\uB97C \uCC3E\uC558\uB2E4.
      \uB9C9\uC2A4\uB294 \uC544\uBC84\uC9C0 \uC606\uC5D0 \uC11C \uC788\uC5C8\uB2E4.
      \uC2DC\uC120\uC740 \uBC14\uB2E5\uC744 \uD5A5\uD558\uACE0 \uC788\uC5C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uBD09\uC2E0\uAC00\uBB38\uC758 \uC8FC\uC7A5\uC5D0 \uC9C1\uC811 \uB2F5\uD588\uB2E4.
      \uBAA9\uC18C\uB9AC\uB294 \uB0AE\uC558\uC9C0\uB9CC, \uBB3C\uB7EC\uC11C\uC9C0
      \uC54A\uC558\uB2E4. \"\uC774 \uC790\uB9AC\uB294 \uC81C \uAC83\uC785\uB2C8\uB2E4.\"\n\uBD09\uC2E0\uAC00\uBB38\uC740
      \uC989\uC2DC \uBB3C\uB7EC\uC11C\uC9C0\uB294 \uC54A\uC558\uC9C0\uB9CC, \uC544\uBCA8\uB9AC\uC544\uC758
      \uD0DC\uB3C4\uC5D0 \uB354 \uC774\uC0C1 \uBC00\uC5B4\uBD99\uC774\uC9C0 \uBABB\uD588\uB2E4.
      \uB9C9\uC2A4\uB294 \uB05D\uAE4C\uC9C0 \uACE0\uAC1C\uB97C \uB4E4\uC9C0 \uC54A\uC558\uB2E4.\n\uBC31\uC791\uB839\uC740
      \uC544\uBCA8\uB9AC\uC544\uC758 \uAC83\uC774 \uB418\uC5C8\uB2E4. \uAC70\uCE5C
      \uC2DC\uC791\uC774\uC5C8\uC9C0\uB9CC, \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8
      \uAC70\uCE68\uC774 \uC2EB\uC9C0 \uC54A\uC558\uB2E4. \uB204\uAD70\uAC00\uC5D0\uAC8C
      \uD5C8\uB77D\uBC1B\uC740 \uC790\uB9AC\uBCF4\uB2E4, \uC9C1\uC811 \uC9C0\uCF1C\uB0B8
      \uC790\uB9AC\uAC00 \uB354 \uB2E8\uB2E8\uD558\uB2E4\uB294 \uAC83\uC744 \uC54C\uC558\uC73C\uB2C8\uAE4C."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
