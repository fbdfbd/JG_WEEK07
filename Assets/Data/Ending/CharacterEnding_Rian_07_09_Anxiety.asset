  m_Name: CharacterEnding_Rian_07_09_Anxiety
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_rian_07_09_anxiety
  _characterType: 0
  _minMeetCount: 7
  _maxMeetCount: 9
  _moodType: 0
  _text:
    _title: "|- \uB9AC\uC548 \uB9CC\uB0A8 7~9 - \uBD88\uC548"
    _body: "|- \uB9AC\uC548\uC740 \uD669\uC2E4\uC758 \uC815\uD1B5\uC131\uC744 \uAC78\uACE0
      \uC544\uBCA8\uB9AC\uC544\uC758 \uACC4\uC2B9\uC744 \uC120\uD3EC\uD588\uB2E4.
      \uBD09\uC2E0\uAC00\uBB38\uC740 \uD574\uCCB4 \uC218\uC21C\uC5D0 \uB4E4\uC5B4\uAC14\uACE0,
      \uD6C4\uC791\uAC00\uB294 \uACF5\uC2DD\uC801\uC73C\uB85C \uBB3C\uB7EC\uC130\uB2E4.
      \uC544\uBB34\uB3C4 \uC544\uBCA8\uB9AC\uC544\uC758 \uBC31\uC791\uC704\uC5D0
      \uC774\uC758\uB97C \uC81C\uAE30\uD560 \uC218 \uC5C6\uC5C8\uB2E4.\n\uADF8\uB7F0\uB370\uB3C4
      \uC544\uBCA8\uB9AC\uC544\uB294 \uBC24\uB9C8\uB2E4 \uCC3D\uBB38\uC744 \uD655\uC778\uD588\uB2E4.
      \uC7A0\uAE34 \uAC83\uC744 \uD655\uC778\uD558\uACE0, \uB2E4\uC2DC \uD655\uC778\uD558\uACE0,
      \uB610 \uD655\uC778\uD588\uB2E4.\n\uB9AC\uC548\uC774 \uD669\uC2E4\uB85C \uB3CC\uC544\uAC04
      \uB4A4, \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8\uC5D0\uAC8C \uBCF4\uB0B4\uB294
      \uC11C\uC2E0\uC758 \uBE48\uB3C4\uB97C \uC2A4\uC2A4\uB85C \uC904\uC774\uB824
      \uD588\uB2E4. \uC77C\uC8FC\uC77C\uC744 \uBC84\uD17C\uB2E4\uAC00, \uACB0\uAD6D
      \uC5F4\uD758\uC9F8\uC5D0 \uAE34 \uD3B8\uC9C0\uB97C \uC37C\uB2E4. \uB9AC\uC548\uC740
      \uB2E4\uC74C \uB0A0 \uB2F5\uC7A5\uC744 \uBCF4\uB0C8\uB2E4. \uB298 \uADF8\uB7AC\uB4EF\uC774.\n\uBC31\uC791\uB839\uC740
      \uC548\uC804\uD588\uB2E4. \uB204\uAD6C\uB3C4 \uC704\uD611\uD558\uC9C0 \uC54A\uC558\uB2E4.
      \uADF8\uB7EC\uB098 \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uC548\uC804\uC774
      \uC790\uC2E0\uC758 \uAC83\uC774\uB77C\uACE0 \uBBFF\uC9C0 \uBABB\uD588\uB2E4.
      \uB9AC\uC548\uC774 \uB9CC\uB4E4\uC5B4\uC900 \uC6B8\uD0C0\uB9AC \uC548\uC5D0\uC11C,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uC870\uC6A9\uD788 \uC6C5\uD06C\uB9AC\uACE0
      \uC788\uC5C8\uB2E4. \uC6B8\uD0C0\uB9AC \uBC16\uC744 \uB0B4\uB2E4\uBCFC \uC6A9\uAE30\uB294,
      \uC544\uC9C1 \uC624\uC9C0 \uC54A\uC558\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 2
