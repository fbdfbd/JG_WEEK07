  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Rian_07_09_Anxiety
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_rian_07_09_anxiety
  _characterType: 0
  _minMeetCount: 7
  _maxMeetCount: 9
  _moodType: 0
  _text:
    _title: "\uBD88\uC548\uD55C \uC544\uBA5C\uB9AC\uC544"
    _body: "\uB9AC\uC548\uC758 \uB04A\uC784\uC5C6\uB294 \uD638\uC758\uB294 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
      \uAD6C\uC6D0\uC774 \uC544\uB2CC, \uAC70\uBD80\uD560 \uC218 \uC5C6\uB294 \uAC70\uB300\uD55C
      \uADF8\uB9BC\uC790\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uD640\uB85C \uC601\uC9C0\uB97C
      \uCC45\uC784\uC838\uC57C \uD55C\uB2E4\uB294 \uACF5\uD3EC\uC5D0 \uC9D3\uB20C\uB9B0
      \uADF8\uB140\uB294 \uACB0\uAD6D \uBC31\uC791\uC758 \uC778\uC7A5\uC744 \uB9AC\uC548\uC758
      \uC190\uC5D0 \uC950\uC5EC\uC8FC\uBA70, \uAC00\uBB38\uC758 \uBAA8\uB4E0 \uBB34\uAC8C\uB97C
      \uD669\uC2E4\uC5D0 \uB118\uACA8\uBC84\uB9AC\uACE0 \uB9D0\uC558\uC9C0\uC694.\n\uADF8\uAC83\uC740
      \uC560\uC815\uC774 \uC544\uB2C8\uB77C, \uB354\uB294 \uBB34\uB108\uC9C0\uC9C0
      \uC54A\uAE30 \uC704\uD574 \uC120\uD0DD\uD55C \uAC00\uC7A5 \uD654\uB824\uD558\uACE0\uB3C4
      \uBE44\uAC81\uD55C \uD22C\uD56D\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC9C0\uB3C4\uC5D0\uC11C \uC9C0\uC6CC\uC838 \uD669\uC2E4\uC758 \uC77C\uBD80\uAC00
      \uB418\uC5C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294 \uAD81\uC804 \uAE4A\uC740
      \uACF3, \uB204\uAD6C\uB3C4 \uCE68\uBC94\uD560 \uC218 \uC5C6\uB294 \uAC00\uC7A5
      \uC548\uC804\uD55C \uBC29\uC73C\uB85C \uC228\uC5B4\uBC84\uB838\uB2F5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uC774\uC81C \uBB34\uC5C7\uB3C4 \uACB0\uC815\uD560 \uD544\uC694\uAC00 \uC5C6\uB294,
      \uAC00\uC7A5 \uC644\uBCBD\uD558\uAC8C \uBC15\uC81C\uB41C \uBC31\uC791\uC774
      \uB418\uC5B4 \uB0A8\uAC8C \uB418\uC5C8\uC5B4\uC694."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 2
