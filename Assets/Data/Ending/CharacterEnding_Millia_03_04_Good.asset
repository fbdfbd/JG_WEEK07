  m_Name: CharacterEnding_Millia_03_04_Good
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_03_04_good
  _characterType: 2
  _minMeetCount: 3
  _maxMeetCount: 4
