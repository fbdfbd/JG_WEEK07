  _maxMeetCount: 9
  _moodType: 6
  _text:
    _title: "\uBC00\uB9AC\uC544 \uB9CC\uB0A8 7~9 - bad"
    _body: "\uC131\uC778\uC2DD\uC774 \uB05D\uB09C \uB4A4, \uC544\uBCA8\uB9AC\uC544\uB294
      \uCE74\uB974\uBCF4 \uC0C1\uB2E8\uACFC \uC0C8\uB85C\uC6B4 \uD611\uC57D\uC744
      \uC9C1\uC811 \uC124\uACC4\uD588\uB2E4. \uBC00\uB9AC\uC544\uAC00 \uC606\uC5D0\uC11C
      \uC9C0\uCF1C\uBCF4\uC558\uC9C0\uB9CC, \uD39C\uC744 \uB4E0 \uAC83\uC740 \uC544\uBCA8\uB9AC\uC544\uC600\uB2E4.\n\uD611\uC57D\uC758
      \uC870\uAC74\uC740 \uACF5\uC815\uD588\uB2E4. \uBC31\uC791\uAC00\uC5D0 \uC720\uB9AC\uD558\uC9C0\uB3C4,
      \uC0C1\uB2E8\uC5D0 \uC720\uB9AC\uD558\uC9C0\uB3C4 \uC54A\uC558\uB2E4. \uBC00\uB9AC\uC544\uB294
      \uADF8 \uBB38\uC11C\uB97C \uC77D\uACE0 \uB098\uC11C \uCC98\uC74C\uC73C\uB85C
      \uC9C4\uC9C0\uD55C \uD45C\uC815\uC744 \uC9C0\uC5C8\uB2E4.\n\"\uC774\uAC74 \uB0B4\uAC00
      \uC368\uB3C4 \uC774\uB807\uAC8C \uBABB \uC37C\uC744 \uAC70\uC57C.\"\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uB300\uB2F5\uD588\uB2E4. \"\uB124\uAC00 \uC5C6\uC5C8\uC73C\uBA74 \uC4F0\uC9C0\uB3C4
      \uBABB\uD588\uC744 \uAC70\uC57C.\"\n\uD6D7\uB0A0 \uC0C1\uB2E8\uC744 \uBB3C\uB824\uBC1B\uC740
      \uBC00\uB9AC\uC544\uC640, \uBC31\uC791\uB839\uC744 \uC774\uB044\uB294 \uC544\uBCA8\uB9AC\uC544\uB294
      \uC11C\uB85C\uC758 \uC601\uC9C0\uC640 \uC0C1\uB2E8\uC744 \uB3D9\uB4F1\uD558\uAC8C
      \uB9C8\uC8FC \uBCF4\uC558\uB2E4. \uB458 \uC0AC\uC774\uC5D0 \uBE5A\uC740 \uC5C6\uC5C8\uB2E4.
      \uAC70\uB798\uB9CC \uC788\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uADF8 \uAC70\uB798\uBCF4\uB2E4
      \uC624\uB798\uB41C \uC6B0\uC815\uC774 \uC788\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 1
