  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Max_01_02_Anxiety
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_01_02_anxiety
  _characterType: 1
  _minMeetCount: 1
  _maxMeetCount: 2
  _moodType: 0
  _text:
    _title: "\uB9C9\uC2A4 \uB9CC\uB0A8 1~2 - \uBD88\uC548"
    _body: "\uBD09\uC2E0\uAC00\uBB38\uC774 \uC774\uC758\uB97C \uC81C\uAE30\uD588\uC744
      \uB54C, \uC544\uBCA8\uB9AC\uC544\uC758 \uC2DC\uC120\uC740 \uB9C9\uC2A4\uC5D0\uAC8C
      \uB2FF\uC558\uB2E4. \uB9C9\uC2A4\uB294 \uACE0\uAC1C\uB97C \uB4E4\uC9C0 \uC54A\uC558\uB2E4.
      \uADF8 \uCE68\uBB35\uC774 \uB3D9\uC758\uC778\uC9C0 \uAC70\uBD80\uC778\uC9C0
      \uC54C \uC218 \uC5C6\uC5C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294 \uB2F5\uBCC0\uD574\uC57C
      \uD588\uC9C0\uB9CC, \uC785\uC774 \uC5F4\uB9AC\uC9C0 \uC54A\uC558\uB2E4. \uACB0\uAD6D
      \uC784\uC2DC\uAC00\uC8FC\uC758 \uB300\uB9AC\uC778\uC774 \uC808\uCC28\uC801
      \uBC18\uB860\uC744 \uC81C\uAE30\uD558\uC5EC \uC774\uC758\uB294 \uBCF4\uB958\uB418\uC5C8\uB2E4.\n\uBC31\uC791\uC704\uB294
      \uACC4\uC2B9\uB418\uC5C8\uC9C0\uB9CC, \uBD09\uC2E0\uAC00\uBB38\uC740 \uBB3C\uB7EC\uC11C\uC9C0
      \uC54A\uC558\uB2E4. \uC774\uC758\uC81C\uAE30\uB294 '\uBCF4\uB958'\uC77C \uBFD0
      '\uAE30\uAC01'\uC774 \uC544\uB2C8\uC5C8\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
      \uB9E4\uC77C \uC544\uCE68 \uBD09\uC2E0\uAC00\uBB38\uC5D0\uC11C \uC628 \uC11C\uC2E0\uC774
      \uC788\uB294\uC9C0 \uD655\uC778\uD588\uB2E4. \uC5C6\uC73C\uBA74 \uC548\uC2EC\uD588\uACE0,
      \uC788\uC73C\uBA74 \uC5F4\uC9C0 \uBABB\uD55C \uCC44 \uC11C\uB78D\uC5D0 \uB123\uC5C8\uB2E4.\n\uBC31\uC791\uB839\uC740
      \uC870\uC6A9\uD588\uB2E4. \uADF8\uB7EC\uB098 \uADF8 \uC870\uC6A9\uD568\uC740
      \uD3C9\uD654\uAC00 \uC544\uB2C8\uB77C, \uC544\uC9C1 \uD130\uC9C0\uC9C0 \uC54A\uC740
      \uAC83\uC774 \uB0A8\uC544 \uC788\uB2E4\uB294 \uB73B\uC774\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 2
