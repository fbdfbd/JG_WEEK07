  m_Name: CharacterEnding_Max_03_04_Rebellion
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_03_04_rebellion
  _characterType: 1
  _minMeetCount: 3
  _maxMeetCount: 4
  _moodType: 2
  _text:
    _title: "|- \uB9C9\uC2A4 \uB9CC\uB0A8 3~4 - \uBC18\uD56D"
    _body: "|- \uB9C9\uC2A4\uC640\uC758 \uC2DC\uAC04 \uC18D\uC5D0\uC11C \uC544\uBCA8\uB9AC\uC544\uB294
      \uACBD\uC7C1\uC774 \uBB34\uC5C7\uC778\uC9C0\uB97C \uBC30\uC6E0\uB2E4. \uC9C0\uB294
      \uAC83\uC774 \uC2EB\uB2E4\uB294 \uAC10\uC815, \uC774\uAE30\uACE0 \uC2F6\uB2E4\uB294
      \uC695\uC2EC. \uB9C9\uC2A4\uAC00 \uC900 \uC790\uADF9\uC740 \uB0A0\uCE74\uB85C\uC6E0\uC9C0\uB9CC,
      \uC544\uBCA8\uB9AC\uC544\uB97C \uB2E8\uB828\uC2DC\uCF30\uB2E4.\n\uC131\uC778\uC2DD\uC5D0\uC11C
      \uBD09\uC2E0\uAC00\uBB38\uC774 \uB0B4\uBD80 \uD68C\uC720\uB97C \uC2DC\uB3C4\uD588\uC744
      \uB54C, \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uD754\uC801\uC744 \uC9C1\uC811
      \uCC3E\uC544\uB0C8\uB2E4. \uB9E4\uC218\uB41C \uD558\uC778\uC758 \uC774\uB984,
      \uC804\uB2EC\uB41C \uC11C\uC2E0\uC758 \uACBD\uB85C, \uC57D\uC18D\uB41C \uB300\uAC00.
      \uB9C9\uC2A4\uC640 \uACA8\uB8E8\uBA70 \uBC30\uC6B4 \uAC83\uC740 \uCE7C\uC774
      \uC544\uB2C8\uB77C, \uC0C1\uB300\uC758 \uC218\uB97C \uC77D\uB294 \uB208\uC774\uC5C8\uB2E4.\n\"\uB9C9\uC2A4.
      \uB124\uAC00 \uAC00\uB974\uCCD0\uC900 \uAC70\uC57C, \uC54C\uC544?\"\n\uB9C9\uC2A4\uB294
      \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB3CC\uC544\uC11C\uB294 \uB4B7\uBAA8\uC2B5\uC774
      \uC870\uAE08 \uC791\uC544 \uBCF4\uC600\uB2E4.\n\uBC31\uC791\uB839\uC5D0\uC11C
      \uBD09\uC2E0\uAC00\uBB38\uC758 \uC601\uD5A5\uB825\uC740 \uC644\uC804\uD788
      \uAC77\uD600 \uB098\uAC14\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294 \uC2A4\uC2A4\uB85C\uC758
      \uD798\uC73C\uB85C \uC790\uB9AC\uB97C \uC9C0\uCF30\uACE0, \uADF8 \uC790\uB9AC\uC5D0\uC11C
      \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
