  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Max_03_04_Rebellion
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_03_04_rebellion
  _characterType: 1
  _minMeetCount: 3
  _maxMeetCount: 4
  _moodType: 2
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9C9\uC2A4\uC640 \uD568\uAED8 \uBCF4\uB0C8\uB358
      \uACBD\uC7C1\uC758 \uC2DC\uAC04\uB4E4\uC744 \uC601\uB9AC\uD558\uAC8C \uC774\uC6A9\uD588\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uC131\uC778\uC2DD \uC9C1\uD6C4 \uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC774
      \uC694\uAD6C\uD55C \uAD70\uC0AC \uACE0\uBB38\uC9C1\uC744 \uAC70\uC808\uD558\uBA70,
      \uC624\uD788\uB824 \uADF8\uB4E4\uC758 \uC0AC\uBCD1\uB4E4\uC744 \uBC31\uC791
      \uC9C1\uC18D \uAE30\uC0AC\uB2E8\uC73C\uB85C \uAC15\uC81C \uD3B8\uC785\uC2DC\uD0A4\uB294
      \uD30C\uACA9\uC801\uC778 \uBC95\uB839\uC744 \uBC1C\uD45C\uD588\uC9C0\uC694.\n\uB9C9\uC2A4\uB294
      \uB2F9\uD669\uD558\uBA70 \uADF8\uB140\uB97C \uCC3E\uC544\uC654\uC9C0\uB9CC,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8\uC5D0\uAC8C \uCC28\uAC00\uC6B4 \uCC28
      \uD55C \uC794\uB9CC\uC744 \uB0B4\uC5B4\uC900 \uCC44 \uB4F1\uC744 \uB3CC\uB838\uC2B5\uB2C8\uB2E4.\n\uBC1C\uD14C\uB9AC\uC628
      \uAC00\uBB38\uC758 \uBB34\uB825\uC740 \uD558\uB8E8\uC544\uCE68\uC5D0 \uBC31\uC791\uC758
      \uC190\uC544\uADC0\uC5D0 \uC7A5\uC545\uB418\uC5C8\uACE0, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC81C\uAD6D \uBD81\uBD80\uC5D0\uC11C \uAC00\uC7A5 \uAC15\uB825\uD55C \uC911\uC559\uC9D1\uAD8C\uC744
      \uC774\uB8E9\uD588\uC2B5\uB2C8\uB2E4.\n\uC0AC\uB78C\uB4E4\uC740 \uADF8\uB140\uC758
      \uB300\uB2F4\uD568\uC5D0 \uD600\uB97C \uB0B4\uB458\uB800\uACE0, \uB9C9\uC2A4\uB294
      \uD3C9\uC0DD \uADF8\uB140\uC758 \uAC00\uC7A5 \uCDA9\uC2E4\uD558\uBA74\uC11C\uB3C4
      \uAC00\uC7A5 \uB450\uB824\uC6B4 \uC2E0\uD558\uB85C \uB0A8\uAC8C \uB418\uC5C8\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
