  _maxMeetCount: 9
  _moodType: 7
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uAC00 12\uB144 \uB3D9\uC548 \uAC00\uC7A5 \uAC00\uAE4C\uC774
      \uB454 \uC0AC\uB78C\uC740 \uBC00\uB9AC\uC544\uC600\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uD638\uAE30\uC2EC \uAC15\uD55C \uC544\uC774\uB85C \uC790\uB790\uAE30\uC5D0...\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uB3C8\uC774 \uACE7 \uAD8C\uB825\uC774 \uB418\uB294 \uC138\uC0C1\uC758 \uB17C\uB9AC\uC5D0
      \uC644\uC804\uD788 \uC555\uB3C4\uB2F9\uD588\uACE0, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB77C\uB294
      \uB0A1\uC740 \uC774\uB984\uBCF4\uB2E4 \uC0C1\uB2E8\uC758 \uAC70\uB300\uD55C
      \uC790\uBCF8\uC744 \uD0DD\uD588\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294 \uC131\uC778\uC2DD
      \uB0A0 \uBC31\uC791\uC758 \uC9C0\uC704\uB97C \uC601\uAD6C\uD788 \uD3EC\uAE30\uD558\uACE0,
      \uC601\uC9C0 \uC804\uCCB4\uB97C \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758
      '\uC9C1\uC601 \uBB3C\uB958 \uAE30\uC9C0'\uB85C \uB9E4\uAC01\uD558\uB294 \uC804\uB300\uBBF8\uBB38\uC758
      \uACC4\uC57D\uC11C\uC5D0 \uC11C\uBA85\uD588\uC9C0\uC694.\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uBC31\uC791\uB839\uC740 \uC9C0\uB3C4\uC5D0\uC11C \uC601\uC6D0\uD788 \uC0AD\uC81C\uB418\uC5C8\uACE0,
      \uADF8 \uC790\uB9AC\uC5D0\uB294 \uC0C1\uB2E8\uC758 \uAC70\uB300\uD55C \uCC3D\uACE0\uC640
      \uD56D\uAD6C\uB9CC\uC774 \uAC00\uBB38\uC758 \uAE43\uBC1C \uB300\uC2E0 \uC138\uC6CC\uC84C\uB2F5\uB2C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uC0C1\uB2E8\uC758 \uBE44\uACF5\uC2DD \uC774\uC0AC\uAC00 \uB418\uC5B4 \uD654\uB824\uD55C
      \uAE08\uD654 \uC18D\uC5D0 \uD30C\uBB3B\uD614\uC9C0\uB9CC, \uADF8\uB140\uAC00
      \uBC84\uB9B0 \uC601\uD1A0 \uC704\uC5D0\uC11C \uAC00\uC2E0\uB4E4\uC740 \uC774\uB984
      \uC5C6\uB294 \uBD80\uB791\uC790\uAC00 \uB418\uC5B4 \uD769\uC5B4\uC84C\uC5B4\uC694.\n\uADF8\uB140\uB294
      \uC5ED\uC0AC\uC5D0 \uAE30\uB85D\uB41C \uB9C8\uC9C0\uB9C9 \uBC31\uC791\uC774\uC790,
      \uC790\uC2E0\uC758 \uAC00\uBB38\uC744 \uAC00\uC7A5 \uBE44\uC2FC \uAC00\uACA9\uC5D0
      \uD314\uC544\uCE58\uC6B4 \uCD5C\uACE0\uC758 \uC0C1\uC778\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 3
