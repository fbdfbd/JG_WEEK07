  m_Name: CharacterEnding_Max_05_05_Rebellion
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_05_05_rebellion
  _priority: 10
  _characterType: 1
