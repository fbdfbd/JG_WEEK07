  _maxMeetCount: 6
  _moodType: 2
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uAC00 12\uB144 \uB3D9\uC548 \uAC00\uC7A5 \uAC00\uAE4C\uC774
      \uB454 \uC0AC\uB78C\uC740 \uB9C9\uC2A4\uC600\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uBC18\uD56D\uC801\uC778 \uC544\uC774\uB85C \uC790\uB790\uAE30\uC5D0...\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uB9C9\uC2A4\uC640\uC758 \uAE4A\uC740 \uC720\uB300\uAC10\uC744 \uBC14\uD0D5\uC73C\uB85C
      \uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC758 \uB0B4\uBD80 \uC0AC\uC815\uC744
      \uB204\uAD6C\uBCF4\uB2E4 \uC815\uD655\uD788 \uAFF0\uB6AB\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uC131\uC778\uC2DD \uB0A0 \uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC774 \uC601\uC9C0
      \uC8FC\uAD8C\uC744 \uC704\uD611\uD558\uB824 \uB4E4\uC790, \uB9C9\uC2A4\uB97C
      \uBC31\uC791\uC800\uC758 '\uC601\uAD6C\uC801\uC778 \uAD6D\uBE48'\uC73C\uB85C
      \uACF5\uD45C\uD558\uBA70 \uC0AC\uC2E4\uC0C1 \uADF8\uB97C \uC778\uC9C8\uB85C
      \uBD99\uC7A1\uC544\uB450\uC5C8\uC2B5\uB2C8\uB2E4.\n\uAC00\uBB38\uACFC \uC544\uBCA8\uB9AC\uC544
      \uC0AC\uC774\uC5D0\uC11C \uAD34\uB85C\uC6CC\uD558\uB294 \uB9C9\uC2A4\uB97C
      \uBCF4\uBA74\uC11C\uB3C4, \uADF8\uB140\uB294 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758
      \uC8FC\uAD8C\uC744 \uC704\uD574 \uB2E8 \uD55C \uAC78\uC74C\uB3C4 \uBB3C\uB7EC\uC11C\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4.\n\uACB0\uAD6D \uBC1C\uD14C\uB9AC\uC628 \uAC00\uBB38\uC740
      \uD6C4\uACC4\uC790\uC758 \uBAA9\uC228\uC744 \uC704\uD574 \uBC31\uC791\uB839\uC5D0
      \uB300\uD55C \uBAA8\uB4E0 \uAD8C\uB9AC\uB97C \uD3EC\uAE30\uD558\uB294 \uAD74\uC695\uC801\uC778
      \uC870\uC57D\uC5D0 \uC11C\uBA85\uD574\uC57C \uD588\uC9C0\uC694.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uAC00\uC7A5 \uC18C\uC911\uD55C \uCE5C\uAD6C\uB97C \uC0C8\uC7A5\uC5D0 \uAC00\uB454
      \uCC44, \uC81C\uAD6D\uC5D0\uC11C \uAC00\uC7A5 \uC11C\uB298\uD558\uACE0 \uAC15\uB825\uD55C
      \uBC31\uC791\uC73C\uB85C \uAD70\uB9BC\uD558\uAC8C \uB418\uC5C8\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
