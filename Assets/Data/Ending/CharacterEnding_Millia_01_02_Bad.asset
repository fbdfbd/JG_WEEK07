  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_01_02_Bad
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_01_02_bad
  _characterType: 2
  _minMeetCount: 1
  _maxMeetCount: 2
  _moodType: 6
  _text:
    _title: "\uBC00\uB9AC\uC544 \uB9CC\uB0A8 1~2 - bad"
    _body: "\uC131\uC778\uC2DD\uC744 \uC55E\uB450\uACE0, \uCE74\uB974\uBCF4 \uC0C1\uB2E8\uC5D0\uC11C
      \uBD80\uCC44 \uCC98\uB9AC \uC81C\uC548\uC774 \uB3C4\uCC29\uD588\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8 \uBB38\uC11C\uB97C \uC9C1\uC811 \uD3BC\uCCD0 \uC77D\uC5C8\uB2E4. \uB0AF\uC120
      \uC6A9\uC5B4 \uC0AC\uC774\uB85C \uC758\uB3C4\uAC00 \uBCF4\uC600\uB2E4.\n\uBC00\uB9AC\uC544\uC758
      \uC5BC\uAD74\uC774 \uB5A0\uC62C\uB790\uB2E4. \uB9CE\uC774 \uB9CC\uB098\uC9C0\uB294
      \uBABB\uD588\uC9C0\uB9CC, \uBC00\uB9AC\uC544\uAC00 \uB9DB\uC5C6\uB294 \uACFC\uC790\uC5D0
      \uB9DB\uC5C6\uB2E4\uACE0 \uB9D0\uD558\uB358 \uADF8 \uC194\uC9C1\uD568\uC774
      \uBB38\uC11C \uC18D \uD3EC\uC7A5\uB41C \uB9D0\uB4E4\uACFC \uB300\uBE44\uB418\uC5C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uB9AC\uD55C \uC870\uD56D\uB9CC \uACE8\uB77C \uC218\uB77D\uD558\uACE0,
      \uB098\uBA38\uC9C0\uB294 \uBCF4\uB958\uD588\uB2E4. \uC0C1\uB2E8\uC740 \uAC70\uB798\uB97C
      \uC720\uC9C0\uD588\uC9C0\uB9CC, \uBC31\uC791\uAC00\uB97C \uD718\uB450\uB97C
      \uBA85\uBD84\uC740 \uC5BB\uC9C0 \uBABB\uD588\uB2E4.\n\uBC31\uC791\uB839\uC758
      \uC7AC\uC815\uC740 \uB290\uB9AC\uC9C0\uB9CC \uD655\uC2E4\uD558\uAC8C \uC790\uB9AC\uB97C
      \uC7A1\uC544 \uAC14\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294 \uC22B\uC790\uB97C
      \uC77D\uB294 \uBC95\uC744 \uBC30\uC6E0\uACE0, \uC22B\uC790 \uB4A4\uC758 \uC758\uB3C4\uB97C
      \uC77D\uB294 \uBC95\uB3C4 \uBC30\uC6B0\uACE0 \uC788\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 1
