  m_Name: CharacterEnding_Yuffie_07_09_Caution
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_07_09_caution
  _characterType: 3
  _minMeetCount: 7
  _maxMeetCount: 9
  _moodType: 3
  _text:
    _title: "|- \uC720\uD53C \uB9CC\uB0A8 7~9 - \uC2E0\uC911"
    _body: "|- \uC131\uC778\uC2DD \uC804\uC57C, \uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
      \uB9D0\uD588\uB2E4. \"\uB0B4\uAC00 \uC606\uC5D0 \uC788\uC744\uAC8C. \uC5B8\uC81C\uAE4C\uC9C0\uB4E0.\"\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uD53C\uC758 \uC190\uC744 \uC7A1\uC558\uB2E4\uAC00, \uCC9C\uCC9C\uD788
      \uB193\uC558\uB2E4. \"\uC720\uD53C. \uB098\uB294 \uB124\uAC00 \uC606\uC5D0
      \uC788\uC5B4\uC11C \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uAC70\uC57C. \uADF8\uB7F0\uB370
      \uC774\uC81C\uBD80\uD130\uB294, \uB0B4 \uBC1C\uB85C \uC11C\uC57C \uD560 \uAC83
      \uAC19\uC544.\"\n\uC720\uD53C\uC758 \uB208\uC5D0 \uB208\uBB3C\uC774 \uACE0\uC600\uB2E4.
      \uD558\uC9C0\uB9CC \uC6C3\uACE0 \uC788\uC5C8\uB2E4.\n\uC131\uC778\uC2DD\uC7A5\uC5D0\uC11C
      \uC544\uBCA8\uB9AC\uC544\uB294 \uD63C\uC790 \uC130\uB2E4. \uBD09\uC2E0\uAC00\uBB38\uC758
      \uB3C4\uC804\uC744 \uC9C1\uC811 \uBB3C\uB9AC\uCCE4\uACE0, \uD6C4\uC791\uAC00\uC758
      \uD6C4\uACAC\uC744 \uAC10\uC0AC\uD558\uC9C0\uB9CC \uD544\uC694\uD558\uC9C0
      \uC54A\uB2E4\uACE0 \uC120\uC5B8\uD588\uB2E4. \uC720\uD53C\uB294 \uD6C4\uC791\uAC00
      \uB300\uD45C\uC11D\uC774 \uC544\uB2CC, \uCE5C\uAD6C\uC758 \uC790\uB9AC\uC5D0
      \uC549\uC544 \uADF8\uAC83\uC744 \uC9C0\uCF1C\uBCF4\uC558\uB2E4.\n\uD6D7\uB0A0,
      \uC544\uBCA8\uB9AC\uC544\uAC00 \uAC00\uC7A5 \uC5B4\uB824\uC6B4 \uACB0\uC815\uC744
      \uB0B4\uB824\uC57C \uD560 \uB54C, \uC720\uD53C\uB294 \uC870\uC5B8\uD558\uC9C0
      \uC54A\uC558\uB2E4. \uB2E4\uB9CC \uC606\uC5D0 \uC788\uC5C8\uB2E4. \uADF8\uAC83\uC774
      \uB450 \uC0AC\uB78C\uC774 \uCC3E\uC740, \uBCF4\uD638\uB3C4 \uD1B5\uC81C\uB3C4
      \uC544\uB2CC \uC138 \uBC88\uC9F8 \uC774\uB984\uC774\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
