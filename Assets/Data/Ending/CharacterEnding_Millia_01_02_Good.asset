  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_01_02_Good
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_01_02_good
  _characterType: 2
  _minMeetCount: 1
  _maxMeetCount: 2
  _moodType: 5
  _text:
    _title: "|- \uBC00\uB9AC\uC544 \uB9CC\uB0A8 1~2 - good"
    _body: "|- \uCE74\uB974\uBCF4 \uC0C1\uB2E8\uC758 \uBD80\uCC44 \uCC98\uB9AC \uC81C\uC548\uC774
      \uB3C4\uCC29\uD588\uC744 \uB54C, \uC544\uBCA8\uB9AC\uC544\uB294 \uBB38\uC11C\uB97C
      \uC77D\uC5C8\uC9C0\uB9CC \uBB34\uC5C7\uC744 \uBD10\uC57C \uD558\uB294\uC9C0
      \uC54C\uC9C0 \uBABB\uD588\uB2E4. \uC870\uC2EC\uC2A4\uB7EC\uC6E0\uC9C0\uB9CC,
      \uC870\uC2EC\uD558\uB294 \uAC83\uACFC \uC774\uD574\uD558\uB294 \uAC83\uC740
      \uB2EC\uB790\uB2E4.\n\uBC00\uB9AC\uC544\uAC00 \uC5B8\uC820\uAC00 \uB9D0\uD588\uC5C8\uB2E4.
      \"\uB9DB\uC5C6\uC73C\uBA74 \uB9DB\uC5C6\uB2E4\uACE0 \uD574\uC57C \uB2E4\uC74C\uC5D0
      \uC548 \uAC00\uC838\uC624\uC9C0.\" \uADF8\uB7EC\uB098 \uC544\uBCA8\uB9AC\uC544\uB294
      \uC774 \uBB38\uC11C\uAC00 \uB9DB\uC788\uB294 \uAC74\uC9C0 \uB9DB\uC5C6\uB294
      \uAC74\uC9C0 \uD310\uB2E8\uD560 \uD600\uB97C \uAC16\uACE0 \uC788\uC9C0 \uC54A\uC558\uB2E4.\n\uACB0\uAD6D
      \uC81C\uC548 \uB300\uBD80\uBD84\uC744 \uC218\uB77D\uD588\uB2E4. \uB2F9\uC7A5\uC740
      \uBB38\uC81C\uAC00 \uC5C6\uC5B4 \uBCF4\uC600\uB2E4.\n\uBC31\uC791\uB839\uC758
      \uC7AC\uC815\uC740 \uC0C1\uB2E8\uC758 \uD750\uB984 \uC548\uC5D0\uC11C \uC6C0\uC9C1\uC774\uAE30
      \uC2DC\uC791\uD588\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294 \uB9E4\uB2EC \uB3C4\uCC29\uD558\uB294
      \uC815\uC0B0 \uBCF4\uACE0\uC11C\uB97C \uC77D\uC5C8\uC9C0\uB9CC, \uADF8 \uC548\uC5D0
      \uC801\uD78C \uC22B\uC790\uAC00 \uC790\uC2E0\uC5D0\uAC8C \uC720\uB9AC\uD55C
      \uAC74\uC9C0 \uBD88\uB9AC\uD55C \uAC74\uC9C0, \uC5EC\uC804\uD788 \uD655\uC2E0\uD558\uC9C0
      \uBABB\uD588\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 3
