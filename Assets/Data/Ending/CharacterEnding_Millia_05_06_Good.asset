  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_05_06_Good
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_05_06_good
  _characterType: 2
  _minMeetCount: 5
  _maxMeetCount: 6
  _moodType: 5
  _text:
    _title: "\uBC00\uB9AC\uC544 \uB9CC\uB0A8 5~6 - good"
    _body: "\uBC00\uB9AC\uC544\uAC00 \uBD80\uCC44 \uC870\uD56D\uC744 \uB300\uC2E0
      \uCC98\uB9AC\uD574\uC8FC\uACA0\uB2E4\uACE0 \uD588\uC744 \uB54C, \uC544\uBCA8\uB9AC\uC544\uB294
      \uBC00\uB9AC\uC544\uC758 \uB2A5\uB825\uC744 \uBBFF\uC5C8\uB2E4. \uC758\uC2EC\uD55C
      \uC801\uC774 \uC5C6\uC5C8\uB2E4.\n\uBD80\uCC44\uB294 \uC815\uB9AC\uB418\uC5C8\uB2E4.
      \uBC00\uB9AC\uC544\uB294 \uACFC\uC815\uC744 \uC124\uBA85\uD574\uC8FC\uC5C8\uACE0,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4.
      \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB294\uC9C0 \uC815\uD655\uD788 \uC774\uD574\uD558\uC9C0\uB294
      \uBABB\uD588\uC9C0\uB9CC, \uBC00\uB9AC\uC544\uAC00 \uAD1C\uCC2E\uB2E4\uACE0
      \uD588\uC73C\uB2C8 \uAD1C\uCC2E\uB2E4\uACE0 \uBBFF\uC5C8\uB2E4.\n\uADF8 \uB4A4\uB85C
      \uBC31\uC791\uAC00\uC758 \uC7AC\uC815 \uACB0\uC815\uC740 \uC810\uC810 \uBC00\uB9AC\uC544\uB97C
      \uAC70\uCE58\uAC8C \uB418\uC5C8\uB2E4. \uBC00\uB9AC\uC544\uB294 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
      \uB9E4\uBC88 \uBCF4\uACE0\uD588\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294 \uB9E4\uBC88
      \uC2B9\uC778\uD588\uB2E4. \uAC70\uC808\uD560 \uADFC\uAC70\uB97C \uCC3E\uC9C0
      \uBABB\uD588\uAE30 \uB54C\uBB38\uC774\uB2E4.\n\uBC31\uC791\uB839\uC740 \uBD80\uC720\uD574\uC84C\uB2E4.
      \uADF8\uB7EC\uB098 \uADF8 \uBD80\uC758 \uD750\uB984\uC744 \uC774\uD574\uD558\uB294
      \uC0AC\uB78C\uC740 \uBC31\uC791\uC774 \uC544\uB2C8\uB77C \uC0C1\uC778\uC758
      \uB538\uC774\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 3
