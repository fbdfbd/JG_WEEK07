  _maxMeetCount: 6
  _moodType: 8
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC00\uB9AC\uC544\uAC00 \uAC74\uB128
      \uC740\uBC00\uD55C \uACBD\uACE0\uB97C \uBC14\uD0D5\uC73C\uB85C, \uC0C1\uB2E8\uC774
      \uC601\uC9C0\uB97C \uC7A0\uC2DD\uD558\uB824\uB358 \uBAA8\uB4E0 \uAD6C\uBA4D\uC744
      \uC644\uBCBD\uD558\uAC8C \uD2C0\uC5B4\uB9C9\uC558\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uBCA0\uB974\uB514\uC544 \uC0C1\uB2E8\uC758 \uB3C5\uC810\uAD8C\uC744 \uD574\uC81C\uD558\uACE0
      \uC5EC\uB7EC \uC0C1\uC778 \uC138\uB825\uC744 \uACBD\uC7C1\uC2DC\uD0B4\uC73C\uB85C\uC368,
      \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C \uC81C\uAD6D \uBD81\uBD80\uC758 \uAC70\uB300\uD55C
      \uACBD\uB9E4\uC7A5\uC73C\uB85C \uD0C8\uBC14\uAFC8\uC2DC\uCF30\uC9C0\uC694.\n\uBC00\uB9AC\uC544\uB294
      \uAC00\uBB38\uC758 \uC774\uC775\uC744 \uBC30\uC2E0\uD55C \uC148\uC774 \uB418\uC5C8\uC9C0\uB9CC,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uC624\uD788\uB824 \uADF8\uB140\uB97C \uC601\uC9C0\uC758
      \uACF5\uC2DD \uACBD\uC81C \uACE0\uBB38\uC73C\uB85C \uC784\uBA85\uD558\uC5EC
      \uACC1\uC5D0 \uBB36\uC5B4\uB450\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC0C1\uB2E8\uC740
      \uC601\uC9C0\uB97C \uC0BC\uD0A4\uB824\uB2E4 \uC624\uD788\uB824 \uC544\uBCA8\uB9AC\uC544\uB77C\uB294
      \uAC70\uB300\uD55C \uD3EC\uC2DD\uC790\uC5D0\uAC8C \uAE38\uB4E4\uC5EC\uC9C0\uB294
      \uAF34\uC774 \uB418\uC5C8\uB2F5\uB2C8\uB2E4.\n\uC0AC\uB78C\uB4E4\uC740 \uC774\uC81C
      \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB97C '\uC0C1\uC778\uB4E4\uC774 \uBB34\uB98E
      \uAFC7\uACE0 \uB4E4\uC5B4\uC624\uB294 \uAE08\uC758 \uC601\uC9C0'\uB77C \uCE6D\uC1A1\uD558\uAC8C
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 1
