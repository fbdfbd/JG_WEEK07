  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_05_06_Innocent
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_05_06_caution
  _characterType: 3
  _minMeetCount: 5
  _maxMeetCount: 6
  _moodType: 4
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC720\uD53C\uC758 \uB2E4\uC815\uD55C \uD3EC\uC639\uC740 \uC0AC\uC2E4
      \uC544\uBCA8\uB9AC\uC544\uC758 \uB450 \uD314\uC744 \uBB36\uB294 \uC18D\uBC15\uC774\uC5C8\uACE0,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uADF8 \uC628\uAE30\uC5D0 \uCDE8\uD574 \uAC00\uBB38\uC758
      \uB9C8\uC9C0\uB9C9 \uC790\uC874\uC2EC\uC744 \uB0B4\uC8FC\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uC601\uC9C0\uC758 \uADF9\uC2EC\uD55C \uAC00\uB09C\uC744 \uD574\uACB0\uD574
      \uC8FC\uACA0\uB2E4\uB294 \uC720\uD53C\uC758 \uC81C\uC548\uC5D0 \uAC10\uB3D9\uD558\uC5EC,
      \uBC31\uC791\uAC00\uC758 \uC778\uC7A5\uC744 \uB85C\uC0AC\uBCA8 \uD6C4\uC791\uC800\uC758
      \uC9D1\uBB34\uC2E4\uC5D0 \uC601\uAD6C \uC704\uD0C1\uD558\uB294 \uC11C\uB958\uC5D0
      \uC11C\uBA85\uD558\uACE0 \uB9D0\uC558\uC9C0\uC694.\n\uC774\uC81C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC9C0\uB3C4 \uC704\uC5D0\uC11C\uB9CC \uC874\uC7AC\uD558\uB294 \uC720\uB839
      \uC601\uC9C0\uAC00 \uB418\uC5C8\uACE0, \uBAA8\uB4E0 \uC2E4\uAD8C\uC740 \uC720\uD53C\uC758
      \uC624\uBE60\uC640 \uCE5C\uCC99\uB4E4\uC5D0\uAC8C \uC870\uAC01\uC870\uAC01
      \uB098\uB258\uC5B4 \uB118\uC5B4\uAC14\uB2F5\uB2C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uD654\uB824\uD55C \uD6C4\uC791\uAC00\uC758 \uBCC4\uC7A5\uC5D0\uC11C \uD3C9\uC0DD
      \uBD80\uC871\uD568 \uC5C6\uB294 \uC0DD\uD65C\uC744 \uBCF4\uC7A5\uBC1B\uC558\uC9C0\uB9CC,
      \uCC3D\uBC16\uC73C\uB85C \uBCF4\uC774\uB294 \uC790\uC2E0\uC758 \uC601\uC9C0\uAC00
      \uB85C\uC0AC\uBCA8\uC758 \uAE43\uBC1C\uB85C \uB4A4\uB36E\uC774\uB294 \uAC83\uC744
      \uBCF4\uBA70 \uBA4D\uD558\uB2C8 \uC6C3\uC744 \uBFD0\uC774\uC5C8\uC5B4\uC694.\n\uADF8\uB140\uB294
      \uAC00\uBB38\uC744 \uD314\uC544 \uC548\uB77D\uD568\uC744 \uC0B0, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uC5ED\uC0AC\uC0C1 \uAC00\uC7A5 \uC2AC\uD504\uACE0 \uBB34\uB2A5\uD55C \uB9C8\uC9C0\uB9C9
      \uAC00\uC8FC\uB85C \uAE30\uB85D\uB418\uC5C8\uB2F5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
