  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_05_06_Innocent
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_05_06_caution
  _characterType: 3
  _minMeetCount: 5
  _maxMeetCount: 6
  _moodType: 3
  _text:
    _title: "\uC720\uD53C \uB9CC\uB0A8 5~6 - \uC2E0\uC911"
    _body: "\uC720\uD53C\uC640 \uC624\uB798 \uD568\uAED8\uD55C \uC544\uBCA8\uB9AC\uC544\uB294
      \uBCF4\uD638\uB77C\uB294 \uB2E8\uC5B4\uC758 \uC591\uBA74\uC744 \uC774\uD574\uD558\uAC8C
      \uB418\uC5C8\uB2E4. \uC720\uD53C\uAC00 \uAC74\uB124\uB294 \uBAA8\uB4E0 \uC870\uC5B8
      \uB4A4\uC5D0\uB294 \uD6C4\uC791\uAC00\uC758 \uADF8\uB9BC\uC790\uAC00 \uC788\uC5C8\uACE0,
      \uC720\uD53C \uC790\uC2E0\uB3C4 \uADF8 \uADF8\uB9BC\uC790\uC5D0\uC11C \uC644\uC804\uD788
      \uC790\uC720\uB86D\uC9C0 \uBABB\uD588\uB2E4.\n\uC131\uC778\uC2DD\uC5D0\uC11C
      \uD6C4\uC791\uAC00\uAC00 \uACF5\uC2DD \uD6C4\uACAC\uC744 \uC81C\uC548\uD588\uC744
      \uB54C, \uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uB97C \uBC14\uB77C\uBCF4\uBA70
      \uB9D0\uD588\uB2E4. \"\uC720\uD53C, \uB098\uB294 \uB124 \uCE5C\uAD6C\uC774\uACE0
      \uC2F6\uC5B4. \uD6C4\uC791\uAC00\uC758 \uBCF4\uD638\uB839\uC774 \uC544\uB2C8\uB77C.\"\n\uC720\uD53C\uC758
      \uB208\uC774 \uC7A0\uAE50 \uD754\uB4E4\uB838\uB2E4. \uADF8\uB9AC\uACE0 \uC544\uC8FC
      \uC791\uAC8C \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4.\n\uD6C4\uC791\uAC00\uB294
      \uBB3C\uB7EC\uC130\uB2E4. \uBC31\uC791\uB839\uC740 \uB3C5\uB9BD\uC744 \uC9C0\uCF30\uACE0,
      \uC720\uD53C\uC5D0\uAC8C\uC11C \uC628 \uD3B8\uC9C0\uC5D0\uB294 \uB354 \uC774\uC0C1
      \uD6C4\uC791\uAC00\uC758 \uACF5\uC2DD \uC778\uC7A5\uC774 \uCC0D\uD600 \uC788\uC9C0
      \uC54A\uC558\uB2E4. \uADF8\uAC83\uC740 \uB450 \uC0AC\uB78C \uBAA8\uB450\uC5D0\uAC8C
      \uC790\uC720\uC758 \uC2DC\uC791\uC774\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
