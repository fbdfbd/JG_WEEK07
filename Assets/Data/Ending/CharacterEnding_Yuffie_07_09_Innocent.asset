  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Yuffie_07_09_Innocent
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_07_09_caution
  _priority: 8
  _characterType: 3
  _minMeetCount: 7
  _maxMeetCount: 9
  _moodType: 4
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB77C\uB294
      \uC131\uC528\uAC00 \uC8FC\uB294 \uCD94\uC704\uBCF4\uB2E4 \uC720\uD53C\uAC00
      \uC57D\uC18D\uD55C \uB85C\uC0AC\uBCA8\uC758 \uC628\uAE30\uB97C \uD0DD\uD588\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uC131\uC778\uC2DD \uB0A0, \uD640\uB85C \uC11C\uC57C \uD558\uB294 \uBC31\uC791\uC758
      \uC8FC\uAD8C \uB300\uC2E0 \uC720\uD53C\uC640\uC758 \uC601\uC6D0\uD55C \uACB0\uC18D\uC744
      \uBCF4\uC7A5\uD558\uB294 '\uAC00\uBB38 \uD1B5\uD569 \uACC4\uC57D\uC11C'\uC5D0
      \uC8FC\uC800 \uC5C6\uC774 \uC778\uC7A5\uC744 \uCC0D\uC5B4\uBC84\uB838\uC9C0\uC694.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \u2018\uB85C\uC0AC\uBCA8\uC758 \uC591\uB140\u2019\uB77C\uB294 \uC0C8\uB85C\uC6B4
      \uC2E0\uBD84\uC744 \uC5BB\uC5C8\uC9C0\uB9CC, \uADF8 \uB300\uAC00\uB85C \uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uBC31\uC791\uB839\uC740 \uD6C4\uC791\uAC00\uC758 \uC9C1\uD560\uB839\uC73C\uB85C
      \uD761\uC218\uB418\uC5B4 \uC81C\uAD6D \uC9C0\uB3C4\uC5D0\uC11C \uC601\uC6D0\uD788
      \uC9C0\uC6CC\uC84C\uB2F5\uB2C8\uB2E4.\n\uAC00\uBB38\uC758 \uBB38\uC7A5\uC744
      \uC9C0\uD0A4\uB824\uB358 \uAC00\uC2E0\uB4E4\uC740 \uC8FC\uAD70\uC774 \uC2A4\uC2A4\uB85C
      \uC774\uB984\uC744 \uB0B4\uB358\uC9C0\uB294 \uBAA8\uC2B5\uC5D0 \uC808\uB9DD\uD558\uBA70
      \uD769\uC5B4\uC84C\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294 \uB85C\uC0AC\uBCA8
      \uD6C4\uC791\uC800\uC758 \uD654\uB824\uD55C \uC815\uC6D0 \uC548\uC73C\uB85C
      \uAC70\uCC98\uB97C \uC62E\uAE30\uAC8C \uB418\uC5C8\uC5B4\uC694.\n\uADF8\uB140\uB294
      \uC774\uC81C \uBC31\uC791\uC774 \uC544\uB2CC \uB85C\uC0AC\uBCA8\uC758 \uBC29\uACC4
      \uC77C\uC6D0\uC73C\uB85C\uC11C, \uD6C4\uC791\uAC00\uAC00 \uD5C8\uB77D\uD55C
      \uC881\uC740 \uC548\uB730\uB9CC\uC744 \uAC70\uB2D0\uBA70 \uC790\uC2E0\uC758
      \uACE0\uD5A5\uC744 \uC774\uBC29\uC778\uCC98\uB7FC \uBC14\uB77C\uBCF4\uAC8C
      \uB418\uC5C8\uB2F5\uB2C8\uB2E4.\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758 \uC5ED\uC0AC\uB294
      \uADF8\uB807\uAC8C \uB2F9\uB2F9\uD55C \uB9C8\uCE68\uD45C \uB300\uC2E0, \uB85C\uC0AC\uBCA8
      \uAC00\uBB38\uC758 \uD654\uB824\uD55C \uBD80\uB85D\uC73C\uB85C \uB0A8\uACA8\uC9C0\uAC8C
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
