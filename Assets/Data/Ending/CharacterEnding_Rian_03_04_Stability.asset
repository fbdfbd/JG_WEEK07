  m_Name: CharacterEnding_Rian_03_04_Stability
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_rian_03_04_stability
  _priority: 0
  _characterType: 0
  _minMeetCount: 3
  _maxMeetCount: 4
  _moodType: 1
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC744 \uAC00\uC7A5 \uB9CE\uC774
      \uB9CC\uB0AC\uC2B5\uB2C8\uB2E4. \uADF8\uB9AC\uACE0 \uC548\uC815\uC801\uC774\uC5C8\uAE30\uC5D0
      \u2014\n\uC131\uC778\uC2DD \uC774\uD6C4 \uB9AC\uC548\uC740 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC5D0
      \uC9C1\uC811 \uAD00\uC5EC\uD558\uC9C0 \uC54A\uC558\uC9C0\uB9CC, \uD669\uC2E4\uC774
      \uC774 \uC601\uC9C0\uB97C \uC8FC\uC2DC\uD558\uACE0 \uC788\uB2E4\uB294 '\uAE30\uBD84
      \uC88B\uC740 \uC18C\uBB38'\uC740 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C \uAC00\uC7A5
      \uB2E8\uB2E8\uD55C \uBC29\uD328\uAC00 \uB418\uC5C8\uC5B4\uC694.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8 \uBBF8\uBB18\uD55C \uACF5\uAE30\uB97C \uC774\uC6A9\uD574 \uD0D0\uC695\uC2A4\uB7EC\uC6B4
      \uC774\uC6C3 \uADC0\uC871\uB4E4\uC758 \uC811\uADFC\uC744 \uCC28\uB2E8\uD588\uACE0,
      \uD669\uC2E4\uC758 \uAD8C\uC704\uB97C \uB9C8\uCE58 \uC601\uC9C0 \uCC3D\uACE0\uC758
      \uC5EC\uBD84 \uC2DD\uB7C9\uCC98\uB7FC \uD544\uC694\uD560 \uB54C\uB9CC \uAEBC\uB0B4
      \uC37C\uC9C0\uC694.\n\uB9AC\uC548\uC758 \uC874\uC7AC\uB294 \uADF8\uB140\uC5D0\uAC8C
      \uC228\uC744 \uD2D4\uC6CC\uC8FC\uB294 \uBC14\uB78C\uC774\uC5C8\uC744 \uBFD0,
      \uACB0\uCF54 \uBAB8\uC744 \uAE30\uB300\uB294 \uBCBD\uC740 \uC544\uB2C8\uC5C8\uB2F5\uB2C8\uB2E4.\n\uC0AC\uB78C\uB4E4\uC740
      \uC544\uBCA8\uB9AC\uC544\uB97C \"\uD669\uC2E4\uC744 \uB4F1\uC5D0 \uC5C5\uACE0
      \uD638\uB791\uC774 \uB178\uB987\uC744 \uD558\uB294 \uC5EC\uC6B0\"\uB77C \uBD80\uB974\uBA70
      \uB450\uB824\uC6CC\uD588\uACE0, \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294 \uBD81\uBD80\uC5D0\uC11C
      \uAC00\uC7A5 \uAC74\uB4DC\uB9AC\uAE30 \uAE4C\uB2E4\uB85C\uC6B4 \uC601\uC9C0\uAC00
      \uB418\uC5C8\uC5B4\uC694."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 3
