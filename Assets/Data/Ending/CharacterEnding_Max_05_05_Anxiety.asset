  m_Name: CharacterEnding_Max_05_05_Anxiety
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_05_05_anxiety
  _characterType: 1
  _minMeetCount: 5
  _maxMeetCount: 5
  _moodType: 0
  _text:
    _title: "|- \uB9C9\uC2A4 \uB9CC\uB0A8 5 - \uBD88\uC548"
    _body: "|- \uB9C9\uC2A4\uAC00 \uD638\uC704\uB97C \uC790\uCC98\uD588\uC744 \uB54C,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uAC70\uC808\uD558\uC9C0 \uBABB\uD588\uB2E4.
      \uB9C9\uC2A4\uC758 \uC758\uB3C4\uB97C \uC758\uC2EC\uD558\uBA74\uC11C\uB3C4,
      \uD63C\uC790 \uB0A8\uB294 \uAC83\uC774 \uB354 \uBB34\uC11C\uC6E0\uAE30 \uB54C\uBB38\uC774\uB2E4.\n\uB9C9\uC2A4\uB294
      \uACC1\uC5D0 \uBA38\uBB3C\uB800\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB97C \uBCF4\uD638\uD588\uACE0,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uC758\uC9C0\uD588\uB2E4. \uADF8 \uC758\uC9C0\uAC00
      \uAE4A\uC5B4\uC9C8\uC218\uB85D, \uBC31\uC791\uAC00\uC758 \uACB0\uC815\uC740
      \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uB9C9\uC2A4\uB97C \uAC70\uCCD0 \uBD09\uC2E0\uAC00\uBB38\uC73C\uB85C
      \uD758\uB7EC\uAC14\uB2E4.\n\uC131\uC778\uC2DD\uC740 \uCE58\uB7EC\uC84C\uB2E4.
      \uC544\uBCA8\uB9AC\uC544\uB294 \uBC31\uC791\uC774 \uB418\uC5C8\uB2E4. \uADF8\uB7EC\uB098
      \uC625\uC88C \uC606\uC5D0\uB294 \uC5B8\uC81C\uB098 \uB9C9\uC2A4\uAC00 \uC11C
      \uC788\uC5C8\uACE0, \uB9C9\uC2A4 \uB108\uBA38\uC5D0\uB294 \uBD09\uC2E0\uAC00\uBB38\uC774
      \uC11C \uC788\uC5C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294 \uC655\uAD00\uC744
      \uC4F4 \uAF2D\uB450\uAC01\uC2DC\uB77C\uB294 \uB9D0\uC744 \uB4E4\uC5C8\uC744
      \uB54C, \uBC18\uBC15\uD558\uC9C0 \uBABB\uD588\uB2E4. \uBC18\uBC15\uD560 \uC218
      \uC5C6\uC5C8\uB358 \uAC83\uC774 \uC544\uB2C8\uB77C, \uBC18\uBC15\uD574\uC57C
      \uD55C\uB2E4\uB294 \uD655\uC2E0\uC774 \uC11C\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uAC83\uC774
      \uAC00\uC7A5 \uBB34\uC11C\uC6B4 \uC77C\uC774\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 2
