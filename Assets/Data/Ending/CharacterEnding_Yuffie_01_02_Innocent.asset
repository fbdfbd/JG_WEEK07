  m_Name: CharacterEnding_Yuffie_01_02_Innocent
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_yuffie_01_02_caution
  _priority: 0
  _characterType: 3
  _minMeetCount: 1
  _maxMeetCount: 2
  _moodType: 4
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uAC00 12\uB144 \uB3D9\uC548 \uAC00\uC7A5 \uAC00\uAE4C\uC774
      \uB454 \uC0AC\uB78C\uC740 \uC720\uD53C\uC600\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uC21C\uC9C4\uD55C \uC544\uC774\uB85C \uC790\uB790\uAE30\uC5D0...\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uC720\uD53C\uC758 \uD638\uC758\uAC00 \uBAA9\uC744 \uC870\uC774\uB294 \uC62C\uAC00\uBBF8\uAC00
      \uB420 \uC904\uC740 \uAFC8\uC5D0\uB3C4 \uBAB0\uB790\uB2F5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uC131\uC778\uC2DD \uC774\uD6C4\uC5D0\uB3C4 \uB85C\uC0AC\uBCA8 \uD6C4\uC791\uAC00\uC5D0\uC11C
      \uBCF4\uB0B4\uC624\uB294 \uB4DC\uB808\uC2A4\uC640 \uC608\uBC95 \uC120\uC0DD\uC744
      \uBC18\uAE30\uBA70,\n\uADF8\uB4E4\uC774 \uC815\uD574\uC900 '\uAC00\uC7A5 \uBC31\uC791\uB2E4\uC6B4
      \uBAA8\uC2B5'\uC73C\uB85C \uC790\uC2E0\uC744 \uAC00\uAFB8\uB294 \uB370 \uC5F4\uC911\uD588\uC5B4\uC694.\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4
      \uBC31\uC791\uC800\uC758 \uBB38\uC740 \uB85C\uC0AC\uBCA8\uC758 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C
      \uD65C\uC9DD \uC5F4\uB838\uACE0,\n\uC544\uBCA8\uB9AC\uC544\uB294 \uADF8\uB4E4\uC774
      \uAC00\uC838\uB2E4\uC8FC\uB294 \uB2EC\uCF64\uD55C \uACFC\uC790\uB97C \uBA39\uC73C\uBA70
      \uC5B4\uB824\uC6B4 \uACB0\uC815\uC740 \uBAA8\uB450 \uD6C4\uC791\uAC00\uC5D0
      \uB9E1\uACA8\uBC84\uB838\uC9C0\uC694.\n\uC0AC\uB78C\uB4E4\uC740 \uADF8\uB140\uB97C
      \uBCF4\uBA70 \uC81C\uAD6D\uC5D0\uC11C \uAC00\uC7A5 \uC778\uD615\uCC98\uB7FC
      \uC608\uC05C \uBC31\uC791\uC774\uB77C \uCE6D\uC1A1\uD588\uC9C0\uB9CC, \uC815\uC791
      \uC601\uC9C0\uC758 \uC138\uAE08\uC740 \uC544\uBCA8\uB9AC\uC544\uC758 \uAE08\uACE0\uAC00
      \uC544\uB2CC \uB85C\uC0AC\uBCA8\uC758 \uCC3D\uACE0\uB85C \uC18C\uB9AC \uC5C6\uC774
      \uD758\uB7EC\uB4E4\uC5B4\uAC14\uB2F5\uB2C8\uB2E4.\n\uADF8\uB140\uB294 \uD654\uB824\uD55C
      \uB9AC\uBCF8\uC5D0 \uBB36\uC778 \uCC44, \uC790\uC2E0\uC758 \uC774\uB984\uC73C\uB85C
      \uB41C \uBA85\uB839\uC11C \uD558\uB098 \uC368\uBCF4\uC9C0 \uBABB\uD558\uB294
      \uAC00\uC9DC \uC8FC\uC778\uC774 \uB418\uACE0 \uB9D0\uC558\uC5B4\uC694."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 5
