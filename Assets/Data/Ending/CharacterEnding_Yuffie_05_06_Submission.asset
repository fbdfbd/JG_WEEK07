  _moodType: 4
  _text:
    _title: "|- \uC720\uD53C \uB9CC\uB0A8 5~6 - \uC21C\uC751"
    _body: "|- \uC720\uD53C\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4
      \uCE5C\uAD6C\uC600\uB2E4. \uAC00\uC7A5 \uC624\uB798\uB41C \uC870\uC5B8\uC790\uC774\uAE30\uB3C4
      \uD588\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294 \uC720\uD53C\uC758 \uB9D0\uC744
      \uC758\uC2EC\uD55C \uC801\uC774 \uC5C6\uC5C8\uB2E4. \uC720\uD53C\uB3C4 \uC544\uBCA8\uB9AC\uC544\uB97C
      \uC18D\uC778 \uC801\uC774 \uC5C6\uC5C8\uB2E4.\n\uBB38\uC81C\uB294 \uC720\uD53C\uC758
      \uB9D0\uC774 \uC5B8\uC81C\uB098 \uD6C4\uC791\uAC00\uC758 \uC774\uC775\uACFC
      \uACB9\uCE5C\uB2E4\uB294 \uAC83\uC774\uC5C8\uB2E4. \uC720\uD53C \uC790\uC2E0\uC870\uCC28
      \uADF8\uAC83\uC744 \uC758\uC2DD\uD558\uC9C0 \uBABB\uD588\uC744 \uC218\uB3C4
      \uC788\uB2E4.\n\uC131\uC778\uC2DD \uC774\uD6C4, \uC544\uBCA8\uB9AC\uC544\uB294
      \uBB34\uC5ED \uD611\uC815, \uC601\uC9C0 \uD655\uC7A5, \uBD09\uC2E0\uAC00\uBB38
      \uCC98\uB9AC\uAE4C\uC9C0 \uBAA8\uB4E0 \uC77C\uC5D0\uC11C \uC720\uD53C\uC758
      \uC758\uACAC\uC744 \uB4E4\uC5C8\uB2E4. \uC720\uD53C\uC758 \uC870\uC5B8\uC740
      \uB298 \uD569\uB9AC\uC801\uC774\uC5C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uB298 \uB530\uB790\uB2E4.\n\uBC31\uC791\uB839\uC740 \uC548\uC815\uC801\uC774\uC5C8\uB2E4.
      \uD48D\uC694\uB85C\uC6E0\uB2E4. \uB2E4\uB9CC \uADF8 \uC548\uC815\uACFC \uD48D\uC694\uC758
      \uBC29\uD5A5\uC744 \uACB0\uC815\uD558\uB294 \uAC83\uC740 \uC810\uC810 \uC544\uBCA8\uB9AC\uC544\uAC00
      \uC544\uB2C8\uAC8C \uB418\uC5B4 \uAC14\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8\uAC83\uC744 \uC6B0\uC815\uC774\uB77C\uACE0 \uBD88\uB800\uACE0, \uD6C4\uC791\uAC00\uB294
      \uADF8\uAC83\uC744 \uC131\uACFC\uB77C\uACE0 \uBD88\uB800\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 4
