  _moodType: 0
  _text:
    _title: "|- \uB9AC\uC548 \uB9CC\uB0A8 3~4 - \uBD88\uC548"
    _body: "|- \uB9AC\uC548\uC774 \uAC1C\uC778 \uC790\uACA9\uC73C\uB85C \uCC38\uC11D\uD588\uB2E4\uB294
      \uC18C\uC2DD\uC5D0 \uC544\uBCA8\uB9AC\uC544\uC758 \uC190\uC774 \uBBF8\uC138\uD558\uAC8C
      \uB5A8\uB838\uB2E4. \uADF8\uAC00 \uC640\uC8FC\uC5B4\uC11C \uC548\uC2EC\uC774
      \uB41C \uAC74\uC9C0, \uADF8\uAC00 \uD669\uC2E4 \uC0AC\uB78C\uC774\uB77C\uB294
      \uC0AC\uC2E4\uC774 \uBD88\uC548\uD55C \uAC74\uC9C0 \uAD6C\uBD84\uC774 \uB418\uC9C0
      \uC54A\uC558\uB2E4.\n\uC131\uC778\uC2DD\uC740 \uBB34\uC0AC\uD788 \uCE58\uB7EC\uC84C\uC9C0\uB9CC,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uBD09\uC2E0\uAC00\uBB38\uC758 \uC2DC\uC120\uC774
      \uC790\uB9AC\uC5D0\uC11C \uB5A0\uB098\uC9C0 \uC54A\uB294 \uAC83\uC744 \uB290\uAF08\uB2E4.
      \uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C \uAD1C\uCC2E\uB0D0\uACE0
      \uBB3C\uC5C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294 \uAD1C\uCC2E\uB2E4\uACE0
      \uB300\uB2F5\uD588\uB2E4. \uB458 \uB2E4 \uADF8 \uB300\uB2F5\uC774 \uC9C4\uC2EC\uC774
      \uC544\uB2C8\uB77C\uB294 \uAC78 \uC54C\uACE0 \uC788\uC5C8\uB2E4.\n\uBC31\uC791\uC704\uB294
      \uACC4\uC2B9\uB418\uC5C8\uB2E4. \uADF8\uB7EC\uB098 \uC911\uC694\uD55C \uACB0\uC815\uC774
      \uC62C \uB54C\uB9C8\uB2E4 \uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC5D0\uAC8C
      \uBA3C\uC800 \uD3B8\uC9C0\uB97C \uC37C\uB2E4. \uB9AC\uC548\uC740 \uB298 \uB2F5\uC7A5\uD588\uC9C0\uB9CC,
      \uB2F5\uC7A5\uC774 \uC62C \uB54C\uAE4C\uC9C0 \uC544\uBCA8\uB9AC\uC544\uB294
      \uC544\uBB34\uAC83\uB3C4 \uACB0\uC815\uD558\uC9C0 \uBABB\uD588\uB2E4. \uBC31\uC791\uB839\uC740
      \uC870\uC6A9\uD588\uB2E4. \uB108\uBB34 \uC870\uC6A9\uD588\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 2
