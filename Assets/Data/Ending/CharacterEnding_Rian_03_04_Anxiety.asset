  _moodType: 0
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uB9AC\uC548\uC744 \uAC00\uC7A5 \uB9CE\uC774
      \uB9CC\uB0AC\uC2B5\uB2C8\uB2E4. \uADF8\uB9AC\uACE0 \uBD88\uC548\uD588\uAE30\uC5D0
      \u2014\n\uBC31\uC791\uC704\uC5D0 \uC624\uB978 \uC544\uBCA8\uB9AC\uC544\uB294
      \uC5B4\uB824\uC6B4 \uBB38\uC81C\uAC00 \uC0DD\uAE38 \uB54C\uB9C8\uB2E4 \uC790\uC2E0\uB3C4
      \uBAA8\uB974\uAC8C \uB9AC\uC548\uC774 \uBCF4\uB0B8 \uD3B8\uC9C0\uB97C \uBA3C\uC800
      \uCC3E\uAC8C \uB418\uC5C8\uC5B4\uC694.\n\uB9AC\uC548\uC758 \uB2E4\uC815\uD55C
      \uC870\uC5B8\uC740 \uB2EC\uCF64\uD55C \uB3C5\uC774\uC5C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uC2A4\uC2A4\uB85C \uC0DD\uAC01\uD558\uB294 \uBC95\uC744 \uC78A\uC740 \uCC44
      \uD669\uC2E4\uC774 \uC815\uD574\uC900 \uC815\uB2F5\uB9CC\uC744 \uC11C\uB958\uC5D0
      \uBCA0\uAEF4 \uC37C\uC9C0\uC694.\n\uC774\uC81C \uC601\uBBFC\uB4E4\uC740 \uBC31\uC791\uC758
      \uBA85\uB839\uBCF4\uB2E4 \uD669\uC2E4 \uC0AC\uC808\uC774 \uAC00\uC838\uC624\uB294
      \uC804\uC5B8\uC5D0 \uB354 \uADC0\uB97C \uAE30\uC6B8\uC774\uBA70, \uC544\uBCA8\uB9AC\uC544\uB294
      \uD654\uB824\uD55C \uBC31\uC791\uB839\uC758 \uC8FC\uC778\uC774\uB77C\uAE30\uBCF4\uB2E4
      \uB9AC\uC548\uC774 \uC870\uC885\uD558\uB294 \uC608\uC05C \uAF2D\uB450\uAC01\uC2DC\uCC98\uB7FC
      \uBCF4\uC600\uB2F5\uB2C8\uB2E4.\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294 \uD3C9\uD654\uB85C\uC6E0\uC73C\uB098,
      \uADF8 \uD3C9\uD654\uB294 \uC544\uBCA8\uB9AC\uC544\uC758 \uC601\uD63C\uC744
      \uB300\uAC00\uB85C \uC9C0\uBD88\uD558\uACE0 \uC0B0 \uD22C\uBA85\uD55C \uAC10\uC625\uC774\uB098
      \uB2E4\uB984\uC5C6\uC5C8\uC5B4\uC694."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 2
