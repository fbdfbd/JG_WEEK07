  m_Script: {fileID: 11500000, guid: 0b68f509342da9940bf43c9618a7a70d, type: 3}
  m_Name: CharacterEnding_Millia_07_09_Cautious
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_07_09_cautious
  _characterType: 2
  _minMeetCount: 7
  _maxMeetCount: 9
  _moodType: 8
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uB294 \uBC00\uB9AC\uC544\uC640\uC758 \uAE4A\uC740
      \uC2E0\uB8B0\uB97C \uD1B5\uD574 \uC0C1\uB2E8\uC758 \uBAA8\uB4E0 \uC57D\uC810\uACFC
      \uB0B4\uBD80 \uAD6C\uC870\uB97C \uC644\uBCBD\uD558\uAC8C \uD30C\uC545\uD588\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uC131\uC778\uC2DD \uB0A0, \uC0C1\uB2E8\uC758 \uC790\uAE08 \uC9C0\uC6D0\uC744
      \uC120\uD3EC\uD558\uB294 \uB300\uC2E0 \uC624\uD788\uB824 \uBCA0\uB974\uB514\uC544
      \uC0C1\uB2E8\uC758 \uBD80\uB2F9 \uAC70\uB798\uB97C \uD3ED\uB85C\uD558\uBA70
      \uADF8\uB4E4\uC758 \uC720\uD1B5\uB9DD\uC744 \uC601\uC9C0 \uC9C1\uD560\uB85C
      \uD761\uC218\uD558\uB294 \uD30C\uAD34\uC801\uC778 \uD589\uBCF4\uB97C \uBCF4\uC600\uC9C0\uC694.\n\uBC00\uB9AC\uC544\uB294
      \uC6B0\uC815\uACFC \uAC00\uBB38 \uC0AC\uC774\uC5D0\uC11C \uC808\uB9DD\uD588\uC73C\uB098,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uB0C9\uC815\uD558\uAC8C \uADF8\uB140\uB97C
      \uC81C\uAD6D\uC758 \uC0C8\uB85C\uC6B4 \uC0C1\uC5C5 \uC9C8\uC11C\uB97C \uC138\uC6B8
      \uB3D9\uBC18\uC790\uB85C \uC7AC\uBC30\uCE58\uD588\uC2B5\uB2C8\uB2E4.\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294
      \uC774\uC81C \uC77C\uAC1C \uBC31\uC791\uB839\uC774 \uC544\uB2C8\uB77C, \uC81C\uAD6D
      \uACBD\uC81C\uC758 \uC228\uD1B5\uC744 \uC950\uACE0 \uD754\uB4DC\uB294 \uAC70\uB300\uD55C
      \uC0C1\uC5C5 \uC81C\uAD6D\uC73C\uB85C \uC6B0\uB69D \uC130\uB2F5\uB2C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uCE5C\uAD6C\uC758 \uC9C4\uC2EC\uC870\uCC28 \uAC00\uC7A5 \uB0A0\uCE74\uB85C\uC6B4
      \uBB34\uAE30\uB85C \uBC14\uAFD4\uBC84\uB9B0, \uC5BC\uC74C\uCC98\uB7FC \uCC28\uAC00\uC6B4
      \uC9C0\uBC30\uC790\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 1
