  _moodType: 1
  _text:
    _title: "\uC5D4\uB529"
    _body: "\uC544\uBCA8\uB9AC\uC544\uAC00 12\uB144 \uB3D9\uC548 \uAC00\uC7A5 \uAC00\uAE4C\uC774
      \uB454 \uC0AC\uB78C\uC740 \uB9AC\uC548\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uB140\uB294
      \uC548\uC815\uC801\uC778 \uC544\uC774\uB85C \uC790\uB790\uAE30\uC5D0...\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uC131\uC778\uC2DD \uB0A0 \uB3C4\uCC29\uD55C \uB9AC\uC548\uC758 \uCE5C\uD544
      \uC11C\uC2E0\uC744 \uBCF4\uAD00\uD568\uC774 \uC544\uB2CC, \uC774\uBBF8 \uCC98\uB9AC\uAC00
      \uB05D\uB09C \uBBFC\uC6D0 \uC11C\uB958 \uBB49\uCE58 \uD2C8\uC5D0 \uB07C\uC6CC
      \uB123\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC694\uC591\uC9C0\uC5D0\uC11C \uB9CC\uB09C
      \uC18C\uB144\uC758 \uAE30\uC5B5\uC740 \uBC18\uAC00\uC6E0\uC73C\uB098, \uB2F9\uC7A5
      \uADF8\uB140\uAC00 \uCC45\uC784\uC838\uC57C \uD560 \uC601\uC9C0\uC758 \uC218\uD655\uB7C9\uBCF4\uB2E4
      \uBB34\uAC70\uC6B8 \uC218\uB294 \uC5C6\uC5C8\uAC70\uB4E0\uC694.\n\uADF8\uB140\uB294
      \uB204\uAD6C\uC758 \uC5B4\uAE68\uC5D0\uB3C4 \uB4F1\uC744 \uAE30\uB300\uC9C0
      \uC54A\uC740 \uCC44, \uC624\uC9C1 \uC790\uC2E0\uC758 \uCC28\uAC00\uC6B4 \uC778\uC7A5
      \uD558\uB098\uB85C \uC601\uC9C0\uC758 \uC6B4\uBA85\uC744 \uC9C1\uC811 \uCC0D\uC5B4
      \uB20C\uB800\uC2B5\uB2C8\uB2E4.\n\uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uB294 \uBE44\uB85D
      \uAC00\uB09C\uD558\uACE0 \uACE0\uB9BD\uB418\uC5C8\uC73C\uB098, \uC544\uBCA8\uB9AC\uC544\uC758
      \uCC45\uC0C1 \uC704\uC5D0\uB294 \uC624\uC9C1 \uADF8\uB140\uC758 \uC774\uB984\uB9CC\uC774
      \uC120\uBA85\uD55C \uC8FC\uAD8C\uC790\uB85C \uB0A8\uC558\uB2F5\uB2C8\uB2E4.\n'\uACE0\uC9D1\uBD88\uD1B5
      \uBC31\uC791'\uC774\uB77C\uB294 \uC18C\uBB38\uC774 \uB4E4\uB824\uC654\uC9C0\uB9CC,
      \uADF8\uB140\uB294 \uADF8\uC800 \uB2F4\uB2F4\uD788 \uB2E4\uC74C \uC7A5\uBD80\uB97C
      \uB118\uAE38 \uBFD0\uC774\uC5C8\uC9C0\uC694."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 3
