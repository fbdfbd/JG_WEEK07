  m_Name: CharacterEnding_Rian_07_09_Stability
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_rian_07_09_stability
  _characterType: 0
  _minMeetCount: 7
  _maxMeetCount: 9
  _moodType: 1
  _text:
    _title: "|- \uB9AC\uC548 \uB9CC\uB0A8 7~9 - \uC548\uC815"
    _body: "|- \uC131\uC778\uC2DD \uC804\uB0A0 \uBC24, \uB9AC\uC548\uC740 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
      \uB9D0\uD588\uB2E4. \"\uB0B4\uC77C, \uB0B4\uAC00 \uD669\uC2E4\uC758 \uC774\uB984\uC73C\uB85C
      \uB108\uB97C \uC9C0\uC9C0\uD560 \uAC70\uC57C. \uBD09\uC2E0\uAC00\uBB38\uC774\uACE0
      \uD6C4\uC791\uAC00\uACE0, \uC544\uBB34\uB3C4 \uC774\uC758\uB97C \uC81C\uAE30\uD558\uC9C0
      \uBABB\uD560 \uAC70\uC57C.\"\n\uC544\uBCA8\uB9AC\uC544\uB294 \uCC3D\uBC16\uC758
      \uB208\uC744 \uBC14\uB77C\uBCF4\uBA70 \uB300\uB2F5\uD588\uB2E4. \"\uB9AC\uC548.
      \uB098\uB294 \uB124 \uBCF4\uD638 \uC544\uB798 \uBC31\uC791\uC774 \uB418\uACE0
      \uC2F6\uC9C0 \uC54A\uC544.\"\n\uB9AC\uC548\uC740 \uC7A0\uAE50 \uBA48\uCD94\uC5C8\uB2E4\uAC00,
      \uC6C3\uC5C8\uB2E4. \uCC98\uC74C \uBCF8 \uAC83 \uAC19\uC740 \uC6C3\uC74C\uC774\uC5C8\uB2E4.\n\uC131\uC778\uC2DD\uC7A5\uC5D0\uC11C
      \uC544\uBCA8\uB9AC\uC544\uB294 \uD63C\uC790 \uC130\uB2E4. \uBD09\uC2E0\uAC00\uBB38\uC758
      \uB3C4\uC804\uC744 \uC9C1\uC811 \uBB3C\uB9AC\uCCE4\uACE0, \uD6C4\uC791\uAC00\uC758
      \uD6C4\uACAC\uC744 \uC815\uC911\uD788 \uC0AC\uC591\uD588\uB2E4. \uB9AC\uC548\uC758
      \uC9C0\uC9C0 \uC131\uBA85\uC740 \uC2DD\uC774 \uB05D\uB09C \uB4A4\uC5D0\uC57C
      \uBC1C\uD45C\uB418\uC5C8\uB2E4. \uCD95\uD558\uC600\uC9C0, \uBCF4\uD638\uAC00
      \uC544\uB2C8\uC5C8\uB2E4.\n\uD6D7\uB0A0, \uB450 \uC0AC\uB78C\uC758 \uC11C\uC2E0\uC740
      \uC815\uCE58\uB3C4 \uC678\uAD50\uB3C4 \uC544\uB2CC \uAC83\uB4E4\uB85C \uCC44\uC6CC\uC84C\uB2E4.
      \uACC4\uC808\uC758 \uBCC0\uD654, \uC815\uC6D0\uC758 \uAF43, \uC11C\uC7AC\uC5D0\uC11C
      \uC77D\uC740 \uCC45. \uC544\uBCA8\uB9AC\uC544\uB294 \uAC00\uC7A5 \uC790\uC720\uB85C\uC6B4
      \uBC31\uC791\uC774\uC5C8\uACE0, \uB9AC\uC548\uC740 \uADF8\uB140\uAC00 \uC790\uC720\uB85C\uC6B4
      \uAC83\uC744 \uAC00\uC7A5 \uAE30\uBED0\uD558\uB294 \uC0AC\uB78C\uC774\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 3
