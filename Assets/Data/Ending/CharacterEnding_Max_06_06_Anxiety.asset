  m_Name: CharacterEnding_Max_06_06_Anxiety
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_06_06_anxiety
  _characterType: 1
  _minMeetCount: 6
  _maxMeetCount: 6
  _moodType: 0
  _text:
    _title: "|- \uB9C9\uC2A4 \uB9CC\uB0A8 6 - \uBD88\uC548"
    _body: "|- \uB9C9\uC2A4\uC758 \uC81C\uC548\uC744 \uBC1B\uC544\uB4E4\uC778 \uB0A0,
      \uC544\uBCA8\uB9AC\uC544\uB294 \uC548\uB3C4\uD588\uB2E4. \uB354 \uC774\uC0C1
      \uD63C\uC790 \uACB0\uC815\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB41C\uB2E4\uB294
      \uAC83\uC774, \uBB34\uC5C7\uBCF4\uB2E4 \uD3B8\uC548\uD588\uB2E4.\n\uC131\uC778\uC2DD\uC740
      \uC131\uB300\uD588\uB2E4. \uBD09\uC2E0\uAC00\uBB38\uACFC \uBC31\uC791\uAC00\uC758
      \uACB0\uD569\uC740 \uC601\uC9C0\uC5D0 \uC548\uC815\uC744 \uAC00\uC838\uC654\uACE0,
      \uB204\uAD6C\uB3C4 \uC774\uC758\uB97C \uC81C\uAE30\uD558\uC9C0 \uC54A\uC558\uB2E4.
      \uB9C9\uC2A4\uB294 \uC544\uBCA8\uB9AC\uC544 \uC606\uC5D0 \uC11C\uC11C \uBBF8\uC18C
      \uC9C0\uC5C8\uB2E4.\n\uC138\uC6D4\uC774 \uD750\uB974\uBA74\uC11C, \uBC31\uC791\uB839\uC758
      \uC2E4\uC9C8\uC801\uC778 \uACB0\uC815\uC740 \uB9C9\uC2A4\uC758 \uC190\uC73C\uB85C
      \uB118\uC5B4\uAC14\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294 \uC11C\uB958\uC5D0
      \uC11C\uBA85\uD588\uC9C0\uB9CC, \uC11C\uB958\uC758 \uB0B4\uC6A9\uC744 \uBA3C\uC800
      \uC77D\uB294 \uAC83\uC740 \uC5B8\uC81C\uB098 \uB9C9\uC2A4\uC600\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8\uAC83\uC744 \uBD84\uC5C5\uC774\uB77C\uACE0 \uBD88\uB800\uB2E4.\n\uD6D7\uB0A0,
      \uBC31\uC791\uAC00\uC758 \uC774\uB984\uC740 \uB0A8\uC558\uC9C0\uB9CC \uADF8
      \uC548\uC5D0 \uBCA8\uB77C\uB9AC\uC6B0\uC2A4\uC758 \uC758\uC9C0\uAC00 \uC5BC\uB9C8\uB098
      \uB0A8\uC544 \uC788\uB294\uC9C0\uB294, \uC544\uBCA8\uB9AC\uC544 \uC790\uC2E0\uB3C4
      \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4. \uBC24\uB9C8\uB2E4 \uC544\uBC84\uC9C0\uC758
      \uC11C\uC7AC\uC5D0 \uC549\uC544 \uC788\uC5C8\uC9C0\uB9CC, \uC11C\uB78D\uC740
      \uC5F4\uC9C0 \uC54A\uC558\uB2E4. \uC548\uC5D0 \uBB34\uC5C7\uC774 \uC788\uB294\uC9C0
      \uC544\uB294 \uAC83\uC774, \uBAA8\uB974\uB294 \uAC83\uBCF4\uB2E4 \uB354 \uBB34\uC11C\uC6E0\uC73C\uBBC0\uB85C."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 2
