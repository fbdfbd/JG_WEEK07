  m_Name: CharacterEnding_Max_03_04_Anxiety
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_max_03_04_anxiety
  _characterType: 1
  _minMeetCount: 3
  _maxMeetCount: 4
  _moodType: 0
  _text:
    _title: "|- \uB9C9\uC2A4 \uB9CC\uB0A8 3~4 - \uBD88\uC548"
    _body: "|- \uB9C9\uC2A4\uC640\uC758 \uB9CC\uB0A8\uC740 \uC544\uBCA8\uB9AC\uC544\uC5D0\uAC8C
      \uC790\uADF9\uC774\uC5C8\uC9C0\uB9CC, \uB3D9\uC2DC\uC5D0 \uC0C1\uCC98\uC774\uAE30\uB3C4
      \uD588\uB2E4. \uB9C9\uC2A4\uC758 \uC2DC\uC120 \uB4A4\uC5D0 \uC228\uC740 \uC57C\uB9DD\uC744
      \uB290\uB084 \uB54C\uB9C8\uB2E4, \uC0AC\uB78C\uC744 \uBBFF\uB294\uB2E4\uB294
      \uAC83\uC774 \uC870\uAE08\uC529 \uC5B4\uB824\uC6CC\uC84C\uB2E4.\n\uBD09\uC2E0\uAC00\uBB38\uC774
      \uB0B4\uBD80 \uD68C\uC720\uB97C \uC2DC\uB3C4\uD588\uC744 \uB54C, \uC544\uBCA8\uB9AC\uC544\uB294
      \uBB34\uC5B8\uAC00 \uC798\uBABB\uB418\uC5C8\uB2E4\uB294 \uAC83\uC744 \uAC10\uC9C0\uD588\uB2E4.
      \uADF8\uB7EC\uB098 \uB204\uAD6C\uB97C \uC758\uC2EC\uD574\uC57C \uD558\uB294\uC9C0,
      \uC5B4\uB514\uAE4C\uC9C0 \uD30C\uD5E4\uCCD0\uC57C \uD558\uB294\uC9C0 \uD310\uB2E8\uD558\uC9C0
      \uBABB\uD588\uB2E4. \uC758\uC2EC\uC740 \uC788\uC5C8\uC9C0\uB9CC \uD655\uC2E0\uC774
      \uC5C6\uC5C8\uACE0, \uD655\uC2E0 \uC5C6\uC774 \uD589\uB3D9\uD558\uB294 \uAC83\uC774
      \uB450\uB824\uC6E0\uB2E4.\n\uACB0\uAD6D \uC77C\uBD80 \uD558\uC778\uC774 \uBD09\uC2E0\uAC00\uBB38
      \uD3B8\uC5D0 \uC130\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uB4A4\uB2A6\uAC8C \uBC1D\uD600\uC84C\uB2E4.
      \uB9C9\uC2A4\uAC00 \uADF8 \uC911\uC2EC\uC5D0 \uC788\uC5C8\uB294\uC9C0\uB294
      \uB05D\uB0B4 \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uB2E4.\n\uBC31\uC791\uC704\uB294
      \uC720\uC9C0\uB418\uC5C8\uC9C0\uB9CC, \uC601\uC9C0 \uB0B4 \uACB0\uC815\uB9C8\uB2E4
      \"\uC774\uAC83\uB3C4 \uC870\uC791\uB41C \uAC83\uC740 \uC544\uB2CC\uC9C0\" \uC758\uC2EC\uC774
      \uB530\uB77C\uB2E4\uB154\uB2E4. \uC544\uBCA8\uB9AC\uC544\uB294 \uB204\uAD6C\uC758
      \uB9D0\uB3C4 \uB05D\uAE4C\uC9C0 \uBBFF\uC9C0 \uBABB\uD558\uB294 \uBC31\uC791\uC774
      \uB418\uC5B4 \uAC00\uACE0 \uC788\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 2
