  m_Name: CharacterEnding_Millia_07_09_Good
  m_EditorClassIdentifier: Assembly-CSharp::SO_CharacterEndingDefinition
  _id: ending_millia_07_09_good
  _characterType: 2
  _minMeetCount: 7
  _maxMeetCount: 9
  _moodType: 5
  _text:
    _title: "|- \uBC00\uB9AC\uC544 \uB9CC\uB0A8 7~9 - good"
    _body: "|- \uC544\uBCA8\uB9AC\uC544\uB294 \uBC31\uC791\uC774 \uB418\uC5C8\uB2E4.
      \uBC00\uB9AC\uC544\uB294 \uB298 \uC606\uC5D0 \uC788\uC5C8\uB2E4. \uC7AC\uC815
      \uBCF4\uACE0\uC11C\uB97C \uC77D\uC5B4\uC8FC\uC5C8\uACE0, \uBB34\uC5ED \uD611\uC815\uC744
      \uAC80\uD1A0\uD574\uC8FC\uC5C8\uACE0, \uB204\uAD6C\uC640 \uAC70\uB798\uD558\uACE0
      \uB204\uAD6C\uB97C \uBA40\uB9AC\uD574\uC57C \uD558\uB294\uC9C0 \uC54C\uB824\uC8FC\uC5C8\uB2E4.\n\uC544\uBCA8\uB9AC\uC544\uB294
      \uBC00\uB9AC\uC544\uB97C \uC9C4\uC2EC\uC73C\uB85C \uC2E0\uB8B0\uD588\uB2E4.
      \uBC00\uB9AC\uC544\uB3C4 \uC544\uBCA8\uB9AC\uC544\uB97C \uC9C4\uC2EC\uC73C\uB85C
      \uC544\uAF08\uB2E4. \uB2E4\uB9CC \uC544\uB07C\uB294 \uBC29\uC2DD\uC774 \uBCF4\uD638\uC778\uC9C0
      \uAD00\uB9AC\uC778\uC9C0, \uB458 \uB2E4 \uAD6C\uBD84\uD558\uC9C0 \uBABB\uD588\uB2E4.\n\uBC31\uC791\uB839\uC740
      \uBC88\uC601\uD588\uB2E4. \uCE74\uB974\uBCF4 \uC0C1\uB2E8\uACFC\uC758 \uAD00\uACC4\uB294
      \uACAC\uACE0\uD588\uACE0, \uC7AC\uC815\uC740 \uD55C \uBC88\uB3C4 \uC801\uC790\uB97C
      \uAE30\uB85D\uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB7EC\uB098 \uBC31\uC791\uB839\uC758
      \uBAA8\uB4E0 \uAC70\uB798\uC5D0\uB294 \uCE74\uB974\uBCF4 \uC0C1\uB2E8\uC758
      \uC778\uC7A5\uC774 \uD568\uAED8 \uCC0D\uD600 \uC788\uC5C8\uACE0, \uC544\uBCA8\uB9AC\uC544\uB294
      \uADF8\uAC83\uC774 \uD611\uB825\uC758 \uC99D\uAC70\uB77C\uACE0 \uBBFF\uC5C8\uB2E4.\n\uBC00\uB9AC\uC544\uB294
      \uC6C3\uACE0 \uC788\uC5C8\uB2E4. \uB298 \uADF8\uB7AC\uB4EF\uC774. \uADF8 \uC6C3\uC74C\uC774
      \uCE5C\uAD6C\uC758 \uAC83\uC778\uC9C0, \uAC70\uB798 \uC0C1\uB300\uC758 \uAC83\uC778\uC9C0\uB294
      \u2014 \uC544\uBCA8\uB9AC\uC544\uB9CC \uBAA8\uB974\uACE0 \uC788\uC5C8\uB2E4."
    _summary: 
    _closingLine: 
    _reputationLine: 
    _visualState: 3
